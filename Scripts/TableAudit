where ACO_Active = 'YES';

with
    cte
    as

    (
        select
            *
            ,ROW_NUMBER()over(
partition by bene_hic_num, CLM_DGNS_CD, year(clm_thru_dt)
order by bene_hic_num, CLM_DGNS_CD, clm_thru_dt
) seq
        from
            #temp_total
    )
merge CCLF_subsets.dbo.clm_dgns_test as tgt
using(
select
    *
from
    cte
where seq = 1
) as src
on 
tgt.bene_hic_num = src.BENE_HIC_NUM
    and tgt.CLM_DGNS_CD = src.CLM_DGNS_CD
    and year(tgt.CLM_THRU_DT) = year(src.clm_thru_dt)
when matched 
and src.clm_thru_dt < tgt.clm_thru_dt
Then update set
      [MedicareFileDate]	                    = src.[MedicareFileDate]
      ,[CCLFFile]			                    = src.[CCLFFile]
      ,[CUR_CLM_UNIQ_ID]	                    = src.[CUR_CLM_UNIQ_ID]
      ,[BENE_MBI_ID]                            = src.[BENE_MBI_ID]
      ,[BENE_HIC_NUM]                           = src.[BENE_HIC_NUM]
      ,[BENE_HIC_NUM_OLD]                       = src.[BENE_HIC_NUM_OLD]
      ,[CLM_TYPE_CD]                            = src.[CLM_TYPE_CD]
      ,[CLM_TYPE]                               = src.[CLM_TYPE]
      ,[CLM_FROM_DT]                            = src.[CLM_FROM_DT]
      ,[CLM_THRU_DT]                            = src.[CLM_THRU_DT]
      ,[CLM_DGNS_CD]                            = src.[CLM_DGNS_CD]
      ,[CLM_DGNS]                               = src.[CLM_DGNS]
      ,[CLM_DGNS_Level1_Short]                  = src.[CLM_DGNS_Level1_Short]
      ,[CLM_DGNS_Level2_Short]                  = src.[CLM_DGNS_Level2_Short]
      ,[CLM_DGNS_Level3_Short]                  = src.[CLM_DGNS_Level3_Short]
      ,[CLM_LINE_HCPCS_CD]                      = src.[CLM_LINE_HCPCS_CD]
      ,[CLM_LINE_HCPCS]                         = src.[CLM_LINE_HCPCS]
      ,[CLM_LINE_HCPCS_From]                    = src.[CLM_LINE_HCPCS_From]
      ,[HCPCS_1_MDFR_CD]                        = src.[HCPCS_1_MDFR_CD]
      ,[HCPCS_2_MDFR_CD]                        = src.[HCPCS_2_MDFR_CD]
      ,[HCPCS_3_MDFR_CD]                        = src.[HCPCS_3_MDFR_CD]
      ,[HCPCS_4_MDFR_CD]                        = src.[HCPCS_4_MDFR_CD]
      ,[HCPCS_5_MDFR_CD]                        = src.[HCPCS_5_MDFR_CD]
      ,[DGNS_PRCDR_ICD_IND]                     = src.[DGNS_PRCDR_ICD_IND]
      ,[RNDRG_PRVDR_TYPE_CD]                    = src.[RNDRG_PRVDR_TYPE_CD]
      ,[RNDRG_PRVDR_TYPE]                       = src.[RNDRG_PRVDR_TYPE]
      ,[RNDRG_PRVDR_NPI_NUM]                    = src.[RNDRG_PRVDR_NPI_NUM]
      ,[RNDRG_Prvdr_Org_Name_Lgl_Bus_Name]      = src.[RNDRG_Prvdr_Org_Name_Lgl_Bus_Name]
      ,[RNDRG_Prvdr_LName]                      = src.[RNDRG_Prvdr_LName]
      ,[RNDRG_Prvdr_FName]                      = src.[RNDRG_Prvdr_FName]
      ,[CLM_PRVDR_SPCLTY_CD]                    = src.[CLM_PRVDR_SPCLTY_CD]
      ,[CLM_PRVDR_SPCLTY]                       = src.[CLM_PRVDR_SPCLTY]
      ,[CLM_FED_TYPE_SRVC_CD]                   = src.[CLM_FED_TYPE_SRVC_CD]
      ,[CLM_FED_TYPE_SRVC]                      = src.[CLM_FED_TYPE_SRVC]
      ,[CLM_POS_CD]                             = src.[CLM_POS_CD]
      ,[CLM_POS]                                = src.[CLM_POS]
      ,[CLM_IDR_LD_DT]                          = src.[CLM_IDR_LD_DT]
      ,[CLM_CNTL_NUM]                           = src.[CLM_CNTL_NUM]
      ,[BENE_EQTBL_BIC_HICN_NUM]                = src.[BENE_EQTBL_BIC_HICN_NUM]
      ,[CLM_PROD_TYPE_CD]                       = src.[CLM_PROD_TYPE_CD]
      ,[CLM_PROD_TYPE]                          = src.[CLM_PROD_TYPE]
      ,[CLM_VAL_SQNC_NUM]                       = src.[CLM_VAL_SQNC_NUM]
      ,[PRVDR_OSCAR_NUM]                        = src.[PRVDR_OSCAR_NUM]
      ,[CLM_POA_IND]                            = src.[CLM_POA_IND]
      ,[CLM_POA_ShortDesc]                      = src.[CLM_POA_ShortDesc]
      ,[FAC_PRVDR_NPI_NUM]                      = src.[FAC_PRVDR_NPI_NUM]
      ,[FAC_PRVDR_NPI_Name]                     = src.[FAC_PRVDR_NPI_Name]
      ,[FAC_Prvdr_Org_Name_Lgl_Bus_Name]        = src.[FAC_Prvdr_Org_Name_Lgl_Bus_Name]
      ,[FAC_Prvdr_Othr_Org_Name]                = src.[FAC_Prvdr_Othr_Org_Name]
      ,[FAC_Prvdr_LName]                        = src.[FAC_Prvdr_LName]
      ,[FAC_Prvdr_FName]                        = src.[FAC_Prvdr_FName]
      ,[ATNDG_PRVDR_NPI_NUM]                    = src.[ATNDG_PRVDR_NPI_NUM]
      ,[ATNDG_PRVDR_LName]                      = src.[ATNDG_PRVDR_LName]
      ,[ATNDG_PRVDR_FName]                      = src.[ATNDG_PRVDR_FName]
      ,[ATNDG_Prvdr_Org_Name_Lgl_Bus_Name]      = src.[ATNDG_Prvdr_Org_Name_Lgl_Bus_Name]
      ,[HCCNumber]                              = src.[HCCNumber]
      ,[HCCDescription]                         = src.[HCCDescription]
      ,[HCCRiskScore]                           = src.[HCCRiskScore]
      ,[SQLRunDate]                             = getdate()
      ,[FromFile]                               = src.[FromFile]
      ,[Acute]                                  = src.[Acute]
      ,[Chronic]                                = src.[Chronic]
      ,[CLM_DGNS_Position]                      = src.[CLM_DGNS_Position]
      ,[CLM_BLG_PRVDR_OSCAR_NUM]                = src.[CLM_BLG_PRVDR_OSCAR_NUM]
