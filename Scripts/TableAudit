4344,2026-07-13T12:12:17.805203,CREATE_PROCEDURE,CCLF_Procedures,dbo,BCDA_v3_EOB_PDE,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE  BCDA_v3_EOB_PDE
	-- Add the parameters for the stored procedure here
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
with cte as (
select * 
from BCDA_data.dbo.eob_base_v3 
where Type_Code_Display = 'pharmacy'
)
Merge BCDA_Data.dbo.EOB_PDE_v3 as tgt 
using cte as src
on tgt.claim_id = src.claim_id
when matched then
update
set
  tgt.Claim_ID = src.Claim_ID
, tgt.CNTRL_num = src.CNTRL_num
, tgt.BillablePeriod_Start = src.BillablePeriod_Start
, tgt.BillablePeriod_End = src.BillablePeriod_End
, tgt.Payment_Date = src.Payment_Date
, tgt.Patient_ID = src.Patient_ID
, tgt.Provider_ID = src.Provider_ID
, tgt.Type_Display = src.Type_Display
, tgt.Type_Code_Display = src.Type_Code_Display
, tgt.Source = src.Source
, tgt.Final_Action = src.Final_Action
, tgt.Created = src.Created
, tgt.LastUpdated = src.LastUpdated
, tgt.MergedBy = 'Updated'
, tgt.Filename = src.Filename
, tgt.Extract_Date = src.Extract_Date
, tgt.Extract_From = src.Extract_From
, tgt.Extract_To = src.Extract_To
when not matched then 
insert (
Claim_ID
,CNTRL_num
,BillablePeriod_Start
,BillablePeriod_End
,Payment_Date
,Patient_ID
,Provider_ID
,Type_Display
,Type_Code_Display
,Source
,Final_Action
,Created
,LastUpdated
,MergedBy
,Filename
,Extract_Date
,Extract_From
,Extract_To
) Values (
 src.Claim_ID
,src.CNTRL_num
,src.BillablePeriod_Start
,src.BillablePeriod_End
,src.Payment_Date
,src.Patient_ID
,src.Provider_ID
,src.Type_Display
,src.Type_Code_Display
,src.Source
,src.Final_Action
,src.Created
,src.LastUpdated
,'Inserted'
,src.Filename
,src.Extract_Date
,src.Extract_From
,src.Extract_To
);

update BCDA_Data.dbo.EOB_PDE_v3
set Product_Service_Display = ndc.brand_name
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join CCLF_LookupTables.dbo.NDC ndc on 
right('0000' + replace([package_ndc], '-', ''), 11) = pde.Product_Service_Code

update BCDA_Data.dbo.EOB_PDE_v3
set Patient_Family = pt.Family
,Patient_Given     = pt.Given
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join BCDA_Data.dbo.Patient_Base_v3 pt
on pde.Patient_ID = pt.Patient_ID

update BCDA_Data.dbo.EOB_PDE_v3
set
Provider_Display = pt.Provider_Name_or_ORG
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join NPPES.dbo.Primary_Taxonomy pt on 
pt.NPI = pde.Provider_ID

update BCDA_Data.dbo.EOB_PDE_v3
set Adj_Type = ss.supportingInfo_code_display
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on pde.Claim_ID = ss.claim_id
where ss.supportingInfo_category_code = 'CLM_ADJSTMT_TYPE_CD'


update BCDA_Data.dbo.EOB_PDE_v3
set 
Product_Service_Code	= it.product_service_code
,Product_Service_System = it.product_service_system
,Quantity_Value         = it.quantity_value
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join BCDA_Staging.dbo.eob_item_staging_v3 it
on pde.claim_id = it.claim_id

update BCDA_Data.dbo.EOB_PDE_v3
set IDR_Load_Date = ss.timingDate
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on pde.Claim_ID = ss.claim_id
where supportingInfo_category_code = 'CLM_IDR_LD_DT' 

update BCDA_Data.dbo.EOB_PDE_v3
set Product_Service_Display = ndc.product_display
from BCDA_Data.dbo.EOB_PDE_v3 pde
inner join BCDA_Staging.dbo.ndccodes ndc on 
pde.Product_Service_Code = ndc.product_code
where Product_Service_Display is null

END
