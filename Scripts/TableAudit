-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE BCBS_Paydetail
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

---------------------------------------------
-- PayDetail Monthly Import to Year Table
---------------------------------------------
Declare @BCBSFileDate as Date
--Set @BCBSFileDate = '09/1/2025'
Set @BCBSFileDate = (select distinct FORMAT(CONVERT(date, max([CapitationPeriodDate])), 'MM-dd-yyyy') from BCBS_Months.dbo.PayDetail_Staging) --automation Levi 10/10/2025


Delete from BCBS_Months.dbo.PayDetail
Where
BCBSFileDate = @BCBSFileDate

Drop Table if Exists #Temp1

--------------------------------------------------
-- Insert into PayDetail Months
--------------------------------------------------
Insert Into BCBS_Months.dbo.PayDetail
(
  BCBSFileDate
, Member_FullName
, MemberDOB
, MemberGender_CD
, MemberGender
, PayeeID
, CapitationPeriodDate
, PAYMENT_TYPE_CD
, Payment_Type
, PatientId
, PatientId_Type
, PROGRAM_INDICATOR_CD
, Program_Indicator
, PaidProcessPeriodDate
, CORPORATE_ENTITY_CD
, Corporate_Entity
, PRODUCT_TYPE_CD
, Product_Type
, PrimaryCareProvider_NPI
, PaidAmount
, SubscriberID
, MemberTypeIndicator_CD
)

Select
  @BCBSFileDate
, Member_FullName
, MemberDOB
, PayD.MemberGender_CD
, Case
	When MemberGender_CD = 'M' Then 'Male'
	When MemberGender_CD = 'F' Then 'Female'
	Else 'Unknown'
  End
, PayeeID
, CapitationPeriodDate
, PayD.PAYMENT_TYPE_CD
, PT.PAYMENT_TYPE
, PatientId
, Case
	When Left(PatientID,8) = '99000000' Then 'Host'
	Else 'Texas'
  End
, PayD.PROGRAM_INDICATOR_CD
, PrgmI.PROGRAM_INDICATOR
, PaidProcessPeriodDate
, PayD.CORPORATE_ENTITY_CD
, CE.CORPORATE_ENTITY
, PayD.PRODUCT_TYPE_CD
, Prod.PRODUCT_TYPE
, Case
	When PrimaryCareProvider_NPI = '9999999998' Then Null
	Else PrimaryCareProvider_NPI
  End
, PaidAmount
, Case
	When SubscriberID = '9999999998' Then Null
	Else SubscriberID
  End
, Null as MemberTypeIndicator_CD
from BCBS_Months.dbo.PayDetail_Staging PayD
Left Join
BCBS_LookupTables.dbo.tbl_Payment_Type_CD PT on
PayD.PAYMENT_TYPE_CD = PT.PAYMENT_TYPE_CD
Left Join
BCBS_LookupTables.dbo.tbl_Product_Type_CD Prod on
PayD.PRODUCT_TYPE_CD = Prod.PRODUCT_TYPE_CD
Left Join
BCBS_LookupTables.dbo.tbl_Coporate_Entity_CD CE on
PayD.CORPORATE_ENTITY_CD = CE.CORPORATE_ENTITY_CD
Left Join
BCBS_LookupTables.dbo.tbl_Program_Indicator_CD PrgmI on
PayD.PROGRAM_INDICATOR_CD = PrgmI.PROGRAM_INDICATOR_CD

--------------------------------------------
-- Update the Member County and Market
--------------------------------------------
Update PayD
Set 
  PayD.MemberCounty			= Mbr.MemberCounty
, PayD.MemberCountyMarket	= Mbr.MemberCountyMarket
from BCBS_Months.dbo.PayDetail PayD
Inner Join
BCBS_Months.dbo.Membership_Months Mbr on
PayD.PatientID = mbr.PatientID
Where
PayD.BCBSFileDate = @BCBSFileDate

--------------------------------------------------------
-- Update Corresponding Tables with Product Type Code
-- Ie: HMO, PPO, etc
--------------------------------------------------------
Select Distinct 
  PayD.PatientId
, PayD.PRODUCT_TYPE_CD
Into #Temp1
from BCBS_Months.dbo.PayDetail PayD
Inner Join
BCBS_Months.dbo.Institution_Header_Months Inst on
	PayD.PatientId		= Inst.PatientID
and PayD.BCBSFileDate	= Inst.BCBSFileDate

-----------------------
-- Crosswalk
-----------------------
Update XREF
Set ProductType_CD = T1.PRODUCT_TYPE_CD
from BCBS_Months.dbo.Crosswalk_Months XREF
Inner Join
#Temp1 T1 on
XREF.PatientID		= T1.PatientId
Where
XREF.BCBSFileDate = @BCBSFileDate

-----------------------
-- Institution
-----------------------
Update InstH
Set ProductType_CD = T1.PRODUCT_TYPE_CD
from BCBS_Months.dbo.Institution_Header_Months InstH
Inner Join
#Temp1 T1 on
InstH.PatientID = T1.PatientId
Where
InstH.BCBSFileDate = @BCBSFileDate

-----------------------
-- Membership
-----------------------
Update Mbr
Set ProductType_CD = T1.PRODUCT_TYPE_CD
from BCBS_Months.dbo.Membership_Months Mbr
Inner Join
#Temp1 T1 on
Mbr.PatientID = T1.PatientId
Where
Mbr.BCBSFileDate = @BCBSFileDate

-----------------------
-- Professional
-----------------------
Update ProfH
Set ProductType_CD = T1.PRODUCT_TYPE_CD
from BCBS_Months.dbo.Professional_Header_Months ProfH
Inner Join
#Temp1 T1 on
ProfH.PatientID = T1.PatientId
Where
ProfH.BCBSFileDate = @BCBSFileDate

-----------------------
-- RX Claims
-----------------------
Update RX
Set ProductType_CD = T1.PRODUCT_TYPE_CD
from BCBS_Months.dbo.RXClaims_Months RX
Inner Join
#Temp1 T1 on
RX.PatientID = T1.PatientId
Where
RX.BCBSFileDate = @BCBSFileDate



END
