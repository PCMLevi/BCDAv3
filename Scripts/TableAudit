5630,2026-08-12T14:29:06.604837,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	--*********************************************************************************************
-- 30_2_0_ACO_Beneficiaries_2025_Quarterly_Ver3_0.sql
--
-- vst 11/11/2025 Changes
-- 
-- Some Voluntary Aligned Beneficiaries DO have PCS records in the Q4 Table.
--
-- Change:  
--		Some Beneficiaries have PCS Records in QASSGN_4 (which is the QARL data)
--
--		Some Beneficiaries do not have PCS Records and are only 
--		Voluntary aligned (data in QASSGN_1 (which is the QARL data).
--
--		Some Beneficiary are Voluntarily aligned with an Physician 
--		who is no longer Active in the ACO.
--
-- Flag Definitions:
--		FLAG_NPI_PCS:	Beneficiary has records in the PCS Table (QASSGN_1_4)
--		FLAG_NPI_VA:	Beneficiary is Voluntarily Aligned and has a row in the QASSGN_1_1 Table
--		Flag_VA_Active:	The Physician is marked ""Active"" in the ACO Table.
--	
-- To handle all of the different scenarios, a truth table has been 
-- created to designate current Attribution.
--
--		  Flag			   Flag			  Flag			Bene_Attribution	Bene_Attribution
--		  InPCS			   InVA			  Active		NPI_Number			NPI_Number2
--														PCS or VA			PCS or VA
--		__________		__________		__________		________________	_________________
--		   1				1				1			  VA_NPI				PCS_NPI
--		   1				0				#N/A		  PCS_NPI				NULL
--		   1				1				0			  PCS_NPI				VA_NPI
--		   0				1				1			  VA_NPI				NULL
--		   0 				1				0			  VA_NPI				NULL
--
--*********************************************************************************************

-----------------------------------------------------
-- Trying to re-work Beneficiary File
-- CHANGE THE CCLF8 File at the bottom!
-----------------------------------------------------
Drop Table if Exists #Temp_NPI_Switch

Declare @SelectType			as Varchar(15)
Declare @YearQuarter		as char(6)
Declare @StartDate			as date
Declare @StopDate			as date
Declare @PrimaryTaxanomy	as varchar(50)

Declare @FiscalYear			as Varchar(6)
Declare @QuarterStart		as Date
Declare @QuarterStop		as Date

Declare @StartTime			as DateTime
Declare @StopTime			as Datetime
Declare @MsgString			as Varchar(75)

Set @SelectType			= 'Current'
Set @FiscalYear			= (Select FiscalYear	From Database_Constants.dbo.Quarterly_Automated)
Set @YearQuarter		= (Select YearQuarter	From Database_Constants.dbo.Quarterly_Automated)
Set @QuarterStart		= (Select QuarterStart	From Database_Constants.dbo.Quarterly_Automated)
Set	@QuarterStop		= (Select QuarterStop	From Database_Constants.dbo.Quarterly_Automated)

----------------------------------------------------------------------------
-- NOTE!!!!!
--
-- I copied attribution records for 2021Q4 for 2022Q1 for Power BI Reports
-- (If 2021Q4 needs run a 2nd time then delete 2022Q1 records and re-copy)
----------------------------------------------------------------------------
Drop Table if exists cclf_testing.dbo.tblTemp1
Drop Table if exists CCLF_Testing.dbo.tblTemp2
Drop Table if exists CCLF_Testing.dbo.tblTemp3
Drop Table if exists CCLF_Testing.dbo.tblTemp4
Drop Table if exists CCLF_Testing.dbo.tblTemp5_0
Drop Table if exists CCLF_Testing.dbo.tblTemp5_1
Drop Table if exists CCLF_Testing.dbo.tblTemp5_2
Drop Table if exists CCLF_Testing.dbo.tblTemp5_3
Drop Table if exists CCLF_Testing.dbo.tblTemp5_4
Drop Table if exists CCLF_Testing.dbo.tblTemp5_5
Drop Table if exists CCLF_Testing.dbo.tblTemp5_6
Drop Table if exists CCLF_Testing.dbo.tblTemp6
Drop Table if exists CCLF_Testing.dbo.tblTemp7
Drop Table if exists CCLF_Testing.dbo.tblTemp8
Drop Table if exists CCLF_Testing.dbo.tblTemp9
Drop Table if exists CCLF_Testing.dbo.tblTemp10
Drop Table if exists CCLF_Testing.dbo.tblTemp11
Drop Table if exists CCLF_Testing.dbo.tblTemp12
Drop Table if exists CCLF_Testing.dbo.tblTemp13
Drop Table if exists CCLF_Testing.dbo.tblTemp13_A
Drop Table if exists CCLF_Testing.dbo.tblTemp14
Drop Table if exists CCLF_Testing.dbo.tblTemp15
Drop Table if exists CCLF_Testing.dbo.tblTemp16

---------------------------------------------------------------------------
-- Delete the current quarter from the ACO_Beneficiaries Table
---------------------------------------------------------------------------
Delete From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where 
BENE_YearQuarter = @YearQuarter

---------------------------------------------------------------------------
-- Insert the Beneficiary informaton from Qassgn into the ACO_Beneficiaries
-- table to start Finding out who their Primary Care Physician is
--
-- BENE_NPI_2 Information is inserted into ACO_Beneficiaries from the Start
-- Because they are Voluntarily Aligned in QASSGN_1.
--
-- BENE_NPI_Number (Regular) is assigned as program determines the correct 
-- PCP the Beneficiary is attributed to according to CMS Rules.
---------------------------------------------------------------------------
Insert into CCLF_LookupTables.dbo.ACO_Beneficiaries
		(
		  BENE_YearQuarter
		, BENE_HIC_NUM
		, BENE_NPI_2_Number
		, BENE_NPI_2_TIN
		, Flag_NPI_VA
		, Flag_NPI_PCS
		, IN_VA_MAX
		)	 

		Select 
		  @YearQuarter
		, Q1.Q1_HICN
		, Q1.VA_NPI
		, Q1.VA_TIN
		, Case 
			When Q1.VA_NPI is null 
			Then 0 Else 1 
		  End As Flag_NPI_VA
		, 0							-- Set pcs_Flag to 0.  
		, IN_VA_MAX					-- We do not know who has/does not have record(s) in PCS
		from CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
		Where Q1_YearQuarter = @YearQuarter


--------------------------------------------------------------------------
-- Update NPI2_GroupTinName because GroupTinName is not in the Q1 Table
-- Update NPI2 Last Name and First Name
--------------------------------------------------------------------------
update BN
set 
  BENE_NPI_2_TINName		= ACO.ACO_GroupTinName
, BENE_NPI_2_Group			= ACO.ACO_GroupTinShortName
, BENE_NPI_2_LastName		= ACO.ACO_NPI_LastName
, BENE_NPI_2_FirstName		= ACO.ACO_NPI_FirstName
, BENE_NPI_Classification	= ACO.ACO_PrimaryTaxonomy         ---Levi 12/1/2025
From CCLF_LookupTables.dbo.ACO_Beneficiaries BN
inner join CCLF_LookupTables.dbo.ACO ACO
on BN.BENE_NPI_2_Number = ACO.ACO_NPIIndividual
Where
BN.BENE_NPI_2_Number	is not null

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have only 
-- 1 NPI.
-- Update all the records in the ACO_Beneficiaries table with this
-- information
---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select 
  Q4_HICN
, Min(Q4_IndividualNPI) as MinNPI
Into cclf_testing.dbo.tblTemp1
from CCLF_LookupTables.dbo.QASSGN_Table1_4
Where
Q4_YearQuarter = @YearQuarter
Group by
  Q4_HICN
Having Count(Q4_HICN) = 1
Order by 
Q4_HICN

Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= Temp1.MinNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 01.  1 NPI'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp1 Temp1 on
ACO_BENE.BENE_HIC_NUM = Temp1.Q4_HICN
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is null	

--Select * from CCLF_Testing.dbo.tblTemp1

Set @StopTime = GetDate()
Set @MsgString = 'Step 01.  1 NPI Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have  
-- > 1 NPI and Only 1 records is a ""Family Medicine"" NPI  
--
-- Update all the records in the ACO_Beneficiaries table with this
-- information

---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select
  Q4.Q4_HICN
, MIN(Q4.Q4_IndividualNPI) as MinNPI
Into CCLF_Testing.dbo.tblTemp2
from CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
Q4.Q4_HICN = ACO_BENE.BENE_HIC_NUM
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where
	ACO_BENE.BENE_YearQuarter		= @YearQuarter
and Q4.Q4_YearQuarter				= @YearQuarter
and ACO_BENE.BENE_ATTR_From			is null
and ACO.ACO_NPI_Classification		In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active					= 'Yes' -- Added 10/25/2021 to make sure 
Group By
  Q4.Q4_HICN
Having Count(Q4.Q4_HICN) = 1
Order by
Q4.Q4_HICN

Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= Temp2.MinNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 02.  1 FAM NPI'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp2 Temp2 on
ACO_BENE.BENE_HIC_NUM = Temp2.Q4_HICN
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and BENE_ATTR_From				Is Null

Set @StopTime = GetDate()
Set @MsgString = 'Step 02.  1 Family NPI Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have  
-- > 1 NPI and > 1 record that is a ""Family Medicine"" NPI  
--
-- Next find which NPI had the most Visits
---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select
 ACO_BENE.BENE_HIC_NUM
Into CCLF_Testing.dbo.tblTemp3
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
ACO_BENE.BENE_HIC_NUM = Q4.Q4_HICN
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and Q4.Q4_YearQuarter			= @YearQuarter
and ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is null
and ACO.ACO_NPI_Classification	In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active				= 'Yes' -- Added 10/25/2021 to make sure 
Group By
  ACO_BENE.BENE_HIC_NUM
Having Count(BENE_HIC_NUM) > 1
Order by
BENE_HIC_NUM

----------------------------------------------
-- Join to QASSGN1_4 to find multiple NPI's
----------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp4
from CCLF_Testing.dbo.tblTemp3 T3
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
T3.BENE_HIC_NUM = Q4.Q4_HICN
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where 
    Q4.Q4_YearQuarter			= @YearQuarter
And ACO.ACO_NPI_Classification	In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active				= 'Yes' -- Added 10/25/2021 to make sure 
Order by 
T3.BENE_HIC_NUM

--------------------------------------------------
-- Join to PCS File to Find Most PCS Visits
--------------------------------------------------
Select 
  T4.BENE_HIC_NUM
--, T4.ACO_NPIIndividual
-- Changed 8/22/2019 for Plurality of greatest cost
--, Count(distinct CUR_CLM_UNIQ_ID) as NumVisits
, Max(Q4.Q4_PCS_Count) as NumVisits
Into CCLF_Testing.dbo.tblTemp5_0
from CCLF_Testing.dbo.tblTemp4 T4
Left Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
    T4.BENE_HIC_NUM			= Q4.Q4_HICN
and T4.ACO_NPIIndividual	= Q4.Q4_IndividualNPI
Where
Q4.Q4_YearQuarter			= @YearQuarter
Group by
  T4.BENE_HIC_NUM
--, T4.ACO_NPIIndividual

------------------------------------------------------
-- Join Back to PCS File to Find NPI with Max Visits
------------------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp5_1 
from CCLF_Testing.dbo.tblTemp5_0 T5
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T5.BENE_HIC_NUM = Q4.Q4_HICN
and T5.NumVisits	= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter = @YearQuarter

--------------------------------------------------
-- Find Single NPI / Beneficiaries
--------------------------------------------------
Select 
  BENE_HIC_NUM
, NumVisits
, Count(BENE_HIC_NUM) as NumRecords
Into CCLF_Testing.dbo.tblTemp5_2
from CCLF_Testing.dbo.tblTemp5_1
Group by
  BENE_HIC_NUM
, NumVisits
Having Count(BENE_HIC_NUM) = 1
Order by
  NumRecords DESC
, BENE_HIC_NUM

---------------------------------------------
-- Join Back to Find NPI with the Max Visits
---------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp5_3
From CCLF_Testing.dbo.tblTemp5_2 T5
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T5.BENE_HIC_NUM		= Q4.Q4_HICN
and T5.NumVisits		= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter		= @YearQuarter
Order by
BENE_HIC_NUM

--------------------------------------------------
-- Update ACO_Beneficiaries 
--------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T5.Q4_IndividualNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 03.  FAM NPI Max PCS Visits'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE 
Inner Join
CCLF_Testing.dbo.tblTemp5_3 T5 on 
ACO_BENE.BENE_HIC_NUM = T5.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is Null		-- vst 11/13/2025  added where clause to make sure we are not updating previous records which were already assigned attribution

Set @StopTime = GetDate()
Set @MsgString = 'Step 03.  FAM NPI Max PCS Visits (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

--------------------------------------------------
-- Select Beneficiaries with more than 1 Fam NPI
-- and Same # of PCS Visits
--------------------------------------------------
Set @StartTime = GetDate()

Select 
  BENE_HIC_NUM
, NumVisits
, Count(BENE_HIC_NUM) as NumRecords
Into CCLF_Testing.dbo.tblTemp5_4
from CCLF_Testing.dbo.tblTemp5_1
Group by
  BENE_HIC_NUM
, NumVisits
Having Count(BENE_HIC_NUM) > 1
Order by
  NumRecords DESC
, BENE_HIC_NUM

----------------------------------------------------
-- Join Back to Find NPI with Same # of PCS  Visits
----------------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp5_5
From CCLF_Testing.dbo.tblTemp5_4 T5
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T5.BENE_HIC_NUM = Q4.Q4_HICN
and T5.NumVisits	= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter	= @YearQuarter
Order by
BENE_HIC_NUM

--------------------------------------------------
-- Join to Final Data to find NPI with most $$
--------------------------------------------------
-------------------------
-- Create Index on T5_5
-------------------------
Create Index idx_BENE_HIC_NUM		on CCLF_Testing.dbo.tblTemp5_5 (BENE_HIC_NUM)
Create Index idx_Q4_IndividualNPI	on CCLF_Testing.dbo.tblTemp5_5 (Q4_IndividualNPI)

Select 
  T5.BENE_HIC_NUM
, T5.Q4_IndividualNPI
-- Changed 8/22/2019 for Plurality of greatest cost
--, Count(distinct CUR_CLM_UNIQ_ID) as NumVisits
, Sum(CLM_PMT_AMT) as TotalPaid
Into CCLF_Testing.dbo.tblTemp5_6
from CCLF_Testing.dbo.tblTemp5_5 T5
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
    T5.BENE_HIC_NUM		= FinalData.BENE_HIC_NUM
and T5.Q4_IndividualNPI = FinalData.RNDRG_PRVDR_NPI_NUM
Where
FinalData.CLM_THRU_DT between @StartDate and @StopDate
Group by
  T5.BENE_HIC_NUM
, T5.Q4_IndividualNPI

-------------------------------------------------------
-- Partition by BENE_HIC_NUM to select Max Paid
-------------------------------------------------------
Select 
  BENE_HIC_NUM
, Q4_IndividualNPI
, TotalPaid
, First_Value(Q4_IndividualNPI) Over (Partition by BENE_HIC_NUM Order by TotalPaid Desc) as NPIWithMostDollars
into CCLF_Testing.dbo.tblTemp6
from CCLF_Testing.dbo.tblTemp5_6
Order by
BENE_HIC_NUM

----------------------------------------------------------
-- Group by to get the NPI with Most Visits isolated
----------------------------------------------------------
Select 
  T6.BENE_HIC_NUM
, T6.NPIWithMostDollars
Into CCLF_Testing.dbo.tblTemp7
from CCLF_Testing.dbo.tblTemp6 T6
Group by
  T6.BENE_HIC_NUM
, T6.NPIWithMostDollars

----------------------------------------------------------
-- Update the ACO_Beneficiary table with FinalData - 2 FAM NPI
----------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T7.NPIWithMostDollars
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 04.  Final Data-2 NPI Fam Max$'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp7 T7 on
ACO_BENE.BENE_HIC_NUM = T7.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is Null		-- vst 11/13/2025  added where clause to make sure we are not updating previous records which were already assigned attribution

Set @StopTime = GetDate()
Set @MsgString = 'Step 04.  2 Family Data Most Dollars NPI Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

------------------------------------------------------------------------------------------------------------
-- The code below is the exact duplicate of the above code (5 sections or so) except it is 
-- selecting >1 NPI that is NOT a Family Medicine Doctor
------------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have  
-- > 1 NPI and > 1 record that is NOT ""Family Medicine"" NPI  
--
-- Next find which NPI had the most Visits
---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select
  ACO_BENE.BENE_HIC_NUM
Into CCLF_Testing.dbo.tblTemp8
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
ACO_BENE.BENE_HIC_NUM = Q4.Q4_HICN
Left Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where
ACO_BENE.BENE_YearQuarter = @YearQuarter
and Q4.Q4_YearQuarter = @YearQuarter
and ACO_BENE.BENE_ATTR_From is null
and ACO.ACO_NPI_Classification not In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active = 'Yes' -- Added 10/25/2021 to make sure 
Group By
  ACO_BENE.BENE_HIC_NUM
Having Count(BENE_HIC_NUM) > 1
Order by
BENE_HIC_NUM

----------------------------------------------
-- Join to QASSGN1_4 to find multiple NPI's
----------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp9
from CCLF_Testing.dbo.tblTemp8 T8
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
T8.BENE_HIC_NUM = Q4.Q4_HICN
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where 
    Q4.Q4_YearQuarter = @YearQuarter
And ACO.ACO_NPI_Classification not In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active = 'Yes' -- Added 10/25/2021 to make sure 
Order by 
T8.BENE_HIC_NUM

--------------------------------------------------
-- Join to Final Data to find NPI with most visits
--------------------------------------------------
Select 
  T9.BENE_HIC_NUM
, T9.ACO_NPIIndividual
-- Changed 8/22/2019 for Plurality of greatest cost
--, Count(distinct CUR_CLM_UNIQ_ID) as NumVisits
, Sum(CLM_PMT_AMT) as NumVisits
Into CCLF_Testing.dbo.tblTemp10
from CCLF_Testing.dbo.tblTemp9 T9
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
    T9.BENE_HIC_NUM = FinalData.BENE_HIC_NUM
and T9.ACO_NPIIndividual = FinalData.RNDRG_PRVDR_NPI_NUM
Where
FinalData.CLM_THRU_DT between @StartDate and @StopDate
Group by
  T9.BENE_HIC_NUM
, T9.ACO_NPIIndividual

-------------------------------------------------------
-- Partition by BENE_HIC_NUM to select Max Visits
-------------------------------------------------------
Select 
  BENE_HIC_NUM
, ACO_NPIIndividual
, NumVisits
, First_Value(ACO_NPIIndividual) Over (Partition by BENE_HIC_NUM Order by NumVisits Desc) as NPIWithMostVisits
into CCLF_Testing.dbo.tblTemp11
from CCLF_Testing.dbo.tblTemp10
Order by
BENE_HIC_NUM

----------------------------------------------------------
-- Group by to get the NPI with Most Visits isolated
----------------------------------------------------------
Select 
  T11.BENE_HIC_NUM
, T11.NPIWithMostVisits
Into CCLF_Testing.dbo.tblTemp12
from CCLF_Testing.dbo.tblTemp11 T11
Group by
  T11.BENE_HIC_NUM
, T11.NPIWithMostVisits

----------------------------------------------------------
-- Update the ACO_Beneficiary table with FinalData - 2 FAM NPI
----------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T12.NPIWithMostVisits
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 06.  Final Data - 2 NPI NOT Fam'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp12 T12 on
ACO_BENE.BENE_HIC_NUM = T12.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is null		-- vst 11/13/2023 Added

Set @StopTime = GetDate()
Set @MsgString = 'Final Data - 2 NPI Not Family Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

------------------------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------------------------

----------------------------------------------------
-- The final records are Beneficiaries that do not
-- have any data for the year searched on.
-- Assign them to the first NPI in the Q1-4 Table
-- Code Change 2/25/2019
-- Make sure the NPI is in our ACO list
-- Code Change 3/8/2022
-- Find NPI that has the MOST visits
----------------------------------------------------
Set @StartTime = GetDate()

Select 
  BENE_HIC_NUM
--, Q4_IndividualNPI
, Max(Q4_PCS_Count) as MaxVisits   ---Was MinNPI
Into CCLF_Testing.dbo.tblTemp13
from CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on 
Q4.Q4_HICN = ACO_BENE.BENE_HIC_NUM
--from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE		-- I reversed the Join because I was taking the MinNPI from the ACO_Beneficiaries
--Inner Join												-- file instead of the Q4 File.  I also added Q4=AttributionYear because it was
--CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on				-- Not limiting the data to just Attribution Quarter we were working on.
--ACO_BENE.BENE_HIC_NUM = Q4.Q4_HICN
-- I added the inner join to ACO 2/25/2019
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where 
    ACO_BENE.BENE_ATTR_From		is null
and ACO_BENE.BENE_YearQuarter	= @YearQuarter
and Q4.Q4_YearQuarter			= @YearQuarter		-- Added 8/30/2020
Group by
  BENE_HIC_NUM

Select
  BENE_HIC_NUM
, Q4_IndividualNPI
into CCLF_Testing.dbo.tblTemp13_A
from CCLF_Testing.dbo.tblTemp13 T13
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T13.BENE_HIC_NUM	= Q4.Q4_HICN
and T13.MaxVisits		= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter = @YearQuarter

---------------------------------------------------------------
-- Update the ACO_Beneficiary table with NoData-MinNPI
---------------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T13_A.Q4_IndividualNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 07.  No Data - Max PCS Count'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp13_A T13_A on
ACO_BENE.BENE_HIC_NUM = T13_A.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter = @YearQuarter
and ACO_BENE.BENE_ATTR_From is null

Set @StopTime = GetDate()
Set @MsgString = 'Step 07.  No Data - Max PCS Count Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

---------------------------------------------------------
-- Update the ACO_Beneficiaries table using 
-- QASSGN Data
---------------------------------------------------------
Update ACO_BENE
Set 
  BENE_MBI						= Q1.Q1_MBI
, BENE_HICN_Link				= Trim(Q1_LastName) + '|' + 
								  Trim(Q1_FirstName) + '|' + 
								  Cast(Q1.Q1_BirthDate as Varchar)	-- vst 10/24/2025 Added col to find BENE_HICN for MDInteractive Data
, BENE_FirstName				= Q1.Q1_FirstName
, BENE_LastName					= Q1.Q1_LastName
, BENE_Sex						= Q1.Q1_Sex
, BENE_BirthDate				= Q1.Q1_BirthDate
, BENE_DeathDate				= Q1.Q1_DeathDate
, BENE_CMSRiskScore				= Q1.CMSRiskScore
, BENE_CMSRiskScoreType			= Q1.CMSRiskScoreType 
, BENE_DemoRiskScore			= Q1.DemoRiskScore
, BENE_DemoRiskScoreType		= Q1.DemoRiskScoreType
, BENE_PersonYears				= Q1.Q1_PersonYears
, AlignmentFlag_CBA				= Q1.AlignmentFlag_CBA		-- Added 5/22/2024
, IN_VA_MAX						= Q1.IN_VA_MAX				-- Added 5/22/2024
, Flag_NPI_PCS					= Case When BENE_NPI_Number is null Then 0 Else 1 End 
, SQLRunDate					= GetDate()
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Left Join
CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1 on
    ACO_BENE.BENE_HIC_NUM		= Q1_HICN
and ACO_BENE.BENE_YearQuarter	= Q1.Q1_YearQuarter
and Q1.Q1_YearQuarter			= @YearQuarter
Where 
BENE_YearQuarter = @YearQuarter

-------------------------------------------------------------
-- Update the ADI for each Beneficiary
-------------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_ADI = Q9.Q9_ADI_NATRANK
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_9 Q9 on
ACO_BENE.BENE_HIC_NUM = Q9.Q9_HICN
Where
	BENE_YearQuarter  = @YearQuarter
and Q9.Q9_YearQuarter = @YearQuarter

----------------------------------------------
-- Update Beneficiary Info from ACO Data
-- for BENE_NPI_Number
----------------------------------------------
Update ACO_BENE
Set
  ACO_BENE.BENE_NPI_LastName			= ACO.ACO_NPI_LastName
, ACO_BENE.BENE_NPI_FirstName			= ACO.ACO_NPI_FirstName
, ACO_BENE.BENE_ACO_GroupTIN			= ACO.ACO_GroupTin
, ACO_BENE.BENE_ACO_GroupTINName		= ACO.ACO_GroupTinName
, ACO_BENE.BENE_ACO_GroupTINShortName	= ACO.ACO_GroupTinShortName
, ACO_Bene.Flag_VA_Active = 
	Case 
		When ACO.ACO_Active = 'Yes' 
		Then 1 
		Else 0 
	End 
, BENE_NPI_Classification                = ACO.ACO_PrimaryTaxonomy         ---Levi 12/1/2025
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Left Join 
CCLF_LookupTables.dbo.ACO aco on
ACO_BENE.BENE_NPI_Number	= ACO.ACO_NPIIndividual
Where 
ACO_BENE.BENE_YearQuarter	= @YearQuarter

----------------------------------------------
-- NPI is the PCS NPI or the VA NPI
--  
-- Change columns around as necessary
----------------------------------------------

--------------------------------------------------------------
-- If  Beneficiary is Voluntarily Aligned 
-- and Beneficiary is NOT in PCS Table then
-- BENE_NPI_Number = NPI_2 (Voluntary Aligned Physician
--
--------------------------------------------------------------
Update ACO_BENE
Set
  ACO_BENE.BENE_ACO_GroupTinShortName	= ACO_BENE.BENE_NPI_2_Group
, ACO_BENE.BENE_ACO_GroupTINName		= ACO_BENE.BENE_NPI_2_TINName
, ACO_BENE.BENE_ACO_GroupTIN			= ACO_BENE.BENE_NPI_2_TIN
, ACO_BENE.BENE_NPI_Number				= ACO_BENE.BENE_NPI_2_Number
, ACO_BENE.BENE_NPI_LastName			= ACO_BENE.BENE_NPI_2_LastName
, ACO_BENE.BENE_NPI_FirstName			= ACO_BENE.BENE_NPI_2_FirstName
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
And ACO_BENE.Flag_NPI_VA		= 1
and ACO_BENE.Flag_NPI_PCS		= 0
and ACO_BENE.BENE_NPI_Number	Is Null

--------------------------------------------------------------
-- AFTER BENE_NPI Info = BENE_NPI_2 Info
-- Change BENE_NPI_2 Information to Null
--------------------------------------------------------------
Update ACO_BENE
Set
  ACO_BENE.BENE_NPI_2_Group			= Null
, ACO_BENE.BENE_NPI_2_TINName		= Null
, ACO_BENE.BENE_NPI_2_TIN			= Null
, ACO_BENE.BENE_NPI_2_Number		= Null
, ACO_BENE.BENE_NPI_2_LastName		= Null
, ACO_BENE.BENE_NPI_2_FirstName		= Null
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
And ACO_BENE.Flag_NPI_VA		= 1
and ACO_BENE.Flag_NPI_PCS		= 0

----------------------------------------------------------------------
-- BENE_NPI_2 is the Voluntary Aligned Physician
-- BENE_NPI_Number is the Primary Physician.
--
-- If BENE_NPI_2 <> BENE_NPI_Number, then 
-- Reverse the NPI's
-- 
-- BENE_NPI_2		= BENE_NPI_Number
-- BENE_NPI_Number	= BENE_NPI_2
-- 
-- Create a Temporary Table so we don't loose original Assignments
--------------------------------------------------------------------
Select 
  BENE_HIC_NUM
, BENE_NPI_Number
, BENE_NPI_LastName
, BENE_NPI_FirstName
, BENE_ACO_GroupTinShortName
, BENE_ACO_GroupTINName
, BENE_ACO_GroupTIN
, BENE_NPI_2_Number
, BENE_NPI_2_LastName
, BENE_NPI_2_FirstName
, BENE_NPI_2_Group
, BENE_NPI_2_TINName
, BENE_NPI_2_TIN
Into #Temp_NPI_Switch
from CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
	BENE_YearQuarter	 = @YearQuarter
and BENE_NPI_Number		<> BENE_NPI_2_Number

------------------------------
-- Switch NPI	with NPI_2
-- Switch NPI_2 with NPI
------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number				= TSwitch.BENE_NPI_2_Number
, ACO_BENE.BENE_NPI_LastName			= TSwitch.BENE_NPI_2_LastName
, ACO_BENE.BENE_NPI_FirstName			= TSwitch.BENE_NPI_2_FirstName
, ACO_BENE.BENE_ACO_GroupTinShortName	= TSwitch.BENE_NPI_2_Group
, ACO_BENE.BENE_ACO_GroupTINName		= TSwitch.BENE_NPI_2_TINName
, ACO_BENE.BENE_ACO_GroupTIN			= TSwitch.BENE_NPI_2_TIN
, ACO_BENE.BENE_NPI_2_Number			= TSwitch.BENE_NPI_Number
, ACO_BENE.BENE_NPI_2_LastName			= TSwitch.BENE_NPI_LastName
, ACO_BENE.BENE_NPI_2_FirstName			= TSwitch.BENE_NPI_FirstName
, ACO_BENE.BENE_NPI_2_Group				= TSwitch.BENE_ACO_GroupTinShortName
, ACO_BENE.BENE_NPI_2_TINName			= TSwitch.BENE_ACO_GroupTINName
, ACO_BENE.BENE_NPI_2_TIN				= TSwitch.BENE_ACO_GroupTIN
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE 
Inner Join
#Temp_NPI_Switch TSwitch on
ACO_BENE.BENE_HIC_NUM = TSwitch.BENE_HIC_NUM
Where
	BENE_YearQuarter				 = @YearQuarter
and ACO_BENE.BENE_NPI_Number		<> ACO_BENE.BENE_NPI_2_Number

-------------------------------------------------------------
-- Update the ACO_Beneficiary Year
-------------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_AttributionYear = 'FY' + Left(@YearQuarter, 4)
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE

-------------------------------------------------------------
-- Update the ACO_Quarter Start/Stop Date 
-------------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_QuarterStart	= @QuarterStart
, ACO_BENE.BENE_QuarterStop		= @QuarterStop
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where
BENE_YearQuarter = @YearQuarter

-------------------------------------------------------------
-- Update Attribution_Type
-- vst 11/17/2025 - New Code
-------------------------------------------------------------
Update ACO_Bene
Set BENE_Attr_Type = 
	Case
		When Flag_NPI_PCS = 0 and Flag_NPI_VA = 1 and Flag_VA_Active = 0		Then 'Step 08.  No PCS, Vol. Align, NPI Not Active'
		When Flag_NPI_PCS = 0 and Flag_NPI_VA = 1 and Flag_VA_Active = 1		Then 'Step 09.  No PCS, Vol. Align, NPI Active'
		When Flag_NPI_PCS = 1 and Flag_NPI_VA = 1 and Flag_VA_Active = 1		Then 'Step 10.  Has PCS, Vol. Align, NPI Active'
		When Flag_NPI_PCS = 1 and Flag_NPI_VA = 1 and Flag_VA_Active = 0		Then 'Step 11.  Has PCS, Vol. Align, NPI Not Active'
		When Flag_NPI_PCS = 1 and Flag_NPI_VA = 0 and Flag_VA_Active In (1,0)	Then 'Step 12.  Has PCS, Not Vol. Align'
	Else 'Invalid'
	End 
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where 
BENE_YearQuarter = @YearQuarter

-------------------------------------------------------------------
-- Update Attribution_From
-- vst 11/17/2025 - New Code
--
-- Attribution_From is updated when there are records in the PCS 
-- table.  With Voluntary Alignment, there are cases where the 
-- Beneficiary has voluntary alignment and records in the PCS Table
--
-- When there are not any records in the PCS Table, It is strictly 
-- Voluntary Alignment.  
-------------------------------------------------------------------

Update ACO_BENE
Set BENE_ATTR_From = BENE_Attr_Type
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where
	BENE_YearQuarter	= @YearQuarter
And Flag_NPI_PCS		= 0							-- No Records in PCS Table (QASSGN_1_4)

------------------------------------------------------------------------------
-- This is for output purposes only to view what kind of panel we have 
-- Show the distribution of Voluntary Aligned Beneficiaries.
-- NOTE:  There are now 5 Beneficiaries as of 2025Q3 that 
-- do not have PCS Records, and the Physicians they are aligned 
-- to have left the ACO.
-- Flag_PCS = 0, Flag_VA = 1, Flag_VA_Active = 0
------------------------------------------------------------------------------
Select 
  BENE_HIC_NUM
, Flag_NPI_PCS
, Flag_NPI_VA
, Flag_VA_Active
, BENE_Attr_Type
From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_YearQuarter = @YearQuarter

Select 
  Count(BENE_HIC_NUM) as NumBene
, Sum(AlignmentFlag_CBA) as NumCBA
, Sum(Flag_NPI_PCS) as NumPCS
, Sum(Flag_NPI_VA) as NumNPI_VA
, Sum(Flag_VA_Active) as Num_VA_Active
, BENE_Attr_Type
From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_YearQuarter = @YearQuarter
Group By
BENE_Attr_Type

----------------------------------------------
-- Update MasterId
-- MasterID and MasterID_From is Updated in 
-- 30_2_2_ACO_Beneficiaries_UpdateML_Info
----------------------------------------------

END
