  HTN_TIN.HTN_Completion_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Complete_TIN as Float)
		 , HTN_Eligible_TIN
	)

From Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN HTN_TIN

--=====================
-- Fail Rate
--=====================
-------------------
-- Fail Rate NPI
-------------------
Update NPI
Set NPI.HTN_Fail_Rate_NPI = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Fail_NPI as Float)
		 , HTN_Complete_NPI
	) 
From Compensation_PYCurrent.dbo.Compensation_10_236_2_2_HTN_Aggregate_NPI NPI

-------------------
-- Fail Rate TIN
-------------------
Update TIN
Set TIN.HTN_Fail_Rate_TIN = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Fail_TIN as Float)
		 , HTN_Complete_TIN
	) 
From Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN TIN

-------------------
-- Fail Rate ACO
-------------------
Update ACO
Set ACO.HTN_Fail_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Fail_ACO as Float)
		 , HTN_Complete_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_236_2_4_HTN_Aggregate_ACO ACO

--===================================================
-- Performance Rate
-- NOTE:  Performance Rate is the same as Pass Rate
--===================================================
-------------------
-- Performance_ACO
-------------------
Update HTN_ACO
Set 
  HTN_ACO.HTN_Performance_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Pass_ACO as Float)
	,	   HTN_Complete_ACO
	)
, HTN_ACO.HTN_Pass_Rate_ACO	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Pass_ACO as Float)
	,	   HTN_Complete_ACO
	)
From Compensation_PYCurrent.dbo.Compensation_10_236_2_4_HTN_Aggregate_ACO HTN_ACO

Declare @HTN_Performance_Rate_ACO as Float
Set		@HTN_Performance_Rate_ACO = 
			(Select HTN_Performance_Rate_ACO
			 From Compensation_PYCurrent.dbo.Compensation_10_236_2_4_HTN_Aggregate_ACO)

--------------------------
-- Performance Rate TIN
--------------------------
Update HTN_TIN
Set 
  HTN_TIN.HTN_Performance_Rate_TIN = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Pass_TIN as Float)
		 , HTN_Complete_TIN
	)

, HTN_TIN.HTN_Pass_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Pass_TIN as Float)
		 , HTN_Complete_TIN
	)

, HTN_TIN.HTN_Performance_Rate_ACO	= @HTN_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN HTN_TIN

-------------------------
-- Performance Rate NPI
-------------------------
Update HTN_NPI
Set 
  HTN_NPI.HTN_Performance_Rate_NPI		= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Pass_NPI as Float)
		 , HTN_Complete_NPI
	)

, HTN_NPI.HTN_Pass_Rate_NPI				= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(HTN_Pass_NPI as Float)
		 , HTN_Complete_NPI
	)
, HTN_NPI.HTN_Performance_Rate_TIN		= HTN_TIN.HTN_Performance_Rate_TIN
, HTN_NPI.HTN_Performance_Rate_ACO		= @HTN_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_236_2_2_HTN_Aggregate_NPI HTN_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN HTN_TIN on
HTN_NPI.ACO_GroupTIN = HTN_TIN.ACO_GroupTIN

--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  HTN_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  HTN_Performance_Rate_TIN
		, @QM_40th_Percentile
		)
From Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Update NPI
Set 
  HTN_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  HTN_Performance_Rate_NPI
		, HTN_Performance_Rate_TIN
		)

, HTN_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		    HTN_Performance_Rate_NPI
		  , @QM_40th_Percentile
		)
From Compensation_PYCurrent.dbo.Compensation_10_236_2_2_HTN_Aggregate_NPI NPI

--=========================
-- Over Group Flag
-- Performance_Rate_Base
--=========================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.HTN_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.HTN_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
, TIN.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.HTN_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.HTN_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.HTN_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.HTN_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_236_2_2_HTN_Aggregate_NPI NPI


End 
