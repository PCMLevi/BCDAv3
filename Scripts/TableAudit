, NPI
, NPI_Fullname
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, BENE_FullName
, PY_BENE
, numBENE_BENE
, MeasureNumber
, MeasureName
, MeasureAbbr
, A1C_Performance
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, A1C_Eligible
, A1C_Complete
, A1C_Reading
, A1C_Reading_DT
, SQLRunDate_MDI_A1C
, SQLRunDate
)

