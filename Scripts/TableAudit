  MDI_A1C.MDI_GroupTin
, Case
	When MDI_A1C.MDI_GroupTin = '900088197'
	Then 'Phynet' 
	Else MDI_GroupTinName 
  End
, MDI_A1C.MDI_NPI
, MDI_A1C.MDI_NPI_LastName + ', ' + MDI_A1C.MDI_NPI_FirstName
, MDI_A1C.MDI_HICN
, MDI_A1C.MDI_HICN_Previous
, MDI_A1C.MDI_HICN_LastName + ', ' + MDI_A1C.MDI_HICN_FirstName
, 0										as PY_BENE
, 1
, @MeasureNumber
, @MeasureName
, @MeasureAbbr
, MDI_A1C.MDI_Performance
---------------------------------
-- A1C is a Reverse Measure
-- Met = Fail, Not Met = Pass
---------------------------------
, Case 
	When MDI_A1C.MDI_Performance = 'Met'
	Then 1
	Else 0
	End as A1C_Met
, Case 
	When MDI_A1C.MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as A1C_NotMet
, Case 
	When MDI_A1C.MDI_Performance = 'UnReported'
	Then 1
	Else 0
	End as A1C_UnReported
, Case
	When MDI_A1C.MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as A1C_Pass
, Case
	When MDI_A1C.MDI_Performance = 'Met'
	Then 1
	Else 0
	End as A1C_Fail
, Case 
	When MDI_A1C.MDI_Eligible = 'Yes' 
	Then 1
	Else 0
	End as A1C_Eligible
, Case 
	When MDI_A1C.MDI_Performance In ('Met','Not Met')
	Then 1
	Else 0
	End as A1C_Complete
, MDI_A1C.MDI_A1C_Reading
, MDI_A1C.MDI_Reading_Date
, MDI_A1C.SQLRunDate_MDI_A1C
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_5_001_MDInteractive_A1C MDI_A1C

End"
