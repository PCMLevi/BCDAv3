Set LOS_Range_60 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_LOS LOS
Where
losNumberDays between 31 and 60

Update LOS
Set LOS_Range_99 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_LOS LOS
Where
losNumberDays between 61 and 99

Update LOS
Set LOS_Range_199 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_LOS LOS
Where
losNumberDays between 100 and 199

Update LOS
Set LOS_Range_299 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_LOS LOS
Where
losNumberDays between 200 and 299

Update LOS
Set LOS_Range_300 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_LOS LOS
Where
losNumberDays >= 300

END
