CREATE PROCEDURE BCBS_Institution_Header_Detail
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	--------------------------------------------
-- Update the Member County and Market
--------------------------------------------
Declare @BCBSFileDate as Date
Set @BCBSFileDate = 
(
select top 1 format(dateadd(Month,1,cast(Line_Paid_Date as date)),'MM/01/yyyy') 
from BCBS_Months.dbo.Institution_Detail_Staging order by Line_DateOfService desc
)
--'10/01/2025'

Update Inst
Set 
  Inst.MemberCounty			= Mbr.MemberCounty
, Inst.MemberCountyMarket	= Mbr.MemberCountyMarket
from BCBS_Months.dbo.Institution_Header_Months Inst
Inner Join
BCBS_Months.dbo.Membership_Months Mbr on
Inst.PatientID = mbr.PatientID
Where
	Inst.BCBSFileDate	= @BCBSFileDate
and Mbr.BCBSFileDate	= @BCBSFileDate

----------------------------------------
-- Update PatientID and SubscriberID
----------------------------------------
Select Distinct 
  PatientID
, SubscriberID
, ClaimId
Into #Temp1
From BCBS_Months.dbo.Institution_Header_Months Mths
Where
Mths.BCBSFileDate = @BCBSFileDate

Update Detail
Set 
  Detail.PatientID		= T1.PatientID
, Detail.SubscriberID	= T1.SubscriberID
from BCBS_Months.dbo.Institution_Detail_Months Detail
Inner Join
#Temp1 T1 on
Detail.ClaimID = T1.ClaimID
Where
Detail.BCBSFileDate = @BCBSFileDate

-------------------------------------------------
-- Update Servicing Specialty in Header Record
-------------------------------------------------
Select Distinct 
  PatientID
, ClaimID
Into #Temp2
from BCBS_Months.dbo.Institution_Header_Months Mths
Where
Mths.BCBSFileDate = @BCBSFileDate

Select Distinct 
  InstD.PatientID
, InstD.ClaimID
, Servicing_Specialty_CD
, Servicing_Specialty
Into #Temp3
from BCBS_Months.dbo.Institution_Detail_Months InstD
Inner Join
#Temp2 T2 on
	InstD.PatientID	= T2.PatientID
and InstD.ClaimID	= T2.ClaimID
Where
InstD.BCBSFileDate = @BCBSFileDate


Update Inst
Set 
  Servicing_Specialty_CD	= T3.Servicing_Specialty_CD
, Servicing_Specialty		= T3.Servicing_Specialty
from BCBS_Months.dbo.Institution_Header_Months Inst
Inner Join
#Temp3 T3 on
	Inst.PatientID	= T3.PatientID
and Inst.ClaimID	= T3.ClaimID
Where
Inst.BCBSFileDate = @BCBSFileDate


END
