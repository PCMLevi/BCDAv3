ALTER PROCEDURE [dbo].[CCLF_CU_BIG_08_CostUtilization_BIG_AllAttributed_LOS]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	---------------------------------------------------------------------------------------------------------------------
