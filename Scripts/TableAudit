From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Where
losNumberDays between 31 and 60
Set @MsgString = 'LOS Range 31 to 60 Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

Update LOS
Set LOS_Range_99 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Where
losNumberDays between 61 and 99
Set @MsgString = 'LOS Range 61 to 99 Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT


Update LOS
Set LOS_Range_199 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Where
losNumberDays between 100 and 199
Set @MsgString = 'LOS Range 100 to 199 Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT


Update LOS
Set LOS_Range_299 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Where
losNumberDays between 200 and 299
Set @MsgString = 'LOS Range 200 to 299 Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT


Update LOS
Set LOS_Range_300 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Where
losNumberDays >= 300
Set @MsgString = 'LOS Range 300+ Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

