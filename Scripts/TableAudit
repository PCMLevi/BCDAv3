2723,2026-06-12T13:16:32.241575,ALTER_PROCEDURE,CCLF_Procedures,dbo,CCLF_CU_PRVS_Year_05_CostUtilization_LOS,"
-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
ALTER PROCEDURE [dbo].[CCLF_CU_PRVS_Year_05_CostUtilization_LOS]

AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	---------------------------------------------------------------------------------------------------------------------
-- Find each Episode for a Beneficiary - Hospital SB, Hospital IP, CAH, SNF, HHA, Hospice
-- expLOSCalculation = 1 in dbo.ExpenseType
---------------------------------------------------------------------------------------------------------------------

Declare @Counter						int = 2			-- For Loop Counter for Records in Table (Start at record 2 becuase we are loading 1st record into previous variables)
Declare @Max							int = 0			-- ??
Declare @LOS							as int			-- Length of stay for a single episode
Declare @PaidTotal						as money		-- Total Amount of Payment for a single episode

Declare @OriginalFrom					as Date			-- Original From date when looping through records
Declare @Current_FinalDataId			as int			-- Id of record
Declare @Current_cuId					as int			-- Expense Id of current Record
Declare @Current_BENE					as char(11)		-- BENE_HIC_NUM of current Record
Declare @Current_From					as date			-- CLM_FROM_DT of current Record
Declare @Current_Thru					as date			-- CLM_THRU_DT of current Record
Declare @Current_Paid					as money		-- CLM_PMT_AMT of current Record
Declare @Current_ExpType				as char(50)		-- expExpenseType of Current Record
Declare @Current_ExpType1				as char(25)		-- expExpenseType1 of Current Record
Declare @Current_ExpType2				as char(25)		-- expExpenseType2 of Current Record

Declare @Previous_FinalDataId			as int			-- Id of record
Declare @Previous_cuId					as int			-- Expense Id of previous Record
Declare @Previous_BENE					as char(11)		-- BENE_HIC_NUM of previous Record
Declare @Previous_From					as date			-- CLM_FROM_DT of previous Record
Declare @Previous_Thru					as date			-- CLM_THRU_DT of previous Record
Declare @Previous_Paid					as money		-- CLM_PMT_AMT of previous Record
Declare @Previous_ExpType				as char(50)		-- expExpenseType of Previous Record
Declare @Previous_ExpType1				as char(25)		-- expExpenseType1 of Previous Record
Declare @Previous_ExpType2				as char(25)		-- expExpenseType2 of previous Record

Declare @InsertRecord	as int

Declare @FiscalYear		as Varchar(6)
Declare @LOS_StartDate	as Date

Set @FiscalYear		= (Select concat('FY',right(FiscalYear, 4) - 1)	 From Database_Constants.dbo.Import_Export_Automated)
Set @LOS_StartDate	= (Select dateadd(year, -1, Dynamic_Lookback_Startdate_BIG)    From Database_Constants.dbo.Import_Export_Automated)--'2020-01-01'--(Select LOS_StartDate From Database_Constants.dbo.Reports Where FiscalYear = @FiscalYear)

Truncate Table CCLF_Reports.dbo.CostUtilization_LOS

--------------------------------------------------------
-- Reset the ID counter to 1 in the temp table
--------------------------------------------------------
--DBCC CHECKIDENT ('CCLF_Reports.dbo.CostUtilization_LOS', RESEED, 0)

--------------------------------------------------
-- Declare a variable of type TABLE.  It will be
-- used as a temporary table.
--------------------------------------------------
Declare @myTable TABLE (
  [Id]					int identity PRIMARY KEY CLUSTERED
, [cuId]				int
, [BENE_HIC_NUM]		char(11)
, [CLM_FROM_DT]			date
, [CLM_THRU_DT]			date
, [CLM_PMT_AMT]			money
, [ExpenseType]			char(50)
, [ExpenseType1]		char(25)
, [ExpenseType2]		char(25)
)

--------------------------------------------------
-- Insert required data into the variable of
-- type TABLE
--------------------------------------------------
Insert into @MyTable

--------------------------------------------------
-- Sort data by Beneficiary, From Date
--------------------------------------------------
Select 
  Min(cuID) as MinCostUtilizationId
, BENE_HIC_NUM
, CLM_FROM_DT
, CLM_THRU_DT
, Sum(CLM_PMT_AMT) as PaidTotal
, expExpenseType
, expExpenseType1
, expExpenseType2

from CCLF_Reports.dbo.CostUtilization CU	-- I don't have to add ACO_Beneficiaries with Quarter because I did that in CU
Where 
    expLOSCalculation	= 1
and CLM_THRU_DT			>= @LOS_StartDate
and CLM_LINE_NUM		= 1		-- Added 3/12/2025 - I do not need detail lines.  Giving duplicates with detail lines

Group by
  expExpenseType
, expExpenseType1
, expExpenseType2
, BENE_HIC_NUM
, CLM_FROM_DT
, CLM_THRU_DT

--HAVING SUM(CLM_PMT_AMT) > 0
---------------------------------------
-- Is this the correct Order by?
---------------------------------------
Order by
  BENE_HIC_NUM
, expExpenseType
, expExpenseType1
, expExpenseType2
, CLM_FROM_DT

Select * From @myTable

Set @LOS = 0
Set @PaidTotal = 0

-----------------------------------------------------------------------------
-- Initialize the @max variable. This variable will be used in the next
-- While loop
-- Note:  Add 1 to @Max to catch last record in table.
-----------------------------------------------------------------------------
Select @Max = Count(ID) + 1 From @myTable

	Set @Previous_cuId =				(Select cuId				From @myTable Where ID = 1)
    Set @Previous_BENE =				(Select BENE_HIC_NUM		From @myTable Where ID = 1)
	Set @Previous_From =				(Select CLM_FROM_DT			From @myTable Where ID = 1)
	Set @Previous_Thru =				(Select CLM_THRU_DT			From @myTable Where ID = 1)
	Set @Previous_Paid =				(Select CLM_PMT_AMT			From @myTable Where ID = 1)
	Set @OriginalFrom =					(Select CLM_FROM_DT			From @myTable Where ID = 1)
	Set @Previous_ExpType =				(Select ExpenseType			from @myTable where ID = 1)
	Set @Previous_ExpType1 =			(Select ExpenseType1		from @myTable where ID = 1)
	Set @Previous_ExpType2 =			(Select ExpenseType2		from @myTable where ID = 1)

While @counter <= @Max
BEGIN
	
	Set @Current_cuId =					(Select cuId				From @myTable Where ID = @Counter)
	Set @Current_BENE =					(Select BENE_HIC_NUM		From @myTable Where ID = @Counter)
	Set @Current_From =					(Select CLM_FROM_DT			From @myTable Where ID = @Counter)
	Set @Current_Thru =					(Select CLM_THRU_DT			From @myTable Where ID = @Counter)
	Set @Current_Paid =					(Select CLM_PMT_AMT			From @myTable Where ID = @Counter)
	Set @Current_ExpType =				(Select ExpenseType			From @myTable Where ID = @Counter)
	Set @Current_ExpType1 =				(Select ExpenseType1		From @myTable Where ID = @Counter)
	Set @Current_ExpType2 =				(Select ExpenseType2		From @myTable Where ID = @Counter)

	-----------------------------------------------------
	-- This will catch the last set of records
	-----------------------------------------------------
	If @Counter = @Max
		BEGIN
			Set @LOS = @LOS + DateDiff(DAY, @Previous_From, @Previous_Thru) + 1
			Set @PaidTotal = @PaidTotal + @Previous_Paid	
			Set @InsertRecord = 1
		END

	If @Current_BENE = @Previous_BENE
		BEGIN
			If (@Current_From = DateAdd(day, 1,@Previous_Thru) or @Current_From = @Previous_Thru) AND @Current_ExpType2 = @Previous_ExpType2
				-------------------------------------------
				-- Episode Continueing
				-------------------------------------------
				BEGIN
					Set @LOS = @LOS + DateDiff(DAY, @Previous_From, @Previous_Thru) + 1
					Set @PaidTotal = @PaidTotal + @Previous_Paid
				END
			Else
				-------------------------------------------
				-- Episode Ending (Same Beneficiary)
				-------------------------------------------
				BEGIN
					Set @LOS = 	@LOS + DateDiff(DAY, @Previous_From, @Previous_Thru) -- changed
					Set @PaidTotal = @PaidTotal + @Previous_Paid -- changed
					Set @InsertRecord = 1
				END
		END
	
	If @Current_BENE <> @Previous_BENE
		-------------------------------------------
		-- Episode Ending from Previous Beneficiary
		-- Start of New Episode with New Beneficiary
		-------------------------------------------
		BEGIN
			Set @LOS = @LOS + DateDiff(DAY, @Previous_From, @Previous_Thru)
			Set @PaidTotal = @PaidTotal + @Previous_Paid
			Set @InsertRecord = 1
		END
	

		if @InsertRecord = 1 
		BEGIN
		Insert Into CCLF_Reports.dbo.CostUtilization_LOS
			( 
			  losCostUtilizationID
			, losExpenseType
			, losExpenseType1
			, losExpenseType2
			, losBENE_HIC_NUM
			, losCLM_FROM_DT
			, losCLM_THRU_DT
			, losNumberDays
			, losPaidTotal
			)
		Values
			(
			  @Previous_cuId
			, @Previous_ExpType
			, @Previous_ExpType1
			, @Previous_ExpType2
			, @Previous_BENE
			, @OriginalFrom
			, @Previous_Thru
			, @LOS
			, @PaidTotal
			)

		Set @LOS = 0
		Set @PaidTotal = 0
		Set @OriginalFrom = @Current_From

		END

	Set @Previous_cuId =				@Current_cuId
	Set @Previous_ExpType =				@Current_ExpType
	Set @Previous_ExpType1 =			@Current_ExpType1
	Set @Previous_ExpType2 =			@Current_ExpType2
	Set @Previous_BENE  =				@Current_BENE
	Set @Previous_From  =				@Current_From
	Set @Previous_Thru  =				@Current_Thru
	Set @Previous_Paid  =				@Current_Paid

	Set @InsertRecord = 0
	
	Set @Counter = @counter + 1
END


-------------------------------------------------------------------
-- Update all of the rest of the information in the 
-- CostUtilization_LOS_Test table
-------------------------------------------------------------------
Update LOS
Set
  LOS.losBENE_MBI_ID				= CU.BENE_MBI_ID
, LOS.losFacility					= CU.FAC_FacilityName
, LOS.losDischarge_CD				= CU.BENE_PTNT_STUS_CD
, LOS.losDischarge					= CU.BENE_PTNT_STUS_Short
, LOS.losCLM_BILL_FAC_TYPE_CD		= CU.CLM_BILL_FAC_TYPE_CD
, LOS.losDoctor_NPI_Name			= CU.Doctor_NPI_Name
, LOS.losPCP						= CU.PCPName
, LOS.losPRNCPL_DGNS_CD				= CU.PRNCPL_DGNS_CD
, LOS.losPRNCPL_DGNS				= CU.PRNCPL_DGNS
, LOS.losTaxonomy					= CCLF_NPI.[Healthcare Provider Taxonomy Code_1]
, LOS.losTax_Class					= CCLF_NPI.Taxonomy1_Classification
, LOS.losTax_Spec					= CCLF_NPI.Taxonomy1_Specialization
, LOS.losCUR_CLM_UNIQ_ID			= CU.CUR_CLM_UNIQ_ID
, LOS.losCLM_LINE_HCPCS_CD			= CU.CLM_LINE_HCPCS_CD
, LOS.losCLM_LINE_HCPCS				= CU.CLM_LINE_HCPCS
, LOS.losHipps150Char				= CU.Hipps150Char
, LOS.losHippsDescription			= CU.HippsDescription
, LOS.losHippsPosition1_Desc		= CU.HippsPosition1_Desc
, LOS.losHippsPosition2_Desc		= CU.HippsPosition2_Desc
, LOS.losHippsPosition3_Desc		= CU.HippsPosition3_Desc
, LOS.losDGNS_DRG_CD				= CU.DGNS_DRG_CD
, LOS.losDGNS_DRG					= CU.DGNS_DRG
, LOS.losDGNS_DRG_MDC_CD			= CU.DGNS_DRG_MDC_CD
, LOS.losDGNS_DRG_MDC				= CU.DGNS_DRG_MDC
, LOS.losCLM_PRVDR_SPCLTY_CD		= CU.CLM_PRVDR_SPCLTY_CD
, LOS.losCLM_PRVDR_SPCLTY			= CU.CLM_PRVDR_SPCLTY
, LOS.losExpenseType_ShortLabel		= CU.expExpenseType_ShortLabel
, LOS.losExpenseType1_ShortLabel	= CU.expExpenseType1_ShortLabel
, LOS.losExpenseType2_ShortLabel	= CU.expExpenseType2_ShortLabel
, LOS.SQLRunDate					= GetDate()
, LOS.losCLM_IDR_LD_DT				= CU.CLM_IDR_LD_DT
, LOS.losFiscalYear					= CU.cuFiscalYear
, LOS.PRVDR_OSCAR_NUM				= CU.PRVDR_OSCAR_NUM
, LOS.PRVDR_OSCAR_NUM_ForLookup		= CU.PRVDR_OSCAR_NUM_ForLookup
, LOS.PRVDR_OSCAR_CTGRY				= CU.PRVDR_OSCAR_CTGRY
, LOS.PRVDR_OSCAR_CTGRY_SBTYP 		= cu.PRVDR_OSCAR_CTGRY_SBTYP
