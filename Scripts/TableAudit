Create Procedure dbo.procCompensation_PYCurrent_10_134_0_DEP_ByMDI
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
	, @MDI_Download_DT		as Date
)
AS
BEGIN

Declare @SelectType		as Varchar(15)
Declare @MeasureNumber	as Varchar(3)
Declare @MeasureName	as Varchar(255)
Declare @MeasureAbbr	as Varchar(5)

Set		@MeasureNumber		= '134'
Set		@SelectType			= @CompensationYear
Set		@MeasureAbbr		= (Select DEP_Abbr From Database_Constants.dbo.Mips Where SelectType = @SelectType and DEP_Number = @MeasureNumber)
Set		@MeasureName		= (Select DEP_Name From Database_Constants.dbo.Mips Where SelectType = @SelectType and DEP_Number = @MeasureNumber)

Delete From Compensation_PYCurrent.dbo.Compensation_10_134_0_DEP_ByMDI

--Select @SelectType as SelectType, @MeasureAbbr as MeasureAbbr

Insert into Compensation_PYCurrent.dbo.Compensation_10_134_0_DEP_ByMDI
( ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_Fullname
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, PY_BENE
, numBENE_BENE
, MeasureNumber
, MeasureName
, MeasureAbbr
, DEP_Performance
, DEP_Met
, DEP_NotMet
, DEP_UnReported
, DEP_Pass
, DEP_Fail
, DEP_Eligible
, DEP_Complete
, DEP_Screening
, SQLRunDate_MDI_DEP
, SQLRunDate
)

Select 
  MDI_GroupTin
, Case
		When MDI_GroupTin = '900088197'
		Then 'Phynet' 
		Else MDI_GroupTinName 
	End
, MDI_NPI
, MDI_NPI_LastName + ', ' + MDI_NPI_FirstName
, MDI_HICN
, MDI_HICN_Previous
, Cast(0 as Float)			As BENE_PY
, 1
, @MeasureNumber
, @MeasureName
, @MeasureAbbr
, MDI_Performance
, Case 
	When MDI_Performance = 'Met'
	Then 1
	Else 0
	End as DEP_Met
, Case 
	When MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as DEP_NotMet
, Case 
	When MDI_Performance = 'UnReported'
	Then 1
	Else 0
	End as DEP_UnReported
, Case
	When MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as DEP_Pass
, Case
	When MDI_Performance = 'Met'
	Then 1
	Else 0
	End as DEP_Fail
, Case 
	When MDI_Eligible = 'Yes' 
	Then 1
	Else 0
	End as DEP_Eligible
, Case 
	When MDI_Performance In ('Met','Not Met')
	Then 1
	Else 0
	End as DEP_Complete
, MDI_DEP_Screening
, SQLRunDate_MDI_DEP
, GetDate()
From 
Compensation_PYCurrent.dbo.Compensation_00_5_134_MDInteractive_DEP MDI_DEP

End"
