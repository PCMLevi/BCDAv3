CCLF_Months.dbo.CCLF5_'+@year+'_WithLookupTables CCLF5 on
	DGNS.BENE_HIC_NUM		= CCLF5.BENE_HIC_NUM
and DGNS.CLM_THRU_DT		= CCLF5.CLM_THRU_DT
and DGNS.CUR_CLM_UNIQ_ID	= CCLF5.CUR_CLM_UNIQ_ID
Left Join
