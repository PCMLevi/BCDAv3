4185,2026-07-07T08:28:37.465190,ALTER_PROCEDURE,CCLF_Procedures,dbo,BCBS_File_Import,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
ALTER PROCEDURE [dbo].[BCBS_File_Import]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;


Set xact_abort on 

DROP TABLE IF EXISTS #temp1,
	#filelist,
	#filelistraw

DECLARE @sql NVARCHAR(max),
	@filename NVARCHAR(500),
	@filenameshort NVARCHAR(100),
	@tablename NVARCHAR(200),
	@Tabledate NVARCHAR(6),
	@FilesizeMB FLOAT,
	@errormsg NVARCHAR(max)

--------------------------------------------------------------
-- Creating Connector table - connects filename to table type
--------------------------------------------------------------
CREATE TABLE #temp1 (
	filename NVARCHAR(500),
	tablename NVARCHAR(200),
	ClaimType NVARCHAR(100)
	)

INSERT INTO #temp1 (
	filename,
	tablename,
	ClaimType
	)
VALUES (
	'ffv.aco_paydetail',
	'BCBS_Months.dbo.Paydetail',
	'PAYDETAIL'
	),
	(
	'ffv.aco_crosswalk',
	'BCBS_Months.dbo.Crosswalk_Months',
	'CROSSWALK'
	),
	(
	'ffv.aco_membership',
	'BCBS_Months.dbo.Membership_Months',
	'MEMBERSHIP'
	),
	(
	'ffv.aco_profclaims',
	'BCBS_Months.dbo.Professional',
	'PROFESSIONAL CLAIMS'
	),
	(
	'ffv.aco_instclaims',
	'BCBS_Months.dbo.Institution_Detail',
	'INSTITUTIONAL CLAIMS'
	),
	(
	'ffv.aco_NCPDP',
	'BCBS_Months.dbo.RXClaims_Months',
	'PHARMACY CLAIMS'
	)

--------------------------------------------------------------
-- Creating Raw filename table - size separated by pipe delim
--------------------------------------------------------------
CREATE TABLE #filelistraw (line NVARCHAR(500))

INSERT INTO #filelistraw
EXEC xp_cmdshell 'powershell -NoProfile -Command ""Get-ChildItem ''C:\BCBS_Import'' -File | Select-Object Name, Length | ForEach-Object { $_.Name + ''|'' + $_.Length }""'

--------------------------------------------------------------
-- Formatting the raw file list into a working table
--------------------------------------------------------------
CREATE TABLE #filelist (
	filename VARCHAR(200),
	FileSizeMB FLOAT
	)

INSERT INTO #filelist (
	filename,
	FileSizeMB
	)
SELECT LEFT(line, CHARINDEX('|', line) - 1) AS FileName,
	cast(RIGHT(line, LEN(line) - CHARINDEX('|', line)) AS FLOAT) / 1048576 AS FileSizeMB
FROM #FileListRaw
WHERE line IS NOT NULL

select * from #filelist

--------------------------------------------------------------
-- Creating cursor and variables to loop through filenames
--------------------------------------------------------------
DECLARE filecursor CURSOR LOCAL STATIC READ_ONLY
FOR
SELECT FL.filename,
	T1.filename,
	tablename,
	CASE 
		WHEN t1.filename = 'ffv.aco_paydetail'
			THEN format(cast(left(right(fl.filename, 22), 8) AS DATE), 'MMyyyy')
		WHEN t1.filename = 'ffv.aco_crosswalk'
			THEN format(cast(left(right(fl.filename, 22), 8) AS DATE), 'MMyyyy')
		WHEN t1.filename = 'ffv.aco_membership'
			THEN format(cast(left(right(fl.filename, 22), 8) AS DATE), 'MMyyyy')
		WHEN t1.filename = 'ffv.aco_profclaims'
			THEN format(cast(left(right(fl.filename, 22), 8) AS DATE), 'MMyyyy')
		WHEN t1.filename = 'ffv.aco_instclaims'
			THEN format(cast(left(right(fl.filename, 22), 8) AS DATE), 'MMyyyy')
		WHEN t1.filename = 'ffv.aco_NCPDP'
			THEN format(cast(left(right(fl.filename, 22), 8) AS DATE), 'MMyyyy')
		END tabledate,
	FileSizeMB
FROM #filelist FL
JOIN #temp1 T1 ON FL.Filename LIKE T1.filename + '%'
	OR FL.Filename LIKE '%' + T1.filename + '%'
WHERE FL.filename IS NOT NULL

OPEN filecursor

FETCH NEXT
FROM filecursor
INTO @filename,
	@filenameshort,
	@Tablename,
	@tabledate,
	@FilesizeMB

WHILE @@fetch_status = 0
BEGIN
	BEGIN TRY
	Begin tran
		SET @sql = '
        drop table if exists ' + @tablename + '_Staging_' + @Tabledate + '
        
        
        truncate table ' + @tablename + '_Staging
        
        select * into ' + @tablename + '_Staging_' + @Tabledate + ' from ' + @tablename + '_Staging
        where 1=2
        
        
        bulk insert ' + @tablename + '_Staging_' + @Tabledate + '
        from ''C:\BCBS_Import\' + @filename + '''
        with 
        (
        fieldterminator = ''|'',
        Rowterminator   = ''0x0A''
        )
        
        bulk insert ' + @tablename + '_Staging
        from ''C:\BCBS_Import\' + @filename + '''
        with 
        (
        fieldterminator = ''|'',
        Rowterminator   = ''0x0A''
        )
        '

		EXEC (@sql)

		PRINT (@SQL)

		SET @sql = '
            INSERT INTO Master.dbo.BCBS_ImportLog
            (Filename, MonthTable, FileSizeMB, Success, Message, DateImported)
            VALUES
            (''' + @filename + ''', 
             ''' + @tablename + '_Staging_' + @Tabledate + ''',
             ' + CAST(@FileSizeMB AS NVARCHAR(50)) + ',
             1,
             ''Imported successfully'',
             ''' + CONVERT(NVARCHAR(30), GETDATE(), 120) + ''')
            '

		EXEC (@sql)

		SET @sql = 'insert into Master.dbo.BCBS_ImportVerify
                             (
                              Filename,
                              Imported_RecordCount,
                              TableDate                                                                                          
                              )
                              select
                              ''' + @filename + ''',
                              (select count(*) from ' + @tablename + '_Staging_' + @Tabledate + ') as Imported_RecordCount,
                              ''' + @Tabledate + ''''

		EXEC (@sql)

		PRINT (@sql)
		commit tran
	END TRY

	BEGIN CATCH
	IF @@TRANCOUNT > 0 ROLLBACK TRAN
		PRINT (@SQL)

		SET @errormsg = Error_Message()
		SET @sql = '
            INSERT INTO Master.dbo.BCBS_ImportLog
            (Filename, MonthTable, FileSizeMB, Success, Message, DateImported)
            VALUES
            (''' + @filename + ''', 
             ''' + @tablename + '_Staging_' + @Tabledate + ''',
             ' + CAST(@FileSizeMB AS NVARCHAR(50)) + ',
             0,
             ''' + @ErrorMsg + ''',
             ''' + CONVERT(NVARCHAR(30), GETDATE(), 120) + ''')
            '

		EXEC (@sql)
	END CATCH

	FETCH NEXT
	FROM filecursor
	INTO @filename,
		@filenameshort,
		@Tablename,
		@tabledate,
		@FilesizeMB
END

--------------------------------------------------------------
-- Closing and deallocating cursor
--------------------------------------------------------------
CLOSE filecursor

DEALLOCATE filecursor

Set xact_abort off

/*
Script: BCBS_Import.sql
Purpose:
        - Automates import of BCBS flat files from C:\BCBS_Import into corresponding staging tables.
        - Creates a month-specific staging snapshot (tablename_Staging_MMyyyy), truncates live staging (tablename_Staging),
                bulk-inserts file data into both tables, and records import logs and verify counts.

High-level flow:
        1. Build a mapping (#temp1) between filename patterns (e.g. 'aco.paydetail') and destination table names.
        2. Use xp_cmdshell (PowerShell) to list files in C:\BCBS_Import with Name and Length => #filelistraw.
        3. Parse file name and size into #filelist.
        4. Cursor over matching files and mapping table to derive @Tabledate (MMyyyy) from filename.
        5. For each file:
                 - Create empty snapshot table: <tablename>_Staging_<MMyyyy> (SELECT INTO ... WHERE 1=2).
                 - TRUNCATE <tablename>_Staging.
                 - BULK INSERT file into both snapshot and staging tables.
                 - Insert success record into Master.dbo.BCBS_ImportLog.
                 - Insert rowcount into Master.dbo.BCBS_ImportVerify.
                 - On error, catch and insert failure message into BCBS_ImportLog.

Inputs / Assumptions:
        - xp_cmdshell enabled and permitted (PowerShell command executed via xp_cmdshell).
        - SQL Server service account (or credential used by xp_cmdshell) has read access to C:\BCBS_Import.
        - Destination databases/schemas and staging tables follow the naming convention: <mappedName>_Staging and <mappedName>_Staging_MMyyyy.
        - Master.dbo.BCBS_ImportLog and Master.dbo.BCBS_ImportVerify exist with expected columns.
        - Filenames contain a date string of 8 characters near the right so that left(right(filename,22),8) yields a valid date string parseable to DATE.
        - Files are pipe-delimited, with LF row terminator (Rowterminator = 0x0A).
        - No header handling is implemented (assumes data rows only).

File format / parsing:
        - Field delimiter: '|'
        - Row terminator: 0x0A (LF)
        - File size computed from file length (bytes) divided by 1048576 => FileSizeMB.

Logging & Verification:
        - Success/failure recorded to Master.dbo.BCBS_ImportLog (Filename, MonthTable, FileSizeMB, Success flag, Message, DateImported).
        - Imported record count recorded to Master.dbo.BCBS_ImportVerify with TableDate and Imported_RecordCount.
        - Basic TRY/CATCH used around per-file processing.

Error handling & known issues:
        - Uses TRY/CATCH to capture errors and insert into import log.
        - Current code references Error_Message() — correct SQL function is ERROR_MESSAGE().
        - Some PRINT statements echo @SQL but may print uninitialized values; consider printing the executed SQL variable after assignment.
        - Initial ""DROP TABLE"" statement at top lacks target table(s) and will raise an error; should be removed or corrected (DROP TABLE IF EXISTS <object>).
        - Filename-to-table matching uses LIKE '%pattern%' which can produce ambiguous matches if not unique.
        - Parsing date from filename via left(right(...,22),8) is brittle and depends on exact filename length/format; validate or use a robust pattern extraction.
        - Dynamic SQL concatenates file names and table names directly — risk of SQL injection or invalid identifiers. Use QUOTENAME for object names and sp_executesql with parameters where possible.
        - BULK INSERT encoding/collation not specified; if files are UTF-8/UTF-16 specify DATAFILETYPE or CODEPAGE as needed.


Cleanup:
        - Cursor is CLOSED and DEALLOCATED at end of processing.
        - Temporary tables used: #temp1, #filelistraw, #filelist — ensure they are dropped/expire at session end.
*/
END
