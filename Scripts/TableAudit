Set 
  ACO_BENE.BENE_HIC_NUM_Previous		= Null
, ACO_BENE.BENE_HIC_NUM_EFCTV_DT		= NULL
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT	= Null
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT	= Null
, ACO_BENE.BENE_HIC_NUM_Prev2			= Null
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT2	= Null
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT2	= Null
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where
ACO_BENE.BENE_YearQuarter = @Q2_Quarter


------------------------------------
