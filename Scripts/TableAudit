5479,2026-08-07T15:30:52.896262,ALTER_PROCEDURE,CCLF_Procedures,dbo,CCLF_13_1_UpdateCLM_DGNS_CD_CCLF5_2025_With2025MedicareFileDate,"ALTER procedure [dbo].[CCLF_13_1_UpdateCLM_DGNS_CD_CCLF5_2025_With2025MedicareFileDate]
as 
begin

Drop Table if exists ##Temp1
Drop Table if exists #Temp2
Drop Table if exists #Temp3

Declare @StartDate			as Date
Declare @StopDate			as Date
Declare @CLM_IDR_LD_DT		as Date
Declare @ClaimYear			as char(6)
Declare @CCLFFile			as char(5)
Declare @MedicarefileDate	as Date
Declare @FromFile			as Varchar(5)
Declare	@RptName		  as Varchar(75)
Declare	@RptStep		  as Varchar(75)
Declare	@RptStepRunTime	  as Varchar(10)
Declare	@rptStartTime	  as DateTime
Declare	@RptStopTime	  as DateTime
declare @int			  as int
declare @sql			  as nvarchar(max)
declare @year			  as varchar(4)

Set @RptName				= '_13_1_UpdateCLM_DGNS_CD_CCLF5_2025_With2025MedicareFileDate'
Set @RptStep				= 'Entire Report'
Set @rptStartTime			= GetDate()


Set @MedicareFileDate		= (Select MedicareFileDate	From Database_Constants.dbo.Import_Export_Automated)


Set @StartDate				= (Select dateadd(year, -1,StartDate)	From Database_Constants.dbo.Import_Export_Automated)
Set @year					= (Select  cclffileyear -1	From Database_Constants.dbo.Import_Export_Automated)
Set @StopDate				= (Select dateadd(year, -1,StopDate)	From Database_Constants.dbo.Import_Export_Automated)
Set @CLM_IDR_LD_DT			= (Select dateadd(year, -1,IDR_LD_DT)	From Database_Constants.dbo.Import_Export_Automated)
Set @ClaimYear				= (Select concat('FY',cast(right(FiscalYear, 4) as int) - 1)	From Database_Constants.dbo.Import_Export_Automated)
Set @CCLFFile				= 'CCLF5'
Set @FromFile				= 'PCM'


CREATE TABLE ##Temp1 (
    BENE_HIC_NUM varchar(13),      -- adjust length to match actual data
    CLM_THRU_DT date,
    CLM_DGNS_CD varchar(8),       -- adjust based on max expected diagnosis code
    CLM_DGNS_Position varchar(11), -- must be long enough for 'CLM_DGNS_12'
    CUR_CLM_UNIQ_ID bigint
);

insert into ##temp1
Select
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_LINE_DGNS_CD	as CLM_DGNS_CD
, 'CLM_DGNS_0'	as CLM_DGNS_Position
, CUR_CLM_UNIQ_ID
from CCLF_Months.dbo.CCLF5_2025_WithLookupTables
Where 
	CLM_THRU_DT				between @StartDate and @StopDate
and CLM_IDR_LD_DT			<= @CLM_IDR_LD_DT
and MedicareFileDate		= @MedicarefileDate

set @int = 1

while @int <= 12
 begin 

set @sql = 
'
Insert into ##Temp1
 Select
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_LINE_DGNS_CD	as CLM_DGNS_CD
, ''CLM_DGNS_'+cast(@int as varchar)+'''	as CLM_DGNS_Position
, CUR_CLM_UNIQ_ID
from CCLF_Months.dbo.CCLF5_'+@year+'_WithLookupTables
Where 
	CLM_THRU_DT				between @StartDate and @StopDate
and CLM_IDR_LD_DT			<= @CLM_IDR_LD_DT
and MedicareFileDate		= @MedicarefileDate
and CLM_DGNS_'+cast(@int as varchar)+'_CD		<> ''~''
and CLM_DGNS_'+cast(@int as varchar)+'_CD		is not null
'


exec sp_executesql 
	@SQL,
	N'@MedicarefileDate date, @CLM_IDR_LD_DT date, @StartDate date, @StopDate date',
	@MedicareFileDate = @MedicarefileDate,
	@CLM_IDR_LD_DT    = @CLM_IDR_LD_DT,
	@StartDate		  = @StartDate,
	@StopDate		  = @StopDate


set @int += 1
end


-------------------------------------------------
-- Find the Minimum Thru Date First
--------------------------------------------------
Select Distinct
  BENE_HIC_NUM
, Min(CLM_THRU_DT)		as CLM_THRU_DT
, CLM_DGNS_CD
Into #Temp2
From ##Temp1
Group by
  BENE_HIC_NUM
, CLM_DGNS_CD
Order by 
  BENE_HIC_NUM
, CLM_DGNS_CD

------------------------------------------------------------
-- Join back to #Temp1 to find the Minimum CUR_CLM_UNIQ_ID
------------------------------------------------------------
Select 
  T2.BENE_HIC_NUM
, T2.CLM_THRU_DT
, T2.CLM_DGNS_CD
, Min(CLM_DGNS_Position)	as CLM_DGNS_Position
, Min(T1.CUR_CLM_UNIQ_ID)	as CUR_CLM_UNIQ_ID
Into #Temp3
From #Temp2 T2
Inner Join 
##Temp1 T1 on
	T2.BENE_HIC_NUM = T1.BENE_HIC_NUM
and T2.CLM_DGNS_CD	= T1.CLM_DGNS_CD
and T2.CLM_THRU_DT	= T1.CLM_THRU_DT
Group by
  T2.BENE_HIC_NUM
, T2.CLM_THRU_DT
, T2.CLM_DGNS_CD
Order by
  T2.BENE_HIC_NUM
, T2.CLM_DGNS_CD
, T2.CLM_THRU_DT

----------------------------------------------------
-- Insert the data into the CLM_DGNS Table
----------------------------------------------------
Insert into CCLF_Subsets.dbo.CLM_DGNS
(
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_DGNS_CD
, CLM_DGNS_Position
, CUR_CLM_UNIQ_ID
, ClaimYear
, CCLFFile
, FromFile
)
Select
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_DGNS_CD
, CLM_DGNS_Position
, CUR_CLM_UNIQ_ID
, @ClaimYear
, @CCLFFile
, @FromFile
From #Temp3

----------------------------------------------------
-- Update the data into the CLM_DGNS Table
----------------------------------------------------
set @sql = 
'
Update DGNS
Set
  MedicareFileDate			= CCLF5.MedicareFileDate
, BENE_MBI_ID				= CCLF5.BENE_MBI_ID
, CLM_TYPE_CD				= CCLF5.CLM_TYPE_CD
, CLM_TYPE					= CCLF5.CLM_TYPE
, CLM_FROM_DT				= CCLF5.CLM_FROM_DT
, CLM_DGNS					= ICD10CM_Desc
, CLM_DGNS_Level1_Short		= ICD10CM.ICD10CM_Level1_ShortDesc
, CLM_DGNS_Level2_Short		= ICD10CM.ICD10CM_Level2
, DGNS_PRCDR_ICD_IND		= CCLF5.DGNS_PRCDR_ICD_IND
, RNDRG_PRVDR_TYPE_CD		= CCLF5.RNDRG_PRVDR_TYPE_CD
, RNDRG_PRVDR_TYPE			= CCLF5.RNDRG_PRVDR_TYPE
, RNDRG_PRVDR_NPI_NUM		= CCLF5.RNDRG_PRVDR_NPI_NUM
, RNDRG_Prvdr_Org_Name_Lgl_Bus_Name = NPPES.[Provider Organization Name (Legal Business Name)]
, RNDRG_Prvdr_LName			= NPPES.[Provider Last Name (Legal Name)] 
, RNDRG_Prvdr_FName			= NPPES.[Provider First Name]
, CLM_PRVDR_SPCLTY_CD		= CCLF5.CLM_PRVDR_SPCLTY_CD
, CLM_PRVDR_SPCLTY			= CCLF5.CLM_PRVDR_SPCLTY
, CLM_FED_TYPE_SRVC_CD		= CCLF5.CLM_FED_TYPE_SRVC_CD
, CLM_FED_TYPE_SRVC			= CCLF5.CLM_FED_TYPE_SRVC
, CLM_POS_CD				= CCLF5.CLM_POS_CD
, CLM_POS					= CCLF5.CLM_POS
, CLM_IDR_LD_DT				= CCLF5.CLM_IDR_LD_DT
, CLM_CNTL_NUM				= CCLF5.CLM_CNTL_NUM
, BENE_EQTBL_BIC_HICN_NUM	= CCLF5.BENE_EQTBL_BIC_HICN_NUM
