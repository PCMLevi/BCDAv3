2619,2026-06-09T16:29:24.352706,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_2_1_Readmit_ByBENE,"
Alter Procedure procCompensation_PYCurrent_06_2_1_Readmit_ByBENE
(	
	  @CompensationYear		as Varchar(6)
	, @CompensationQuarter	as Varchar(6)
	, @CompensationPercent	as Float
	, @StartDate			as Date
	, @StopDate				as Date
	, @IDR_LD_DT			as Date
)
AS
BEGIN

Declare @SelectType			as Varchar(15)
Declare @ReAdmit_Days		as Int

Set @SelectType				= 'Current'
Set @ReAdmit_Days			= (Select ReAdmit_Days From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_06_2_1_ReAdmit_ByBENE

Select Distinct 
  RA.raBENE_HIC_NUM
, RA.BENE_HIC_NUM_Previous
, RA.raCLM_FROM_DT_Previous
, RA.raCLM_THRU_DT_Previous
, RA.raCLM_FROM_DT_Current
, RA.raCLM_THRU_DT_Current
, RA.raExpenseType_Previous
, RA.raExpenseType_Current
, RA.raFacility_Previous
, RA.raFacility_Current
, 1							as ReAdmit_VisitCount
, RA.SQLRunDate				as SQLRunDate_ReAdmit
Into #Temp_ReAdmit
From CCLF_Reports.dbo.CostUtilization_AllAttributed_ReAdmit_Hospital RA
Where
	raExpenseType2_Previous = 'Inpatient Hospital'
and raReAdmit_InDays		<= @ReAdmit_Days
and raCLM_THRU_DT_Previous	Between @StartDate and @StopDate

---------------------------------------------------------------
-- Insert into Compensation ReAdmit Table
-- Join back To CCLF_Reports ReAdmit for rest of Information
---------------------------------------------------------------
Insert into Compensation_PYCurrent.dbo.Compensation_06_2_1_ReAdmit_ByBENE
(
  ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_Fullname
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, BENE_FullName
, raCLM_FROM_DT_Previous
, raCLM_THRU_DT_Previous
, raCLM_FROM_DT_Current
, raCLM_THRU_DT_Current
, raFacility_Previous
, raFacility_Current
, raCUR_CLM_UNIQ_ID_Previous
, raCUR_CLM_UNIQ_ID_Current
, ReAdmit_VisitCount
, raPaid_Previous
, raPaid_Current
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select 
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_Fullname
, ReAdmit.raBENE_HIC_NUM
, ReAdmit.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName
, AllReAdmit.raCLM_FROM_DT_Previous
, AllReAdmit.raCLM_THRU_DT_Previous
, AllReAdmit.raCLM_FROM_DT_Current
, AllReAdmit.raCLM_THRU_DT_Current
, AllReAdmit.raFacility_Previous
, AllReAdmit.raFacility_Current
, Max(raCUR_CLM_UNIQ_ID_Previous)		As raCUR_CLM_UNIQ_ID_Previous
, Max(raCUR_CLM_UNIQ_ID_Current)		As raCUR_CLM_UNIQ_ID_Current
, Sum(ReAdmit_VisitCount)				as ReAdmit_VisitCount
, Sum(AllReAdmit.raPaidTotal_Previous)	as raPaidTotal_Previous
, Sum(AllReAdmit.raPaidTotal_Current)	As raPaidTotal_Current
, ReAdmit.SQLRunDate_ReAdmit
, GetDate()
From #Temp_ReAdmit ReAdmit
Inner Join
CCLF_Reports.dbo.CostUtilization_AllAttributed_ReAdmit_Hospital AllReAdmit on
	ReAdmit.raBENE_HIC_NUM			= AllReAdmit.raBENE_HIC_NUM
and ReAdmit.raCLM_THRU_DT_Previous	= AllReAdmit.raCLM_THRU_DT_Previous
and ReAdmit.raCLM_FROM_DT_Previous	= AllReAdmit.raCLM_FROM_DT_Previous
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE on
ReAdmit.raBENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Group By
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_Fullname
, ReAdmit.raBENE_HIC_NUM
, ReAdmit.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName
, AllReAdmit.raCLM_FROM_DT_Previous
, AllReAdmit.raCLM_THRU_DT_Previous
, AllReAdmit.raCLM_FROM_DT_Current
, AllReAdmit.raCLM_THRU_DT_Current
, AllReAdmit.raFacility_Previous
, AllReAdmit.raFacility_Current
, ReAdmit.SQLRunDate_ReAdmit

