4293,2026-07-09T09:46:06.565780,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_A1C_4_Bonus,"
Create Procedure procCompensation_PYCurrent_10_001_A1C_4_Bonus
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Declare @A1C_Bonus_Allotment	as float

Set @SelectType = 'Current'
Set @A1C_Bonus_Allotment = (Select A1C_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN

Select 
  @QM_Completion_Percent	as ComplPct
, @QM_40th_Percentile		as PerfPct
, @A1C_Bonus_Allotment		As A1C_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @A1C_Performance_Rate_ACO as Float	
Set		
@A1C_Performance_Rate_ACO = 
	(Select A1C_Performance_Rate_ACO
	 From   Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO)

-- Select @A1C_Performance_Rate_ACO as PerfRate_ACO

Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Pass_TIN
, A1C_Complete_TIN
, Completion_Percent
, Performance_Percent
, A1C_Performance_Rate_TIN
, A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, A1C_Quality_Weight
, A1C_Bonus_Allotment
, SQLRunDate_A1C
)

Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Pass_TIN
, A1C_Complete_TIN
, @QM_Completion_Percent
, @QM_40th_Percentile
, A1C_Performance_Rate_TIN
, @A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(  A1C_Performance_Rate_TIN
	 , @QM_40th_Percentile
	) 
, @A1C_Bonus_Allotment
, SQLRunDate_MDI_A1C
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN


Update A1C
Set 
A1C_BENE_Weight =
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1 
		Then A1C_Eligible_TIN * A1C_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN A1C

Declare @A1C_BENE_Weight_Total as Float
Set		@A1C_BENE_Weight_Total = 
		(Select Sum(A1C_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN)

Update A1C
Set 
  A1C_Bonus_Percent	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then (A1C_BENE_Weight / @A1C_BENE_Weight_Total)
		Else 0
	End
, A1C_BENE_Weight_Total	= @A1C_BENE_Weight_Total
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN A1C

Update A1C
Set 
  A1C_Bonus_PerTIN	=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End 
, A1C_Bonus_TIN		=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End
, A1C_Bonus_PerBENE	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0
			(
			 (A1C_Bonus_Percent * A1C_Bonus_Allotment)
		    , A1C_Eligible_TIN
		    )
		
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN A1C

------------------------
-- Update SQLRunDate
------------------------
Update A1C
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN A1C

End
"
4292,2026-07-09T09:43:05.205222,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_A1C_3_Calculations,"
Create Procedure procCompensation_PYCurrent_10_001_A1C_3_Calculations
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Set		@SelectType				= 'Current'

Drop Table if Exists #Temp_Complete_NPI
Drop Table if Exists #Temp_Complete_TIN
Drop Table if Exists #Temp_Complete_ACO

Drop Table if Exists #Temp_Performance_NPI
Drop Table if Exists #Temp_Performance_TIN
Drop Table if Exists #Temp_Performance_ACO

Drop Table if Exists #Temp_Perf_NPI
Drop Table if Exists #Temp_Perf_TIN
Drop Table if Exists #Temp_Perf_ACO

Drop Table if Exists #Temp_Over_NPI

--=======================================
-- Calculate Completion Rate
-- Calculate Performance Rate
-- Calculate % Above ACO Average
-- See if Group has a positive Above Average
--=======================================

--============================================
-- Update Completion Percent  (Lookup Values)
-- Update Performance Percent (Lookup Values)
--============================================
------------------------------------------------------
-- Update Pct Constants - NPI
-- Update Compensation_Quarter & Compensaton_Percent
------------------------------------------------------
Update A1C_NPI
Set 
  
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI A1C_NPI

-------------------------------
-- Update Pct Constants - TIN
-------------------------------
Update A1C_TIN
Set 
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN A1C_TIN

-------------------------------
-- Update Pct Constants - ACO
-------------------------------
Update A1C_ACO
Set 
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO A1C_ACO

--========================
-- Update Completion Rate
--========================

--=====================
-- Completion Rate
--=====================
-------------------
-- Completion_ACO
-------------------
Update A1C_ACO
Set 
  A1C_ACO.A1C_Completion_Rate_ACO = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_ACO as Float)
		 , A1C_Eligible_ACO
	) 

From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO A1C_ACO

-------------------------
-- Completion Rate NPI
-------------------------
-- Select * From #Temp_Complete_NPI

Update A1C_NPI
Set 
  A1C_NPI.A1C_Completion_Rate_NPI	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_NPI as Float)
		 , A1C_Eligible_NPI
	)

From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI A1C_NPI

-------------------------
-- Completion Rate TIN
-------------------------
Update A1C_TIN
Set 
  A1C_TIN.A1C_Completion_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_TIN as Float)
		 , A1C_Eligible_TIN
	)

From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN A1C_TIN

--=====================
-- Fail Rate
--=====================
-------------------
-- Fail Rate NPI
-------------------
Update NPI
Set NPI.A1C_Fail_Rate_NPI = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_NPI as Float)
		 , A1C_Complete_NPI
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI NPI

-------------------
-- Fail Rate TIN
-------------------
Update TIN
Set TIN.A1C_Fail_Rate_TIN = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_TIN as Float)
		 , A1C_Complete_TIN
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN TIN

-------------------
-- Fail Rate ACO
-------------------
Update ACO
Set ACO.A1C_Fail_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_ACO as Float)
		 , A1C_Complete_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO ACO

--===================================================
-- Performance Rate
-- NOTE:  Performance Rate is the same as Pass Rate
--===================================================
-------------------
-- Performance_ACO
-------------------
Update A1C_ACO
Set 
  A1C_ACO.A1C_Performance_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_ACO as Float)
	,	   A1C_Complete_ACO
	)
, A1C_ACO.A1C_Pass_Rate_ACO	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_ACO as Float)
	,	   A1C_Complete_ACO
	)
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO A1C_ACO

Declare @A1C_Performance_Rate_ACO as Float
Set		@A1C_Performance_Rate_ACO = 
			(Select A1C_Performance_Rate_ACO
			 From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO)

--------------------------
-- Performance Rate TIN
--------------------------
Update A1C_TIN
Set 
  A1C_TIN.A1C_Performance_Rate_TIN = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_TIN as Float)
		 , A1C_Complete_TIN
	)

, A1C_TIN.A1C_Pass_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_TIN as Float)
		 , A1C_Complete_TIN
	)

, A1C_TIN.A1C_Performance_Rate_ACO	= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN A1C_TIN

-------------------------
-- Performance Rate NPI
-------------------------
Update A1C_NPI
Set 
  A1C_NPI.A1C_Performance_Rate_NPI		= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)

, A1C_NPI.A1C_Pass_Rate_NPI				= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)
, A1C_NPI.A1C_Performance_Rate_TIN		= A1C_TIN.A1C_Performance_Rate_TIN
, A1C_NPI.A1C_Performance_Rate_ACO		= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI A1C_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN A1C_TIN on
A1C_NPI.ACO_GroupTIN = A1C_TIN.ACO_GroupTIN

--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @QM_40th_Percentile
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Update NPI
Set 
  A1C_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, A1C_Performance_Rate_TIN
		)

, A1C_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		    A1C_Performance_Rate_NPI
		  , @QM_40th_Percentile
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI NPI

--=========================
-- Over Group Flag
-- Performance_Rate_Base
--=========================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
, TIN.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI NPI


End 
"
4291,2026-07-09T09:40:27.627904,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_A1C_2_Aggregate,"
Create Procedure dbo.procCompensation_PYCurrent_10_001_A1C_2_Aggregate
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN


Delete From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_1_Aggregate_BENE
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO

Drop Table If Exists #Temp_Base
Drop Table If Exists #Temp_ACO
Drop Table If Exists #Temp_TIN
Drop Table if Exists #Temp_NPI
Drop Table if Exists #Temp_NPIPercent
Drop Table if Exists #Temp_TINPercent


--=============================
-- Aggregate to BENE Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_1_Aggregate_BENE
(
  Compensation_Quarter
, Compensation_Percent
, NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, A1C_Eligible
, A1C_Complete
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, SQLRunDate_MDI_A1C
, SQLRunDate
)

Select Distinct 
  @YearQuarter
, @CompensationPercent
, NPI
, NPI_FullName
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, 1						as NumBENE_BENE
, A1C_Eligible
, A1C_Complete
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, SQLRunDate_MDI_A1C
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_1_ByBENE A1C

-- Select * From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_Aggregate_BENE

--=============================
-- Aggregate to ACO Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_4_Aggregate_ACO
(
  Compensation_Quarter
, Compensation_Percent
, GroupName
, PY_ACO
, NumBENE_ACO
, A1C_Eligible_ACO
, A1C_Complete_ACO
, A1C_Met_ACO
, A1C_NotMet_ACO
, A1C_UnReported_ACO
, A1C_Pass_ACO
, A1C_Fail_ACO
, SQLRunDate_MDI_A1C
, SQLRunDate
)
Select
  @YearQuarter
, @CompensationPercent
, 'ACO'
, Sum(PY_BENE)
, Sum(numBENE_BENE)
, Sum(A1C_Eligible)
, Sum(A1C_Complete)
, Sum(A1C_Met)
, Sum(A1C_NotMet)
, Sum(A1C_UnReported)
, Sum(A1C_Pass)
, Sum(A1C_Fail)
, Max(SQLRunDate_MDI_A1C)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_1_ByBENE A1C

--=============================
-- Aggregate to TIN Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_3_Aggregate_TIN
(
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Complete_TIN
, A1C_Met_TIN
, A1C_NotMet_TIN
, A1C_UnReported_TIN
, A1C_Pass_TIN
, A1C_Fail_TIN
, SQLRunDate_MDI_A1C
, SQLRunDate
)
Select
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, Sum(PY_BENE)
, Sum(numBENE_BENE)
, Sum(A1C_Eligible)
, Sum(A1C_Complete)
, Sum(A1C_Met)
, Sum(A1C_NotMet)
, Sum(A1C_UnReported)
, Sum(A1C_Pass)
, Sum(A1C_Fail)
, Max(SQLRunDate_MDI_A1C)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_1_Aggregate_BENE A1C_BENE
Group By
  ACO_GroupTIN
, ACO_GroupTINName_New

--=============================
-- Aggregate to NPI Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI
(
  Compensation_Quarter
, Compensation_Percent
, NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_NPI
, NumBENE_NPI
, A1C_Eligible_NPI
, A1C_Complete_NPI
, A1C_Met_NPI
, A1C_NotMet_NPI
, A1C_UnReported_NPI
