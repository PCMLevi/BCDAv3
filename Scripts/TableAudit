5608,2026-08-11T22:26:10.596399,ALTER_PROCEDURE,CCLF_Procedures,dbo,proc2026_Mips_Exclusions_xx_Frailty,"
/*
=============================================
Author:			Michelle Olmstead
Create date:	2026-08-03	
Description:	collect ALL frailty claims and/or encounters for the current reporting period
=============================================
*/


Alter PROCEDURE dbo.proc2026_Mips_Exclusions_xx_Frailty 
(
	  @StartDate			as Date
	, @StopDate				as Date
	, @AttributionQuarter	as char(6)
	, @FiscalYear			as char(6)
)
AS

BEGIN

	-- prevent extra result sets from interfering with SELECT statements.
	SET NOCOUNT ON;

	-------------------------
	-- internal variables
	-------------------------

	declare -- declare, and set constant *values*
		  @SelectType				as Varchar(25) = 'Current'
		, @FiscalYearLocal			as char(6)
		, @StartDateLocal			as Date
		, @StopDateLocal			as Date
		, @AttributionQuarterLocal	as varchar(7)
		, @MinimumAgeFrailty		as int = 66 -- calculate and save in exclusion table
		, @MsgString				as Varchar(100)
		, @StartTime				as Datetime
		, @StopTime					as Datetime
		, @Exclusion_Name			as Varchar(255)
		, @Exclusion_Abbr			as Varchar(10)
		, @Excl_CD_Frail			as Varchar(10);
	
	-- set values selected from constants *tables*
	Set @StartDate				= (Select StartDate			From Database_Constants.dbo.Mips Where FiscalYear = @FiscalYear);
	Set @StopDate				= (Select StopDate			From Database_Constants.dbo.Mips Where FiscalYear = @FiscalYear);
	Set @AttributionQuarter		= (Select YearQuarter		From Database_Constants.dbo.Mips Where FiscalYear = @FiscalYear);
	Set @Exclusion_Name			= (Select Max(Code_Name)	From CCLF_mips.dbo.MipsCodes_Fraility);
	Set @Exclusion_Abbr			= (Select Max(Code_Abbr)	From CCLF_mips.dbo.MipsCodes_Fraility);
	

	-------------------------
	-- temp tables
	-------------------------


	--------------------------------------------------------
	-- Find Beneficiaries with Frailty codes
	--------------------------------------------------------

	-- get rid of old records
	delete 
	from CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	where FiscalYear = @FiscalYear;

	-- insert new records
	insert into CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	(
		  BENE_HIC_NUM
		, BENE_BirthDate
		, CLM_THRU_DT 
		, CLM_DGNS_CD
		, FiscalYear
		, SQLRunDate
	) 
	select distinct  -- Select Distinct to take care of Original/Cancelled Claims
		  DGNS.BENE_HIC_NUM
		, Uniq.BENE_BirthDate
		, DGNS.CLM_THRU_DT
		, DGNS.CLM_DGNS_CD
		, @FiscalYear as FiscalYear
		, getdate()
	From CCLF_Subsets.dbo.CLM_DGNS DGNS 
	Inner Join 
	CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq on -- Changed from ACO_BENE to Uniqe 9/11/2024
	DGNS.BENE_HIC_NUM = Uniq.BENE_HIC_NUM 
	Inner Join 
	CCLF_Mips.dbo.MipsCodes_Fraility Fraility on
	DGNS.CLM_DGNS_CD = Fraility.CodeWithoutPeriod 
	Where 
	DGNS.CLM_FROM_DT Between @StartDate and @StopDate;


	-- set BENE_AgeInYearsOnClaimDate
	--		NOTE implicit assumption that birth year is less than claim year
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		BENE_AgeInYearsOnClaimDate = NULL -- reset
		, Updated = getdate();
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		BENE_AgeInYearsOnClaimDate = datediff(YEAR, BENE_BirthDate, CLM_THRU_DT)
		, Updated = getdate()
	where 
		datepart(MONTH, BENE_BirthDate) < datepart(MONTH, CLM_THRU_DT) 
		or
		(
			datepart(MONTH, BENE_BirthDate) = datepart(MONTH, CLM_THRU_DT) 
			and
			datepart(DAY, BENE_BirthDate) < datepart(DAY, CLM_THRU_DT) 
		);
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		BENE_AgeInYearsOnClaimDate = datediff(YEAR, BENE_BirthDate, CLM_THRU_DT) - 1
		, Updated = getdate()
	where
		datepart(MONTH, BENE_BirthDate) > datepart(MONTH, CLM_THRU_DT) 
		or
		(
			datepart(MONTH, BENE_BirthDate) = datepart(MONTH, CLM_THRU_DT) 
			and
			datepart(DAY, BENE_BirthDate) >= datepart(DAY, CLM_THRU_DT) 
		);


	-- flag minimum age for claims
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMinimumAgeOnClaimDate = 0 -- resEt
		, Updated = getdate();
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMinimumAgeOnClaimDate = 1 
		, Updated = getdate()  
	where BENE_AgeInYearsOnClaimDate >= @MinimumAgeFrailty;


	-- set RecentClaimSequenceNumber
	--		LOWER number is more recent
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty  
	set 
		RecentClaimSequenceNumber = NULL
		, Updated = getdate();
	--
	update frail 
	set 
		RecentClaimSequenceNumber = RCSN
		, Updated = getdate() 
	from CCLF_Mips.dbo.Mips_Exclusions_Frailty frail 
		inner join (
				select 
					BENE_HIC_NUM
					, CLM_THRU_DT
					, RCSN = rank() over(partition by BENE_HIC_NUM order by CLM_THRU_DT desc) 
				from CCLF_Mips.dbo.Mips_Exclusions_Frailty
			) getRCSN 
		on frail.BENE_HIC_NUM = getRCSN.BENE_HIC_NUM 
		and frail.CLM_THRU_DT = getRCSN.CLM_THRU_DT;


	-- handle claim dates with more than one frailty code
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		RecentClaimSequenceNumberBreakTies = NULL -- reset 
		, Updated = getdate();
	--
	update frail 
	set 
		RecentClaimSequenceNumberBreakTies = RCSNBT
		, Updated = getdate() 
	from CCLF_Mips.dbo.Mips_Exclusions_Frailty frail 
		inner join (
				select 
					BENE_HIC_NUM
					, CLM_THRU_DT
					, CLM_DGNS_CD 
					, RCSNBT = rank() over(partition by BENE_HIC_NUM, RecentClaimSequenceNumber order by CLM_DGNS_CD desc) 
				from CCLF_Mips.dbo.Mips_Exclusions_Frailty 
				where RecentClaimSequenceNumber = 1
			) getRCSNBT 
		on frail.BENE_HIC_NUM = getRCSNBT.BENE_HIC_NUM 
		and frail.CLM_THRU_DT = getRCSNBT.CLM_THRU_DT 
		and frail.CLM_DGNS_CD = getRCSNBT.CLM_DGNS_CD;


	-- flag most recent claim
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMostRecentClaim = 0 -- reset
		, Updated = getdate();
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMostRecentClaim = 1
		, Updated = getdate() 
	where RecentClaimSequenceNumberBreakTies = 1;



END
"
5607,2026-08-11T22:13:55.232060,CREATE_PROCEDURE,CCLF_Procedures,dbo,proc2026_Mips_Exclusions_xx_Frailty,"
/*
=============================================
Author:			Michelle Olmstead
Create date:	2026-08-03	
Description:	collect ALL frailty claims and/or encounters for the current reporting period
=============================================
*/


CREATE PROCEDURE dbo.proc2026_Mips_Exclusions_xx_Frailty 
(
	  @StartDate			as Date
	, @StopDate				as Date
	, @AttributionQuarter	as char(6)
	, @FiscalYear			as char(6)
)
AS

BEGIN

	-- prevent extra result sets from interfering with SELECT statements.
	SET NOCOUNT ON;

	-------------------------
	-- internal variables
	-------------------------

	declare -- declare, and set constant *values*
		@SelectType					as Varchar(25) = 'Current'
		, @FiscalYearLocal			as char(6)
		, @StartDateLocal			as Date
		, @StopDateLocal			as Date
		, @AttributionQuarterLocal	as varchar(7)
		, @MinimumAgeFrailty		as int = 66 -- calculate and save in exclusion table
		, @MsgString				as Varchar(100)
		, @StartTime				as Datetime
		, @StopTime					as Datetime
		, @Exclusion_Name			as Varchar(255)
		, @Exclusion_Abbr			as Varchar(10)
		, @Excl_CD_Frail			as Varchar(10);
	
	-- set values selected from constants *tables*
	Set @StartDate				= (Select StartDate			From Database_Constants.dbo.Mips Where FiscalYear = @FiscalYear);
	Set @StopDate				= (Select StopDate			From Database_Constants.dbo.Mips Where FiscalYear = @FiscalYear);
	Set @AttributionQuarter		= (Select YearQuarter		From Database_Constants.dbo.Mips Where FiscalYear = @FiscalYear);
	Set @Exclusion_Name			= (Select Max(Code_Name)	From CCLF_mips.dbo.MipsCodes_Fraility);
	Set @Exclusion_Abbr			= (Select Max(Code_Abbr)	From CCLF_mips.dbo.MipsCodes_Fraility);
	

	-------------------------
	-- temp tables
	-------------------------


	--------------------------------------------------------
	-- Find Beneficiaries with Frailty codes
	--------------------------------------------------------

	-- get rid of old records
	delete 
	from CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	where FiscalYear = @FiscalYear;

	-- insert new records
	insert into CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	(
		BENE_HIC_NUM
		, BENE_BirthDate
		, CLM_THRU_DT 
		, CLM_DGNS_CD
		, FiscalYear
		, SQLRunDate
	) 
	select distinct  -- Select Distinct to take care of Original/Cancelled Claims
		DGNS.BENE_HIC_NUM
		, Uniq.BENE_BirthDate
		, DGNS.CLM_THRU_DT
		, DGNS.CLM_DGNS_CD
		, @FiscalYear as FiscalYear
		, getdate()
	from CCLF_Subsets.dbo.CLM_DGNS DGNS 
		inner join CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq  -- Changed from ACO_BENE to Uniqe 9/11/2024
			on DGNS.BENE_HIC_NUM = Uniq.BENE_HIC_NUM 
		inner join CCLF_Mips.dbo.MipsCodes_Fraility Fraility 
			on DGNS.CLM_DGNS_CD = Fraility.CodeWithoutPeriod 
	where DGNS.CLM_FROM_DT Between @StartDate and @StopDate;


	-- set BENE_AgeInYearsOnClaimDate
	--		NOTE implicit assumption that birth year is less than claim year
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		BENE_AgeInYearsOnClaimDate = NULL -- reset
		, Updated = getdate();
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		BENE_AgeInYearsOnClaimDate = datediff(YEAR, BENE_BirthDate, CLM_THRU_DT)
		, Updated = getdate()
	where 
		datepart(MONTH, BENE_BirthDate) < datepart(MONTH, CLM_THRU_DT) 
		or
		(
			datepart(MONTH, BENE_BirthDate) = datepart(MONTH, CLM_THRU_DT) 
			and
			datepart(DAY, BENE_BirthDate) < datepart(DAY, CLM_THRU_DT) 
		);
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		BENE_AgeInYearsOnClaimDate = datediff(YEAR, BENE_BirthDate, CLM_THRU_DT) - 1
		, Updated = getdate()
	where
		datepart(MONTH, BENE_BirthDate) > datepart(MONTH, CLM_THRU_DT) 
		or
		(
			datepart(MONTH, BENE_BirthDate) = datepart(MONTH, CLM_THRU_DT) 
			and
			datepart(DAY, BENE_BirthDate) >= datepart(DAY, CLM_THRU_DT) 
		);


	-- flag minimum age for claims
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMinimumAgeOnClaimDate = 0 -- resEt
		, Updated = getdate();
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMinimumAgeOnClaimDate = 1 
		, Updated = getdate()  
	where BENE_AgeInYearsOnClaimDate >= @MinimumAgeFrailty;


	-- set RecentClaimSequenceNumber
	--		LOWER number is more recent
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty  
	set 
		RecentClaimSequenceNumber = NULL
		, Updated = getdate();
	--
	update frail 
	set 
		RecentClaimSequenceNumber = RCSN
		, Updated = getdate() 
	from CCLF_Mips.dbo.Mips_Exclusions_Frailty frail 
		inner join (
				select 
					BENE_HIC_NUM
					, CLM_THRU_DT
					, RCSN = rank() over(partition by BENE_HIC_NUM order by CLM_THRU_DT desc) 
				from CCLF_Mips.dbo.Mips_Exclusions_Frailty
			) getRCSN 
		on frail.BENE_HIC_NUM = getRCSN.BENE_HIC_NUM 
		and frail.CLM_THRU_DT = getRCSN.CLM_THRU_DT;


	-- handle claim dates with more than one frailty code
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		RecentClaimSequenceNumberBreakTies = NULL -- reset 
		, Updated = getdate();
	--
	update frail 
	set 
		RecentClaimSequenceNumberBreakTies = RCSNBT
		, Updated = getdate() 
	from CCLF_Mips.dbo.Mips_Exclusions_Frailty frail 
		inner join (
				select 
					BENE_HIC_NUM
					, CLM_THRU_DT
					, CLM_DGNS_CD 
					, RCSNBT = rank() over(partition by BENE_HIC_NUM, RecentClaimSequenceNumber order by CLM_DGNS_CD desc) 
				from CCLF_Mips.dbo.Mips_Exclusions_Frailty 
				where RecentClaimSequenceNumber = 1
			) getRCSNBT 
		on frail.BENE_HIC_NUM = getRCSNBT.BENE_HIC_NUM 
		and frail.CLM_THRU_DT = getRCSNBT.CLM_THRU_DT 
		and frail.CLM_DGNS_CD = getRCSNBT.CLM_DGNS_CD;


	-- flag most recent claim
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMostRecentClaim = 0 -- reset
		, Updated = getdate();
	--
	update CCLF_Mips.dbo.Mips_Exclusions_Frailty 
	set 
		IsMostRecentClaim = 1
		, Updated = getdate() 
	where RecentClaimSequenceNumberBreakTies = 1;



END
"
