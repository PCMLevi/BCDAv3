  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Percent_Base = @A1C_Performance_Rate_Base
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
"
3920,2026-06-29T12:23:54.312663,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_4_A1C_Bonus,"
Alter Procedure procCompensation_PYCurrent_10_001_4_A1C_Bonus
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
	, @CompletionPercent	as Float
	, @PerformancePercent	as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Declare @A1C_Bonus_Allotment	as float
Declare @A1C_Performance_Percent_Base	as Float

Set @SelectType = 'Current'
Set @A1C_Bonus_Allotment = (Select A1C_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN

Select 
  @CompletionPercent	as ComplPct
, @PerformancePercent	as PerfPct
, @A1C_Bonus_Allotment	As A1C_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @A1C_Performance_Rate_ACO as Float	
Set		
@A1C_Performance_Rate_ACO = 
	(Select A1C_Performance_Rate_ACO
	 From   Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO)

-- Select @A1C_Performance_Rate_ACO as PerfRate_ACO

Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Pass_TIN
, A1C_Complete_TIN
, Completion_Percent
, Performance_Percent
, A1C_Performance_Rate_TIN
, A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, A1C_Quality_Weight
, A1C_Bonus_Allotment
, SQLRunDate_A1C
)

Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Pass_TIN
, A1C_Complete_TIN
, @CompletionPercent
, @PerformancePercent
, A1C_Performance_Rate_TIN
, @A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(  A1C_Performance_Rate_TIN
	, A1C_Performance_Percent_Base
--	, @A1C_Performance_Rate_ACO
	) 
, @A1C_Bonus_Allotment
, SQLRunDate_MDI_A1C
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN

------------------------------------------------------
-- Calculate or Create Performance_Rate_Base
-- Use this Calculation in determing A1C_BENE_Weight
-- 10% Below Minimum or Straight 40%
------------------------------------------------------
Update A1C
Set 
A1C_BENE_Weight =
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1 
		Then A1C_Eligible_TIN * A1C_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

Declare @Total_BENE_Weight as Float
Set		@Total_BENE_Weight = 
		(Select Sum(A1C_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN)

Update A1C
Set 
  A1C_Bonus_Percent	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then (A1C_BENE_Weight / @Total_BENE_Weight)
		Else 0
	End
, A1C_Total_Weight	= @Total_BENE_Weight
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

Update A1C
Set 
  A1C_Bonus_PerTIN	=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End 
, A1C_Bonus_TIN		=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End
, A1C_Bonus_PerBENE	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then (A1C_Bonus_Percent * A1C_Bonus_Allotment) / A1C_Eligible_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

------------------------
-- Update SQLRunDate
------------------------
Update A1C
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

End
"
3919,2026-06-29T12:21:18.209861,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_3_A1C_Calculations,"
Alter Procedure procCompensation_PYCurrent_10_001_3_A1C_Calculations
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @CompletionPercent		as Float
	, @PerformancePercent		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Set		@SelectType				= 'Current'

Drop Table if Exists #Temp_Complete_NPI
Drop Table if Exists #Temp_Complete_TIN
Drop Table if Exists #Temp_Complete_ACO

Drop Table if Exists #Temp_Performance_NPI
Drop Table if Exists #Temp_Performance_TIN
Drop Table if Exists #Temp_Performance_ACO

Drop Table if Exists #Temp_Perf_NPI
Drop Table if Exists #Temp_Perf_TIN
Drop Table if Exists #Temp_Perf_ACO

Drop Table if Exists #Temp_Over_NPI

--=======================================
-- Calculate Completion Rate
-- Calculate Performance Rate
-- Calculate % Above ACO Average
-- See if Group has a positive Above Average
--=======================================

--============================================
-- Update Completion Percent  (Lookup Values)
-- Update Performance Percent (Lookup Values)
--============================================
-------------------------------
-- Update Pct Constants - NPI
-------------------------------
Update A1C_NPI
Set 
  A1C_Completion_Percent	= @CompletionPercent
, A1C_Performance_Percent	= @PerformancePercent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

-------------------------------
-- Update Pct Constants - TIN
-------------------------------
Update A1C_TIN
Set 
  A1C_Completion_Percent	= @CompletionPercent
, A1C_Performance_Percent	= @PerformancePercent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

-------------------------------
-- Update Pct Constants - ACO
-------------------------------
Update A1C_ACO
Set 
  A1C_Completion_Percent	= @CompletionPercent
, A1C_Performance_Percent	= @PerformancePercent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

--========================
-- Update Completion Rate
--========================

--=====================
-- Completion Rate
--=====================
-------------------
-- Completion_ACO
-------------------
Select 
  A1C_Complete_ACO
, A1C_Eligible_ACO
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_ACO as Float)
		 , A1C_Eligible_ACO
	)   as A1C_Completion_Rate_ACO
Into #Temp_Complete_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO

Update A1C_ACO
Set 
  A1C_ACO.A1C_Completion_Rate_ACO	= TACO.A1C_Completion_Rate_ACO
, A1C_ACO.A1C_Pass_Rate_ACO			= TACO.A1C_Completion_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO
Left Join
#Temp_Complete_ACO TACO on
1=1

-------------------------
-- Completion Rate NPI
-------------------------
Select 
  NPI
, A1C_Complete_NPI
, A1C_Eligible_NPI
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_NPI as Float)
		 , A1C_Eligible_NPI
	)	as A1C_Completion_Rate_NPI
Into #Temp_Complete_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI

-- Select * From #Temp_Complete_NPI

Update A1C_NPI
Set 
A1C_NPI.A1C_Completion_Rate_NPI	= TNPI.A1C_Completion_Rate_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join
#Temp_Complete_NPI TNPI on
A1C_NPI.NPI = TNPI.NPI


-------------------------
-- Completion Rate TIN
-------------------------
Select 
  ACO_GroupTIN
, A1C_Complete_TIN
, A1C_Eligible_TIN
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_TIN as Float)
		 , A1C_Eligible_TIN
	)	as A1C_Completion_Rate_TIN
Into #Temp_Complete_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN

Update A1C_TIN
Set 
  A1C_TIN.A1C_Completion_Rate_TIN	= TTIN.A1C_Completion_Rate_TIN
, A1C_TIN.A1C_Pass_Rate_TIN			= TTIN.A1C_Completion_Rate_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN
Left Join
#Temp_Complete_TIN TTIN on
A1C_TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN

--=====================
-- Fail Rate
--=====================
-------------------
-- Fail Rate NPI
-------------------
Update NPI
Set NPI.A1C_Fail_Rate_NPI = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_NPI as Float)
	, A1C_Complete_NPI
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

-------------------
-- Fail Rate TIN
-------------------
Update TIN
Set TIN.A1C_Fail_Rate_TIN = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_TIN as Float)
	, A1C_Complete_TIN
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

-------------------
-- Fail Rate ACO
-------------------
Update ACO
Set ACO.A1C_Fail_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_ACO as Float)
		 , A1C_Complete_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO ACO

--===================================================
-- Performance Rate
-- NOTE:  Performance Rate is the same as Pass Rate
--===================================================
-------------------
-- Performance_ACO
-------------------
Select 
  GroupName
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_ACO as Float)
	,	   A1C_Complete_ACO
	)	as A1C_Performance_Rate
Into #Temp_Perf_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

Update A1C_ACO
Set 
  A1C_ACO.A1C_Performance_Rate_ACO	= TPerf_ACO.A1C_Performance_Rate
, A1C_ACO.A1C_Pass_Rate_ACO			= TPerf_ACO.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO
Left Join #Temp_Perf_ACO TPerf_ACO on
1=1

Declare @A1C_Performance_Rate_ACO as Float
Set		@A1C_Performance_Rate_ACO = 
			(Select A1C_Performance_Rate_ACO
			 From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO)

--------------------------
-- Performance Rate TIN
--------------------------
Select 
  ACO_GroupTIN
, A1C_Pass_TIN
, A1C_Pass_Rate_TIN
, A1C_Complete_TIN
, A1C_Completion_Rate_TIN
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_TIN as Float)
		 , A1C_Complete_TIN
	)	as A1C_Performance_Rate_TIN
Into #Temp_Perf_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

-- Select * From #Temp_Perf_TIN

Update A1C_TIN
Set 
  A1C_TIN.A1C_Performance_Rate_TIN	= TPerf_TIN.A1C_Performance_Rate_TIN
, A1C_TIN.A1C_Pass_Rate_TIN			= TPerf_TIN.A1C_Performance_Rate_TIN
, A1C_TIN.A1C_Performance_Rate_ACO	= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN
Left Join #Temp_Perf_TIN TPerf_TIN on
A1C_TIN.ACO_GroupTIN = TPerf_TIN.ACO_GroupTIN


-------------------------
-- Performance Rate NPI
-------------------------
Select 
  NPI
, A1C_Pass_NPI
, A1C_Complete_NPI
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)	as A1C_Performance_Rate_NPI
Into #Temp_Perf_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

Update A1C_NPI
Set 
  A1C_NPI.A1C_Performance_Rate_NPI		= TPerf_NPI.A1C_Performance_Rate_NPI
, A1C_NPI.A1C_Pass_Rate_NPI				= TPerf_NPI.A1C_Performance_Rate_NPI
, A1C_NPI.A1C_Performance_Rate_ACO		= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join #Temp_Perf_NPI TPerf_NPI on
A1C_NPI.NPI = TPerf_NPI.NPI

--==============================
-- NPI Over Group Percent
--==============================

--------------------------------
-- Set Preformance_Rate_Base to Calculate the Percent Over 
-- a Defined Performance_Base to disseminate Bonus
-- I'm setting 3 of them to see what the bonus structure looks like

Declare @Performance_Rate_Min	as Float
Declare @A1C_Performance_Rate_Base	as Float
-- Set		@A1C_Performance_Rate_Base	= @PerformancePercent
-- Set		@A1C_Performance_Rate_Base	= @A1C_Performance_Rate_ACO
Set		@Performance_Rate_Min	= 
	(
	Select 
	Min(A1C_Performance_Rate_TIN)
	From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN
	)

Set @A1C_Performance_Rate_Base = 
	(
	Select Distinct 
		Case
			When (@Performance_Rate_Min - (@Performance_Rate_Min * .10)) > A1C_Performance_Percent
			Then (@Performance_Rate_Min - (@Performance_Rate_Min * .10))
			Else A1C_Performance_Percent
		End 
	From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN
	)

Select @A1C_Performance_Rate_Base

--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @A1C_Performance_Rate_Base
		--, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Select 
  A1C_Performance_Rate_NPI
, A1C_Performance_Rate_TIN
, CCLF_Functions.dbo.Percent_Over
	(
	Cast(A1C_Performance_Rate_NPI as float)
		 , @A1C_Performance_Rate_Base
	 --  , A1C_Performance_Rate_TIN
	) As A1C_Preformance_Rate_NPI_Over_TIN
, CCLF_Functions.dbo.Percent_Over
	(
	Cast(A1C_Performance_Rate_NPI as float)
		 , @A1C_Performance_Rate_Base
	  -- , A1C_Performance_Rate_ACO
	) As A1C_Preformance_Rate_NPI_Over_ACO
Into #Temp_Over_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

Update NPI
Set 
  A1C_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, @A1C_Performance_Rate_Base
	--	, A1C_Performance_Rate_TIN
		)

, A1C_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		  , @A1C_Performance_Rate_Base
	--	, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

--=========================
-- Over Group Flag
-- Performance_Rate_Base
--=========================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
, TIN.A1C_Performance_Percent_Base = @A1C_Performance_Rate_Base
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Percent_Base = @A1C_Performance_Rate_Base
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
