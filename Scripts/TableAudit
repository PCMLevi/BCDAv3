2644,2026-06-10T18:05:17.465324,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_1_Hospital_ByBENE,"
Alter Procedure procCompensation_PYCurrent_06_1_1_Hospital_ByBENE
(	
	  @CompensationYear		as Varchar(6)
	, @CompensationQuarter	as Varchar(6)
	, @CompensationPercent	as Float
	, @StartDate			as Date
	, @StopDate				as Date
	, @IDR_LD_DT			as Date
)
AS
BEGIN

Declare @SelectType			as Varchar(15)
Set		@SelectType			= 'Current'

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_1_Hospital_ByBENE

-------------------------------------------------
-- Select Distinct Hospital Inpatient Records.
-- Do Not select Payment nor Claim ID because 
-- there could be cancelled or adjusted claims.
-------------------------------------------------
Select Distinct 
  Hosp.BENE_HIC_NUM
, Hosp.BENE_HIC_NUM_Previous
, Hosp.CLM_FROM_DT
, Hosp.CLM_THRU_DT
, Hosp.CLM_PMT_AMT
, Hosp.CUR_CLM_UNIQ_ID
, Hosp.FAC_FacilityName
, Hosp.SQLRunDate			as SQLRunDate_Hosp
Into #Temp_Hospital
From CCLF_Reports.dbo.CostUtilization_AllAttributed_HospitalInpatient Hosp
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE on
Hosp.BENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Where
	expExpenseType2		= 'Inpatient Hospital'
and CLM_THRU_DT			between @StartDate and @StopDate
and CLM_LINE_NUM		= 1

----------------------------------------------
-- Insert into Compensation Hospital Table
-- Join Back to Retrieve rest of Information
----------------------------------------------
Insert into Compensation_PYCurrent.dbo.Compensation_06_1_1_Hospital_ByBENE
(
  ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_Fullname
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, BENE_FullName
, CLM_FROM_DT
, CLM_THRU_DT
, CLM_PMT_AMT
, CUR_CLM_UNIQ_ID
, FAC_FacilityName
, SQLRunDate_Hosp
, SQLRunDate
)
Select
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, Hosp.BENE_HIC_NUM
, Hosp.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName
, Hosp.CLM_FROM_DT
, Hosp.CLM_THRU_DT
, Sum(AllHosp.CLM_PMT_AMT)	as CLM_PMT_AMT
, Max(hosp.CUR_CLM_UNIQ_ID)	as CUR_CLM_UNIQ_ID
, Hosp.FAC_FacilityName
, SQLRunDate_Hosp
, GetDate()
From #Temp_Hospital Hosp
Inner Join 
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE on
Hosp.BENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Inner Join
CCLF_Reports.dbo.CostUtilization_AllAttributed_HospitalInpatient AllHosp on
	Hosp.BENE_HIC_NUM		= AllHosp.BENE_HIC_NUM
and Hosp.CLM_FROM_DT		= AllHosp.CLM_FROM_DT
and Hosp.CLM_THRU_DT		= AllHosp.CLM_THRU_DT
and Hosp.FAC_FacilityName	= AllHosp.FAC_FacilityName
Group By
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, Hosp.BENE_HIC_NUM
, Hosp.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName
, Hosp.CLM_FROM_DT
, Hosp.CLM_THRU_DT
, Hosp.FAC_FacilityName
, Hosp.SQLRunDate_Hosp
End"
