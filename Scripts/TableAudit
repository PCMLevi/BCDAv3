Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T12.NPIWithMostVisits
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 06.  Final Data - 2 NPI NOT Fam'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp12 T12 on
ACO_BENE.BENE_HIC_NUM = T12.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is null		-- vst 11/13/2023 Added

Set @StopTime = GetDate()
Set @MsgString = 'Final Data - 2 NPI Not Family Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

------------------------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------------------------

----------------------------------------------------
-- The final records are Beneficiaries that do not
-- have any data for the year searched on.
-- Assign them to the first NPI in the Q1-4 Table
-- Code Change 2/25/2019
-- Make sure the NPI is in our ACO list
-- Code Change 3/8/2022
-- Find NPI that has the MOST visits
----------------------------------------------------
Set @StartTime = GetDate()

Select 
  BENE_HIC_NUM
--, Q4_IndividualNPI
, Max(Q4_PCS_Count) as MaxVisits   ---Was MinNPI
Into CCLF_Testing.dbo.tblTemp13
from CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on 
Q4.Q4_HICN = ACO_BENE.BENE_HIC_NUM
--from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE		-- I reversed the Join because I was taking the MinNPI from the ACO_Beneficiaries
--Inner Join												-- file instead of the Q4 File.  I also added Q4=AttributionYear because it was
--CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on				-- Not limiting the data to just Attribution Quarter we were working on.
--ACO_BENE.BENE_HIC_NUM = Q4.Q4_HICN
-- I added the inner join to ACO 2/25/2019
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where 
    ACO_BENE.BENE_ATTR_From		is null
and ACO_BENE.BENE_YearQuarter	= @YearQuarter
and Q4.Q4_YearQuarter			= @YearQuarter		-- Added 8/30/2020
Group by
  BENE_HIC_NUM

Select
  BENE_HIC_NUM
, Q4_IndividualNPI
into CCLF_Testing.dbo.tblTemp13_A
from CCLF_Testing.dbo.tblTemp13 T13
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T13.BENE_HIC_NUM	= Q4.Q4_HICN
and T13.MaxVisits		= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter = @YearQuarter

---------------------------------------------------------------
-- Update the ACO_Beneficiary table with NoData-MinNPI
---------------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T13_A.Q4_IndividualNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 07.  No Data - Max PCS Count'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp13_A T13_A on
ACO_BENE.BENE_HIC_NUM = T13_A.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter = @YearQuarter
and ACO_BENE.BENE_ATTR_From is null

Set @StopTime = GetDate()
Set @MsgString = 'Step 07.  No Data - Max PCS Count Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

---------------------------------------------------------
-- Update the ACO_Beneficiaries table using 
-- QASSGN Data
---------------------------------------------------------
Update ACO_BENE
Set 
  BENE_MBI						= Q1.Q1_MBI
, BENE_HICN_Link				= Trim(Q1_LastName) + '|' + 
								  Trim(Q1_FirstName) + '|' + 
								  Cast(Q1.Q1_BirthDate as Varchar)	-- vst 10/24/2025 Added col to find BENE_HICN for MDInteractive Data
, BENE_FirstName				= Q1.Q1_FirstName
, BENE_LastName					= Q1.Q1_LastName
, BENE_Sex						= Q1.Q1_Sex
, BENE_BirthDate				= Q1.Q1_BirthDate
, BENE_DeathDate				= Q1.Q1_DeathDate
, BENE_CMSRiskScore				= Q1.CMSRiskScore
, BENE_CMSRiskScoreType			= Q1.CMSRiskScoreType 
, BENE_DemoRiskScore			= Q1.DemoRiskScore
, BENE_DemoRiskScoreType		= Q1.DemoRiskScoreType
, BENE_PersonYears				= Q1.Q1_PersonYears
, AlignmentFlag_CBA				= Q1.AlignmentFlag_CBA		-- Added 5/22/2024
, IN_VA_MAX						= Q1.IN_VA_MAX				-- Added 5/22/2024
, Flag_NPI_PCS					= Case When BENE_NPI_Number is null Then 0 Else 1 End 
, SQLRunDate					= GetDate()
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Left Join
CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1 on
    ACO_BENE.BENE_HIC_NUM		= Q1_HICN
and ACO_BENE.BENE_YearQuarter	= Q1.Q1_YearQuarter
and Q1.Q1_YearQuarter			= @YearQuarter
Where 
BENE_YearQuarter = @YearQuarter

-------------------------------------------------------------
-- Update the ADI for each Beneficiary
-------------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_ADI = Q9.Q9_ADI_NATRANK
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_9 Q9 on
ACO_BENE.BENE_HIC_NUM = Q9.Q9_HICN
Where
	BENE_YearQuarter  = @YearQuarter
and Q9.Q9_YearQuarter = @YearQuarter

----------------------------------------------
-- Update Beneficiary Info from ACO Data
-- for BENE_NPI_Number
----------------------------------------------
Update ACO_BENE
Set
  ACO_BENE.BENE_NPI_LastName			= ACO.ACO_NPI_LastName
, ACO_BENE.BENE_NPI_FirstName			= ACO.ACO_NPI_FirstName
, ACO_BENE.BENE_ACO_GroupTIN			= ACO.ACO_GroupTin
, ACO_BENE.BENE_ACO_GroupTINName		= ACO.ACO_GroupTinName
, ACO_BENE.BENE_ACO_GroupTINShortName	= ACO.ACO_GroupTinShortName
, ACO_Bene.Flag_VA_Active = 
	Case 
		When ACO.ACO_Active = 'Yes' 
		Then 1 
		Else 0 
	End 
, BENE_NPI_Classification                = ACO.ACO_PrimaryTaxonomy         ---Levi 12/1/2025
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Left Join 
CCLF_LookupTables.dbo.ACO aco on
ACO_BENE.BENE_NPI_Number	= ACO.ACO_NPIIndividual
Where 
ACO_BENE.BENE_YearQuarter	= @YearQuarter

----------------------------------------------
-- NPI is the PCS NPI or the VA NPI
--  
-- Change columns around as necessary
----------------------------------------------

--------------------------------------------------------------
-- If  Beneficiary is Voluntarily Aligned 
-- and Beneficiary is NOT in PCS Table then
-- BENE_NPI_Number = NPI_2 (Voluntary Aligned Physician
--
--------------------------------------------------------------
Update ACO_BENE
Set
  ACO_BENE.BENE_ACO_GroupTinShortName	= ACO_BENE.BENE_NPI_2_Group
, ACO_BENE.BENE_ACO_GroupTINName		= ACO_BENE.BENE_NPI_2_TINName
, ACO_BENE.BENE_ACO_GroupTIN			= ACO_BENE.BENE_NPI_2_TIN
, ACO_BENE.BENE_NPI_Number				= ACO_BENE.BENE_NPI_2_Number
, ACO_BENE.BENE_NPI_LastName			= ACO_BENE.BENE_NPI_2_LastName
, ACO_BENE.BENE_NPI_FirstName			= ACO_BENE.BENE_NPI_2_FirstName
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
And ACO_BENE.Flag_NPI_VA		= 1
and ACO_BENE.Flag_NPI_PCS		= 0
and ACO_BENE.BENE_NPI_Number	Is Null

--------------------------------------------------------------
-- AFTER BENE_NPI Info = BENE_NPI_2 Info
-- Change BENE_NPI_2 Information to Null
--------------------------------------------------------------
Update ACO_BENE
Set
  ACO_BENE.BENE_NPI_2_Group			= Null
, ACO_BENE.BENE_NPI_2_TINName		= Null
, ACO_BENE.BENE_NPI_2_TIN			= Null
, ACO_BENE.BENE_NPI_2_Number		= Null
, ACO_BENE.BENE_NPI_2_LastName		= Null
, ACO_BENE.BENE_NPI_2_FirstName		= Null
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
And ACO_BENE.Flag_NPI_VA		= 1
and ACO_BENE.Flag_NPI_PCS		= 0

----------------------------------------------------------------------
-- BENE_NPI_2 is the Voluntary Aligned Physician
-- BENE_NPI_Number is the Primary Physician.
--
-- If BENE_NPI_2 <> BENE_NPI_Number, then 
-- Reverse the NPI's
-- 
-- BENE_NPI_2		= BENE_NPI_Number
-- BENE_NPI_Number	= BENE_NPI_2
-- 
-- Create a Temporary Table so we don't loose original Assignments
--------------------------------------------------------------------
Select 
  BENE_HIC_NUM
, BENE_NPI_Number
, BENE_NPI_LastName
, BENE_NPI_FirstName
, BENE_ACO_GroupTinShortName
, BENE_ACO_GroupTINName
, BENE_ACO_GroupTIN
, BENE_NPI_2_Number
, BENE_NPI_2_LastName
, BENE_NPI_2_FirstName
, BENE_NPI_2_Group
, BENE_NPI_2_TINName
, BENE_NPI_2_TIN
Into #Temp_NPI_Switch
from CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
	BENE_YearQuarter	 = @YearQuarter
and BENE_NPI_Number		<> BENE_NPI_2_Number

------------------------------
-- Switch NPI	with NPI_2
-- Switch NPI_2 with NPI
------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number				= TSwitch.BENE_NPI_2_Number
, ACO_BENE.BENE_NPI_LastName			= TSwitch.BENE_NPI_2_LastName
, ACO_BENE.BENE_NPI_FirstName			= TSwitch.BENE_NPI_2_FirstName
, ACO_BENE.BENE_ACO_GroupTinShortName	= TSwitch.BENE_NPI_2_Group
, ACO_BENE.BENE_ACO_GroupTINName		= TSwitch.BENE_NPI_2_TINName
, ACO_BENE.BENE_ACO_GroupTIN			= TSwitch.BENE_NPI_2_TIN
, ACO_BENE.BENE_NPI_2_Number			= TSwitch.BENE_NPI_Number
, ACO_BENE.BENE_NPI_2_LastName			= TSwitch.BENE_NPI_LastName
, ACO_BENE.BENE_NPI_2_FirstName			= TSwitch.BENE_NPI_FirstName
, ACO_BENE.BENE_NPI_2_Group				= TSwitch.BENE_ACO_GroupTinShortName
, ACO_BENE.BENE_NPI_2_TINName			= TSwitch.BENE_ACO_GroupTINName
, ACO_BENE.BENE_NPI_2_TIN				= TSwitch.BENE_ACO_GroupTIN
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE 
Inner Join
#Temp_NPI_Switch TSwitch on
ACO_BENE.BENE_HIC_NUM = TSwitch.BENE_HIC_NUM
Where
	BENE_YearQuarter				 = @YearQuarter
and ACO_BENE.BENE_NPI_Number		<> ACO_BENE.BENE_NPI_2_Number

-------------------------------------------------------------
-- Update the ACO_Beneficiary Year
-------------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_AttributionYear = 'FY' + Left(@YearQuarter, 4)
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE

-------------------------------------------------------------
-- Update the ACO_Quarter Start/Stop Date 
-------------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_QuarterStart	= @QuarterStart
, ACO_BENE.BENE_QuarterStop		= @QuarterStop
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where
BENE_YearQuarter = @YearQuarter

-------------------------------------------------------------
-- Update Attribution_Type
-- vst 11/17/2025 - New Code
-------------------------------------------------------------
Update ACO_Bene
Set BENE_Attr_Type = 
	Case
		When Flag_NPI_PCS = 0 and Flag_NPI_VA = 1 and Flag_VA_Active = 0		Then 'Step 08.  No PCS, Vol. Align, NPI Not Active'
		When Flag_NPI_PCS = 0 and Flag_NPI_VA = 1 and Flag_VA_Active = 1		Then 'Step 09.  No PCS, Vol. Align, NPI Active'
		When Flag_NPI_PCS = 1 and Flag_NPI_VA = 1 and Flag_VA_Active = 1		Then 'Step 10.  Has PCS, Vol. Align, NPI Active'
		When Flag_NPI_PCS = 1 and Flag_NPI_VA = 1 and Flag_VA_Active = 0		Then 'Step 11.  Has PCS, Vol. Align, NPI Not Active'
		When Flag_NPI_PCS = 1 and Flag_NPI_VA = 0 and Flag_VA_Active In (1,0)	Then 'Step 12.  Has PCS, Not Vol. Align'
	Else 'Invalid'
	End 
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where 
BENE_YearQuarter = @YearQuarter

-------------------------------------------------------------------
-- Update Attribution_From
-- vst 11/17/2025 - New Code
--
-- Attribution_From is updated when there are records in the PCS 
-- table.  With Voluntary Alignment, there are cases where the 
-- Beneficiary has voluntary alignment and records in the PCS Table
--
-- When there are not any records in the PCS Table, It is strictly 
-- Voluntary Alignment.  
-------------------------------------------------------------------

Update ACO_BENE
Set BENE_ATTR_From = BENE_Attr_Type
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Where
	BENE_YearQuarter	= @YearQuarter
And Flag_NPI_PCS		= 0							-- No Records in PCS Table (QASSGN_1_4)

------------------------------------------------------------------------------
-- This is for output purposes only to view what kind of panel we have 
-- Show the distribution of Voluntary Aligned Beneficiaries.
-- NOTE:  There are now 5 Beneficiaries as of 2025Q3 that 
-- do not have PCS Records, and the Physicians they are aligned 
-- to have left the ACO.
-- Flag_PCS = 0, Flag_VA = 1, Flag_VA_Active = 0
------------------------------------------------------------------------------
Select 
  BENE_HIC_NUM
, Flag_NPI_PCS
, Flag_NPI_VA
, Flag_VA_Active
, BENE_Attr_Type
From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_YearQuarter = @YearQuarter

Select 
  Count(BENE_HIC_NUM) as NumBene
, Sum(AlignmentFlag_CBA) as NumCBA
, Sum(Flag_NPI_PCS) as NumPCS
, Sum(Flag_NPI_VA) as NumNPI_VA
, Sum(Flag_VA_Active) as Num_VA_Active
, BENE_Attr_Type
From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_YearQuarter = @YearQuarter
Group By
BENE_Attr_Type

----------------------------------------------
-- Update MasterId
-- MasterID and MasterID_From is Updated in 
-- 30_2_2_ACO_Beneficiaries_UpdateML_Info
----------------------------------------------

END
