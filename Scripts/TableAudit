3674,2026-06-22T09:55:14.134177,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_3_ReAdmit_Calculations,"
Alter Procedure procCompensation_PYCurrent_06_1_3_ReAdmit_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate 
--   ReAdmit_Rate
-- , Rate_Group_Under_Total
-- , Rate_Group_Flag_Under_Total
--	 For Each Group
--=======================================

--========================
-- Update ACO Aggregate
--========================
Select 
 'ACO'							as GroupName
, ReAdmit_ACO
, Hospital_ACO
, ReAdmit_ACO / 
  Cast(Hospital_ACO as Float)	as ReAdmit_Rate_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO

-- Select * From #Temp_ACO

-------------------
-- ReAdmit Rate
-------------------
Update ACO
Set 
  ReAdmit_Rate_ACO = TACO.ReAdmit_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO ACO
Inner Join
#Temp_ACO TACO on
1=1

-------------------------
-- ED Visit Declare's
-------------------------
Declare @ReAdmit_Rate_ACO			as Float

Set		@ReAdmit_Rate_ACO = 
		(Select ReAdmit_Rate_ACO 
		 From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO)

Select @ReAdmit_Rate_ACO as E1000_ACO

--========================
-- Update TIN Aggregate
--========================

----------------
-- TIN ReAdmit
----------------
Select 
  ACO_GroupTIN
, CCLF_Functions.dbo.Divide_Return0(
  ReAdmit_TIN
, Hospital_TIN)	As ReAdmit_Rate_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
Group By
  ACO_GroupTIN
, ReAdmit_TIN
, Hospital_TIN

-- Select * From #Temp_TIN

Update TIN
Set 
  TIN.ReAdmit_Rate_TIN		= TempTIN.ReAdmit_Rate_TIN
, TIN.ReAdmit_Rate_ACO		= @ReAdmit_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN
Inner Join
#Temp_TIN TempTIN on
TIN.ACO_GroupTIN = TempTIN.ACO_GroupTIN


-----------------------------------------------
-- TIN ReAdmit % Under
-- Less ReAdmits than Avg ACO Visits = Better
-----------------------------------------------
-- Select * From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
Update TIN
Set 
ReAdmit_Rate_TIN_Under_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (TIN.ReAdmit_Rate_TIN
	- TIN.ReAdmit_Rate_ACO)
	, TIN.ReAdmit_Rate_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

Update TIN
Set 
ReAdmit_Flag_TIN_Under_ACO = 
	Case
		When ReAdmit_Rate_TIN_Under_ACO < 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

--========================
-- Update NPI Aggregate
--========================

----------------
-- NPI ReAdmit
----------------
Update NPI
Set 
  NPI.ReAdmit_Rate_NPI	= 
  CCLF_Functions.dbo.Divide_Return0(NPI.ReAdmit_NPI, NPI.Hospital_NPI)
, NPI.ReAdmit_Rate_TIN		= 
  CCLF_Functions.dbo.Divide_Return0(NPI.ReAdmit_TIN, NPI.Hospital_TIN)
, NPI.ReAdmit_Rate_ACO		= 
  CCLF_Functions.dbo.Divide_Return0(NPI.ReAdmit_ACO, NPI.Hospital_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI


-----------------------------------------------
-- NPI ReAdmit % Under
-- Less ReAdmits than Avg ACO Visits = Better
-----------------------------------------------
Update NPI
Set 
  ReAdmit_Rate_NPI_Under_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (NPI.ReAdmit_Rate_NPI
	- NPI.ReAdmit_Rate_TIN)
	, NPI.ReAdmit_Rate_TIN)
, ReAdmit_Rate_NPI_Under_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (NPI.ReAdmit_Rate_NPI
	- NPI.ReAdmit_Rate_ACO)
	, NPI.ReAdmit_Rate_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI

Update NPI
Set 
  ReAdmit_Flag_NPI_Under_TIN = 
	Case
		When ReAdmit_Rate_NPI_Under_TIN < 0
		Then 1
		Else 0
	End

, ReAdmit_Flag_NPI_Under_ACO = 
	Case
		When ReAdmit_Rate_NPI_Under_ACO < 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN

End 
"
3673,2026-06-22T09:50:05.364048,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_4_ReAdmit_Bonus_TIN,"
Alter Procedure procCompensation_PYCurrent_06_1_4_ReAdmit_Bonus_TIN
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Declare @ReAdmit_Bonus_Allotment as float

Set @SelectType = 'Current'
Set @ReAdmit_Bonus_Allotment = (Select RTA_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN

Select @ReAdmit_Bonus_Allotment As ReAdmit_Bonus_Allotment

Drop Table if Exists #Temp_PercentPositive

Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, Hospital_TIN
, ReAdmit_TIN
, ReAdmit_Rate_TIN
, ReAdmit_Rate_ACO
, ReAdmit_Rate_TIN_Under_ACO
, ReAdmit_Flag_TIN_Under_ACO
, ReAdmit_Quality_Weight
, ReAdmit_Bonus_Allotment
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
)
Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, Hospital_TIN
, ReAdmit_TIN
, ReAdmit_Rate_TIN
, ReAdmit_Rate_ACO
, ReAdmit_Rate_TIN_Under_ACO
, ReAdmit_Flag_TIN_Under_ACO
, CCLF_Functions.dbo.Divide_Return0(
  ReAdmit_Rate_Tin_Under_ACO 
, ReAdmit_Rate_ACO) * -1 -- Multiply by -1 so Bonus information is positive
, @ReAdmit_Bonus_Allotment
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN

Update EDBonus
Set 
ReAdmit_BENE_Weight =
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1 
		Then NumBENE_TIN * ReAdmit_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN EDBonus

Declare @Total_BENE_Weight as Float
Set		@Total_BENE_Weight = 
		(Select Sum(ReAdmit_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN)

Update EDBonus
Set 
  ReAdmit_Bonus_Percent	= 
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then (ReAdmit_BENE_Weight / @Total_BENE_Weight)
		Else 0
	End
, ReAdmit_Total_Weight	= @Total_BENE_Weight
From Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN EDBonus

Update EDBonus
Set 
  ReAdmit_Bonus_PerTIN =  
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment
		Else 0
	End 
, ReAdmit_Bonus_TIN	=  
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment
		Else 0
	End
, ReAdmit_Bonus_PerBENE	= 
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then (ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment) / NumBENE_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN EDBonus

------------------------
-- Update SQLRunDate
------------------------
Update EDBonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_06_1_4_ReAdmit_Bonus_TIN EDBonus

End
"
