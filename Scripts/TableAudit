2934,2026-06-15T14:20:54.152727,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_05_1_3_EDObs_Calculations,"
Alter Procedure procCompensation_PYCurrent_05_1_3_EDObs_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate E1000 For Each Group
--=======================================

--===========
-- ACO
--===========
Select 
  Sum(EDVisit_ACO)	as EDVisit_ACO
, Sum(PY_ACO)		As PY_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO

Update ACO
Set EDVisit_E1000_ACO = CCLF_Functions.dbo.Divide_Return0(TACO.EDVisit_ACO, TACO.PY_ACO) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO
Inner Join
#Temp_ACO TACO on
1=1

--===========
-- NPI
--===========
Select 
  NPI
, Sum(EDVisit_NPI)	as EDVisit_NPI
, Sum(PY_NPI)		As PY_NPI
Into #Temp_NPI
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI
Group By
NPI

Update NPI
Set EDVisit_E1000_NPI = 
	CCLF_Functions.dbo.Divide_Return0(TNPI.EDVisit_NPI, TNPI.PY_NPI) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI
Inner Join
#Temp_NPI TNPI on
TNPI.NPI = NPI.NPI

--===========
-- TIN
--===========
Select 
  ACO_GroupTIN
, Sum(EDVisit_TIN)	as EDVisit_TIN
, Sum(PY_TIN)		As PY_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN
Group By
ACO_GroupTIN

Update TIN
Set 
EDVisit_E1000_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	  TTIN.EDVisit_TIN
	, TTIN.PY_TIN) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN
Left Join
#Temp_TIN TTIN on
TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN

Update TIN
Set
EDVisit_E1000_TIN_Under_ACO = 
	CCLF_Functions.dbo.Divide_Return0(
	 (TIN.EDVisit_E1000_TIN
	- TIN.EDVisit_E1000_Average_TIN)
	, TIN.EDVisit_E1000_Average_TIN)
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN

Update TIN
Set 
EDVisit_Flag_TIN_Under_ACO = 
	Case
		When TIN.EDVisit_E1000_TIN_Under_ACO < 0
		Then 1
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN


--=======================================
-- Calculate E1000 Average For Each Group
--=======================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Average
--=========================
Declare @Average_ACO as Float
Declare @Average_TIN as Float
Declare @Average_NPI as Float

Set @Average_ACO = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(EDVisit_ACO), Sum(PY_ACO)) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO)

Update ACO
Set EDVisit_E1000_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO

--=========================
-- TIN Average
--=========================
Select 
  ACO_GroupTIN
, EDVisit_E1000_Average_ACO
, EDVisit_E1000_Average_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN

Update TIN
Set TIN.EDVisit_E1000_Average_TIN = @Average_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN

--=========================
-- NPI Average
--=========================
Set @Average_NPI = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(EDVisit_NPI), Sum(PY_NPI)) * 1000 
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI)

Update NPI
Set NPI.EDVisit_E1000_Average_NPI = @Average_NPI
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI

End
