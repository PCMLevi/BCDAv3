3571,2026-06-18T08:49:56.726635,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_05_1_4_EDObs_Bonus_TIN,"
Alter Procedure procCompensation_PYCurrent_05_1_4_EDObs_Bonus_TIN
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Declare @EDObs_Bonus_Allotment as float

Set @SelectType = 'Current'
Set @EDObs_Bonus_Allotment = (Select EDObs_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN

Select @EDObs_Bonus_Allotment As EDObs_Bonus_Allotment

Drop Table if Exists #Temp_PercentPositive

Insert Into Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, EDVisit_TIN
, EDVisit_ACO
, EDVisit_E1000_TIN
, EDVisit_E1000_ACO
, EDVisit_E1000_Average_TIN
, EDVisit_E1000_Average_ACO
, EDVisit_E1000_TIN_Under_ACO
, EDVisit_Flag_TIN_Under_ACO
, EDObs_Quality_Weight
, EDObs_Bonus_Allotment
, SQLRunDate_EDobs
)
Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, EDVisit_TIN
, EDVisit_ACO
, EDVisit_E1000_TIN
, EDVisit_E1000_ACO
, EDVisit_E1000_Average_TIN
, EDVisit_E1000_Average_ACO
, EDVisit_E1000_TIN_Under_ACO
, EDVisit_Flag_TIN_Under_ACO
, CCLF_Functions.dbo.Divide_Return0(
  EDVisit_E1000_Tin_Under_ACO 
, EDVisit_E1000_Average_ACO) * -1 -- Multiply by -1 so Bonus information is positive
, @EDObs_Bonus_Allotment
, SQLRunDate_EDObs
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN

Update EDBonus
Set 
EDObs_BENE_Weighted =
	Case
		When EDVisit_Flag_TIN_Under_ACO = 1 
		Then NumBENE_TIN * EDObs_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus

Declare @Total_BENE_Weighted as Float
Set		@Total_BENE_Weighted = 
		(Select Sum(EDObs_BENE_Weighted)
		From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN)

Update EDBonus
Set 
  EDObs_Bonus_Percent	= 
	Case
		When EDVisit_Flag_TIN_Under_ACO = 1
		Then (EDObs_BENE_Weighted / @Total_BENE_Weighted)
		Else 0
	End
, EDObs_Total_Weighted	= @Total_BENE_Weighted
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus

Update EDBonus
Set 
  EDObs_Bonus_PerTIN	=  
	Case
		When EDVisit_Flag_TIN_Under_ACO = 1
		Then EDObs_Bonus_Percent * EDObs_Bonus_Allotment
		Else 0
	End 
, EDObs_Bonus_TIN		=  
	Case
		When EDVisit_Flag_TIN_Under_ACO = 1
		Then EDObs_Bonus_Percent * EDObs_Bonus_Allotment
		Else 0
	End
, EDObs_Bonus_PerBENE	= 
	Case
		When EDVisit_Flag_TIN_Under_ACO = 1
		Then (EDObs_Bonus_Percent * EDObs_Bonus_Allotment) / NumBENE_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus

------------------------
-- Update SQLRunDate
------------------------
Update EDBonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus

End
"
