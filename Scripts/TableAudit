    NULL
);

set @JobEndTime = SYSDATETIME()

set @TotalSeconds = DATEDIFF(SECOND, @JobStartTime, @JobEndTime)

SET @JobRunTime = 
    RIGHT('0' + CAST(@TotalSeconds / 3600 AS VARCHAR), 2) + ':' +
    RIGHT('0' + CAST((@TotalSeconds % 3600) / 60 AS VARCHAR), 2) + ':' +
    RIGHT('0' + CAST(@TotalSeconds % 60 AS VARCHAR), 2)

UPDATE Master.dbo.CCLFExecutionLog
SET JobRunTime = CAST(@JobRunTime AS TIME(0))
,JobEndTime    = @JobEndTime 
,JobStartTime  = @JobStartTime
WHERE RunID = @RunID
  AND JobName = @JobName
  and Status = 'Success'

 commit Tran
END TRY
BEGIN CATCH
    if @@TRANCOUNT > 0
    rollback tran
        INSERT Master.dbo.CCLFExecutionLog
        (
            RunID,
            MedicareFileDate,
            JobName,
            ProcName,
            StartTime,
            EndTime,
            Status,
            ErrorNumber,
            ErrorMessage
        )
        VALUES
        (
            @RunID,
            @MedicareFileDate,
            @JobName,
            @CurrentProc,
            @StartTime,
            SYSDATETIME(),
            'Failed',
            ERROR_NUMBER(),
            ERROR_MESSAGE()
        );

        THROW;
    END CATCH;
--set noexec off
END
