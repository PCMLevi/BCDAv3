-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
ALTER PROCEDURE [dbo].[BCDA_v3_Item]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
with cte as (
select it.* 
from BCDA_Staging.dbo.eob_base_staging_v3 bs
inner join BCDA_Staging.dbo.eob_item_staging_v3 it 
on bs.claim_id = it.claim_id
where type_code_display != 'pharmacy'
)
Merge BCDA_Data.dbo.EOB_Item_v3 as tgt
using BCDA_Staging.dbo.eob_item_staging_v3 as src
on tgt.claim_id = src.claim_id
and tgt.sequence = src.sequence
when matched then 
update
set
 tgt.Claim_ID = src.Claim_ID
,tgt.Patient_ID = src.Patient_ID
,tgt.Sequence = src.Sequence
,tgt.DiagnosisSequence = src.DiagnosisSequence
,tgt.InformationSequence = src.InformationSequence
,tgt.Location_Code = src.Location_Code
,tgt.Location_Display = src.Location_Display
,tgt.Product_Service_Code = src.Product_Service_Code
,tgt.Modifier = src.Modifier
,tgt.Product_Service_System = src.Product_Service_System
,tgt.Quantity_Value = src.Quantity_Value
,tgt.Revenue_Code = src.Revenue_Code
,tgt.Revenue_Display = src.Revenue_Display
,tgt.Service_Start = src.Service_Start
,tgt.Service_End = src.Service_End
,tgt.ServicedDate = src.ServicedDate
,tgt.LastUpdated = src.LastUpdated
,tgt.MergedBy = 'Updated'
,tgt.Filename = src.Filename
,tgt.Extract_Date = src.Extract_Date
when not matched then 
Insert (
 Claim_ID
,Patient_ID
,Sequence
,DiagnosisSequence
,InformationSequence
,Location_Code
,Location_Display
,Product_Service_Code
,Modifier
,Product_Service_System
,Quantity_Value
,Revenue_Code
,Revenue_Display
,Service_Start
,Service_End
,ServicedDate
,LastUpdated
,MergedBy
,Filename
,Extract_Date
) Values (
 src.Claim_ID
,src.Patient_ID
,src.Sequence
,src.DiagnosisSequence
,src.InformationSequence
,src.Location_Code
,src.Location_Display
,src.Product_Service_Code
,src.Modifier
,src.Product_Service_System
,src.Quantity_Value
,src.Revenue_Code
,src.Revenue_Display
,src.Service_Start
,src.Service_End
,src.ServicedDate
,src.LastUpdated
,'Inserted'
,src.Filename
,src.Extract_Date
);

update BCDA_Data.dbo.EOB_Item_v3
set CLM_PMT_AMT = st.adjudication_amount
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join BCDA_Staging.dbo.eob_item_adjudication_staging_v3 st
on bt.Claim_ID = st.claim_id
and bt.Sequence = st.sequence
where adjudication_category_display = 'Benefit Amount'

update BCDA_Data.dbo.EOB_Item_v3
set Tax_Num = identifierValue
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join BCDA_Staging.dbo.eob_item_ext_staging_v3 st  
on bt.Claim_ID = st.claim_id
and bt.Sequence = st.sequence
where url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/CLM-PRVDR-TAX-NUM'

update BCDA_Data.dbo.EOB_Item_v3
set Service_Type = ext.extension_display
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join BCDA_Staging.dbo.eob_item_ext_staging_v3 ext on
ext.claim_id = bt.Claim_ID
and ext.sequence = bt.sequence
where url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/CLM-FED-TYPE-SRVC-CD'

update BCDA_Data.dbo.EOB_Item_v3
set Quantity_Unit = ext.extension_display
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join BCDA_Staging.dbo.eob_item_ext_staging_v3 ext on
ext.claim_id = bt.Claim_ID
and ext.sequence = bt.sequence
where url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/CLM-MTUS-IND-CD'

update BCDA_Data.dbo.EOB_Item_v3
set PRVDR_Specialty = ext.extension_display
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join BCDA_Staging.dbo.eob_item_ext_staging_v3 ext on
ext.claim_id = bt.Claim_ID
and ext.sequence = bt.sequence
where url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/CLM-PRVDR-SPCLTY-CD'

update BCDA_Data.dbo.EOB_Item_v3
set Product_Service_Display = cpt.cptDescription
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join cclf_lookuptables.dbo.tbl_CPTCode cpt on
cpt.cptCode = Product_Service_Code

update BCDA_Data.dbo.EOB_Item_v3
set Product_Service_Display = hc.CLM_LINE_HCPCS
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join CCLF_LookupTables.dbo.tbl_CLM_LINE_HCPCS_CD hc on
hc.CLM_LINE_HCPCS_CD = Product_Service_Code


update BCDA_Data.dbo.EOB_Item_v3
set DGNS_Code = st.DGNS_Code_Without_Period
,DGNS_Descr   = st.DGNS_Desc
,DGNS_Type    = st.Diagnosis_Type_Code
from BCDA_Data.dbo.EOB_Item_v3 bt
inner join  BCDA_Data.dbo.EOB_Diagnosis_v3 st
on bt.Claim_ID = st.claim_id
and bt.DiagnosisSequence = st.sequence

update [BCDA_Data].[dbo].[EOB_Item_v3]
set Type_Display = bs.Type_Display
from [BCDA_Data].[dbo].[EOB_Item_v3] it
inner join [BCDA_Staging].[dbo].[eob_base_staging_v3] bs on 
bs.claim_id = it.claim_id 

END
