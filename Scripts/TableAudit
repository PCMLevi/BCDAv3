set BENE_MasterID = ML.BENE_MasterID
from cclf_reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
left join CCLF_LookupTables.dbo.ACO_BENE_MasterList ML on
RA.raBENE_HIC_NUM = ML.BENE_HIC_NUM_Previous
where ML.BENE_HIC_NUM_Previous is not null
*/
END
