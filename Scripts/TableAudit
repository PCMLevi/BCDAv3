	CLM_DGNS.CLM_DGNS_Level1_Short	is null
and CLM_DGNS.MedicareFileDate		= @MedicarefileDate
and CLM_DGNS.CLM_THRU_DT			between @StartDate and @StopDate
and CLM_DGNS.CCLFFile				= @CCLFFile
and CLM_DGNS.FromFile				= @FromFile

---------------------------------------------------
-- Update HCC Code - For some reason this is not 
-- in the code.  Added 7/6/2021
-- Update Acute/Chronic.  Added 7/13/2021
---------------------------------------------------
Update CLM_DGNS
Set 
  CLM_DGNS.HCCNumber			= ICD10.HCCNumber
, CLM_DGNS.HCCDescription		= ICD10.HCCDescription
, CLM_DGNS.HCCRiskScore			= ICD10.HCCRiskScore
, CLM_DGNS.HCCNumber_V28		= ICD10.HCCNumber_V28			-- Added 10/8/2024
, CLM_DGNS.HCCDescription_V28	= ICD10.HCCDescription_V28		-- Added 10/8/2024
, CLM_DGNS.HCCRiskScore_V28		= ICD10.HCCRiskScore_V28		-- Added 10/8/2024
from CCLF_Subsets.dbo.CLM_DGNS CLM_DGNS
Inner Join
CCLF_LookupTables.dbo.tbl_HCC_HCPCS_ICD10CM ICD10 on			-- 5/2/2023 Changed to Table with Unique Values
