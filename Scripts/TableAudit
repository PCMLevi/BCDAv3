  cuFiscalYear
, BENE_HIC_NUM
, count (distinct CLM_Thru_DT) as NumVisits
into #Temp22
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
	edType			= 'ED'
and CM.cuFiscalYear = @FiscalYear
Group by 
  cuFiscalYear
, BENE_HIC_NUM
Having count(distinct CLM_Thru_DT) >= 3

Update CM
Set InStatus1_ED = NumVisits
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
#Temp22 T22 on
    CM.BENE_HIC_NUM = T22.BENE_HIC_NUM
and CM.cuFiscalYear = T22.cuFiscalYear
Where 
CM.cuFiscalYear = @FiscalYear

--------------------------
-- Inpatient >= 2
--------------------------
