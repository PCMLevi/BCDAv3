Create Procedure procCompensation_PYCurrent_05_1_4_EDObs_Positive
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Declare @ED_Bonus_Allotment as float

Set @SelectType = 'Current'
Set @ED_Bonus_Allotment = (Select EDObs_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN

Drop Table if Exists #Temp_PercentPositive

Insert Into Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN
(
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, EDVisit_TIN
, EDVisit_E1000_TIN
, PercentPositive
, EDVisit_E1000_Average_TIN
, EDVisit_Positive_Flag_TIN
, EDVisit_OverUnder
, ED_Bonus_Allotment
, SQLRunDate_EDobs
, SQLRunDate
)

Select 
  @YearQuarter				as Compensation_Quarter
, @CompensationPercent		as Comensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, EDVisit_TIN
, EDVisit_E1000_TIN
, Case
	When EDVisit_E1000_TIN < EDVisit_E1000_Average_TIN 
	Then EDVisit_E1000_TIN
  End							as PercentPositive
, EDVisit_E1000_Average_TIN
, Case 
	When EDVisit_E1000_TIN < EDvisit_E1000_Average_TIN 
	Then 1
	Else 0
  End							as EDVisit_Positive_Flag_TIN 
, CCLF_Functions.dbo.Divide_Return0((EDVisit_E1000_Average_TIN - EDVisit_E1000_TIN) , EDVisit_E1000_TIN) as EDVisit_OverUnder
, @ED_Bonus_Allotment
, SQLRunDate_EDObs
, GetDate()
from Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN

Declare @NumBene_PY_Positive as Float
Set		@NumBene_PY_Positive = 
(Select Sum(PY_TIN) 
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN
Where
EDVisit_Positive_Flag_TIN = 1)

Declare @BENE_BonusEach as float
Set		@BENE_BonusEach = @ED_Bonus_Allotment / @NumBene_PY_Positive

----------------------------
-- Update The Bonus Amount
----------------------------
Update Bonus
Set ED_Bonus_TIN = PY_TIN * @BENE_BonusEach
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN Bonus
Where
EDVisit_Positive_Flag_TIN = 1

End"
2576,2026-06-08T10:13:04.305017,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_05_1_3_EDObs_Calculations,"
Create Procedure procCompensation_PYCurrent_05_1_3_EDObs_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate E1000 For Each Group
--=======================================

--===========
-- ACO
--===========
Select 
  Sum(EDVisit_ACO)	as EDVisit_ACO
, Sum(PY_ACO)		As PY_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO

Update ACO
Set EDVisit_E1000_ACO = CCLF_Functions.dbo.Divide_Return0(TACO.EDVisit_ACO, TACO.PY_ACO) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO
Inner Join
#Temp_ACO TACO on
1=1

--===========
-- NPI
--===========
Select 
  NPI
, Sum(EDVisit_NPI)	as EDVisit_NPI
, Sum(PY_NPI)		As PY_NPI
Into #Temp_NPI
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI
Group By
NPI

Update NPI
Set EDVisit_E1000_NPI = 
	CCLF_Functions.dbo.Divide_Return0(TNPI.EDVisit_NPI, TNPI.PY_NPI) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI
Inner Join
#Temp_NPI TNPI on
TNPI.NPI = NPI.NPI

--===========
-- TIN
--===========
Select 
  ACO_GroupTIN
, Sum(EDVisit_TIN)	as EDVisit_TIN
, Sum(PY_TIN)		As PY_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN
Group By
ACO_GroupTIN

Update TIN
Set EDVisit_E1000_TIN = 
	CCLF_Functions.dbo.Divide_Return0(TTIN.EDVisit_TIN, TTIN.PY_TIN) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN
Left Join
#Temp_TIN TTIN on
TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN




--=======================================
-- Calculate E1000 Average For Each Group
--=======================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Average
--=========================
Declare @Average_ACO as Float
Declare @Average_TIN as Float
Declare @Average_NPI as Float

Set @Average_ACO = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(EDVisit_ACO), Sum(PY_ACO)) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO)

Update ACO
Set EDVisit_E1000_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO

--=========================
-- TIN Average
--=========================
Set @Average_TIN = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(EDVisit_TIN), Sum(PY_TIN)) * 1000
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN)

Update TIN
Set TIN.EDVisit_E1000_Average_TIN = @Average_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN

--=========================
-- NPI Average
--=========================
Set @Average_NPI = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(EDVisit_NPI), Sum(PY_NPI)) * 1000 
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI)

Update NPI
Set NPI.EDVisit_E1000_Average_NPI = @Average_NPI
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI

End
