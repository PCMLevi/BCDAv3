	When MDI_HTN.MDI_GroupTin = '900088197'
	Then 'Phynet' 
	Else MDI_GroupTinName 
  End
, MDI_HTN.MDI_NPI
, MDI_HTN.MDI_NPI_LastName + ', ' + MDI_HTN.MDI_NPI_FirstName
, MDI_HTN.MDI_HICN
, MDI_HTN.MDI_HICN_Previous
, MDI_HTN.MDI_HICN_LastName + ', ' + MDI_HTN.MDI_HICN_FirstName
, 0										as PY_BENE
, 1
, @MeasureNumber
, @MeasureName
, @MeasureAbbr
, MDI_Reading_Date
, MDI_HTN_Systolic
, MDI_HTN_Diastolic
, MDI_HTN.MDI_Performance
, Case 
	When MDI_HTN.MDI_Performance = 'Met'
	Then 1
	Else 0
	End as HTN_Met
, Case 
	When MDI_HTN.MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as HTN_NotMet
, Case 
	When MDI_HTN.MDI_Performance = 'UnReported'
	Then 1
	Else 0
	End as HTN_UnReported
, Case
	When MDI_HTN.MDI_Performance = 'Met'
	Then 1
	Else 0
	End as HTN_Pass
, Case
	When MDI_HTN.MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as HTN_Fail
, Case 
	When MDI_HTN.MDI_Eligible = 'Yes' 
	Then 1
	Else 0
	End as HTN_Eligible
, Case 
	When MDI_HTN.MDI_Performance In ('Met','Not Met')
	Then 1
	Else 0
	End as HTN_Complete
, MDI_HTN.SQLRunDate_MDI_HTN
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_5_236_MDInteractive_HTN MDI_HTN

End"
