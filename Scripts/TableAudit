TNPI.NPI = NPI.NPI

--===========
-- TIN
--===========
Select 
  ACO_GroupTIN
, Sum(ReAdmit_TIN)	as ReAdmit_TIN
, Sum(PY_TIN)		As PY_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN
Group By
ACO_GroupTIN

Update TIN
Set ReAdmit_E1000_TIN = 
	CCLF_Functions.dbo.Divide_Return0(TTIN.ReAdmit_TIN, TTIN.PY_TIN) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN TIN
Left Join
#Temp_TIN TTIN on
TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN




--=======================================
-- Calculate E1000 Average For Each Group
--=======================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Average
--=========================
Declare @Average_ACO as Float
Declare @Average_TIN as Float
Declare @Average_NPI as Float

Set @Average_ACO = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(ReAdmit_ACO), Sum(PY_ACO)) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_4_ReAdmit_Aggregate_ACO ACO)

Update ACO
Set ReAdmit_E1000_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_06_2_2_4_ReAdmit_Aggregate_ACO ACO

--=========================
-- TIN Average
--=========================
Set @Average_TIN = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(ReAdmit_TIN), Sum(PY_TIN)) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN TIN)

Update TIN
Set TIN.ReAdmit_E1000_Average_TIN = @Average_TIN
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN TIN

--=========================
-- NPI Average
--=========================
Set @Average_NPI = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(ReAdmit_NPI), Sum(PY_NPI)) * 1000 
From Compensation_PYCurrent.dbo.Compensation_06_2_2_2_ReAdmit_Aggregate_NPI NPI)

Update NPI
Set NPI.ReAdmit_E1000_Average_NPI = @Average_NPI
From Compensation_PYCurrent.dbo.Compensation_06_2_2_2_ReAdmit_Aggregate_NPI NPI

End"
