5478,2026-08-07T15:30:04.171025,ALTER_PROCEDURE,CCLF_Procedures,dbo,CCLF_13_1_UpdateCLM_DGNS_CD_CCLF4_2025_With2025MedicareFileDate,"ALTER procedure [dbo].[CCLF_13_1_UpdateCLM_DGNS_CD_CCLF4_2025_With2025MedicareFileDate]
as 
begin

Drop Table if exists ##Temp1
Drop Table if exists #Temp2
Drop Table if exists #Temp3

Declare @StartDate			as Date
Declare @StopDate			as Date
Declare @CLM_IDR_LD_DT		as Date
Declare @ClaimYear			as char(6)
Declare @CCLFFile			as char(5)
Declare @MedicarefileDate	as Date
Declare @FromFile			as Varchar(5)
Declare	@RptName		  as Varchar(75)
Declare	@RptStep		  as Varchar(75)
Declare	@RptStepRunTime	  as Varchar(10)
Declare	@rptStartTime	  as DateTime
Declare	@RptStopTime	  as DateTime
declare @sql				as nvarchar(max)
declare @year				as varchar(4)


Set @RptName				= '_13_1_UpdateCLM_DGNS_CD_CCLF4_2025_With2025MedicareFileDate'
Set @RptStep				= 'Entire Report'
Set @rptStartTime			= GetDate()


Set @MedicareFileDate		= (Select MedicareFileDate	From Database_Constants.dbo.Import_Export_Automated)


Set @StartDate			= (Select dateadd(year , -1,StartDate)	From Database_Constants.dbo.Import_Export_Automated)
Set @StopDate			= (Select dateadd(year, -1, StopDate)	From Database_Constants.dbo.Import_Export_Automated)
Set @CLM_IDR_LD_DT		= (Select  dateadd(year, -1, IDR_LD_DT)	From Database_Constants.dbo.Import_Export_Automated)
Set @ClaimYear			= (Select concat(left(FiscalYear,2),right(FiscalYear, 4)-1)	From Database_Constants.dbo.Import_Export_Automated)
Set @year				= (Select CCLFFileYear - 1	From Database_Constants.dbo.Import_Export_Automated)
Set @CCLFFile			= 'CCLF4'
Set @FromFile			= 'PCM'

-----------------------------------------------
-- Delete Current Records
-----------------------------------------------
Delete from CCLF_Subsets.dbo.CLM_DGNS
Where
	MedicareFileDate	= @MedicarefileDate
and CLM_THRU_DT			between @StartDate and @StopDate
and CCLFFile			= @CCLFFile
and FromFile			= @FromFile

set @sql = 
'
Select
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_DGNS_CD			as CLM_DGNS_CD
, ''CCLF4''			    as CLM_DGNS_Position
, CUR_CLM_UNIQ_ID 
Into ##Temp1
from CCLF_Months.dbo.CCLF4_'+@year+'_WithLookupTables
Where 
	CLM_THRU_DT			between @StartDate and @StopDate
and MedicareFileDate	= @MedicarefileDate
'

EXEC sp_executesql
    @sql,
    N'@StartDate DATE, @StopDate DATE, @MedicareFileDate DATE',
    @StartDate = @StartDate,
    @StopDate = @StopDate,
    @MedicareFileDate = @MedicareFileDate;


--------------------------------------
-- Alter the #Temp1 table so it will 
-- Accept the rest of the fields
-- (longer length)
--------------------------------------
Alter Table ##Temp1
Alter Column CLM_DGNS_Position Varchar(15)

-------------------------------------------------
-- Find the Minimum Thru Date First
--------------------------------------------------
Select Distinct
  BENE_HIC_NUM
, Min(CLM_THRU_DT)	as CLM_THRU_DT
, CLM_DGNS_CD
Into #Temp2
From ##Temp1
Group by
  BENE_HIC_NUM
, CLM_DGNS_CD
Order by 
  BENE_HIC_NUM
, CLM_DGNS_CD


------------------------------------------------------------
-- Join back to #Temp1 to find the Minimum CUR_CLM_UNIQ_ID
------------------------------------------------------------
Select 
  T2.BENE_HIC_NUM
, T2.CLM_THRU_DT
, T2.CLM_DGNS_CD
, Min(CLM_DGNS_Position)	as CLM_DGNS_Position
, Min(T1.CUR_CLM_UNIQ_ID)	as CUR_CLM_UNIQ_ID
Into #Temp3
From #Temp2 T2
Inner Join 
##Temp1 T1 on
	T2.BENE_HIC_NUM		= T1.BENE_HIC_NUM
and T2.CLM_DGNS_CD		= T1.CLM_DGNS_CD
and T2.CLM_THRU_DT		= T1.CLM_THRU_DT
Group by
  T2.BENE_HIC_NUM
, T2.CLM_THRU_DT
, T2.CLM_DGNS_CD
Order by
  T2.BENE_HIC_NUM
, T2.CLM_DGNS_CD
, T2.CLM_THRU_DT

----------------------------------------------------
-- Insert the data into the CLM_DGNS Table
----------------------------------------------------
set @sql = 
'
Insert into CCLF_Subsets.dbo.CLM_DGNS
(
  MedicareFileDate
, CCLFFile
, ClaimYear
, CUR_CLM_UNIQ_ID
, BENE_MBI_ID
, BENE_HIC_NUM
, CLM_TYPE_CD
, CLM_TYPE
, CLM_PROD_TYPE_CD
, CLM_PROD_TYPE
, CLM_VAL_SQNC_NUM
