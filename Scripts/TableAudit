Into CCLF_Testing.dbo.Compensation_Temp_Paid_Preliminary_CRNT_PRVS
From #Temp_Paid_Preliminary

-----------------------------------------------------------------------------------
-- This Step must be Done to combine Current and Prev Bene with Paid in same month
-----------------------------------------------------------------------------------
Select 
  BENE_HIC_NUM
, Q1_HICN
, Q1_HICN_Prev
, MonthPaid
, StartDate
, StopDate
, Sum(TotalPaid) as TotalPaid
Into #Temp_Paid
From #Temp_Paid_Preliminary
Group By
  BENE_HIC_NUM
, Q1_HICN
, Q1_HICN_Prev
, MonthPaid
, StartDate
, StopDate

Set @MsgString = 'Paid by Month Completed'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

-- Select * From #Temp_Paid

-- Select * From #Temp_Paid TPaid Inner Join CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq on TPaid.BENE_HIC_NUM = Uniq.BENE_HIC_NUM Where BENE_ACO_GroupTinShortName = 'FMG' Order by BENE_ACO_GroupTinShortName, TPaid.BENE_HIC_NUM, MonthPaid

--*** Note:  FMG is not in Q7 File - It is now because I copied 2025Q1 to 2025Q4

-----------------------------------------
-- Write to Temporary Table for Testing
-----------------------------------------
Drop Table if Exists CCLF_Testing.dbo.Compensation_Temp_Paid_CRNT_PRVS
Select *
Into CCLF_Testing.dbo.Compensation_Temp_Paid_CRNT_PRVS
from #Temp_Paid

-----------------------------------------------------
-- Write Combined Information out to Detail Table
-----------------------------------------------------  
Drop Table if Exists #Temp_Final

Select 
  TMonth.Q1_HICN
, TMonth.Q1_HICN_Prev
, TMonth.BENE_PY
, TMonth.MonthFlag
, TMonth.StartDate	as MonthStartDate
, TMonth.StopDate	as MonthStopDate
, TMonth.MonthFlagType
, Case When MonthPaid		is Null Then TMonth.MonthFlag	Else TPaid.MonthPaid	End		as MonthPaid
, Case When TPaid.StartDate	is Null Then TMonth.StartDate	Else TPaid.StartDate	End		as PaidStartDate
, Case When TPaid.StopDate	is Null Then TMonth.StopDate	Else TPaid.StopDate		End 	as PaidStopDate
, Case When TPaid.TotalPaid is Null Then 0					Else TPaid.TotalPaid	End		as TotalPaid
Into #Temp_Final
From #Temp_Month TMonth
Left Join
#Temp_Paid TPaid on
	TMonth.Q1_HICN		= TPaid.BENE_HIC_NUM
and TMonth.MonthFlag	= TPaid.MonthPaid
and TMonth.StartDate	= TPaid.StartDate
and TMonth.StopDate		= TPaid.StopDate

--------------------------------------------
-- Insert Data into Temp Table for Testing
--------------------------------------------
Drop Table if Exists CCLF_Testing.dbo.Compensation_Temp_Final_CRNT_PRVS
Select *
Into CCLF_Testing.dbo.Compensation_Temp_Final_CRNT_PRVS
from #Temp_Final

-- Select * From #Temp_Final Order by Q1_HICN, MonthFlag

--------------------------------------------
-- Insert into Compensation Table
--------------------------------------------
Delete From Compensation_PYCurrent.dbo.Compensation_01_1_Attribution_ByCMSRiskType_ByMonth

Insert Into Compensation_PYCurrent.dbo.Compensation_01_1_Attribution_ByCMSRiskType_ByMonth
(

  Compensation_Quarter
, Compensation_Percent
, ACO_GroupName
, ACO_GroupTINName
, ACO_GroupTINName_New
, ACO_GroupTin
, NPI
, NPI_LastName
, NPI_FirstName
, NPI_Fullname
, BENE_MasterID
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, CMSRiskType
, BENE_PY
, Month_Number
, Month_StartDate
, Month_StopDate
, BENE_TotalPaid
, SQLRunDate
)

Select 
  @Compensation_Quarter
, @Compensation_Percent
, ACO_BENE.ACO_GroupName
, ACO_BENE.ACO_GroupTINName
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.NPI
, ACO_BENE.NPI_LastName
, ACO_BENE.NPI_FirstName
, ACO_BENE.NPI_LastName + ', ' + ACO_BENE.NPI_FirstName as NPI_Fullname
, ACO_BENE.BENE_MasterID
, TFinal.Q1_HICN					as BENE_HIC_NUM
, TFinal.Q1_HICN_Prev				as BENE_HIC_NUM_Previous
, TFinal.MonthFlagType				as CMSRiskType
, TFinal.BENE_PY
, TFinal.MonthFlag					as MonthNum
, TFinal.MonthStartDate
, TFinal.MonthStopDate
, TFinal.TotalPaid					as BENE_TotalPaid
, GetDate()							as LastUpdated
from #Temp_Final TFinal
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE on
TFinal.Q1_HICN = ACO_BENE.BENE_HIC_NUM
Where
ACO_BENE.BENE_YearQuarter = @Compensation_Quarter

