5627,2026-08-12T14:23:35.830930,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_30_0_1_QASSGN_CheckForMissingNPI,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_30_0_1_QASSGN_CheckForMissingNPI
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	----------------------------------------------------------
-- QASSGN Table 1_4 is PCS Visits (Primary Care Services)
-- Lists Primary Care Physicians and Beneficiary Visits
-- Verify if there are any new NPI's not in the ACO Table
----------------------------------------------------------
Declare @SelectType				as Varchar(15)
Declare @AttributionQuarter		as char(7)

Set @SelectType				= 'Current'
SET @AttributionQuarter		= (Select YearQuarter	From Database_Constants.dbo.Quarterly_Automated)

drop table if exists #temp1

Select Distinct
  Q4_ACOParticipatingTIN
, Q4_IndividualNPI
into #temp1
from CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4
Left Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where 
	Q4_YearQuarter			= @AttributionQuarter
and ACO.ACO_NPIIndividual	is null
Order by
Q4_IndividualNPI

insert into CCLF_LookupTables.dbo.ACO (
 ACO_NPIIndividual
,ACO_Active
,ACO_ActiveDate
,ACO_GroupTin
,ACO_NPI_LastName
,ACO_NPI_FirstName
,ACO_NPI_Title
,ACO_NPI_StreetAddress
,ACO_NPI_City
,ACO_NPI_State
,ACO_NPI_ZipCode
,ACO_NPI_Telephone
,ACO_SpecialtyDescription
,ACO_PrimaryTaxonomyCode
,ACO_PrimaryTaxonomy
,ACO_Note
)
Select Distinct
t1.Q4_IndividualNPI
,'Yes'
,getdate()
,t1.Q4_ACOParticipatingTIN
,npi.[Provider Last Name (Legal Name)]
,npi.[Provider First Name]
,npi.[Provider Credential Text]
,npi.[Provider First Line Business Mailing Address]
,npi.[Provider Business Mailing Address City Name]
,npi.[Provider Business Mailing Address State Name]
,left(npi.[Provider Business Mailing Address Postal Code], 5)
,[Provider Business Mailing Address Telephone Number]
,pt.Specialization
,pt.Primary_Taxonomy
,pt.Classification
,'Updated from Quarterly_30_0_1_automated job; NPI found in QASSGN_Table1_4'
from #temp1 t1
inner join NPPES.dbo.npidata_pfile npi on 
t1.Q4_IndividualNPI = npi.NPI
inner join NPPES.dbo.Primary_Taxonomy pt on 
npi.NPI = pt.NPI

END
