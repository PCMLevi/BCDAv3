      set  CLM_DGNS             		        = ICD10CM.ICD10CM_Desc
         , CLM_DGNS_Level1_Short		        = ICD10CM.ICD10CM_Level1_ShortDesc
         , CLM_DGNS_Level2_Short		        = ICD10CM.ICD10CM_Level2
         , CLM_DGNS_Level3_Short		        = ICD10CM.ICD10CM_Level3
         , RNDRG_Prvdr_Org_Name_Lgl_Bus_Name    = NPPES.[Provider Organization Name (Legal Business Name)]
         , HCCNumber					        = HCC.HCCNumber
         , HCCDescription			            = HCC.HCCDescription
         , HCCRiskScore				            = HCC.HCCRiskScore
         , HCCNumber_V28			            = HCC.HCCNumber_V28			
         , HCCDescription_V28		            = HCC.HCCDescription_V28	
         , HCCRiskScore_V28			            = HCC.HCCRiskScore_V28	
