5642,2026-08-12T14:59:45.930259,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_8_3_5_UpdateACO_BENE_Prev_Crnt,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_8_3_5_UpdateACO_BENE_Prev_Crnt
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	------------------------------------------------------------------------------------------
-- Update BENE_HIC_NUM Records to Determine whether they are Previous or Current Records
------------------------------------------------------------------------------------------
Drop Table if Exists #Temp_Current
Drop Table if Exists #Temp_Previous

--------------
-- Current
--------------
Select Distinct 
  BENE_HIC_NUM
, Cast(Null as Varchar(15)) as BENE_Type
, BENE_YearQuarter
Into #Temp_Current
From CCLF_LookupTables.dbo.ACO_Beneficiaries

-- Select * From #Temp_Current

--------------
-- Previous
--------------
Select Distinct 
  BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, 'Previous'				as BENE_Type
, BENE_YearQuarter
Into #Temp_Previous
From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_HIC_NUM_Previous is not null

-- Select * From #Temp_Previous

Update Crnt
Set BENE_Type = 
Case When Prvs.BENE_Type is not Null Then 'Previous' Else 'Current' End
from #Temp_Current Crnt
Left Join
#Temp_Previous Prvs on
Crnt.BENE_HIC_NUM		= Prvs.BENE_HIC_NUM_Previous

-- Select * From #Temp_Current

---------------------------------
-- Update ACO_Beneficiaries
---------------------------------
Update ACO_BENE
Set BENE_HIC_NUM_Type = Crnt.BENE_Type
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Left Join
#Temp_Current Crnt on
	ACO_BENE.BENE_HIC_NUM		= Crnt.BENE_HIC_NUM
and ACO_BENE.BENE_YearQuarter	= Crnt.BENE_YearQuarter

END
"
5641,2026-08-12T14:59:16.925448,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_8_3_4_UpdateBeneficiaries_Unique_Prev_Crnt,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_8_3_4_UpdateBeneficiaries_Unique_Prev_Crnt
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	------------------------------------------------------------------------------------------
-- Update BENE_HIC_NUM Records to Determine whether they are Previous or Current Records
------------------------------------------------------------------------------------------

Declare @CurrentProc      SYSNAME
Declare @StartTime        DATETIME2
Declare @MedicareFileDate DATE
Declare @RunID            VARCHAR(15)
Declare @JobName          VARCHAR(100)

Drop Table if Exists #Temp_Uniq_Current
Drop Table if Exists #Temp_Uniq_Previous


--------------
-- Current
--------------
Select 
  BENE_HIC_NUM
, Cast(Null as Varchar(15)) as BENE_Type
Into #Temp_Uniq_Current
From CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique_Test Uniq

-- Select * From #Temp_Uniq_Current

--------------
-- Previous
--------------
Select 
  BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, 'Previous'				as BENE_Type
Into #Temp_Uniq_Previous
From CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique
Where
BENE_HIC_NUM_Previous is not null

Update Crnt
Set BENE_Type = 
Case When Prvs.BENE_Type is not Null Then 'Previous' Else 'Current' End
from #Temp_Uniq_Current Crnt
Left Join
#Temp_Uniq_Previous Prvs on
Crnt.BENE_HIC_NUM = Prvs.BENE_HIC_NUM_Previous

