5636,2026-08-12T14:43:44.128559,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_8_3_1_UpdateDeathDateQ1_From_BENE_GEO_INFO,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_8_3_1_UpdateDeathDateQ1_From_BENE_GEO_INFO
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	Drop Table if Exists #Temp_ACO_BENE
Drop Table if Exists #Temp_QASSGN
Drop Table if Exists #Temp_GEO
Drop Table if Exists #Temp_Death
Drop Table if Exists #Temp_DeathQuarter
Drop Table if Exists #Temp_Death_Needs_Updated
Drop Table if Exists #Temp_DeathDate_WrongQuarter

---------------------------------
-- Find Death Dates in ACO_Bene
---------------------------------
Select Distinct 
  BENE_HIC_NUM
, BENE_DeathDate
Into #Temp_ACO_BENE
from CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_DeathDate is not null

---------------------------------
-- Find Death Dates in QASSGN
---------------------------------
Select Distinct 
  Q1_HICN
, Q1_DeathDate
Into #Temp_QASSGN
from CCLF_LookupTables.dbo.QASSGN_Table1_1
Where
Q1_DeathDate is not null

---------------------------------
-- Find Death Dates in BENE_GEO
---------------------------------
Select Distinct 
  BENE_HIC_NUM
, BENE_DEATH_DT
Into #Temp_GEO
from CCLF_Subsets.dbo.BENE_GEO_INFO
Where
BENE_Death_DT is not null

---------------------------------
-- Union All Death Dates
-- Note:  Union Selects Distinct
---------------------------------
Select *
Into #Temp_Death
From #Temp_ACO_BENE
Union
Select *
From #Temp_QASSGN
Union
Select *
from #Temp_GEO
Order by
BENE_HIC_NUM

----------------------------------------------
-- Match up Death Dates to Correct Quarter
----------------------------------------------
Select 
  TDeath.BENE_HIC_NUM
, TDeath.BENE_DeathDate
, YQQ.yqqStart
, YQQ.yqqEnd
, YQQ.yqqName
Into #Temp_DeathQuarter
From #Temp_Death TDeath
Inner Join
CCLF_LookupTables.dbo.tbl_YearQuarter_Quarter Yqq on
TDeath.BENE_DeathDate between Yqq.yqqStart and Yqq.yqqEnd
Order by
BENE_HIC_NUM

---------------------------------
-- Find Quarters in ACO_BENE 
-- Where Death Date is Null
---------------------------------
Select 
  ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_YearQuarter
, ACO_BENE.BENE_DeathDate		as ACO_BENE_DeathDate
, TQtr.BENE_DeathDate			as Quarter_DeathDate
, TQtr.yqqName
Into #Temp_Death_Needs_Updated
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_DeathQuarter TQtr on
	ACO_BENE.BENE_HIC_NUM		= TQtr.BENE_HIC_NUM
and ACO_BENE.BENE_YearQuarter	>= TQtr.yqqName
and ACO_BENE.BENE_DeathDate		is Null
Order by
  BENE_HIC_NUM
, BENE_YearQuarter

------------------------------------------------------
-- Update ACO_BENE with Death Date in Correct Quarter
------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_DeathDate = TUpdate.Quarter_DeathDate
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join 
#Temp_Death_Needs_Updated TUpdate on
	ACO_BENE.BENE_HIC_NUM		= TUpdate.BENE_HIC_NUM
and ACO_BENE.BENE_YearQuarter	= TUpdate.BENE_YearQuarter

------------------------------------------------------
-- Find Death Dates in wrong Quarter
------------------------------------------------------
Select 
  ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_YearQuarter
, ACO_BENE.BENE_DeathDate
, YQQ.yqqName
Into #Temp_DeathDate_WrongQuarter
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.tbl_YearQuarter_Quarter YQQ on
	ACO_BENE.BENE_YearQuarter	= YQQ.yqqName
and ACO_BENE.BENE_DeathDate		> YQQ.yqqEnd
Where
BENE_DeathDate is not Null
Order by
  BENE_HIC_NUM
, BENE_YearQuarter

------------------------------------------------------
-- Change Death Dates to Null in wrong Quarter
------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_DeathDate = Null
From CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_DeathDate_WrongQuarter TWrongQuarter on
	ACO_BENE.BENE_HIC_NUM		= TWrongQuarter.BENE_HIC_NUM
and ACO_BENE.BENE_YearQuarter	= TWrongQuarter.BENE_YearQuarter

------------------------------------------
-- Make Sure All Death Dates Are Correct
------------------------------------------
Select 
  Q1.Q1_HICN				as Q1_HICN
, Q1.Q1_YearQuarter			as Q1_Qtr
, Q1.Q1_DeathDate			as Q1_Death
, ACO_BENE.BENE_HIC_NUM		as ACO_HICN
, ACO_BENE.BENE_YearQuarter	as ACO_Qtr
, ACO_BENE.BENE_DeathDate	as ACO_Death
From CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
	Q1.Q1_HICN			= ACO_BENE.BENE_HIC_NUM
and Q1.Q1_YearQuarter	= ACO_BENE.BENE_YearQuarter
Where
ACO_BENE.BENE_DeathDate <> Q1.Q1_DeathDate


------------------------------------------------------------
-- Update QASSGN Table with Death Dates in Correct Quarters
------------------------------------------------------------
/*
Update Q1
Set Q1.Q1_DeathDate = ACO_BENE.BENE_DeathDate
From CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
	Q1.Q1_HICN			= ACO_BENE.BENE_HIC_NUM
and Q1.Q1_YearQuarter	= ACO_BENE.BENE_YearQuarter
Where
ACO_BENE.BENE_DeathDate is not null
*/



END
