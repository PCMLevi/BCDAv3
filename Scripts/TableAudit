3994,2026-07-04T03:28:43.210632,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_4_A1C_Bonus,"
Alter Procedure procCompensation_PYCurrent_10_001_4_A1C_Bonus
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Declare @A1C_Bonus_Allotment	as float

Set @SelectType = 'Current'
Set @A1C_Bonus_Allotment = (Select A1C_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN

Select 
  @QM_Completion_Percent	as ComplPct
, @QM_40th_Percentile		as PerfPct
, @A1C_Bonus_Allotment		As A1C_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @A1C_Performance_Rate_ACO as Float	
Set		
@A1C_Performance_Rate_ACO = 
	(Select A1C_Performance_Rate_ACO
	 From   Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO)

-- Select @A1C_Performance_Rate_ACO as PerfRate_ACO

Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Pass_TIN
, A1C_Complete_TIN
, Completion_Percent
, Performance_Percent
, A1C_Performance_Rate_TIN
, A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, A1C_Quality_Weight
, A1C_Bonus_Allotment
, SQLRunDate_A1C
)

Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, A1C_Pass_TIN
, A1C_Complete_TIN
, @QM_Completion_Percent
, @QM_40th_Percentile
, A1C_Performance_Rate_TIN
, @A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(  A1C_Performance_Rate_TIN
	 , @QM_40th_Percentile
	) 
, @A1C_Bonus_Allotment
, SQLRunDate_MDI_A1C
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN


Update A1C
Set 
A1C_BENE_Weight =
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1 
		Then A1C_Eligible_TIN * A1C_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

Declare @A1C_BENE_Weight_Total as Float
Set		@A1C_BENE_Weight_Total = 
		(Select Sum(A1C_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN)

Update A1C
Set 
  A1C_Bonus_Percent	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then (A1C_BENE_Weight / @A1C_BENE_Weight_Total)
		Else 0
	End
, A1C_BENE_Weight_Total	= @A1C_BENE_Weight_Total
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

Update A1C
Set 
  A1C_Bonus_PerTIN	=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End 
, A1C_Bonus_TIN		=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End
, A1C_Bonus_PerBENE	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0
			(
			 (A1C_Bonus_Percent * A1C_Bonus_Allotment)
		    , A1C_Eligible_TIN
		    )
		
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

------------------------
-- Update SQLRunDate
------------------------
Update A1C
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

End
