2854,2026-06-13T12:48:54.350185,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_1_Readmit_ByBENE,"
Alter Procedure procCompensation_PYCurrent_06_1_1_ReAdmit_ByBENE
(	
	  @CompensationYear		as Varchar(6)
	, @CompensationQuarter	as Varchar(6)
	, @CompensationPercent	as Float
	, @StartDate			as Date
	, @StopDate				as Date
	, @IDR_LD_DT			as Date
)
AS
BEGIN

Declare @SelectType		as Varchar(15)
Declare @ReAdmit_Days	as Int

Set		@SelectType		= 'Current'
Set		@ReAdmit_Days	= (Select ReAdmit_Days From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_1_ReAdmit_ByBENE

Drop Table if Exists #Temp_Hospital
Drop Table if Exists #Temp_ReAdmit
Drop Table if Exists #Temp_HospitalReAdmit

------------------------------------------
-- Select all Hospital Inpatient Records
------------------------------------------
Select Distinct 
  Hosp.BENE_HIC_NUM
, Hosp.BENE_HIC_NUM_Previous
, Hosp.CLM_FROM_DT
, Hosp.CLM_THRU_DT
, Sum(Hosp.CLM_PMT_AMT)		as Hospital_Paid
, Hosp.FAC_FacilityName		as Hospital_Facility
, Hosp.SQLRunDate			as SQLRunDate_Hospital
Into #Temp_Hospital
from CCLF_Reports.dbo.CostUtilization_AllAttributed_HospitalInpatient Hosp
Where
	CLM_THRU_DT			between @StartDate and @StopDate
and expExpenseType2		= 'Inpatient Hospital'
and CLM_LINE_NUM		= 1
Group By
  Hosp.BENE_HIC_NUM
, Hosp.BENE_HIC_NUM_Previous
, Hosp.CLM_FROM_DT
, Hosp.CLM_THRU_DT
, Hosp.FAC_FacilityName	
, Hosp.SQLRunDate

------------------------------------------
-- Select all ReAdmit Records
------------------------------------------
Select Distinct 
  ReAdmit.raBENE_HIC_NUM
, ReAdmit.BENE_HIC_NUM_Previous
, ReAdmit.raCLM_FROM_DT_Previous
, ReAdmit.raCLM_THRU_DT_Previous
, ReAdmit.raCLM_FROM_DT_Current
, ReAdmit.raCLM_THRU_DT_Current
, ReAdmit.raFacility_Current			as ReAdmit_Facility
, Sum(ReAdmit.raPaidTotal_Current)		as ReAdmit_Paid
, ReAdmit.SQLRunDate					as SQLRunDate_ReAdmit
Into #Temp_ReAdmit
from CCLF_Reports.dbo.CostUtilization_AllAttributed_ReAdmit_Hospital ReAdmit
Where
	raCLM_THRU_DT_Previous between @StartDate and @StopDate
and raReAdmit_InDays <= @ReAdmit_Days
Group By
  ReAdmit.raBENE_HIC_NUM
, ReAdmit.BENE_HIC_NUM_Previous
, ReAdmit.raCLM_FROM_DT_Previous
, ReAdmit.raCLM_THRU_DT_Previous
, ReAdmit.raCLM_FROM_DT_Current
, ReAdmit.raCLM_THRU_DT_Current
, ReAdmit.raFacility_Current
, ReAdmit.SQLRunDate

------------------------------------------------
-- Combine Hospital and ReAdmit Data together
------------------------------------------------
Insert into Compensation_PYCurrent.dbo.Compensation_06_1_1_ReAdmit_ByBENE
( ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_FullName
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, Hospital_FROM_DT
, Hospital_THRU_DT
, Hospital_VisitCount
, Hospital_Paid
, Hospital_FacilityName
, ReAdmit_FROM_DT_Previous
, ReAdmit_THRU_DT_Previous
, ReAdmit_FROM_DT_Current
, ReAdmit_THRU_DT_Current
, ReAdmit_VisitCount
, ReAdmit_Paid
, ReAdmit_FacilityName
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select 
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY		as PY_BENE
, 1						as NumBENE_BENE
, Hospital.CLM_FROM_DT
, Hospital.CLM_THRU_DT
, Case 
	When Hospital.CLM_THRU_DT is not null
	Then 1
	Else 0
  End					as HospitalVisit_Count
, Hospital.Hospital_Paid
, Hospital.Hospital_Facility
, ReAdmit.raCLM_FROM_DT_Previous
, ReAdmit.raCLM_THRU_DT_Previous
, ReAdmit.raCLM_FROM_DT_Current
, ReAdmit.raCLM_THRU_DT_Current
, Case
	When ReAdmit.raCLM_THRU_DT_Current is not null
	Then 1
	Else 0
  End		as ReAdmitVisit_Count
, ReAdmit.ReAdmit_Paid
, ReAdmit.ReAdmit_Facility
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
FROM 
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
#Temp_Hospital Hospital on
ACO_BENE.BENE_HIC_NUM = Hospital.BENE_HIC_NUM
Left Join
#Temp_ReAdmit ReAdmit on
	ACO_BENE.BENE_HIC_NUM	= Hospital.BENE_HIC_NUM
and ACO_BENE.BENE_HIC_NUM	= ReAdmit.raBENE_HIC_NUM
and Hospital.CLM_THRU_DT	= ReAdmit.raCLM_THRU_DT_Previous

-- Select * From #Temp1 Where raCLM_FROM_DT_Previous is not null

End"
