5617,2026-08-12T13:36:19.146912,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_Import,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_Import
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	
drop table if exists #filelist, #filelistrawqalr, #connectiontable

declare @tablename varchar(25)
,@namefile varchar(200)
,@FileSizeMB float
,@sql nvarchar(max)
,@dir nvarchar(max)

if @@SERVERNAME in ('PROD-Test', 'PROD-Final')
set @dir = 'E:\SQL\SQLBulkImport\QALR\'
else 
set @dir = 'C:\SQLBulkImport\QALR\'

create table #filelistrawQALR (line nvarchar(max))

set @sql = 
'
insert into #filelistrawQALR
EXEC xp_cmdshell ''powershell -NoProfile -Command ""Get-ChildItem '+@dir+' -File | Select-Object Name, Length | ForEach-Object { $_.Name + ''''|'''' + $_.Length }""''
'

exec(@sql)

create table #connectiontable (
  namefile varchar(200)
, tablename varchar(25)
, FileSizeMB float
)

CREATE TABLE #filelist (
  Filename VARCHAR(200)
, FilesizeMB FLOAT
)

INSERT INTO #filelist (
	Filename,
	FilesizeMB
	)
SELECT LEFT(line, CHARINDEX('|', line) - 1) AS FileName,
	cast(RIGHT(line, LEN(line) - CHARINDEX('|', line)) AS FLOAT) / 1048576 AS FileSizeMB
FROM #filelistrawQALR
WHERE line IS NOT NULL

insert into #connectiontable
select 
filename
,case 
	when filename like '%QALR%' then 'QALR_' + left(right(filename, 5), 1) + '_Staging'
	when filename like '%QBEUR%' then 'QBEUR_1_Staging'
end as tablename
, FileSizeMB
from #filelist

declare tablecursor cursor for 
select * from #connectiontable

open tablecursor

fetch next from tablecursor into
@namefile
,@tablename
,@FileSizeMB

while @@FETCH_STATUS = 0
begin 

set @sql = 
'
use CCLF_LookupTables
truncate table '+@tablename+'

Bulk Insert CCLF_LookupTables.dbo.'+ @tablename+'
From  '''+@dir+@namefile+'''
With (Format = ''CSV''  ,FIELDTerminator = '','' , RowTerminator = ''0x0a'' , FirstRow = 2)
'
exec(@sql)

fetch next from tablecursor into 
@namefile
,@tablename
,@FileSizeMB

end

close tablecursor

deallocate tablecursor
END
"
