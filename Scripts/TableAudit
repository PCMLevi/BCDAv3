Select 
  @QM_Completion_Percent	as ComplPct
, @QM_40th_Percentile		as PerfPct
, @DEP_Bonus_Allotment		As DEP_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @DEP_Performance_Rate_ACO as Float	
Set		
@DEP_Performance_Rate_ACO = 
	(Select DEP_Performance_Rate_ACO
	 From   Compensation_PYCurrent.dbo.Compensation_10_134_2_4_DEP_Aggregate_ACO)

-- Select @DEP_Performance_Rate_ACO as PerfRate_ACO

Insert Into Compensation_PYCurrent.dbo.Compensation_10_134_2_6_DEP_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, DEP_Eligible_TIN
, DEP_Pass_TIN
, DEP_Complete_TIN
, Completion_Percent
, Performance_Percent
, DEP_Performance_Rate_TIN
, DEP_Performance_Rate_ACO
, DEP_Performance_Rate_TIN_Over_ACO
, DEP_Performance_Flag_TIN_Over_ACO
, DEP_Quality_Weight
, DEP_Bonus_Allotment
, SQLRunDate_MDI_DEP
)

