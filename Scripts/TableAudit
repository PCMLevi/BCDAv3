CCLF_LookupTables.dbo.ACO ACO on
ACO_BENE.BENE_NPI_Number = ACO.ACO_NPIIndividual
Left Join
CCLF_LookupTables.dbo.CCM_BENE_HIC_NUM CCM on
T1.BENE_HIC_NUM = CCM.ccmBENE_HIC_NUM

Set @StopTime = GetDate()
Set @MsgString = 'Insert into ACO_Beneficiaries_Unique Complete (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

