, 0										as PY_BENE
, 1
, @MeasureNumber
, @MeasureName
, @MeasureAbbr
, MDI_BCS.MDI_Performance
, Case 
	When MDI_BCS.MDI_Performance = 'Met'
	Then 1
	Else 0
	End as BCS_Met
, Case 
	When MDI_BCS.MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as BCS_NotMet
, Case 
	When MDI_BCS.MDI_Performance = 'UnReported'
	Then 1
	Else 0
	End as BCS_UnReported
, Case
	When MDI_BCS.MDI_Performance = 'Met'
	Then 1
	Else 0
	End as BCS_Pass
, Case
	When MDI_BCS.MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as BCS_Fail
, Case 
	When MDI_BCS.MDI_Eligible = 'Yes' 
	Then 1
	Else 0
	End as BCS_Eligible
, Case 
	When MDI_BCS.MDI_Performance In ('Met','Not Met')
	Then 1
	Else 0
	End as BCS_Complete
, MDI_BCS.MDI_Mammogram_Code
, MDI_BCS.MDI_Mammogram_Date
, MDI_BCS.SQLRunDate_MDI_BCS
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_5_112_MDInteractive_BCS MDI_BCS

End"
