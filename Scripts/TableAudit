  NPI
, NPI_FullName
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, 0						as BENE_PY
, 1						as NumBENE_BENE
, A1C_Eligible
, A1C_Complete
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, SQLRunDate_MDI_A1C
, GetDate()
From 
Compensation_PYCurrent.dbo.Compensation_10_001_0_A1C_ByMDI A1C

-- Select * From Compensation_PYCurrent.dbo.Compensation_10_001_2_A1C_Aggregate_BENE

--===============================================================
-- Aggregate to MDI Summary Level
--
-- NOTE:  I am creating this to compare Summary results against 
--		  Quality Submission Details that Jae tracks.
--===============================================================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI
(
  GroupName
, PY_BENE_MDI
, NumBENE_BENE_MDI
, A1C_Eligible_MDI
, A1C_Complete_MDI
, A1C_Met_MDI
, A1C_NotMet_MDI
, A1C_UnReported_MDI
, A1C_Pass_MDI
, A1C_Fail_MDI
, SQLRunDate_MDI_A1C
, SQLRunDate
)
Select
