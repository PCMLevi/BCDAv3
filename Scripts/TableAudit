--============================================
-------------------------------
-- Update Pct Constant - NPI
-------------------------------
Update A1C_NPI
Set 
  A1C_Completion_Percent	= @Completion_Percent
, A1C_Performance_Percent	= @Performance_Percent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

-------------------------------
-- Update Pct Constant - TIN
-------------------------------
Update A1C_TIN
Set 
  A1C_Completion_Percent	= @Completion_Percent
, A1C_Performance_Percent	= @Performance_Percent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

-------------------------------
-- Update Pct Constant - ACO
-------------------------------
Update A1C_ACO
Set 
  A1C_Completion_Percent	= @Completion_Percent
, A1C_Performance_Percent	= @Performance_Percent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

-------------------------------
-- Update Pct Constant - MDI
-- (MDI_Summary)
-------------------------------
Update A1C_MDI
Set 
  A1C_Completion_Percent	= @Completion_Percent
, A1C_Performance_Percent	= @Performance_Percent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI A1C_MDI

--========================
-- Update Completion Rate
--========================

--=====================
-- Completion Rate
--=====================

-------------------
-- Completion_NPI
-------------------
Select 
  NPI
, CCLF_Functions.dbo.Divide_Return0(
  A1C_Complete_NPI
, A1C_Eligible_NPI) as A1C_Completion_Rate_NPI
Into #Temp_Complete_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI

-- Select * From #Temp_Complete_NPI

Update A1C_NPI
Set A1C_NPI.A1C_Completion_Rate_NPI = TNPI.A1C_Completion_Rate_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join
#Temp_Complete_NPI TNPI on
A1C_NPI.NPI = TNPI.NPI

-------------------
-- Completion_TIN
-------------------
Select 
  ACO_GroupTIN
, CCLF_Functions.dbo.Divide_Return0(
  A1C_Complete_TIN
, A1C_Eligible_TIN) as A1C_Completion_Rate_TIN
Into #Temp_Complete_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN

Update A1C_TIN
Set A1C_TIN.A1C_Completion_Rate_TIN = TTIN.A1C_Completion_Rate_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN
Left Join
#Temp_Complete_TIN TTIN on
A1C_TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN

-------------------
-- Completion_ACO
-------------------
Select 
A1C_Complete_ACO / A1C_Eligible_ACO as A1C_Completion_Rate_ACO
Into #Temp_Complete_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO

Update A1C_ACO
Set A1C_ACO.A1C_Completion_Rate_ACO = TACO.A1C_Completion_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO
Left Join
#Temp_Complete_ACO TACO on
1=1

-------------------
-- Completion_MDI
-- (Summary)
-------------------
Drop Table if Exists #Temp_Complete_MDI

Select 
  A1C_Complete_MDI
, A1C_Eligible_MDI
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_MDI as Float)
	, A1C_Eligible_MDI
	) as A1C_Completion_Rate_MDI
Into #Temp_Complete_MDI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI

-- Select * From #Temp_Complete_MDI
Update A1C_MDI
Set A1C_MDI.A1C_Completion_Rate_MDI = TMDI.A1C_Completion_Rate_MDI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI A1C_MDI
Left Join
#Temp_Complete_MDI TMDI on
1=1

--=====================
-- Performance Rate
--=====================
-------------------
-- Performance_TIN
-------------------
Select 
  ACO_GroupTIN
, A1C_Pass_Rate_TIN
, CCLF_Functions.dbo.Divide_Return0(
  A1C_Pass_Rate_TIN
, A1C_Completion_Rate_TIN)	as A1C_Performance_Rate
Into #Temp_Perf_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

Update A1C_TIN
Set A1C_TIN.A1C_Performance_Rate_TIN = TPerf_TIN.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN
Left Join #Temp_Perf_TIN TPerf_TIN on
A1C_TIN.ACO_GroupTIN = TPerf_TIN.ACO_GroupTIN

-------------------
-- Performance_NPI
-------------------
Select 
  NPI
, CCLF_Functions.dbo.Divide_Return0(
  A1C_Pass_Rate_NPI, 
  A1C_Completion_Rate_NPI)	as A1C_Performance_Rate
Into #Temp_Perf_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

Update A1C_NPI
Set A1C_NPI.A1C_Performance_Rate_NPI = TPerf_NPI.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join #Temp_Perf_NPI TPerf_NPI on
A1C_NPI.NPI = TPerf_NPI.NPI

Update A1C_NPI
Set A1C_NPI.A1C_Performance_Rate_TIN = TPerf_TIN.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join #Temp_Perf_TIN TPerf_TIN on
A1C_NPI.ACO_GroupTIN = TPerf_TIN.ACO_GroupTIN

-------------------
-- Performance_ACO
-------------------
Select 
  GroupName
, CCLF_Functions.dbo.Divide_Return0(
  A1C_Pass_Rate_ACO
, A1C_Completion_Rate_ACO)	as A1C_Performance_Rate
Into #Temp_Perf_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

Update A1C_ACO
Set A1C_ACO.A1C_Performance_Rate_ACO = TPerf_ACO.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO
Left Join #Temp_Perf_ACO TPerf_ACO on
1=1

-------------------
-- Performance_MDI
-------------------
Select 
  GroupName
, CCLF_Functions.dbo.Divide_Return0(
  A1C_Pass_Rate_MDI
, A1C_Completion_Rate_MDI)	as A1C_Performance_Rate
Into #Temp_Perf_MDI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI A1C_MDI

Update A1C_MDI
Set A1C_MDI.A1C_Performance_Rate_MDI = TPerf_MDI.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI A1C_MDI
Left Join #Temp_Perf_MDI TPerf_MDI on
1=1

--=====================
-- Over_Under Percent
--=====================
Declare @A1C_Performance_Rate_ACO as Float

Set @A1C_Performance_Rate_ACO = 
	(Select 
	 A1C_Performance_Rate_ACO 
	 From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO)
--------------------------------
-- NPI Over Performance Percent
--------------------------------
Update NPI
Set 
  A1C_Performance_NPI_Over_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	  (A1C_Performance_Rate_NPI - @A1C_Performance_Rate_ACO)
	, @A1C_Performance_Rate_ACO) * 1000
	, A1C_Performance_NPI_Over_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	  (A1C_Performance_Rate_NPI - A1C_Performance_Rate_TIN)
	,  A1C_Performance_Rate_TIN) * 1000
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
