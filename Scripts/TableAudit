4140,2026-07-06T15:32:59.689743,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_134_3_DEP_Calculations,"
Create Procedure procCompensation_PYCurrent_10_134_3_DEP_Calculations
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Set		@SelectType				= 'Current'

Drop Table if Exists #Temp_Complete_NPI
Drop Table if Exists #Temp_Complete_TIN
Drop Table if Exists #Temp_Complete_ACO

Drop Table if Exists #Temp_Performance_NPI
Drop Table if Exists #Temp_Performance_TIN
Drop Table if Exists #Temp_Performance_ACO

Drop Table if Exists #Temp_Perf_NPI
Drop Table if Exists #Temp_Perf_TIN
Drop Table if Exists #Temp_Perf_ACO

Drop Table if Exists #Temp_Over_NPI

--=======================================
-- Calculate Completion Rate
-- Calculate Performance Rate
-- Calculate % Above ACO Average
-- See if Group has a positive Above Average
--=======================================

--============================================
-- Update Completion Percent  (Lookup Values)
-- Update Performance Percent (Lookup Values)
--============================================
------------------------------------------------------
-- Update Pct Constants - NPI
-- Update Compensation_Quarter & Compensaton_Percent
------------------------------------------------------
Update DEP_NPI
Set 
  
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_134_2_2_DEP_Aggregate_NPI DEP_NPI

-------------------------------
-- Update Pct Constants - TIN
-------------------------------
Update DEP_TIN
Set 
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN DEP_TIN

-------------------------------
-- Update Pct Constants - ACO
-------------------------------
Update DEP_ACO
Set 
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_134_2_4_DEP_Aggregate_ACO DEP_ACO

--========================
-- Update Completion Rate
--========================

--=====================
-- Completion Rate
--=====================
-------------------
-- Completion_ACO
-------------------
Update DEP_ACO
Set 
  DEP_ACO.DEP_Completion_Rate_ACO = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Complete_ACO as Float)
		 , DEP_Eligible_ACO
	) 

From Compensation_PYCurrent.dbo.Compensation_10_134_2_4_DEP_Aggregate_ACO DEP_ACO

-------------------------
-- Completion Rate NPI
-------------------------
-- Select * From #Temp_Complete_NPI

Update DEP_NPI
Set 
  DEP_NPI.DEP_Completion_Rate_NPI	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Complete_NPI as Float)
		 , DEP_Eligible_NPI
	)

From Compensation_PYCurrent.dbo.Compensation_10_134_2_2_DEP_Aggregate_NPI DEP_NPI

-------------------------
-- Completion Rate TIN
-------------------------
Update DEP_TIN
Set 
  DEP_TIN.DEP_Completion_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Complete_TIN as Float)
		 , DEP_Eligible_TIN
	)

From Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN DEP_TIN

--=====================
-- Fail Rate
--=====================
-------------------
-- Fail Rate NPI
-------------------
Update NPI
Set NPI.DEP_Fail_Rate_NPI = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Fail_NPI as Float)
		 , DEP_Complete_NPI
	) 
From Compensation_PYCurrent.dbo.Compensation_10_134_2_2_DEP_Aggregate_NPI NPI

-------------------
-- Fail Rate TIN
-------------------
Update TIN
Set TIN.DEP_Fail_Rate_TIN = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Fail_TIN as Float)
		 , DEP_Complete_TIN
	) 
From Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN TIN

-------------------
-- Fail Rate ACO
-------------------
Update ACO
Set ACO.DEP_Fail_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Fail_ACO as Float)
		 , DEP_Complete_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_134_2_4_DEP_Aggregate_ACO ACO

--===================================================
-- Performance Rate
-- NOTE:  Performance Rate is the same as Pass Rate
--===================================================
-------------------
-- Performance_ACO
-------------------
Update DEP_ACO
Set 
  DEP_ACO.DEP_Performance_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Pass_ACO as Float)
	,	   DEP_Complete_ACO
	)
, DEP_ACO.DEP_Pass_Rate_ACO	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Pass_ACO as Float)
	,	   DEP_Complete_ACO
	)
From Compensation_PYCurrent.dbo.Compensation_10_134_2_4_DEP_Aggregate_ACO DEP_ACO

Declare @DEP_Performance_Rate_ACO as Float
Set		@DEP_Performance_Rate_ACO = 
			(Select DEP_Performance_Rate_ACO
			 From Compensation_PYCurrent.dbo.Compensation_10_134_2_4_DEP_Aggregate_ACO)

--------------------------
-- Performance Rate TIN
--------------------------
Update DEP_TIN
Set 
  DEP_TIN.DEP_Performance_Rate_TIN = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Pass_TIN as Float)
		 , DEP_Complete_TIN
	)

, DEP_TIN.DEP_Pass_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Pass_TIN as Float)
		 , DEP_Complete_TIN
	)

, DEP_TIN.DEP_Performance_Rate_ACO	= @DEP_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN DEP_TIN

-------------------------
-- Performance Rate NPI
-------------------------
Update DEP_NPI
Set 
  DEP_NPI.DEP_Performance_Rate_NPI		= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Pass_NPI as Float)
		 , DEP_Complete_NPI
	)

, DEP_NPI.DEP_Pass_Rate_NPI				= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(DEP_Pass_NPI as Float)
		 , DEP_Complete_NPI
	)
, DEP_NPI.DEP_Completion_Rate_TIN		= DEP_TIN.DEP_Completion_Rate_TIN
, DEP_NPI.DEP_Performance_Rate_TIN		= DEP_TIN.DEP_Performance_Rate_TIN
, DEP_NPI.DEP_Performance_Rate_ACO		= @DEP_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_134_2_2_DEP_Aggregate_NPI DEP_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN DEP_TIN on
DEP_NPI.ACO_GroupTIN = DEP_TIN.ACO_GroupTIN

--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  DEP_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  DEP_Performance_Rate_TIN
		, @DEP_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Update NPI
Set 
  DEP_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  DEP_Performance_Rate_NPI
		, DEP_Performance_Rate_TIN
		)

, DEP_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		    DEP_Performance_Rate_NPI
		  , @DEP_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_134_2_2_DEP_Aggregate_NPI NPI

--=========================
-- Over Group Flag
-- Performance_Rate_Base
--=========================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.DEP_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.DEP_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
, TIN.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.DEP_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.DEP_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.DEP_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.DEP_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_134_2_2_DEP_Aggregate_NPI NPI


End 
