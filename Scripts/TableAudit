, ACO_GroupTinName
, ACO_GroupTin
, BENE_NPI_2_Group					-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_NPI_2_TINName				-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_NPI_2_TIN					-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, ACO.ACO_NPI_RLS_Email as BENE_RLS_Email
, CCM.ccmSeat
, CCM.ccmSeat_FullName
, ACO_BENE.AlignmentFlag_CBA		-- Added 5/22/2024
, ACO_BENE.IN_VA_MAX				-- Added 5/22/2024
from #Temp_Bene T1
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
