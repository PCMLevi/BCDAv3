-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_8_3_4_CreateBeneficiaries_Unique
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	-----------------------------------------------------------------------
-- This will create a new table of ALL UNIQUE Beneficiaries 
-- Attributed since the start of data.
--
-- Change Last Attributed to Year Quarter when new Q1 Data comes out.
-- ***** Change in Database Constants Import_Export Table *****
-----------------------------------------------------------------------
Declare @SelectedType	as Varchar(15)
Declare @FiscalYear		as Varchar(6)
Declare @YearQuarter	as Varchar(6)
Declare @LastAttributed as char(7)
Declare @StartTime		as Datetime
Declare @StopTime		as Datetime
Declare @msgString		as Varchar(max)

Set @SelectedType		= 'Current'
Set @YearQuarter		= (Select YearQuarter From Database_Constants.dbo.Quarterly_Automated)--FiscalYear = @FiscalYear)
Set @FiscalYear			= (Select FiscalYear From Database_Constants.dbo.Quarterly_Automated)--FiscalYear = @FiscalYear)
Set @LastAttributed		= (Select YearQuarter From Database_Constants.dbo.Quarterly_Automated) --yearquarter until we decide how to automate lastattributed--

Drop Table if exists #Temp_Bene
Drop Table if exists #Temp_HCC
Drop Table if exists #Temp_Sum_RiskScore
Drop Table if exists #Temp_MaxClaimDate
Drop Table if exists #Temp_BENE_GEO
Drop Table if exists #Temp_Max_CLM_Date
Drop Table if exists #Temp_Last_AWV

Set @StartTime = GetDate()

Truncate Table CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique

-------------------------------------------------------------------------
-- Last Attributed Quarter is used for the following condition:
-- When we receive Q4, we copy Q4 to Q1 so we can start getting
-- data (information) for the new year.
--
-- Last Attributed is used when we create ACO_Beneficiaries_Unique.
-- We do not want Q1 Attribution to be in ACO_Beneficiaries until
-- we get the REAL Q1 Attribution File in May.
-------------------------------------------------------------------------

Select  
  BENE_HIC_NUM
, Max(BENE_YearQuarter) as LastAttributed
Into #Temp_Bene
from CCLF_LookupTables.dbo.ACO_Beneficiaries
Where
BENE_YearQuarter <= @LastAttributed		
Group by
  BENE_HIC_NUM
Order by
BENE_HIC_NUM

Set @StopTime	= GetDate()
Set @MsgString = 'Max BENE_YearQuarter Found Complete - ' + Cast(DateDiff(ss, @StartTime, @StopTime) as varchar) + ' Seconds'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

--------------------------------------
-- Insert Records into Table
--------------------------------------
Set @StartTime = GetDate()

Insert into CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique
(
  BENE_MasterID
, BENE_MasterID_From
, MasterID_Key
, BENE_HICN_Link
, BENE_HIC_NUM
, BENE_MBI
, BENE_HIC_NUM_Old
, BENE_HIC_NUM_Previous
