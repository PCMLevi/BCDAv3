NPI.ACO_GroupTIN = TIN_MDI.ACO_GroupTIN


--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

--------------------------------
-- TIN_MDI Over Percents
--------------------------------
Update TIN_MDI
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @A1C_Performance_Rate_ACO_MDI
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN_MDI TIN_MDI

--------------------------------
-- NPI Over Percents
--------------------------------
Select 
  A1C_Performance_Rate_NPI
, A1C_Performance_Rate_TIN
, CCLF_Functions.dbo.Percent_Over
	(
	Cast(A1C_Performance_Rate_NPI as float)
	   , A1C_Performance_Rate_TIN
	) As A1C_Preformance_Rate_NPI_Over_TIN
, CCLF_Functions.dbo.Percent_Over
	(
	Cast(A1C_Performance_Rate_NPI as float)
	   , A1C_Performance_Rate_ACO
	) As A1C_Preformance_Rate_NPI_Over_ACO
Into #Temp_Over_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

Update NPI
Set 
  A1C_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, A1C_Performance_Rate_TIN
		)

, A1C_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

--=====================
-- Over Group Flag
--=====================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

-----------------------
-- TIN_MDI Over ACO Flag
-----------------------
Update TIN_MDI
Set 
  TIN_MDI.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN_MDI.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN_MDI TIN_MDI


----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
