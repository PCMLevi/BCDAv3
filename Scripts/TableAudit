Select Distinct					-- Added distinct and took out Attribution year for when the last quarter is duplicated for the
								-- new year data.
  ACO_BENE.BENE_MasterID
, ACO_BENE.BENE_MasterID_From
, ACO_BENE.MasterID_Key
, Trim(ACO_BENE.BENE_LastName) + ', ' + 
  Trim(ACO_BENE.BENE_FirstName) + ' - ' + 
  Cast(ACO_BENE.BENE_BirthDate as VarChar)		-- vst Added 10/24/2025
, Trim(T1.BENE_HIC_NUM)			-- vst Added Trim 4/20/22 because somewhere there is a trailing blank on some BENE_HIC_NUMS
, ACO_BENE.BENE_MBI
, ACO_BENE.BENE_HIC_NUM_Old
, ACO_BENE.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_HIC_NUM_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT
, T1.LastAttributed
, ACO_BENE.BENE_LastName
, ACO_BENE.BENE_FirstName
, Trim(ACO_BENE.BENE_LastName) + ', ' + Trim(ACO_BENE.BENE_FirstName) as BENE_FullName
, ACO_BENE.BENE_BirthDate
, ACO_BENE.BENE_DeathDate
, Case 
	When BENE_DeathDate is null		Then DateDiff(year, ACO_BENE.BENE_BirthDate, GetDate())
	When BENE_DeathDate > '1/1/1900'	Then DateDiff(year, ACO_BENE.BENE_BirthDate, ACO_BENE.BENE_DeathDate)
  END as BENE_Age
, Case
	When ACO_BENE.BENE_Sex = '1' Then 'Male'
	When ACO_BENE.BENE_Sex = '2' Then 'Female'
	Else 'Unknown'
  End
, ACO_BENE.BENE_CMSRiskScoreType
, ACO_BENE.BENE_CMSRiskScore
, ACO_BENE.BENE_DemoRiskScore
, ACO_BENE.BENE_DemoRiskScoreType
, ACO_BENE.BENE_NPI_Number
, ACO_BENE.BENE_NPI_LastName
, ACO_BENE.BENE_NPI_FirstName
, ACO_BENE.BENE_NPI_2_Number		-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
