-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
ALTER PROCEDURE [dbo].[Run_All_CCLF_Import]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    set xact_abort on
--set noexec on 
DECLARE 
        @CurrentProc      SYSNAME,
        @StartTime        DATETIME2,
        @MedicareFileDate Date,
        @RunID            varchar(15),
        @JobName          varchar(100),
        @MainJobName      varchar(100),
        @JobStartTime     DATETIME2,
        @JobEndTime       DATETIME2,
        @TotalSeconds     INT,
        @JobRunTime       varchar(8);

    set @MedicareFileDate = (select medicarefiledate from Database_Constants.dbo.Import_Export_Automated) 
    set @MainJobName      = 'dbo.Run_All_CCLF_Import'
    set @RunID            = (select RunID  from Database_Constants.dbo.Import_Export_Automated)
    set @JobStartTime     = SYSDATETIME()

print(concat('MedicareFileDate: ',@MedicareFileDate))
print(concat('JobName: ',@JobName))
print(concat('RunID: ',@RunID))

    BEGIN TRY
    --begin tran

        --EXEC dbo.Run_07_to_15_5_CCLF_Procedures;
        --
        --EXEC dbo.Run_Import_8_1_through_9_Job;
        --
        --EXEC dbo.Run_10_to_18_CCLF_Procedures;
        
        if MONTH(@MedicareFileDate) <= 7
        BEGIN
            EXEC dbo.Run_CostUtilization_PRVS_Year_Procedures;
        
            EXEC dbo.Run_CostUtilization_BIG_PRVS_Year_Procedures;
        END
        
        EXEC dbo.Run_CostUtilization_Procedures;
        
        EXEC dbo.Run_CostUtilization_BIG_Procedures;
        
        EXEC dbo.Run_Rim_Score_Procedures;


set @JobEndTime = SYSDATETIME()

set @TotalSeconds = DATEDIFF(SECOND, @JobStartTime, @JobEndTime)

SET @JobRunTime =
    CASE 
        WHEN @TotalSeconds >= 86400 THEN
            CAST(@TotalSeconds / 86400 AS VARCHAR) + 'd ' +
            RIGHT('0' + CAST((@TotalSeconds % 86400) / 3600 AS VARCHAR), 2) + ':' +
            RIGHT('0' + CAST(((@TotalSeconds % 86400) % 3600) / 60 AS VARCHAR), 2) + ':' +
            RIGHT('0' + CAST(@TotalSeconds % 60 AS VARCHAR), 2)
        ELSE
            RIGHT('0' + CAST(@TotalSeconds / 3600 AS VARCHAR), 2) + ':' +
            RIGHT('0' + CAST((@TotalSeconds % 3600) / 60 AS VARCHAR), 2) + ':' +
            RIGHT('0' + CAST(@TotalSeconds % 60 AS VARCHAR), 2)
    END


UPDATE Master.dbo.CCLFExecutionLog
set MainJobName = @MainJobName
where RunID = @RunID
  and Status      = 'Success'

UPDATE Master.dbo.CCLFExecutionLog
SET TotalRunTime = @JobRunTime
,TotalStart      = @JobStartTime 
,TotalEnd        = @JobEndTime 
WHERE RunID = @RunID
  AND MainJobName = @MainJobName 
  and Status      = 'Success'

--commit tran
end try 
begin catch

--If @@TRANCOUNT > 0
 --rollback tran

        INSERT Master.dbo.CCLFExecutionLog
        (
            RunID,
            MedicareFileDate,
            MainJobName,
            JobName,
            StartTime,
            EndTime,
            Status,
            ErrorNumber,
            ErrorMessage
        )
        VALUES
        (
            @RunID,
            @MedicareFileDate,
            @MainJobName,
            @JobName,
            @StartTime,
            SYSDATETIME(),
            'Failed',
            ERROR_NUMBER(),
            ERROR_MESSAGE()
        );
    throw

end catch
--set noexec off
set xact_abort off
END
