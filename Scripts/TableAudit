Create Procedure dbo.procCompensation_PYCurrent_10_112_2_BCS_Aggregate
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN


Delete From Compensation_PYCurrent.dbo.Compensation_10_112_2_1_BCS_Aggregate_BENE
Delete From Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI
Delete From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN
Delete From Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO

Drop Table If Exists #Temp_Base
Drop Table If Exists #Temp_ACO
Drop Table If Exists #Temp_TIN
Drop Table if Exists #Temp_NPI
Drop Table if Exists #Temp_NPIPercent
Drop Table if Exists #Temp_TINPercent


--=============================
-- Aggregate to BENE Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_112_2_1_BCS_Aggregate_BENE
(
  Compensation_Quarter
, Compensation_Percent
, NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, BCS_Eligible
, BCS_Complete
, BCS_Met
, BCS_NotMet
, BCS_UnReported
, BCS_Pass
, BCS_Fail
, SQLRunDate_MDI_BCS
, SQLRunDate
)

Select Distinct 
  @YearQuarter
, @CompensationPercent
, NPI
, NPI_FullName
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, 1						as NumBENE_BENE
, BCS_Eligible
, BCS_Complete
, BCS_Met
, BCS_NotMet
, BCS_UnReported
, BCS_Pass
, BCS_Fail
, SQLRunDate_MDI_BCS
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_112_1_BCS_ByBENE BCS

-- Select * From Compensation_PYCurrent.dbo.Compensation_10_112_2_BCS_Aggregate_BENE

--=============================
-- Aggregate to ACO Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO
(
  Compensation_Quarter
, Compensation_Percent
, GroupName
, PY_ACO
, NumBENE_ACO
, BCS_Eligible_ACO
, BCS_Complete_ACO
, BCS_Met_ACO
, BCS_NotMet_ACO
, BCS_UnReported_ACO
, BCS_Pass_ACO
, BCS_Fail_ACO
, SQLRunDate_MDI_BCS
, SQLRunDate
)
Select
  @YearQuarter
, @CompensationPercent
, 'ACO'
, Sum(PY_BENE)
, Sum(numBENE_BENE)
, Sum(BCS_Eligible)
, Sum(BCS_Complete)
, Sum(BCS_Met)
, Sum(BCS_NotMet)
, Sum(BCS_UnReported)
, Sum(BCS_Pass)
, Sum(BCS_Fail)
, Max(SQLRunDate_MDI_BCS)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_112_1_BCS_ByBENE BCS

--=============================
-- Aggregate to TIN Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN
(
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, BCS_Eligible_TIN
, BCS_Complete_TIN
, BCS_Met_TIN
, BCS_NotMet_TIN
, BCS_UnReported_TIN
, BCS_Pass_TIN
, BCS_Fail_TIN
, SQLRunDate_MDI_BCS
, SQLRunDate
