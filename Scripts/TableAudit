Select 
  T5.MedicareFileDate
, T3.LastAttributedQuarter
, T6.BENE_MBI_ID
, T2.BENE_HIC_NUM
, T6.BENE_FIPS_STATE_CD
, T6.BENE_FIPS_STATE
, T6.BENE_FIPS_CNTY_CD
, T6.BENE_FIPS_CNTY
, T6.BENE_ZIP_CD
, T6.BENE_DOB
