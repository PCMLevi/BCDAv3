3777,2026-06-25T08:59:34.874676,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_0_A1C_ByMDI,"
Create Procedure dbo.procCompensation_PYCurrent_10_001_0_A1C_ByMDI
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
	, @MDI_Download_DT		as Date
)
AS
BEGIN

Declare @SelectType		as Varchar(15)
Declare @MeasureNumber	as Varchar(3)
Declare @MeasureName	as Varchar(255)
Declare @MeasureAbbr	as Varchar(5)

Set		@MeasureNumber		= '001'
Set		@SelectType			= @CompensationYear
Set		@MeasureAbbr		= (Select A1C_Abbr From Database_Constants.dbo.Mips Where SelectType = @SelectType and A1C_Number = @MeasureNumber)
Set		@MeasureName		= (Select A1C_Name From Database_Constants.dbo.Mips Where SelectType = @SelectType and A1C_Number = @MeasureNumber)

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_0_A1C_ByMDI

--Select @SelectType as SelectType, @MeasureAbbr as MeasureAbbr

Insert into Compensation_PYCurrent.dbo.Compensation_10_001_0_A1C_ByMDI
( ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_Fullname
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, PY_BENE
, numBENE_BENE
, MeasureNumber
, MeasureName
, MeasureAbbr
, A1C_Performance
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, A1C_Eligible
, A1C_Complete
, A1C_Reading
, A1C_Reading_DT
, SQLRunDate_MDI_A1C
, SQLRunDate
)

Select 
  MDI_GroupTin
, Case
		When MDI_GroupTin = '900088197'
		Then 'Phynet' 
		Else MDI_GroupTinName 
	End


, MDI_NPI
, MDI_NPI_LastName + ', ' + MDI_NPI_FirstName
, MDI_HICN
, MDI_HICN_Previous
, Cast(0 as Float)			As BENE_PY
, 1
, @MeasureNumber
, @MeasureName
, @MeasureAbbr
, MDI_Performance
, Case 
	When MDI_Performance = 'Met'
	Then 1
	Else 0
	End as A1C_Met
, Case 
	When MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as A1C_NotMet
, Case 
	When MDI_Performance = 'UnReported'
	Then 1
	Else 0
	End as A1C_UnReported
, Case
	When MDI_Performance = 'Not Met'
	Then 1
	Else 0
	End as A1C_Pass
, Case
	When MDI_Performance = 'Met'
	Then 1
	Else 0
	End as A1C_Fail
, Case 
	When MDI_Eligible = 'Yes' 
	Then 1
	Else 0
	End as A1C_Eligible
, Case 
	When MDI_Performance In ('Met','Not Met')
	Then 1
	Else 0
	End as A1C_Complete
, MDI_A1C_Reading
, MDI_Reading_Date
, SQLRunDate_MDI_A1C
, GetDate()
From 
Compensation_PYCurrent.dbo.Compensation_00_5_001_MDInteractive_A1C MDI_A1C

End"
