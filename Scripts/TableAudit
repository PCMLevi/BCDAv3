, LOS.ACO_GroupTinShortName			= cu.ACO_GroupTinShortName
, LOS.ACO_GroupTin					= cu.ACO_GroupTin
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Inner Join
