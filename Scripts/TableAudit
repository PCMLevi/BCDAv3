, @MeasureNumber
, @MeasureName
, @MeasureAbbr
, MDI_Performance
, Case
	When MDI_Performance =  'Not Met'		Then 'NotMet'
	When MDI_Performance =  'Met'			Then 'Met'
	When MDI_Performance =  'Unreported'	Then 'UnReported'
	Else										 'UnReported'
	End as A1C_Result
, MDI_A1C_Reading
, MDI_Reading_Date
, SQLRunDate_MDI_A1C
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join Compensation_PYCurrent.dbo.Compensation_00_5_001_MDInteractive_A1C A1C on
ACO_BENE.BENE_HIC_NUM = A1C.MDI_HICN

