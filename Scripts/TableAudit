2867,2026-06-13T13:06:41.511395,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_3_ReAdmit_Calculations,"
Create Procedure procCompensation_PYCurrent_06_1_3_ReAdmit_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--====================================================
-- Calculate Hospital ReAdmit Percent 
-- Calculate Hospital ReAdmit Average
-- Calculate Hospital ReAdmit Percent Over_Under
--====================================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Percent (Average)
--=========================
Declare @Average_ACO as Float

Set @Average_ACO = 
(Select CCLF_Functions.dbo.Divide_Return0(ReAdmit_VisitCount_ACO, Hospital_VisitCount_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO ACO)

Update ACO
Set ReAdmit_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO ACO

--=========================
-- TIN Percent (Average)
--=========================
Update TIN
Set 
  TIN.ReAdmit_Average_TIN = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	  TIN.ReAdmit_VisitCount_TIN
	, TIN.Hospital_VisitCount_TIN)
, TIN.ReAdmit_Percent_TIN = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	  TIN.ReAdmit_VisitCount_TIN
	, TIN.Hospital_VisitCount_TIN)
, TIN.ReAdmit_Average_ACO = @Average_ACO
from Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

Update TIN
Set 
TIN.ReAdmit_TIN_OverUnder_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (TIN.ReAdmit_Average_TIN 
	- TIN.ReAdmit_Average_ACO)
	, TIN.ReAdmit_Average_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

Update NPI
Set 
NPI.ReAdmit_Average_TIN = TIN.ReAdmit_Average_TIN
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN

Update TIN
Set 
ReAdmit_Positive_Flag_TIN = 
	Case
		When TIN.ReAdmit_TIN_OverUnder_ACO >= 0
		Then 0
		Else 1
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

--=========================
-- NPI Percent (Average)
--=========================
Update NPI
Set 
  NPI.ReAdmit_Percent_NPI = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	  NPI.ReAdmit_VisitCount_NPI
	, NPI.Hospital_VisitCount_NPI)
, NPI.ReAdmit_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI

Update NPI
Set 
  NPI.ReAdmit_NPI_OverUnder_TIN = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	 (NPI.ReAdmit_Percent_NPI 
	- NPI.ReAdmit_Average_TIN)
	, NPI.ReAdmit_Average_TIN)
, NPI.ReAdmit_NPI_OverUnder_ACO = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	 (NPI.ReAdmit_Percent_NPI 
	- NPI.ReAdmit_Average_ACO)
	, NPI.ReAdmit_Average_ACO)
from Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI

Update NPI
Set 
  ReAdmit_Positive_Flag_TIN = 
	Case
		When NPI.ReAdmit_NPI_OverUnder_TIN >= 0
		Then 0
		Else 1
	End
, ReAdmit_Positive_Flag_NPI = 
	Case
		When NPI.ReAdmit_NPI_OverUnder_ACO >= 0
		Then 0
		Else 1
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI

End
