, Sum(A1C_BENE.A1C_Eligible)
, Sum(A1C_BENE.A1C_Complete)
, Sum(A1C_BENE.A1C_Met)
, Sum(A1C_BENE.A1C_NotMet)
, Sum(A1C_BENE.A1C_UnReported)
, Sum(A1C_BENE.A1C_Pass)
, Sum(A1C_BENE.A1C_Fail)
, Max(SQLRunDate_MDI_A1C)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_2_0_A1C_Aggregate_MDI A1C_BENE
Group By
  ACO_GroupTIN
, ACO_GroupTINName_New

--=============================
-- Aggregate to NPI Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_NPI
, NumBENE_NPI
, A1C_Eligible_NPI
, A1C_Complete_NPI
, A1C_Met_NPI
, A1C_NotMet_NPI
, A1C_UnReported_NPI
, A1C_Pass_NPI
, A1C_Fail_NPI
, SQLRunDate_MDI_A1C
, SQLRunDate
)
Select
  ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, Sum(ACO_BENE.BENE_PY)
, Sum(A1C_BENE.numBENE_BENE)
, Sum(A1C_BENE.A1C_Eligible)
, Sum(A1C_BENE.A1C_Complete)
, Sum(A1C_BENE.A1C_Met)
, Sum(A1C_BENE.A1C_NotMet)
, Sum(A1C_BENE.A1C_UnReported)
, Sum(A1C_BENE.A1C_Pass)
, Sum(A1C_BENE.A1C_Fail)
, Max(SQLRunDate_MDI_A1C)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE 
Left Join
Compensation_PYCurrent.dbo.Compensation_10_001_2_1_A1C_Aggregate_BENE A1C_BENE on
ACO_BENE.BENE_HIC_NUM = A1C_BENE.BENE_HIC_NUM
Group By
  ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New

End"
3875,2026-06-27T17:47:37.484875,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_4_A1C_Bonus_MDI,"
Create Procedure procCompensation_PYCurrent_10_001_4_A1C_Bonus_MDI
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
	, @CompletionPercent	as Float
	, @PerformancePercent	as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Declare @A1C_Bonus_Allotment	as float

Set @SelectType = 'Current'
Set @A1C_Bonus_Allotment = (Select A1C_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN_MDI

Select 
  @CompletionPercent	as ComplPct
, @PerformancePercent	as PerfPct
, @A1C_Bonus_Allotment	As A1C_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @A1C_Performance_Rate_ACO_MDI as Float	
Set		
@A1C_Performance_Rate_ACO_MDI = 
	(Select A1C_Performance_Rate_MDI
	 From   Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI)

Select @A1C_Performance_Rate_ACO_MDI as PerfRate_ACO_MDI

Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN_MDI
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, Completion_Percent
, Performance_Percent
, A1C_Performance_Rate_TIN
, A1C_Performance_Rate_ACO
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, A1C_Quality_Weight
, A1C_Bonus_Allotment
, SQLRunDate_A1C
)

Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, A1C_Eligible_TIN
, @CompletionPercent
, @PerformancePercent
, A1C_Performance_Rate_TIN
, @A1C_Performance_Rate_ACO_MDI
, A1C_Performance_Rate_TIN_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(  A1C_Performance_Rate_TIN
	, @A1C_Performance_Rate_ACO_MDI
	)
, @A1C_Bonus_Allotment
, SQLRunDate_MDI_A1C
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN_MDI

Update A1C
Set 
A1C_BENE_Weight =
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1 
		--Then NumBENE_TIN * A1C_Quality_Weight
		Then A1C_Eligible_TIN * A1C_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN_MDI A1C

Declare @Total_BENE_Weight as Float
Set		@Total_BENE_Weight = 
		(Select Sum(A1C_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN_MDI)

Update A1C
Set 
  A1C_Bonus_Percent	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then (A1C_BENE_Weight / @Total_BENE_Weight)
		Else 0
	End
, A1C_Total_Weight	= @Total_BENE_Weight
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN_MDI A1C

Update A1C
Set 
  A1C_Bonus_PerTIN	=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End 
, A1C_Bonus_TIN		=  
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment
		Else 0
	End
, A1C_Bonus_PerBENE	= 
	Case
		When A1C_Performance_Flag_TIN_Over_ACO = 1
		--Then (A1C_Bonus_Percent * A1C_Bonus_Allotment) / NumBENE_TIN
		Then (A1C_Bonus_Percent * A1C_Bonus_Allotment) / A1C_Eligible_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN_MDI A1C

------------------------
-- Update SQLRunDate
------------------------
Update A1C
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_2_6_A1C_Bonus_TIN A1C

End
