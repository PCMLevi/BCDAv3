Declare @MeasureNumber	as Varchar(3)
Declare @MeasureName	as Varchar(255)
Declare @MeasureAbbr	as Varchar(5)

Set		@MeasureNumber		= '236'
Set		@SelectType			= @CompensationYear
Set		@MeasureAbbr		= (Select HTN_Abbr From Database_Constants.dbo.Mips Where SelectType = @SelectType and HTN_Number = @MeasureNumber)
Set		@MeasureName		= (Select HTN_Name From Database_Constants.dbo.Mips Where SelectType = @SelectType and HTN_Number = @MeasureNumber)

