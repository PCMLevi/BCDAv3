, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY
, 1						As NumBENE_BENE
, Hosp.CLM_FROM_DT		
, Hosp.CLM_THRU_DT		
, Case 
	When Hosp.CLM_THRU_DT is not null 
	Then 1
	Else 0
  End			as Hospital_VisitCount
, Hosp.CLM_PMT_AMT						as HospPaid
, Hosp.FAC_FacilityName
, ReAdmit.raCLM_FROM_DT_Previous
, ReAdmit.raCLM_THRU_DT_Previous
, ReAdmit.raCLM_FROM_DT_Current 
, ReAdmit.raCLM_THRU_DT_Current
, Case
	When ReAdmit.raCLM_THRU_DT_Current is not null
	Then 1
	Else 0
  End as ReAdmitVisit_Count
, ReAdmit.raPaid_Current				as ReAdmitPaid
, ReAdmit.raFacility_Current
, SQLRunDate_Hosp
, SQLRunDate_ReAdmit
, GetDate()
from Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_06_1_1_Hospital_ByBENE Hosp on
ACO_BENE.BENE_HIC_NUM = Hosp.BENE_HIC_NUM
Left Join
Compensation_PYCurrent.dbo.Compensation_06_2_1_ReAdmit_ByBENE ReAdmit on
	ACO_BENE.BENE_HIC_NUM	= ReAdmit.BENE_HIC_NUM
and ACO_BENE.BENE_HIC_NUM	= Hosp.BENE_HIC_NUM
and Hosp.BENE_HIC_NUM		= ReAdmit.BENE_HIC_NUM
and Hosp.CLM_THRU_DT		= ReAdmit.raCLM_THRU_DT_Previous
and Hosp.CUR_CLM_UNIQ_ID	= ReAdmit.raCUR_CLM_UNIQ_ID_Previous
Where
hosp.CLM_FROM_DT is not null

End
