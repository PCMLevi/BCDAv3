LOS.losCostUtilizationID = CU.cmId
Left Join
NPPES.dbo.NPI_CCLFSpecific CCLF_NPI on
Left(CU.Doctor_NPI_Name,10) = CCLF_NPI.NPI

Set @MsgString = 'LOS Update Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

-------------------------------------------------------------------
-- Update LOS_RANGE
------------------------------------------------------------------
-- I had to Update each Range separately with the Where clause
-- because the case statement overwrote previous values
------------------------------------------------------------------
Update LOS
Set 
  LOS_Range_30	= Null
, LOS_Range_60	= Null
, LOS_Range_99	= Null
, LOS_Range_199	= Null
, LOS_Range_299 = Null
, LOS_Range_300 = Null
From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Set @MsgString = 'LOS Set to Null Complete'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

Update LOS
Set LOS_Range_30 = losNumberDays
From CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS
Where
losNumberDays between 1 and 30
Set @MsgString = 'LOS Range 30 Complete'
