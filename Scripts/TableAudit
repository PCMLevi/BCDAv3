set CLM_Query = ss.supportingInfo_code_display
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on bt.Claim_ID = ss.claim_id
where supportingInfo_category_code = 'clm_query_cd'

update BCDA_Data.dbo.EOB_Base_v3
set Discharge_Status = lt.description
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on bt.Claim_ID = ss.claim_id
inner join [BCDA_Staging].[dbo].[blueButton_LookupTable] lt
on ss.supportingInfo_code = lt.value
where supportingInfo_category_code = 'discharge-status'

update BCDA_Data.dbo.EOB_Base_v3
set IDR_Load_Date = ss.timingDate
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on bt.Claim_ID = ss.claim_id
where supportingInfo_category_code = 'CLM_IDR_LD_DT' 
END
