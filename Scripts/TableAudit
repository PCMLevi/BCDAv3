5633,2026-08-12T14:32:59.953297,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_30_3_MonthlyEligibility,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_30_3_MonthlyEligibility
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	---------------------------------------------------------------------------
-- This file will calculate the Person Years for each beneficiary so
-- We can more accurately predict PMPM
---------------------------------------------------------------------------
Drop Table if exists #Temp1

Declare @SelectType			as Varchar(15)
Declare @YearQuarter		as char(6)

Set		@SelectType			= 'Current'
Set		@YearQuarter		= (Select YearQuarter From Database_Constants.dbo.Quarterly_Automated)

Delete from CCLF_LookupTables.dbo.Q1_MonthlyEligibility 
--Where Q1_YearQuarter = @YearQuarter

Select 
  Q1_YearQuarter
, Q1_HICN
, Count(MonthlyEligibilityFlag1) as TotalRecords
, Sum(Case When MonthlyEligibilityFlag1  = 0 Then 1 Else 0 End) as NotEligibleFlag1
, Sum(Case When MonthlyEligibilityFlag2  = 0 Then 1 Else 0 End) as NotEligibleFlag2
, Sum(Case When MonthlyEligibilityFlag3  = 0 Then 1 Else 0 End) as NotEligibleFlag3
, Sum(Case When MonthlyEligibilityFlag4  = 0 Then 1 Else 0 End) as NotEligibleFlag4
, Sum(Case When MonthlyEligibilityFlag5  = 0 Then 1 Else 0 End) as NotEligibleFlag5
, Sum(Case When MonthlyEligibilityFlag6  = 0 Then 1 Else 0 End) as NotEligibleFlag6
, Sum(Case When MonthlyEligibilityFlag7  = 0 Then 1 Else 0 End) as NotEligibleFlag7
, Sum(Case When MonthlyEligibilityFlag8  = 0 Then 1 Else 0 End) as NotEligibleFlag8
, Sum(Case When MonthlyEligibilityFlag9  = 0 Then 1 Else 0 End) as NotEligibleFlag9
, Sum(Case When MonthlyEligibilityFlag10 = 0 Then 1 Else 0 End) as NotEligibleFlag10
, Sum(Case When MonthlyEligibilityFlag11 = 0 Then 1 Else 0 End) as NotEligibleFlag11
, Sum(Case When MonthlyEligibilityFlag12 = 0 Then 1 Else 0 End) as NotEligibleFlag12
Into #Temp1
from CCLF_LookupTables.dbo.QASSGN_Table1_1
Where Q1_YearQuarter = @YearQuarter
Group by
  Q1_YearQuarter
, Q1_HICN

Insert into CCLF_LookupTables.dbo.Q1_MonthlyEligibility
( 
  Q1_YearQuarter
, Q1_HICN
, Q1_MBI
, Q1_BENEMonths
, Q1_NotEligible
)

Select 
  Q1_YearQuarter
, Q1_HICN
, Null
, TotalRecords * 12
, NotEligibleFlag1 
+ NotEligibleFlag2
+ NotEligibleFlag3
+ NotEligibleFlag4
+ NotEligibleFlag5
+ NotEligibleFlag6
+ NotEligibleFlag7
+ NotEligibleFlag8
+ NotEligibleFlag9
+ NotEligibleFlag10
+ NotEligibleFlag11
+ NotEligibleFlag12 as NotEligible
from #Temp1

-------------------------------------------------------------
-- Update Person Years in QASSGN_Table1_1
-------------------------------------------------------------
Update Q1
Set Q1_PersonYears = Str(((Q1Month.Q1_BENEMonths - Q1Month.Q1_NotEligible) / 12), 12,3)
from CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
Inner Join
CCLF_LookupTables.dbo.Q1_MonthlyEligibility Q1Month on
	Q1.Q1_YearQuarter	= Q1Month.Q1_YearQuarter
and Q1.Q1_HICN			= Q1Month.Q1_HICN

-------------------------------------------------------------
-- Update Person Years in ACO_Beneficiaries
-------------------------------------------------------------
Update ACO_BENE
Set ACO_BENE.BENE_PersonYears = Q1.Q1_PersonYears
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1 on
ACO_BENE.BENE_HIC_NUM = Q1.Q1_HICN
Where
	BENE_YearQuarter			= @YearQuarter
and Q1.Q1_YearQuarter			= @YearQuarter
and ACO_BENE.BENE_PersonYears	is null

END
