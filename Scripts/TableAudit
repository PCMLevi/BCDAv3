	When MarginBENE.ACO_GroupTin = '900088197'
	Then 'Phynet' 
	Else MarginBENE.ACO_GroupTinName End As ACO_GroupTINName_New
, MarginBENE.NPI
, MarginBENE.NPI_Fullname
, MarginBENE.BENE_PY
, MarginBENE.BENE_HIC_NUM
, MarginBENE.BENE_Fullname
, MarginBENE.BENE_Budget
, MarginBENE.BENE_Expenditures
, MarginBENE.BENE_Margin
, MarginNPI.NPI_Margin
, MarginNPI.NPI_Margin_Positive
, MarginBENE.BENE_Margin / MarginNPI.NPI_Margin			as BENE_Margin_Percent_All
, Case 
	When MarginBENE.BENE_Margin > 0 
	Then MarginBENE.BENE_Margin 
	Else 0	End		As BENE_Margin_Positive
, Case
	When MarginBENE.BENE_Margin > 0
	Then 1
	Else 0 End		as BENE_Positive
, NPI_Margin		as NPI_Margin_Total_Positive
, NPI_Margin_Bonus
Into #Temp_BENE_Margin
From Compensation_PYCurrent.dbo.Compensation_03_6_1_Margin_Bonus_ByBENE MarginBENE
Inner Join
Compensation_PYCurrent.dbo.Compensation_03_7_2_Margin_Positive_ByNPI MarginNPI on
MarginBENE.NPI = MarginNPI.NPI

-- Select * From #Temp_BENE_Margin Order by ACO_GroupName, ACO_GroupTINName_New
---------------------------
-- Insert Data Into Table
---------------------------
Insert Into Compensation_PYCurrent.dbo.Compensation_03_7_3_Margin_Positive_ByBENE
(
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupName
, ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_FullName
, BENE_PY
, BENE_HIC_NUM
, BENE_FullName
, BENE_Budget
, BENE_Expenditures
, BENE_Margin
, BENE_Margin_Positive
, NPI_Margin_Total_All
, BENE_Margin_Percent_All
, NPI_Margin_Bonus_Allotment
, BENE_Positive

)

Select 
  @Compensation_Quarter
, @Compensation_Percent
, ACO_GroupName
, ACO_GroupTin
, ACO_GroupTINName_New
, NPI
, NPI_Fullname
, BENE_PY
, BENE_HIC_NUM
, BENE_Fullname
, BENE_Budget
, BENE_Expenditures
, BENE_Margin
, BENE_Margin_Positive
, NPI_Margin
, BENE_Margin_Percent_All
, NPI_Margin_Bonus
, BENE_Positive
From #Temp_BENE_Margin

-- Select * From #Temp_BENE_Margin

Select 
  NPI
, Sum(BENE_Margin) as NPI_Margin_Total_Positive
Into #Temp_NPI_Positive
From Compensation_PYCurrent.dbo.Compensation_03_7_3_Margin_Positive_ByBENE
Where
BENE_Positive = 1
Group By
NPI


-------------------------------------------
-- Update NPI_Margin_Percent_Positive
-------------------------------------------
Update MBENE
Set 
MBENE.NPI_Margin_Total_Positive = TPos.NPI_Margin_Total_Positive
From Compensation_PYCurrent.dbo.Compensation_03_7_3_Margin_Positive_ByBENE MBENE
Inner Join
#Temp_NPI_Positive TPos on
MBENE.NPI = TPos.NPI

-------------------------------------------
-- Update BENE_Margin_Percent_Positive
-------------------------------------------
Update BENEMargin
Set 
BENE_Margin_Percent_Positive =	CCLF_Functions.dbo.Divide_Return0
								(BENE_Margin_Positive, NPI_Margin_Positive)
from Compensation_PYCurrent.dbo.Compensation_03_7_3_Margin_Positive_ByBENE BENEMargin
Inner Join
Compensation_PYCurrent.dbo.Compensation_03_7_2_Margin_Positive_ByNPI NPIMargin on
BENEMargin.NPI = NPIMargin.NPI

-------------------------------------------
-- Update BENE_Margin_New
-------------------------------------------
Update BENEMargin
Set 
BENE_Margin_Positive_New =	BENE_Margin_Percent_Positive * NPI_Margin_Total_Positive
from Compensation_PYCurrent.dbo.Compensation_03_7_3_Margin_Positive_ByBENE BENEMargin
Inner Join
Compensation_PYCurrent.dbo.Compensation_03_7_2_Margin_Positive_ByNPI NPIMargin on
BENEMargin.NPI = NPIMargin.NPI

----------------------------------------------
-- Calculate Bonus for Positive NPIs by NPI
----------------------------------------------
Update NPIBonus
Set 
  ACO_Margin_Bonus_Allotment = @ACO_Margin_Bonus_Allotment
, BENE_Margin_Bonus				= NPI_Margin_Bonus_Allotment * BENE_Margin_Percent_Positive
from Compensation_PYCurrent.dbo.Compensation_03_7_3_Margin_Positive_ByBENE NPIBonus

End"
