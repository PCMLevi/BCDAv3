5618,2026-08-12T13:37:09.923484,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_Create_variables,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_Create_variables
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	

drop table if exists #filelist, #filelistrawqalr, #connectiontable, #variables

declare @tablename varchar(25)
,@namefile varchar(200)
,@FileSizeMB float
,@sql nvarchar(max)
,@dir nvarchar(max)

if @@SERVERNAME in ('PROD-Test', 'PROD-Final')
set @dir = 'E:\SQL\SQLBulkImport\QALR\'
else 
set @dir = 'C:\SQLBulkImport\QALR\'

create table #filelistrawQALR (line nvarchar(max))

create table #variables(fiscalyear varchar(6),yearquarter varchar(6), quarterstart date, quarterstop date, lastattributed varchar(6))

create table #connectiontable (fiscalquarter varchar(1), startdate date, stopdate date)

truncate table Database_Constants.dbo.Quarterly_Automated

set @sql = 
'
insert into #filelistrawQALR
EXEC xp_cmdshell ''powershell -NoProfile -Command ""Get-ChildItem '+@dir+' -File | Select-Object Name, Length | ForEach-Object { $_.Name + ''''|'''' + $_.Length }""''
'

exec(@sql)

CREATE TABLE #filelist (
  Filename VARCHAR(200)
, FilesizeMB FLOAT
)

INSERT INTO #filelist (
	Filename,
	FilesizeMB
	)
SELECT LEFT(line, CHARINDEX('|', line) - 1) AS FileName,
	cast(RIGHT(line, LEN(line) - CHARINDEX('|', line)) AS FLOAT) / 1048576 AS FileSizeMB
FROM #filelistrawQALR
WHERE line IS NOT NULL


insert into Database_Constants.dbo.Quarterly_Automated(
RunID,
FiscalYear,
YearQuarter,
QuarterStart,
QuarterStop
)
select distinct
format(GETDATE(),'yyyyMMddHHmmss')
,concat('FY', LEFT(RIGHT(Filename, 31), 4)) as fiscalyear
,LEFT(RIGHT(Filename, 31), 6) as yearquarter
, case 
	when LEFT(RIGHT(Filename, 27), 2) = 'Q1' then concat(LEFT(RIGHT(Filename, 31), 4), '-01-01')
	when LEFT(RIGHT(Filename, 27), 2) = 'Q2' then concat(LEFT(RIGHT(Filename, 31), 4), '-04-01')
	when LEFT(RIGHT(Filename, 27), 2) = 'Q3' then concat(LEFT(RIGHT(Filename, 31), 4), '-07-01')
	when LEFT(RIGHT(Filename, 27), 2) = 'Q4' then concat(LEFT(RIGHT(Filename, 31), 4), '-10-01')
end as startdate
,CASE
    WHEN LEFT(RIGHT(Filename, 27), 2) = 'Q1' THEN EOMONTH(DATEFROMPARTS(LEFT(RIGHT(Filename, 31), 4), 1, 1), 2)
    WHEN LEFT(RIGHT(Filename, 27), 2) = 'Q2' THEN EOMONTH(DATEFROMPARTS(LEFT(RIGHT(Filename, 31), 4), 4, 1), 2)
    WHEN LEFT(RIGHT(Filename, 27), 2) = 'Q3' THEN EOMONTH(DATEFROMPARTS(LEFT(RIGHT(Filename, 31), 4), 7, 1), 2)
    WHEN LEFT(RIGHT(Filename, 27), 2) = 'Q4' THEN EOMONTH(DATEFROMPARTS(LEFT(RIGHT(Filename, 31), 4), 10, 1), 2)
end as stopdate
from #filelist
where filename not like '%QBEUR%'




END
