3557,2026-06-17T15:09:33.721483,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_05_1_3_EDObs_Calculations,"
Alter Procedure procCompensation_PYCurrent_05_1_3_EDObs_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Declare @ED_Bonus_Allotment as float

Set @SelectType = 'Current'
Set @ED_Bonus_Allotment = (Select EDObs_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN

Select @ED_Bonus_Allotment As ED_Bonus_Allotment

Drop Table if Exists #Temp_PercentPositive

Insert Into Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, EDVisit_TIN
, EDVisit_ACO
, EDVisit_E1000_TIN
, EDVisit_E1000_ACO
, EDVisit_E1000_Average_TIN
, EDVisit_E1000_Average_ACO
, EDVisit_E1000_TIN_Under_ACO
, EDVisit_Flag_TIN_Under_ACO
, ED_Quality_Weight
, ED_Bonus_Allotment
, SQLRunDate_EDobs
)
Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, EDVisit_TIN
, EDVisit_ACO
, EDVisit_E1000_TIN
, EDVisit_E1000_ACO
, EDVisit_E1000_Average_TIN
, EDVisit_E1000_Average_ACO
, EDVisit_E1000_TIN_Under_ACO
, EDVisit_Flag_TIN_Under_ACO
, EDVisit_TIN / PY_TIN
, @ED_Bonus_Allotment
, SQLRunDate_EDObs
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN

Update EDBonus
Set ED_BENE_Weighted = NumBENE_TIN * ED_Quality_Weight
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus
Where
EDVisit_Flag_TIN_Under_ACO = 1

Declare @Total_BENE_Weighted as Float
Set		@Total_BENE_Weighted = 
		(Select Sum(ED_BENE_Weighted)
		From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN)

Update EDBonus
Set 
  ED_Bonus_Percent	= (ED_BENE_Weighted / @Total_BENE_Weighted)
, ED_Total_Weighted = @Total_BENE_Weighted
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus

Update EDBonus
Set 
  ED_Bonus_PerTIN	=  ED_Bonus_Percent * ED_Bonus_Allotment
, ED_Bonus_TIN		=  ED_Bonus_Percent * ED_Bonus_Allotment
, ED_Bonus_PerBENE	= (ED_Bonus_Percent * ED_Bonus_Allotment) / NumBENE_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_4_EDObs_Bonus_TIN EDBonus

End
