Update A1C_TIN
Set 
  A1C_TIN.A1C_Performance_Rate_TIN	= TPerf_TIN.A1C_Performance_Rate_TIN
, A1C_TIN.A1C_Pass_Rate_TIN			= TPerf_TIN.A1C_Performance_Rate_TIN
, A1C_TIN.A1C_Performance_Rate_ACO	= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN
Left Join #Temp_Perf_TIN TPerf_TIN on
A1C_TIN.ACO_GroupTIN = TPerf_TIN.ACO_GroupTIN

-------------------------
-- Performance Rate NPI
-------------------------
Select 
  NPI
, A1C_Pass_NPI
, A1C_Complete_NPI
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)	as A1C_Performance_Rate_NPI
Into #Temp_Perf_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

Update A1C_NPI
Set 
  A1C_NPI.A1C_Performance_Rate_NPI		= TPerf_NPI.A1C_Performance_Rate_NPI
, A1C_NPI.A1C_Pass_Rate_NPI				= TPerf_NPI.A1C_Performance_Rate_NPI
, A1C_NPI.A1C_Performance_Rate_ACO		= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join #Temp_Perf_NPI TPerf_NPI on
A1C_NPI.NPI = TPerf_NPI.NPI

--------------------------------
-- Performance Rate TIN In NPI
-------------------------
Update NPI
Set 
NPI.A1C_Performance_Rate_TIN		= TIN.A1C_Performance_Rate_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI
Left Join Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN


--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Select 
  A1C_Performance_Rate_NPI
, A1C_Performance_Rate_TIN
, CCLF_Functions.dbo.Percent_Over
	(
	Cast(A1C_Performance_Rate_NPI as float)
	   , A1C_Performance_Rate_TIN
	) As A1C_Preformance_Rate_NPI_Over_TIN
, CCLF_Functions.dbo.Percent_Over
	(
	Cast(A1C_Performance_Rate_NPI as float)
	   , A1C_Performance_Rate_ACO
	) As A1C_Preformance_Rate_NPI_Over_ACO
Into #Temp_Over_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

Update NPI
Set 
  A1C_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, A1C_Performance_Rate_TIN
		)

, A1C_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

--=====================
-- Over Group Flag
--=====================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
"
3863,2026-06-27T16:53:59.131511,ALTER_FUNCTION,CCLF_Functions,dbo,E1000,"
--------------------------------------------------------------
-- This function will Calculate the E1000 Value
--------------------------------------------------------------

Alter Function E1000
(
  @Numerator		as Float
, @Denominator		as Float
)

RETURNS Float
AS

BEGIN

Declare @E1000 as Float

Set @E1000 = 
	CCLF_Functions.dbo.Divide_Return0
		(
		  @Numerator
		, @Denominator
		) * 1000

Return @E1000

END

"
3862,2026-06-27T16:53:15.659347,ALTER_FUNCTION,CCLF_Functions,dbo,E1000,"
--------------------------------------------------------------
-- This function will Calculate the E1000 Value
--------------------------------------------------------------

Alter Function E1000
(
  @Numerator		as Float
, @Denominator		as Float
)

RETURNS Float
AS

BEGIN

Declare @E1000 as Float

Set @E1000 = CCLF_Functions.dbo.Divide_Return0(@Numerator, @Denominator) * 1000

Return @E1000

END

"
3861,2026-06-27T16:51:33.299697,ALTER_FUNCTION,CCLF_Functions,dbo,E1000_Over,"
----------------------------------------------------------------------
-- This function will Calculate the E1000 OVER
--
-- Use E1000 Over for Quality Measures BP, Dep Screening, etc.
-- NPI (@Numerator) wants to be Over the ACO Average (@Denominator)
-- ie: More BP Pass, More Dep Screen
--
-- Use E1000 Under for ED Vists, RTA, etc.  
-- NPI (@Numerator) wants to be Under the ACO Average (@Denominator)
-- ie: Less ED Visits, Less ReAdmits
--
----------------------------------------------------------------------
Alter Function E1000_Over
(
  @Numerator		as Float
, @Denominator		as Float
)

RETURNS Float
AS

BEGIN

Declare @E1000_Over as Float

Set @E1000_Over = CCLF_Functions.dbo.Divide_Return0((@Numerator - @Denominator), @Denominator) * 1000

Return @E1000_Over

END

"
3860,2026-06-27T16:46:10.848409,ALTER_FUNCTION,CCLF_Functions,dbo,Percent_Over,"
----------------------------------------------------------------------
-- This function will Calculate the Percent Over the Group
--
-- Use Percent Over for Quality Measures BP, Dep Screening, etc.
-- NPI (@Numerator) wants to be Over the ACO Average (@Denominator)
-- ie: More BP Pass, More Dep Screen
--
-- Use Percent Under for ED Vists, RTA, etc.  
-- NPI (@Numerator) wants to be Under the ACO Average (@Denominator)
-- ie: Less ED Visits, Less ReAdmits
--
----------------------------------------------------------------------
Alter Function Percent_Over
(
  @Numerator		as Float
, @Denominator		as Float
)

RETURNS Float
AS

BEGIN

Declare @Percent_Over as Float

Set @Percent_Over = CCLF_Functions.dbo.Divide_Return0((@Numerator - @Denominator), @Denominator)

Return @Percent_Over

END

