5628,2026-08-12T14:25:20.643597,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_30_0_2_QASSGN_UpdateRiskScoreAndType,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_30_0_2_QASSGN_UpdateRiskScoreAndType
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	-------------------------------------------------------
-- Update the Risk Score and Risk Score Type for both
-- CMS and Demo
-------------------------------------------------------
Declare @SelectType				as Varchar(15)
Declare @AttributionQuarter		As Varchar(6)

Set @SelectType				= 'Current'
SET @AttributionQuarter		= (Select YearQuarter	From Database_Constants.dbo.Quarterly_Automated)

Update Q1
Set CMSRiskScore = 
	Case 
		When CMSRiskScoreESRD > 0			Then CMSRiskScoreESRD
		When CMSRiskScoreDisabled > 0		Then CMSRiskScoreDisabled
		When CMSRiskScoreAgedDual > 0		Then CMSRiskScoreAgedDual
		When CMSRiskScoreAgedNonDual > 0	Then CMSRiskScoreAgedNonDual
		Else 0
	End

, CMSRiskScoreType = 
	Case 
		When CMSRiskScoreESRD > 0			Then 'ESRD'
		When CMSRiskScoreDisabled > 0		Then 'Disabled'
		When CMSRiskScoreAgedDual > 0		Then 'Aged_Dual'
		When CMSRiskScoreAgedNonDual > 0	Then 'Aged_NonDual'
		Else 'Unknown'
	End

, DemoRiskScore = 
	Case 
		When DemoRiskScoreESRD > 0			Then DemoRiskScoreESRD
		When DemoRiskScoreDisabled > 0		Then DemoRiskScoreDisabled
		When DemoRiskScoreAgedDual > 0		Then DemoRiskScoreAgedDual
		When DemoRiskScoreAgedNonDual > 0	Then DemoRiskScoreAgedNonDual
		Else 0
	End

, DemoRiskScoreType = 
	Case 
		When DemoRiskScoreESRD > 0			Then 'ESRD'
		When DemoRiskScoreDisabled > 0		Then 'Disabled'
		When DemoRiskScoreAgedDual > 0		Then 'Aged_Dual'
		When DemoRiskScoreAgedNonDual > 0	Then 'Aged_NonDual'
		Else 'Unknown'
	End

from CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
Where Q1_YearQuarter = @AttributionQuarter
END
