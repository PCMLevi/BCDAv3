	(
	Compensation_Quarter varchar(6) NULL,
	Compensation_Percent float(53) NULL,
	ACO_GroupTIN varchar(10) NULL,
	ACO_GroupTINName_New varchar(255) NULL,
	PY_TIN float(53) NULL,
