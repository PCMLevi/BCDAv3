Set		@ReAdmit_Days	= (Select ReAdmit_Days From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_1_HospReAdmit_ByBENE

