4323,2026-07-10T11:48:54.174729,CREATE_PROCEDURE,CCLF_Procedures,dbo,BCDA_Coverage_Base_v3,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE BCDA_Coverage_Base_v3
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
	merge BCDA_Data.dbo.Coverage_Base_v3 as tgt
using [BCDA_Staging].[dbo].[coverage_base_staging_v3] as src
on tgt.coverage_id = src.coverage_id
when matched then 
update
set
 tgt.[patient_id]        = src.[patient_id]  	
,tgt.[start]			 = src.[start]		
,tgt.[end]				 = src.[end]			
,tgt.[status]			 = src.[status]		
,tgt.[subscriberId]		 = src.[subscriberId]
,tgt.MergedBy			 = 'Updated'
,tgt.[lastUpdated]		 = src.[lastUpdated]
,tgt.[filename]			 = src.[filename]		
,tgt.[extract_date]		 = src.[extract_date]
when not matched then 
insert (
[coverage_id]
,[patient_id]
,[start]
,[end]
,[status]
,[subscriberId]
,MergedBy
,[lastUpdated]
,[filename]
,[extract_date]
) Values (
 src.[coverage_id]
,src.[patient_id]
,src.[start]
,src.[end]
,src.[status]
,src.[subscriberId]
,'Inserted'
,src.[lastUpdated]
,src.[filename]
,src.[extract_date]
);

update BCDA_Data.dbo.Coverage_Base_v3
set 
 PBPName = co.name
from BCDA_Data.dbo.Coverage_Base_v3 bs
inner join BCDA_Staging.dbo.coverage_contained_staging_v3 co
on bs.coverage_id = co.coverage_id;

WITH CoverageClass AS
(
    SELECT
        coverage_id,

        MAX(CASE WHEN code = 'rxid'
            THEN value END) AS PDPEnrollmentID,

        MAX(CASE WHEN code = 'rxgroup'
            THEN value END) AS PDPEnrollmentGroup,

        MAX(CASE WHEN code = 'rxpcn'
            THEN value END) AS PDPEnrollmentProcessor,

        MAX(CASE WHEN code = 'rxbin'
            THEN value END) AS PDPEnrollmentBank
            

    FROM BCDA_Staging.dbo.coverage_class_staging_v3 cc
    GROUP BY coverage_id
)

UPDATE b
SET
    PDPEnrollmentID        = cc.PDPEnrollmentID,
    PDPEnrollmentGroup     = cc.PDPEnrollmentGroup,
    PDPEnrollmentProcessor = cc.PDPEnrollmentProcessor,
    PDPEnrollmentBank      = cc.PDPEnrollmentBank
FROM BCDA_Data.dbo.Coverage_Base_v3 b
JOIN CoverageClass cc
    ON b.coverage_id = cc.coverage_id;

WITH CoverageExtensions AS
(
    SELECT
        coverage_id,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-MDCR-STUS-CD'
            THEN lt.description END) AS MedicareStatus,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-MDCR-ENTLMT-STUS-CD'
            THEN lt.description END) AS MedicareEntitlement,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-BUYIN-CD'
            THEN lt.description END) AS BuyIn,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-ENRLMT-RSN-CD'
            THEN ext.code END) AS EnrollmentReason,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-MDCR-ENTLMT-RSN-CD'
            THEN lt.description END) AS EntitlementReason,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-ESRD-STUS-ID'
            THEN lt.description END) AS ESRD,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-DSBLD-STUS-ID'
            THEN lt.description END) AS Disabled,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-DUAL-STUS-CD'
            THEN lt.description END) AS Dual,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-DUAL-TYPE-CD'
            THEN lt.description END) AS DualType,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-CNTRCT-NUM'
            THEN ext.valueString END) AS ContractNumber,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-PBP-NUM'
            THEN ext.valueString END) AS PBPNumber,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-CVRG-TYPE-CD'
            THEN lt.description END) AS CoverageType,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-LIS-EFCTV-DT'
            THEN lt.description END) AS LISEffective,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-LIS-COPMT-LVL-CD'
            THEN lt.description END) AS LISCopayment,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-LIS-PTD-PRM-PCT'
            THEN valueDecimal END) AS LISPartDPremium,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/CNTRCT-PBP-SGMT-NUM'
            THEN lt.description END) AS PBPSegment,

        MAX(CASE WHEN ext.url = 'https://bluebutton.cms.gov/fhir/StructureDefinition/BENE-ENRLMT-EMPLR-SBSDY-SW'
            THEN lt.description END) AS DrugSubsidySwitch

    FROM BCDA_Staging.dbo.coverage_extension_staging_v3 ext
    left join [BCDA_Staging].[dbo].[blueButton_LookupTable] lt
    on 
    RIGHT(
    lt.url,
    CHARINDEX('/', REVERSE(lt.url)) - 1
    )
    = 
    RIGHT(
    ext.url,
    CHARINDEX('/', REVERSE(ext.url)) - 1
    )
    and lt.value = ext.code
    GROUP BY coverage_id
)

UPDATE b
SET
    MedicareStatus          = ce.MedicareStatus,
    MedicareEntitlement     = ce.MedicareEntitlement,
    BuyIn                   = ce.BuyIn,
    EnrollmentReason        = ce.EnrollmentReason,
    EntitlementReason       = ce.EntitlementReason,
    ESRD                    = ce.ESRD,
    Disabled                = ce.Disabled,
    Dual                    = ce.Dual,
    DualType                = ce.DualType,
    ContractNumber          = ce.ContractNumber,
    PBPNumber               = ce.PBPNumber,
    CoverageType            = ce.CoverageType,
    LISEffective            = ce.LISEffective,
    LISCopayment            = ce.LISCopayment,
    LISPartDPremium         = ce.LISPartDPremium,
    PBPSegment              = ce.PBPSegment,
    DrugSubsidySwitch       = ce.DrugSubsidySwitch
FROM BCDA_Data.dbo.Coverage_Base_v3 b
JOIN CoverageExtensions ce
    ON b.coverage_id = ce.coverage_id;
END
