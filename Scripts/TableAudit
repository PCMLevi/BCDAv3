4167,2026-07-06T16:40:52.313280,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_236_4_HTN_Bonus,"
Create Procedure procCompensation_PYCurrent_10_236_4_HTN_Bonus
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Declare @HTN_Bonus_Allotment	as float

Set @SelectType					= 'Current'
Set @HTN_Bonus_Allotment		= (Select HTN_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN

Select 
  @QM_Completion_Percent	as ComplPct
, @QM_40th_Percentile		as PerfPct
, @HTN_Bonus_Allotment		As HTN_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @HTN_Performance_Rate_ACO as Float	
Set		
@HTN_Performance_Rate_ACO = 
	(Select HTN_Performance_Rate_ACO
	 From   Compensation_PYCurrent.dbo.Compensation_10_236_2_4_HTN_Aggregate_ACO)

-- Select @HTN_Performance_Rate_ACO as PerfRate_ACO

Insert Into Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, HTN_Eligible_TIN
, HTN_Pass_TIN
, HTN_Complete_TIN
, Completion_Percent
, Performance_Percent
, HTN_Performance_Rate_TIN
, HTN_Performance_Rate_ACO
, HTN_Performance_Rate_TIN_Over_ACO
, HTN_Performance_Flag_TIN_Over_ACO
, HTN_Quality_Weight
, HTN_Bonus_Allotment
, SQLRunDate_MDI_HTN
)

Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, HTN_Eligible_TIN
, HTN_Pass_TIN
, HTN_Complete_TIN
, @QM_Completion_Percent
, @QM_40th_Percentile
, HTN_Performance_Rate_TIN
, @HTN_Performance_Rate_ACO
, HTN_Performance_Rate_TIN_Over_ACO
, HTN_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(   HTN_Performance_Rate_TIN
	 , @HTN_Performance_Rate_ACO
	) 
, @HTN_Bonus_Allotment
, SQLRunDate_MDI_HTN
From Compensation_PYCurrent.dbo.Compensation_10_236_2_3_HTN_Aggregate_TIN


Update HTN
Set 
HTN_BENE_Weight =
	Case
		When HTN_Performance_Flag_TIN_Over_ACO = 1 
		Then HTN_Eligible_TIN * HTN_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN HTN

Declare @HTN_BENE_Weight_Total as Float
Set		@HTN_BENE_Weight_Total = 
		(Select Sum(HTN_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN)

Update HTN
Set 
  HTN_Bonus_Percent	= 
	Case
		When HTN_Performance_Flag_TIN_Over_ACO = 1
		Then (HTN_BENE_Weight / @HTN_BENE_Weight_Total)
		Else 0
	End
, HTN_BENE_Weight_Total	= @HTN_BENE_Weight_Total
From Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN HTN

Update HTN
Set 
  HTN_Bonus_PerTIN	=  
	Case
		When HTN_Performance_Flag_TIN_Over_ACO = 1
		Then HTN_Bonus_Percent * HTN_Bonus_Allotment
		Else 0
	End 
, HTN_Bonus_TIN		=  
	Case
		When HTN_Performance_Flag_TIN_Over_ACO = 1
		Then HTN_Bonus_Percent * HTN_Bonus_Allotment
		Else 0
	End
, HTN_Bonus_PerBENE	= 
	Case
		When HTN_Performance_Flag_TIN_Over_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0
			(
			 (HTN_Bonus_Percent * HTN_Bonus_Allotment)
		    , HTN_Eligible_TIN
		    )
		
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN HTN

------------------------
-- Update SQLRunDate
------------------------
Update HTN
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_236_2_6_HTN_Bonus_TIN HTN

End
