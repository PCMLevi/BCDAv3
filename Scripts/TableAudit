5268,2026-07-27T08:55:21.276148,CREATE_TABLE,VIM,dbo,Diagnosis_Gaps_Data,"SELECT
--  InACO.Id					as DGNS_ID
  ACO_BENE.BENE_LastName			as patient_last_name
, ACO_BENE.BENE_FirstName			as patient_first_name
, ACO_BENE.BENE_ID					as patient_unique_id
, ACO_BENE.BENE_BirthDate			as patient_dob
, InACO.BENE_HIC_NUM				as patient_insurance_id
, ACO_BENE.BENE_EHR_ID				as patient_ehr_id
, ACO_BENE.BENE_EHR_ZIP				as patient_zip_code
, 'Medicare'						As patient_insurer
, ACO_BENE.BENE_EHR_State			as patient_State
, Concat(ACO_BENE.BENE_LastName, '_'
, ACO_BENE.BENE_FirstName, '_' 
, Cast(ACO_BENE.BENE_BirthDate as Varchar), '_' 
, ACO_BENE.BENE_EHR_ID, '_' 
, Cast(HCC.HCCNumber_V28 as Varchar))	as gap_unique_id
, 'HCC'								as gap_system
, HCC.HCCNumber_V28					as hcc_code
, HCC.HCCDescription_V28			as hcc_description
, InACO.CLM_DGNS_CD					as icd_code
, InACO.CLM_DGNS					as icd_description
, 'V28'								as hcc_model_version
, 'KNOWN'							as gap_type
, 'OPEN'							as gap_status
, HCC.HCCRiskScore_V28				as gap_raf_value
, '' As gap_source  --InACO.Facility_			as gap_source
, InACO.MaxDate_2025				as last_recorded_dos
, InACO.RNDRG_NPI_2025				as last_recorded_npi
, InACO.RNDRG_Name_2025 			as last_recorded_npi_Name
, Null								as notes
Into VIM.dbo.Diagnosis_Gaps_Data
  FROM PreChart_ALL.dbo.PreChart_HCC_InACOGroup_V28 InACO
Left Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on 
InACO.BENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Left Join 
CCLF_LookupTables.dbo.tbl_HCC_HCPCS_ICD10CM HCC on
InACO.CLM_DGNS_CD = HCC.Diagnosis_Code
Where
	HCC.HCCNumber_V28 Is Not Null
and ACO_BENE.BENE_YearQuarter = '2026Q1'
and ACO_BENE.BENE_EHR_ID is not null
Order by
gap_unique_id"
