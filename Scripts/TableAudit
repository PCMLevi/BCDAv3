2552,2026-06-04T17:14:22.049309,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_01_4_Attribution_Bonus,"				
Create Procedure procCompensation_01_4_Attribution_Bonus
(	
	  @CompensationYear		as Char(6)
	, @CompensationQuarter	as Varchar(6)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @Attribution_Allotment	as Float
Declare @BENE_PY_Total			as Float
Declare @Allotment_Each			as Float

Delete From Compensation_PYCurrent.dbo.Compensation_01_4_Attribution_Bonus

Drop Table if Exists #Temp1

Set @Attribution_Allotment = 
(
	Select 
	Attribution_Allotment
	from Compensation_PYCurrent.dbo.Compensation_00_1_Constants
	Where
		Compensation_Year		= @CompensationYear
	and Compensation_Percent	= @CompensationPercent
) 

SELECT 
  NPI
, ACO_GroupTin			
, Count(BENE_HIC_NUM)		as NumBENE
, Sum(BENE_PY)				as BENE_PY
, @Attribution_Allotment	as Attributon_Allotment
Into #Temp1
From Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized
Group By
  NPI
, ACO_GroupTin

Set @BENE_PY_Total = 
(
	Select 
	Sum(BENE_PY)
	From #Temp1
)

Set @Allotment_Each = @Attribution_Allotment / @BENE_PY_Total

Insert Into Compensation_PYCurrent.dbo.Compensation_01_4_Attribution_Bonus
( Compensation_Quarter
, Compensation_Percent
, ACO_GroupTin
, NPI
, NumBENE
, BENE_PersonYears
, AttributionBonus_Allotment
, AttributionBonus_Each
, AttributionBonus
)

SELECT 
  @CompensationQuarter
, @CompensationPercent
, ACO_GroupTin
, NPI
, NumBENE
, BENE_PY
, @Attribution_Allotment
, @Allotment_Each
, BENE_PY * @Allotment_Each	as Attribution_Bonus
From #Temp1

-----------------------------------
-- Update ACO and NPI Information
-----------------------------------
Update Bonus
Set 
  Bonus.ACO_GroupName			= NPI.ACO_GroupName
, Bonus.ACO_GroupTinName		= NPI.ACO_GroupTINName
, Bonus.NPI_LastName			= NPI.NPI_LastName
, Bonus.NPI_FirstName			= NPI.NPI_FirstName
, Bonus.NPI_Fullname			= NPI.NPI_FullName
, Bonus.NPI_Classification		= NPI.NPI_Classification
, Bonus.NPI_Classification_Type = NPI.NPI_Classification_Type
From Compensation_PYCurrent.dbo.Compensation_01_4_Attribution_Bonus Bonus
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_4_ACO_NPI NPI on
Bonus.npi = NPI.NPI

----------------------
-- Update SQLRunDate
----------------------
Update Bonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_01_4_Attribution_Bonus Bonus

End"
