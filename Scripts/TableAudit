--=============================
-- Aggregate to BENE Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE
(
  ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_FullName
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, Hospital_VisitCount
, Hospital_Paid
, ReAdmit_VisitCount
, ReAdmit_Paid
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate

)

Select 
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName
, Max(ACO_BENE.BENE_PY)				as PY_BENE
, 1									as NumBENE_BENE
, Sum(HospRA.Hospital_VisitCount)	as Hospital_VisitCount
, Sum(HospRA.Hospital_Paid)			as Hospital_Paid
, Sum(HospRA.ReAdmit_VisitCount)	as ReAdmit_VisitCount
, Sum(HospRA.ReAdmit_Paid)			as ReAdmit_Paid
, Max(HospRA.SQLRunDate_Hospital)	As SQLRunDate_Hospital
, Max(HospRA.SQLRunDate_ReAdmit)	As SQLRunDate_ReAdmit
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_06_1_1_ReAdmit_ByBENE HospRA on
ACO_BENE.BENE_HIC_NUM = HospRA.BENE_HIC_NUM
Group By
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_FullName



