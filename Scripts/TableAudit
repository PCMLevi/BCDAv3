2101,2026-06-02T11:22:29.258291,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_4_A1C_ACO,"
Create Procedure procCompensation_PYCurrent_10_001_4_A1C_ACO
(	
	    @Compensation_Year		as Varchar(6)  -- vst - Changed from 6 to 7 for Testing
	  , @Compensation_Percent	As Float
	  , @Compensation_Quarter	as Varchar(6)
	  , @MDI_Download_DT		as Date
)

AS
BEGIN

Declare @SelectType		as Varchar(15)
Declare @MeasureNumber	as Varchar(3)
Declare @MeasureAbbr	as Varchar(5)

Set		@MeasureNumber	= '001'
Set		@SelectType		= @Compensation_Year
Set		@MeasureAbbr	= (Select A1C_Abbr From Database_Constants.dbo.Mips Where SelectType = @SelectType and A1C_Number = '001')

Drop Table if Exists #Temp_A1C

Select 
  @MeasureAbbr				As MeasureAbbr
, Case
	When MDI_Performance =  'Not Met'		Then 'NotMet'
	When MDI_Performance =  'Met'			Then 'Met'
	When MDI_Performance =  'Unreported'	Then 'UnReported'
	Else										 'UnReported'
	End as Measure_Result
, Count(MDI_Performance)	as MDI_Performance
, Cast(1 as Float)			as MDI_Total
Into #Temp_A1C
from CCLF_MipsCurrent.dbo.MDInteractive_A1C
Where
MDI_A1C_Download_Date = @MDI_Download_DT
Group By
MDI_Performance
Order by
MDI_Performance

Declare @Result_Eligible as Float
Set		@Result_Eligible = (Select Sum(MDI_Performance) From #Temp_A1C)

Declare @Result_Met as Float
Set		@Result_Met = (Select MDI_Performance From #Temp_A1C Where Measure_Result = 'Met')

Declare @Result_NotMet as Float
Set		@Result_NotMet = (Select MDI_Performance From #Temp_A1C Where Measure_Result = 'NotMet')

Declare @Result_UnReported as Float
Set		@Result_UnReported = (Select MDI_Performance From #Temp_A1C Where Measure_Result = 'UnReported')

Select 
  @MeasureAbbr						as MeasureAbbr
, @MeasureNumber					as MeasureNumber
, @Result_Met						as Met
, @Result_NotMet					as NotMet
, @Result_UnReported				as UnReported
, @Result_Eligible					as Eligible
, (@Result_Met + @Result_NotMet)	as Complete
, (@Result_Met + @Result_NotMet) 
/ @Result_Eligible					as CompletionRate
, @Result_NotMet / (@Result_Met 
+ @Result_NotMet)					as PerformanceRate

End"
