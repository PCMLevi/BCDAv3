CREATE TABLE ##Temp1 (
    BENE_HIC_NUM varchar(13),      -- adjust length to match actual data
    CLM_THRU_DT date,
    CLM_DGNS_CD varchar(8),       -- adjust based on max expected diagnosis code
    CLM_DGNS_Position varchar(11), -- must be long enough for 'CLM_DGNS_12'
    CUR_CLM_UNIQ_ID bigint
);

insert into ##temp1
Select
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_LINE_DGNS_CD	as CLM_DGNS_CD
, 'CLM_DGNS_0'	as CLM_DGNS_Position
, CUR_CLM_UNIQ_ID
from CCLF_Months.dbo.CCLF5_2025_WithLookupTables
Where 
	CLM_THRU_DT				between @StartDate and @StopDate
and CLM_IDR_LD_DT			<= @CLM_IDR_LD_DT
and MedicareFileDate		= @MedicarefileDate

set @int = 1

while @int <= 12
 begin 

set @sql = 
'
Insert into ##Temp1
 Select
  BENE_HIC_NUM
, CLM_THRU_DT
, CLM_LINE_DGNS_CD	as CLM_DGNS_CD
, ''CLM_DGNS_'+cast(@int as varchar)+'''	as CLM_DGNS_Position
, CUR_CLM_UNIQ_ID
from CCLF_Months.dbo.CCLF5_'+@year+'_WithLookupTables
Where 
	CLM_THRU_DT				between @StartDate and @StopDate
and CLM_IDR_LD_DT			<= @CLM_IDR_LD_DT
and MedicareFileDate		= @MedicarefileDate
and CLM_DGNS_'+cast(@int as varchar)+'_CD		<> ''~''
and CLM_DGNS_'+cast(@int as varchar)+'_CD		is not null
'


exec sp_executesql 
	@SQL,
	N'@MedicarefileDate date,
	@CLM_IDR_LD_DT date,
	@StartDate date,
	@StopDate date',
	@MedicareFileDate = @MedicarefileDate,
	@CLM_IDR_LD_DT    = @CLM_IDR_LD_DT,
	@StartDate		  = @StartDate,
	@StopDate		  = @StopDate


