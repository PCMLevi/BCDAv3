3924,2026-06-29T14:16:35.322188,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_3_A1C_Calculations,"
Alter Procedure procCompensation_PYCurrent_10_001_3_A1C_Calculations
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @CompletionPercent		as Float
	, @PerformancePercent		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Set		@SelectType				= 'Current'

Drop Table if Exists #Temp_Complete_NPI
Drop Table if Exists #Temp_Complete_TIN
Drop Table if Exists #Temp_Complete_ACO

Drop Table if Exists #Temp_Performance_NPI
Drop Table if Exists #Temp_Performance_TIN
Drop Table if Exists #Temp_Performance_ACO

Drop Table if Exists #Temp_Perf_NPI
Drop Table if Exists #Temp_Perf_TIN
Drop Table if Exists #Temp_Perf_ACO

Drop Table if Exists #Temp_Over_NPI

--=======================================
-- Calculate Completion Rate
-- Calculate Performance Rate
-- Calculate % Above ACO Average
-- See if Group has a positive Above Average
--=======================================

--============================================
-- Update Completion Percent  (Lookup Values)
-- Update Performance Percent (Lookup Values)
--============================================
-------------------------------
-- Update Pct Constants - NPI
-------------------------------
Update A1C_NPI
Set 
  A1C_Completion_Percent	= @CompletionPercent
, A1C_Performance_Percent	= @PerformancePercent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

-------------------------------
-- Update Pct Constants - TIN
-------------------------------
Update A1C_TIN
Set 
  A1C_Completion_Percent	= @CompletionPercent
, A1C_Performance_Percent	= @PerformancePercent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

-------------------------------
-- Update Pct Constants - ACO
-------------------------------
Update A1C_ACO
Set 
  A1C_Completion_Percent	= @CompletionPercent
, A1C_Performance_Percent	= @PerformancePercent
from Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

--========================
-- Update Completion Rate
--========================

--=====================
-- Completion Rate
--=====================
-------------------
-- Completion_ACO
-------------------
Update A1C_ACO
Set 
  A1C_ACO.A1C_Completion_Rate_ACO = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_ACO as Float)
		 , A1C_Eligible_ACO
	) 

, A1C_ACO.A1C_Pass_Rate_ACO	= 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_ACO as Float)
		 , A1C_Eligible_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

-------------------------
-- Completion Rate NPI
-------------------------
-- Select * From #Temp_Complete_NPI

Update A1C_NPI
Set 
  A1C_NPI.A1C_Completion_Rate_NPI	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_NPI as Float)
		 , A1C_Eligible_NPI
	)

, A1C_NPI.A1C_Pass_Rate_NPI	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_NPI as Float)
		 , A1C_Eligible_NPI
	)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

-------------------------
-- Completion Rate TIN
-------------------------
Update A1C_TIN
Set 
  A1C_TIN.A1C_Completion_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_TIN as Float)
		 , A1C_Eligible_TIN
	)
, A1C_TIN.A1C_Pass_Rate_TIN			= 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Complete_TIN as Float)
		 , A1C_Eligible_TIN
	)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

--=====================
-- Fail Rate
--=====================
-------------------
-- Fail Rate NPI
-------------------
Update NPI
Set NPI.A1C_Fail_Rate_NPI = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_NPI as Float)
		 , A1C_Complete_NPI
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

-------------------
-- Fail Rate TIN
-------------------
Update TIN
Set TIN.A1C_Fail_Rate_TIN = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_TIN as Float)
		 , A1C_Complete_TIN
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

-------------------
-- Fail Rate ACO
-------------------
Update ACO
Set ACO.A1C_Fail_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Fail_ACO as Float)
		 , A1C_Complete_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO ACO

--===================================================
-- Performance Rate
-- NOTE:  Performance Rate is the same as Pass Rate
--===================================================
-------------------
-- Performance_ACO
-------------------
Update A1C_ACO
Set 
  A1C_ACO.A1C_Performance_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_ACO as Float)
	,	   A1C_Complete_ACO
	)
, A1C_ACO.A1C_Pass_Rate_ACO	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_ACO as Float)
	,	   A1C_Complete_ACO
	)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO A1C_ACO

Declare @A1C_Performance_Rate_ACO as Float
Set		@A1C_Performance_Rate_ACO = 
			(Select A1C_Performance_Rate_ACO
			 From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO)

--------------------------
-- Performance Rate TIN
--------------------------
Update A1C_TIN
Set 
  A1C_TIN.A1C_Performance_Rate_TIN = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_TIN as Float)
		 , A1C_Complete_TIN
	)

, A1C_TIN.A1C_Pass_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_TIN as Float)
		 , A1C_Complete_TIN
	)

, A1C_TIN.A1C_Performance_Rate_ACO	= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

-------------------------
-- Performance Rate NPI
-------------------------
Update A1C_NPI
Set 
  A1C_NPI.A1C_Performance_Rate_NPI		= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)

, A1C_NPI.A1C_Pass_Rate_NPI				= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)
, A1C_NPI.A1C_Performance_Rate_ACO		= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

--==============================
-- NPI Over Group Percent
--==============================

--------------------------------
-- Set Preformance_Rate_Base to Calculate the Percent Over 
-- a Defined Performance_Base to disseminate Bonus
-- I'm setting 3 of them to see what the bonus structure looks like

Declare @Performance_Rate_Min	as Float
Declare @A1C_Performance_Percent_Base	as Float
-- Set		@A1C_Performance_Rate_Base	= @PerformancePercent
-- Set		@A1C_Performance_Rate_Base	= @A1C_Performance_Rate_ACO
Set		@Performance_Rate_Min	= 
	(
	Select Distinct 
	Min(A1C_Performance_Rate_TIN)
	From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN
	)

Set @A1C_Performance_Percent_Base = 
	(
	Select Distinct 
		Case
			When (@Performance_Rate_Min - (@Performance_Rate_Min * .10)) > A1C_Performance_Percent
			Then (@Performance_Rate_Min - (@Performance_Rate_Min * .10))
			Else A1C_Performance_Percent
		End 
	From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN
	)

-- Select @A1C_Performance_Percent_Base

--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @A1C_Performance_Percent_Base
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Update NPI
Set 
  A1C_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, A1C_Performance_Rate_TIN
		)

, A1C_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		    A1C_Performance_Rate_NPI
		  , A1C_Performance_Percent_Base
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

--=========================
-- Over Group Flag
-- Performance_Rate_Base
--=========================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
, TIN.A1C_Performance_Percent_Base = A1C_Performance_Percent_Base
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Percent_Base = @A1C_Performance_Percent_Base
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
