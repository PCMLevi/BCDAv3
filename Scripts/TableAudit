3662,2026-06-21T04:03:12.629702,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_3_ReAdmit_Calculations,"
Alter Procedure procCompensation_PYCurrent_06_1_3_ReAdmit_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate 
--   ReAdmit_Rate
-- , Rate_Group_Under_Total
-- , Rate_Group_Flag_Under_Total
--	 For Each Group
--=======================================

--========================
-- Update ACO Aggregate
--========================
Select 
 'ACO'							as GroupName
, ReAdmit_ACO
, Hospital_ACO
, ReAdmit_ACO / 
  Cast(Hospital_ACO as Float)	as ReAdmit_Rate_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO

-- Select * From #Temp_ACO

-------------------
-- ReAdmit Rate
-------------------
Update ACO
Set 
  ReAdmit_Rate_ACO = TACO.ReAdmit_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO ACO
Inner Join
#Temp_ACO TACO on
1=1

-------------------------
-- ED Visit Declare's
-------------------------
Declare @ReAdmit_Rate_ACO			as Float

Set		@ReAdmit_Rate_ACO = 
		(Select ReAdmit_Rate_ACO 
		 From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO)

Select @ReAdmit_Rate_ACO as E1000_ACO

--========================
-- Update TIN Aggregate
--========================

----------------
-- TIN ReAdmit
----------------
Select 
  ACO_GroupTIN
, CCLF_Functions.dbo.Divide_Return0(
  ReAdmit_TIN
, Hospital_TIN)	As ReAdmit_Rate_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
Group By
  ACO_GroupTIN
, ReAdmit_TIN
, Hospital_TIN

-- Select * From #Temp_TIN

Update TIN
Set 
  TIN.ReAdmit_Rate_TIN	= TempTIN.ReAdmit_Rate_TIN
, TIN.ReAdmit_Rate_ACO		= @ReAdmit_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN
Inner Join
#Temp_TIN TempTIN on
TIN.ACO_GroupTIN = TempTIN.ACO_GroupTIN


-----------------------------------------------
-- TIN ReAdmit % Under
-- Less ReAdmits than Avg ACO Visits = Better
-----------------------------------------------
-- Select * From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
Update TIN
Set 
ReAdmit_Rate_TIN_Under_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (TIN.ReAdmit_Rate_ACO
	- TIN.ReAdmit_Rate_TIN)
	, TIN.ReAdmit_Rate_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

Update TIN
Set 
ReAdmit_Flag_TIN_Under_ACO = 
	Case
		When ReAdmit_Rate_TIN_Under_ACO < 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN

--========================
-- Update NPI Aggregate
--========================

----------------
-- NPI ReAdmit
----------------
Update NPI
Set 
  NPI.ReAdmit_Rate_NPI	= 
  CCLF_Functions.dbo.Divide_Return0(NPI.ReAdmit_NPI, NPI.Hospital_NPI)
, NPI.ReAdmit_Rate_TIN		= 
  CCLF_Functions.dbo.Divide_Return0(NPI.ReAdmit_TIN, NPI.Hospital_TIN)
, NPI.ReAdmit_Rate_ACO		= 
  CCLF_Functions.dbo.Divide_Return0(NPI.ReAdmit_ACO, NPI.Hospital_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI


-----------------------------------------------
-- NPI ReAdmit % Under
-- Less ReAdmits than Avg ACO Visits = Better
-----------------------------------------------
Update NPI
Set 
  ReAdmit_Rate_NPI_Under_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (NPI.ReAdmit_Rate_TIN
	- NPI.ReAdmit_Rate_NPI)
	, NPI.ReAdmit_Rate_TIN)
, ReAdmit_Rate_NPI_Under_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (NPI.ReAdmit_Rate_ACO
	- NPI.ReAdmit_Rate_NPI)
	, NPI.ReAdmit_Rate_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI

Update NPI
Set 
  ReAdmit_Flag_NPI_Under_TIN = 
	Case
		When ReAdmit_Rate_NPI_Under_TIN < 0
		Then 1
		Else 0
	End

, ReAdmit_Flag_NPI_Under_ACO = 
	Case
		When ReAdmit_Rate_NPI_Under_ACO < 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN

End 
