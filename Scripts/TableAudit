--------------------
-- Month 1 Costs
--------------------
Select 
  FinalData.BENE_HIC_NUM
, Q1_HICN
, Q1_HICN_Prev
, 1 As MonthPaid
, @StartDate_1	as StartDate
, @StopDate_1	as StopDate
, Sum(FinalData.CLM_PMT_AMT) as TotalPaid
Into #Temp_Paid1
from CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData
Inner Join
#Temp_Month1 Month1 on
FinalData.BENE_HIC_NUM = Month1.Q1_HICN
Where
	FinalData.CLM_THRU_DT		between @StartDate_1 and @StopDate_1
and FinalData.CLM_IDR_LD_DT		<= @IDR_LD_DT
and FinalData.CLM_LINE_HCPCS_CD Not In ('A4352','A4353','A6197','L0486','L1852','L3916')	-- Take out Cathether, Alginet, Orthotics Payments 10/23/2025
Group by
  FinalData.BENE_HIC_NUM
, Q1_HICN
, Q1_HICN_Prev

Set @MsgString = 'Month 1 Costs'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

