4286,2026-07-09T00:52:39.712054,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_4_2_ReAdmit_Bonus_NPI,"
Create Procedure procCompensation_PYCurrent_06_1_4_2_ReAdmit_Bonus_NPI
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Set		@SelectType = 'Current'

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI

Drop Table if Exists #Temp_PercentPositive
Drop Table if Exists #Temp_ReAdmit_TotalWeight

----------------------------------------------------------------
-- Insert Only the NPI's in TINs that are under the ACO Average
----------------------------------------------------------------
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_FullName
, PY_NPI
, NumBENE_NPI
, Hospital_NPI		--EDVisit_NPI
, Hospital_TIN		--EDVisit_TIN
, Hospital_ACO		--EDVisit_ACO
, ReAdmit_NPI		--EDVisit_E1000_NPI
, ReAdmit_TIN		--EDVisit_E1000_TIN
, ReAdmit_ACO		--EDVisit_E1000_ACO
, ReAdmit_Rate_NPI	--EDVisit_Average_PY_NPI
, ReAdmit_Rate_TIN	--EDVisit_Average_PY_TIN
, ReAdmit_Rate_ACO	--EDVisit_Average_PY_ACO
, ReAdmit_Rate_NPI_Under_TIN	--EDVisit_E1000_NPI_Under_TIN
, ReAdmit_Rate_NPI_Under_ACO	--EDVisit_E1000_NPI_Under_ACO
, ReAdmit_Flag_NPI_Under_TIN	--EDVisit_Flag_NPI_Under_TIN
, ReAdmit_Flag_NPI_Under_ACO	--ReAdmit_Flag_NPI_Under_ACO
, ReAdmit_Flag_TIN_Under_ACO	--EDVisit_Flag_TIN_Under_ACO
, ReAdmit_Bonus_Allotment_TIN
, SQLRunDate_ReAdmit
)
Select 
  @YearQuarter
, @CompensationPercent
, Agg_NPI.ACO_GroupTIN
, Agg_NPI.ACO_GroupTINName_New
, Agg_NPI.NPI
, AGG_NPI.NPI_Fullname
, Agg_NPI.PY_NPI
, Agg_NPI.NumBENE_NPI
, Agg_NPI.Hospital_NPI		--EDVisit_NPI
, Agg_NPI.Hospital_TIN		--EDVisit_TIN
, Agg_NPI.Hospital_ACO		--EDVisit_ACO
, Agg_NPI.ReAdmit_NPI		--EDVisit_E1000_NPI
, Agg_NPI.ReAdmit_TIN		--EDVisit_E1000_TIN
, Agg_NPI.ReAdmit_ACO		--EDVisit_E1000_ACO
, Agg_NPI.ReAdmit_Rate_NPI	--EDVisit_Average_PY_NPI
, Agg_NPI.ReAdmit_Rate_TIN	--EDVisit_Average_PY_TIN
, Agg_NPI.ReAdmit_Rate_ACO	--EDVisit_Average_PY_ACO
, Agg_NPI.ReAdmit_Rate_NPI_Under_TIN	--EDVisit_E1000_NPI_Under_TIN
, Agg_NPI.ReAdmit_Rate_NPI_Under_ACO	--EDVisit_E1000_NPI_Under_ACO
, Agg_NPI.ReAdmit_Flag_NPI_Under_TIN	--EDVisit_Flag_NPI_Under_TIN
, Agg_NPI.ReAdmit_Flag_NPI_Under_ACO	--ReAdmit_Flag_NPI_Under_ACO
, BonusTin.ReAdmit_Flag_TIN_Under_ACO	--EDVisit_Flag_TIN_Under_ACO
, BonusTin.ReAdmit_Bonus_TIN
, Agg_NPI.SQLRunDate_ReAdmit
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI Agg_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN BonusTIN on
Agg_NPI.ACO_GroupTIN = BonusTin.ACO_GroupTIN
Where
BonusTin.ReAdmit_Flag_TIN_Under_ACO = 1

-------------------------------
-- Calculation Quality Weight
-------------------------------
Update ReAdmitBonus
Set 
ReAdmit_Quality_Weight = 
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1 
		Then CCLF_Functions.dbo.Divide_Return0(
			 ReAdmit_Rate_NPI_Under_ACO 
		   , ReAdmit_Rate_ACO) * -1 -- Multiply by -1 so Bonus information is positive
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus

-----------------------------------------
-- Calculation BENE Weight
-- Beneficiares for NPI * Quality Weight
-----------------------------------------
Update ReAdmitBonus
Set 
ReAdmit_BENE_Weight =
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1 
		Then NumBENE_NPI * ReAdmit_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus

----------------------------------------------------
-- Calculate and Update Total Weight for Each TIN
-- Sum BENE Weight by TIN
----------------------------------------------------
Select 
  ReAdmitBonus.ACO_GroupTIN
, Sum(ReAdmitBonus.ReAdmit_BENE_Weight) as EDObos_TotalWeight
Into #Temp_ReAdmit_TotalWeight
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus
Where
ReAdmitBonus.ReAdmit_Flag_NPI_Under_ACO = 1
Group By
ReAdmitBonus.ACO_GroupTIN

Update ReAdmitBonus
Set 
ReAdmitBonus.ReAdmit_Total_Weight = 
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1 
		Then TW.EDObos_TotalWeight
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus
Inner Join
#Temp_ReAdmit_TotalWeight TW on
ReAdmitBonus.ACO_GroupTIN = TW.ACO_GroupTIN

-------------------------------------
-- Calculate ReAdmit Bonus Percent
-- (BENE Weight / BENE Total Weight)
-------------------------------------
Update ReAdmitBonus
Set 
ReAdmit_Bonus_Percent	= 
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0(ReAdmit_BENE_Weight, ReAdmit_Total_Weight)
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus

---------------------------------
-- Calculate ED Bonus
-- Bonus of TIN * Bonus Percent
---------------------------------
Update ReAdmitBonus
Set 
  ReAdmit_Bonus_PerNPI	=  
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1
		Then ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment_TIN
		Else 0
	End 
, ReAdmit_Bonus_NPI		=  
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1
		Then ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment_TIN
		Else 0
	End
, ReAdmit_Bonus_PerBENE	= 
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0(
		     (ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment_TIN), NumBENE_NPI)
		Else 0
	End
, ReAdmit_Bonus_Allotment_TIN = 
	Case
		When ReAdmit_Flag_NPI_Under_ACO = 1
		Then ReAdmit_Bonus_Allotment_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus

------------------------
-- Update SQLRunDate
------------------------
Update ReAdmitBonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_06_1_4_2_ReAdmit_Bonus_NPI ReAdmitBonus

End
