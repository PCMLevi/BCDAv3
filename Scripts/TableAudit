from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
	expExpenseType2 In ('Inpatient Hospital', 'Inpatient Swing Bed', 'SNF Inpatient')
and CM.cuFiscalYear = @FiscalYear
Group by 
  cuFiscalYear
, BENE_HIC_NUM
Having count(distinct CLM_FROM_DT) >= 2

Update CM
Set InStatus1_Inpatient = T23.NumVisits
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
#Temp23 T23 on
    CM.BENE_HIC_NUM = T23.BENE_HIC_NUM
and CM.cuFiscalYear = T23.cuFiscalYear
Where 
CM.cuFiscalYear = @FiscalYear

--------------------------
-- Outpatient >= 10
--------------------------
-------------------------------
-- Clear out OP Visits First
-------------------------------
Update CM
Set InStatus1_Outpatient = Null
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where
	cuFiscalYear			= @FiscalYear
and InStatus1_Outpatient	is not null

select 
  cuFiscalYear
, BENE_HIC_NUM
, count (distinct CLM_FROM_DT) as NumVisits
into #Temp24
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
CM.CLM_TYPE_CD = '40'
--expExpenseType2 In ('Hospital Outpatient','SNF Outpatient','Office, Clinic Services')
and CM.cuFiscalYear = @FiscalYear
Group by 
  cuFiscalYear
, BENE_HIC_NUM
Having count(distinct CLM_FROM_DT) >= 10

Update CM
Set InStatus1_Outpatient = T24.NumVisits
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
#Temp24 T24 on
    CM.BENE_HIC_NUM = T24.BENE_HIC_NUM
and CM.cuFiscalYear = T24.cuFiscalYear
Where
CM.cuFiscalYear = @FiscalYear

--------------------------
-- Update InStatus1 
--------------------------
--------------------------
-- Clear InStatus1
--------------------------
Update CM
Set CM.InStatus1 = Null
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where
	CM.InStatus1	is not null
and CM.cuFiscalYear = @FiscalYear

Select Distinct
  BENE_HIC_NUM
, cuFiscalYear
Into #Temp25
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where
(
   InStatus1_Catastrophic	is not null
or InStatus1_ED				is not null
or InStatus1_Inpatient		is not null
or InStatus1_Outpatient		is not null
)
and CM.cuFiscalYear = @FiscalYear
Order by
  BENE_HIC_NUM
, cuFiscalYear

Update CM
Set InStatus1 = T25.cuFiscalYear
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
#Temp25 T25 on
    CM.BENE_HIC_NUM = T25.BENE_HIC_NUM
and CM.cuFiscalYear = T25.cuFiscalYear
Where
CM.cuFiscalYear = @FiscalYear

----------------------------------------------------------------
-- Update Payment Amount Range
----------------------------------------------------------------
Select 
  cuFiscalYear
, BENE_HIC_NUM
, Sum(CLM_PMT_AMT) as TotalPaid
Into #Temp26
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
CM.cuFiscalYear = @FiscalYear
Group by
  cuFiscalYear
, BENE_HIC_NUM

Update CM
Set Payment_Range = 
	Case 
		When TotalPaid between      0 and  10000	Then '000-10K'
		When TotalPaid between  10001 and  25000	Then '010-25K'
		When TotalPaid between  25001 and  50000	Then '025-50K'
		When TotalPaid between  51001 and  75000	Then '050-75K'
		When TotalPaid between  75001 and 100000	Then '075-100K'
		When TotalPaid between 100001 and 150000	Then '100-150K'
		When TotalPaid between 150001 and 200000	Then '150-200K'
		When TotalPaid > 200000						Then '200K+'
	END
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
#Temp26 T26 on
	CM.cuFiscalYear = T26.cuFiscalYear
and CM.BENE_HIC_NUM = T26.BENE_HIC_NUM
Where
CM.cuFiscalYear = @FiscalYear

--------------------------------------------------
-- Update the Hipps Grouper for Home Health Records
--------------------------------------------------
Update CU
Set HippsGrouper = HG.Grouper
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Inner Join
CCLF_LookupTables.dbo.tbl_HippsGrouper HG on
CU.PRNCPL_DGNS_CD = HG.DGNS_CD
Where
	expExpenseType1		= 'Home Health'
and cuFiscalYear		= @FiscalYear

--------------------------------------------------
-- Update the Hospital Inpatient to Rehab
--------------------------------------------------
Update CU
Set 
  expExpenseType1 = 'Inpatient Rehab'
, expExpenseType2 = 'Inpatient Rehab'
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Where
	CLM_TYPE_CD					= '60'
and CLM_LINE_PROD_REV_CTR_CD	= '0024'
and cuFiscalYear				= @FiscalYear

--------------------------------------------------
-- Update Attribution Quarter
--------------------------------------------------
Update CM
Set CM.Attribution_Quarter = ACO_BENE.BENE_YearQuarter
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
CM.BENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Where
CM.CLM_THRU_DT between @StartDate and @StopDate
and ACO_BENE.BENE_YearQuarter = @YearQuarter

--------------------------------------------------
-- Update Attribution Quarter that is Null
-- Give it Last Attributed Quarter
--------------------------------------------------
Update CM
Set CM.Attribution_Quarter = CM.LastAttributed
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where
	CM.CLM_THRU_DT			between @StartDate and @StopDate
and CM.Attribution_Quarter	is null

update CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager
set SQLRunDate = getdate()
/*
--------------------------------------------------
--Update Bene_MasterID											--Levi 8/11/2025
--------------------------------------------------
update cclf_reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager
set BENE_MasterID = ML.BENE_MasterID
from cclf_reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
left join CCLF_LookupTables.dbo.ACO_BENE_MasterList ML on
CM.BENE_HIC_NUM = ML.BENE_HIC_NUM
where CM.CLM_THRU_DT between @StartDate and @StopDate


update cclf_reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager
set BENE_MasterID = ML.BENE_MasterID
from cclf_reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
