Select Distinct 
  Q1_HICN
, Q1_HICN_Prev
, 1 as MonthFlag
, @StartDate_1	as StartDate
, @StopDate_1	as StopDate
, Case
	When MonthlyEligibilityFlag1 = '0' Then 'NONE'
	When MonthlyEligibilityFlag1 = '1' Then 'ESRD'
	When MonthlyEligibilityFlag1 = '2' Then 'Disabled'
	When MonthlyEligibilityFlag1 = '3' Then 'Aged_Dual'
	When MonthlyEligibilityFlag1 = '4' Then 'Aged_NonDual'
  End as MonthFlagType
, (Cast(1 as Float) /12) As BENE_PY
Into #Temp_Month1
from CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
Where
	Q1_YearQuarter			= @Compensation_Quarter
and MonthlyEligibilityFlag1 <> 0				-- vst Added 9/24/2025

