5631,2026-08-12T14:30:29.476326,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_30_2_1_UpdatePhysicianVoluntaryAlignment,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_30_2_1_UpdatePhysicianVoluntaryAlignment
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	Update ACO_BENE
Set 
  ACO_BENE.BENE_ACO_GroupTIN			= ACO.ACO_GroupTin
, ACO_BENE.BENE_ACO_GroupTINName		= ACO.ACO_GroupTinName
, ACO_BENE.BENE_ACO_GroupTinShortName	= ACO.ACO_GroupTinShortName
, ACO_BENE.BENE_NPI_Number				= ACO.ACO_NPIIndividual
, ACO_BENE.BENE_NPI_LastName			= ACO.ACO_NPI_LastName
, ACO_BENE.BENE_NPI_FirstName			= ACO.ACO_NPI_FirstName
, ACO_BENE.BENE_ATTR_From				= 'Physician VA'
, ACO_BENE.SQLRunDate					= GetDate()
, ACO_BENE.BENE_NPI_Classification		= ACO.ACO_NPI_Classification
, ACO_BENE.BENE_PhysicianAlignment		= 'Yes'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries_VoluntaryAlignment VA on
ACO_BENE.BENE_HIC_NUM = VA.VA_BENE_HIC_NUM
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
VA.VA_NPI = ACO.ACO_NPIIndividual
Where
ACO_BENE.BENE_ATTR_From <> 'Voluntary Aligned'
END
