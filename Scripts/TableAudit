4345,2026-07-13T13:09:26.138994,ALTER_PROCEDURE,CCLF_Procedures,dbo,CCLF_CU_BIG_02_CostUtilization_BIG_AllAttributed_CohortManager,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
ALTER PROCEDURE [dbo].[CCLF_CU_BIG_02_CostUtilization_BIG_AllAttributed_CohortManager]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	------------------------------------------------
-- Cohort Manager 2024
------------------------------------------------
Declare @FiscalYear		as char(6)

Declare @YearQuarter	as Varchar(7)
Declare @StartDate		as date
Declare @StopDate		as date
Declare @IDRLoadDate	as date

Set @FiscalYear		= (Select FiscalYear From Database_Constants.dbo.Import_Export_Automated)

Set @YearQuarter	= (Select CurrentQuarter 	From Database_Constants.dbo.Import_Export_Automated)
Set @StartDate		= (Select StartDate From Database_Constants.dbo.Import_Export_Automated)
Set @StopDate		= (Select StopDate  From Database_Constants.dbo.Import_Export_Automated)
Set @IDRLoadDate	= (Select IDR_LD_DT From Database_Constants.dbo.Import_Export_Automated)

Delete from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager Where cuFiscalYear = @FiscalYear
Drop Table if Exists #Temp40

---------------------------------------------------------------------
-- Run the Query and put all of the data in Table CostUtilization
---------------------------------------------------------------------
Select
  @FiscalYear as 'cuFiscalYear'
, MedicareFileDate
, Id
, Finaldata.BENE_MasterID					--add Bene_MasterID Levi 8/8/2025
, FinalData.BENE_HIC_NUM
, Uniq.LastAttributed
, CUR_CLM_UNIQ_ID
, FinalData.CLM_LINE_NUM
, CLM_FROM_DT
, CLM_THRU_DT
, CLM_PMT_AMT
, expExpenseOrder
, expExpenseType
, expExpenseType1
, expExpenseType2
, expExpenseType_ShortLabel
, expExpenseType1_ShortLabel
, expExpenseType2_ShortLabel
, expLOSCalculation
--, expColor
Into #Temp40
from CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData
Left Join
CCLF_LookupTables.dbo.tbl_ExpenseType ET on
    (FinalData.CLM_TYPE_CD = ET.expCLM_TYPE_CD
or  (FinalData.CLM_TYPE_CD is null and et.expCLM_TYPE_CD is Null))
and (FinalData.CLM_BILL_FAC_TYPE_CD = ET.expCLM_BILL_FAC_TYPE_CD
or  (FinalData.CLM_BILL_FAC_TYPE_CD is null and ET.expCLM_BILL_FAC_TYPE_CD is null))
and (FinalData.CLM_BILL_CLSFCTN_CD = ET.expCLM_BILL_CLSFCTN_CD
or  (FinalData.CLM_BILL_CLSFCTN_CD is null and ET.expCLM_BILL_CLSFCTN_CD is null))
and (FinalData.CLM_POS_CD = ET.expCLM_POS_CD
or  (FinalData.CLM_POS_CD is null and ET.expCLM_POS_CD is null))
Inner Join	-- Changed from Left to Inner on 6/7/2022
CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq on
FinalData.BENE_HIC_NUM = Uniq.BENE_HIC_NUM
Where 
    CLM_THRU_DT		between @StartDate and @StopDate
and CLM_IDR_LD_DT	<= @IDRLoadDate


------------------------------------------------------------------
-- Select The records from the temp table, group by and 
-- insert into cost utilization table
------------------------------------------------------------------
Insert into CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager
(
  cuFiscalYear
, MedicareFileDate
, FinalDataId
, BENE_MasterID				--add Bene_MasterID Levi 8/8/2025
, BENE_HIC_NUM
, LastAttributed
, CUR_CLM_UNIQ_ID
, CLM_FROM_DT
, CLM_THRU_DT
, CLM_PMT_AMT
, expExpenseOrder
, expExpenseType
, expExpenseType1
, expExpenseType2
, expExpenseType_ShortLabel
, expExpenseType1_ShortLabel
, expExpenseType2_ShortLabel
, expLOSCalculation
--, expColor
)
Select 
  cuFiscalYear
, MedicareFileDate
, ID
, BENE_MasterID          --add Bene_MasterID Levi 8/8/2025
, BENE_HIC_NUM
, LastAttributed
, CUR_CLM_UNIQ_ID
, CLM_FROM_DT
, CLM_THRU_DT
, Sum(COALESCE(CLM_PMT_AMT,0)) as CLM_PMT_ATM
, expExpenseOrder
, expExpenseType
, expExpenseType1
, expExpenseType2
, expExpenseType_ShortLabel
, expExpenseType1_ShortLabel
, expExpenseType2_ShortLabel
, expLOSCalculation
--, expColor
from #Temp40

Group by
  cuFiscalYear
, MedicareFileDate
, ID
, BENE_MasterID
, BENE_HIC_NUM
, LastAttributed
, CUR_CLM_UNIQ_ID
, CLM_FROM_DT
, CLM_THRU_DT
, expExpenseOrder
, expExpenseType
, expExpenseType1
, expExpenseType2
, expExpenseType_ShortLabel
, expExpenseType1_ShortLabel
, expExpenseType2_ShortLabel
, expLOSCalculation
--, expColor

Order by
  BENE_HIC_NUM
, CLM_FROM_DT
, CUR_CLM_UNIQ_ID

-----------------------------------------------------------------------
-- Update all of the rest of the fields in the Cohort Table
-- (All except expExpenseType3 - It will be updated at the last of the
-- code.
----------------------------------------------------------------------- 
Update CU
Set 
  CLM_TYPE_CD				= FinalData.CLM_TYPE_CD
, CLM_BILL_FAC_TYPE_CD		= FinalData.CLM_BILL_FAC_TYPE_CD
, CLM_BILL_CLSFCTN_CD		= FinalData.CLM_BILL_CLSFCTN_CD
, CLM_POS_CD				= FinalData.CLM_POS_CD
, CLM_POS_Short				= POS.CLM_POS_Short
, CLM_LINE_PROD_REV_CTR_CD	= FinalData.CLM_LINE_PROD_REV_CTR_CD
, CLM_LINE_PROD_REV_CTR		= REV.CLM_LINE_PROD_REV_CTR
, CLM_LINE_PROD_REV_Group1	= REV.CLM_LINE_PROD_REV_Group1
, HCPCS_BETOS_CD			= FinalData.HCPCS_BETOS_CD
, HCPCS_BETOS				= FinalData.HCPCS_BETOS
, FAC_FacilityName			= CCLF_Functions.dbo.FacilityName
(
  FinalData.CLM_TYPE_CD
, FinalData.FAC_Prvdr_Org_Name_Lgl_Bus_Name
, FinalData.FAC_Prvdr_Othr_Org_Name
, FinalData.CLM_POS
) 
, Doctor_NPI_Name			= CCLF_Functions.dbo.Doctor_NPI_Name
(
  FinalData.CLM_TYPE_CD
, FinalData.ATNDG_PRVDR_LName
, FinalData.ATNDG_PRVDR_FName
, FinalData.ATNDG_PRVDR_NPI_NUM
, FinalData.OPRTG_PRVDR_LName
, FinalData.OPRTG_PRVDR_FName
, FinalData.OPRTG_PRVDR_NPI_NUM
, FinalData.RNDRG_PRVDR_LName
, FinalData.RNDRG_PRVDR_FName
, FinalData.RNDRG_PRVDR_NPI_NUM
, FinalData.PAYTO_PRVDR_LName
, FinalData.PAYTO_PRVDR_FName
, FinalData.PAYTO_PRVDR_NPI_NUM
, FinalData.ORDRG_PRVDR_LName
, FinalData.ORDRG_PRVDR_FName
, FinalData.ORDRG_PRVDR_NPI_NUM
) 
, PCPName					= Uniq.BENE_NPI_LastName + ', ' + BENE_NPI_FirstName		-- Changed From FinalData to Unique
, PCPNPI					= Uniq.BENE_NPI_Number
, ACO_GroupTin				= Uniq.ACO_GroupTin
, ACO_GroupTinShortName		= Uniq.ACO_GroupTinShortName
, PRNCPL_DGNS_CD			= FinalData.PRNCPL_DGNS_CD
, PRNCPL_DGNS				= FinalData.PRNCPL_DGNS
, DGNS_DRG_CD				= FinalData.DGNS_DRG_CD
, DGNS_DRG					= FinalData.DGNS_DRG
, CLM_LINE_HCPCS_CD			= FinalData.CLM_LINE_HCPCS_CD
, CLM_LINE_HCPCS			= FinalData.CLM_LINE_HCPCS
, hipps150Char				= HIPPS.hipps150Char
, hippsDescription			= HIPPS.hippsDescription
, hippsPosition1_Desc		= HIPPS.hippsPosition1_Desc
, hippsPosition2_Desc		= HIPPS.hippsPosition2_Desc
, hippsPosition3_Desc		= HIPPS.hippsPosition3_Desc
, CLM_PRVDR_SPCLTY_CD		= FinalData.CLM_PRVDR_SPCLTY_CD
, CLM_PRVDR_SPCLTY			= FinalData.CLM_PRVDR_SPCLTY
, CLM_ADJSMT_TYPE_CD		= FinalData.CLM_ADJSMT_TYPE_CD
, CLM_LINE_NUM				= FinalData.CLM_LINE_NUM
, PRVDR_OSCAR_NUM		    = FinalData.PRVDR_OSCAR_NUM
, PRVDR_OSCAR_NUM_ForLookup = Case When Substring(FinalData.PRVDR_OSCAR_NUM,3,1) = 'T' Then Left(FinalData.PRVDR_OSCAR_NUM,2) + '0' + Right(FinalData.PRVDR_OSCAR_NUM,3)
								   When Substring(FinalData.PRVDR_OSCAR_NUM,3,1) = 'S' Then Left(FinalData.PRVDR_OSCAR_NUM,2) + '0' + Right(FinalData.PRVDR_OSCAR_NUM,3)
								   When Substring(FinalData.PRVDR_OSCAR_NUM,3,1) = 'Z' Then Left(FinalData.PRVDR_OSCAR_NUM,2) + '1' + Right(FinalData.PRVDR_OSCAR_NUM,3)
								   When Substring(FinalData.PRVDR_OSCAR_NUM,3,1) = 'U' Then Left(FinalData.PRVDR_OSCAR_NUM,2) + '0' + Right(FinalData.PRVDR_OSCAR_NUM,3)
								   When ISNUMERIC(FinalData.PRVDR_OSCAR_NUM) = 1 Then FinalData.PRVDR_OSCAR_NUM
								   Else Null
							  END
, losNumberDays				= iif(FinalData.CLM_LINE_NUM = 1,DATEDIFF(day, FinalData.CLM_FROM_DT, FinalData.CLM_THRU_DT), Null)
, Covid19Episode			= FinalData.Covid19Episode
, Covid19Positive			= FinalData.Covid19Positive
, Covid19ExcludeCost		= FinalData.Covid19ExcludeCost
, ICD10CM_Level2			= ICD10_3.ICD10CM_Desc
, CLM_MDCR_NPMT_RSN_CD		= FinalData.CLM_MDCR_NPMT_RSN_CD
, CLM_MDCR_NPMT_RSN			= FinalData.CLM_MDCR_NPMT_RSN
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Inner Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
CU.FinalDataId = FinalData.ID
Left Join
CCLF_LookupTables.dbo.tbl_HIPPS_CD HIPPS on
FinalData.CLM_LINE_HCPCS_CD = HIPPS.hippsCode
Left Join
CCLF_LookupTables.dbo.tbl_BENE_PTNT_STUS_CD STUS on
FinalData.BENE_PTNT_STUS_CD = STUS.BENE_PTNT_STUS_CD
Left Join
CCLF_LookupTables.dbo.tbl_CLM_POS_CD POS on
CU.CLM_POS_CD = POS.CLM_POS_CD
Left Join
CCLF_LookupTables.dbo.tbl_CLM_LINE_PROD_REV_CTR_CD REV on
CU.CLM_LINE_PROD_REV_CTR_CD = REV.CLM_LINE_PROD_REV_CTR_CD
Left Join
CCLF_LookupTables.dbo.ACO ACO on
FinalData.BENE_PCP_NPI = ACO.ACO_NPIIndividual
Left Join
CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq on
CU.BENE_HIC_NUM = Uniq.BENE_HIC_NUM
Left Join
CCLF_LookupTables.dbo.tbl_ICD10CM_Level3 ICD10_3 on
Left(CU.PRNCPL_DGNS_CD,3) = ICD10_3.ICD10CM_Code
Where 
cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Update Provider Oscar Category and Subcategory
----------------------------------------------------------------------- 
Update CU
Set 
  PRVDR_OSCAR_CTGRY				= OSCAR.PRVDR_CTGRY
, PRVDR_OSCAR_CTGRY_SBTYP		= OSCAR.PRVDR_CTGRY_SBTYP
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Inner Join CCLF_LookupTables.dbo.CCN_PRVDR_OSCAR_NUM OSCAR on
CU.PRVDR_OSCAR_NUM_ForLookup = OSCAR.PRVDR_NUM
Where 
cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Update Claim Type Short (CLM_TYPE_CD) is Udated first in above code
----------------------------------------------------------------------- 
Update CU
Set 
  CLM_TYPE_Short				= CLMType.CLM_TYPE_Short
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Left Join
CCLF_LookupTables.dbo.tbl_CLM_TYPE_CD CLMType on
CU.CLM_TYPE_CD = CLMType.CLM_TYPE_CD
Where 
cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Update Place of Service All Separately.  All of the necessary fields
-- are now in the CostUtilization table.  This is a long function
-- Also update CPD now that we have LOS in the table
----------------------------------------------------------------------- 
Update CU
Set CLM_POS_ALL = CCLF_Functions.dbo.ClaimPlaceOfService_ALL
(
  CLM_TYPE_CD
, CLM_POS_Short
, CLM_BILL_CLSFCTN_CD
, CLM_BILL_FAC_TYPE_CD
)
, CLM_CPD		= CLM_PMT_AMT / Nullif(CLM_LOS,0)
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Where 
cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Update expExpenseType3 Separately.  All of the necessary fields
-- are now in the CostUtilization table.  This last update has to call
-- two different functions, and therefore takes the longest.  
-- I didn't want to join any tables when running this update.
----------------------------------------------------------------------- 
Update CU
Set expExpenseType3 = CCLF_Functions.dbo.funcExpenseType
(
  CLM_TYPE_CD
, CLM_BILL_FAC_TYPE_CD
, CLM_BILL_CLSFCTN_CD
, CLM_POS_CD
, CLM_LINE_PROD_REV_CTR_CD
, CLM_LINE_HCPCS_CD
, CLM_FED_TYPE_SRVC_CD
, CLM_PRVDR_SPCLTY_CD
, expExpenseType1_ShortLabel
)
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Where 
cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Update expExpenseType3 Again just for Hospital Outpatient
----------------------------------------------------------------------- 
Drop Table if exists #Temp12
Drop Table if exists #Temp13
Drop Table if exists #Temp14

--------------------------------------------------
-- Find all of the REVCTR records 
--------------------------------------------------
Select Distinct
  CU.CUR_CLM_UNIQ_ID
Into #Temp12
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Inner Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
CU.CUR_CLM_UNIQ_ID = FinalData.CUR_CLM_UNIQ_ID
Inner Join
CCLF_LookupTables.dbo.tbl_ExpenseType ET on
    CU.expExpenseType	= ET.expExpenseType
and CU.expExpenseType1	= ET.expExpenseType1
and CU.expExpenseType2	= ET.expExpenseType2
Where
    ET.expExpenseType3_From1 = 'REVCTR'
and ET.expExpenseType3_From2 is Null
and FinalData.CCLFFile In ( 'CCLF1' , 'CCLF2' )
and CU.expExpenseType2 = 'Outpatient Hospital'
and CU.CLM_LINE_NUM = 1
and cuFiscalYear = @FiscalYear

--------------------------------------------------
-- Find the record that has the largest payment
--------------------------------------------------
Select Distinct
  FinalData.CUR_CLM_UNIQ_ID
, Max(CLM_LINE_CVRD_PD_AMT) as MaxPaidAmount
Into #Temp13
from CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData 
Inner Join #Temp12 T12 on
FinalData.CUR_CLM_UNIQ_ID = T12.CUR_CLM_UNIQ_ID
Where 
CLM_LINE_CVRD_PD_AMT <> 0		
Group By
  FinalData.CUR_CLM_UNIQ_ID

--------------------------------------------------
-- Some records have the same Payment Amount,
-- so pick the max RevCtr
--------------------------------------------------
Select Distinct
  FinalData.CUR_CLM_UNIQ_ID
, MaxPaidAmount
, Max(REV.CLM_LINE_PROD_REV_Group2) as MaxRevGroup2
Into #Temp14
From #Temp13 T13
Inner Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
T13.CUR_CLM_UNIQ_ID = FinalData.CUR_CLM_UNIQ_ID
and T13.MaxPaidAmount = FinalData.CLM_LINE_CVRD_PD_AMT
Left Join
CCLF_LookupTables.dbo.tbl_CLM_LINE_PROD_REV_CTR_CD REV on
FinalData.CLM_LINE_PROD_REV_CTR_CD = REV.CLM_LINE_PROD_REV_CTR_CD
Group By
FinalData.CUR_CLM_UNIQ_ID
, MaxPaidAmount

--------------------------------------------------
-- Update the CostUtilization Data
--------------------------------------------------
Update CU
Set expExpenseType3 = expExpenseType1_ShortLabel + '-' +  T14.MaxRevGroup2   -- Did have this hardcoded to OP, but changed to expExpenseType1_ShortLabel
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CU
Inner Join #Temp14 T14 on
CU.CUR_CLM_UNIQ_ID = T14.CUR_CLM_UNIQ_ID
Where 
CU.CLM_LINE_NUM = 1
and cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Update Place of Service All Separately.  All of the necessary fields
-- are now in the CostUtilization table.  This is a long function
----------------------------------------------------------------------- 
Update CM
Set CLM_POS_ALL = CCLF_Functions.dbo.ClaimPlaceOfService_ALL
(
  CLM_TYPE_CD
, CLM_POS_Short
, CLM_BILL_CLSFCTN_CD
, CLM_BILL_FAC_TYPE_CD
)
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
cuFiscalYear = @FiscalYear

-----------------------------------------------------------------------
-- Find all of the Patients that have been in Home Health,
-- Physical Therapy, or Hospice
----------------------------------------------------------------------- 
Drop Table if exists #Temp1
Drop Table if exists #Temp2
Drop Table if exists #Temp3
Drop Table if exists #Temp4
Drop Table if exists #Temp5
Drop Table if exists #Temp6
Drop Table if exists #Temp7
Drop Table if exists #Temp8
Drop Table if exists #Temp16
Drop Table if exists #Temp9

------------------------------------
-- Home Health
------------------------------------
Select Distinct 
   BENE_HIC_NUM
, 'FY' + Format(CLM_THRU_DT, 'yyyy') as FiscalYear
Into #Temp1
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
CLM_TYPE_CD = '10'		-- Home Health
and cuFiscalYear = @FiscalYear

Update CM
Set InHomeHealth = T1.FiscalYear
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join #Temp1 T1 on
	CM.cuFiscalYear = T1.FiscalYear
and CM.BENE_HIC_NUM = T1.BENE_HIC_NUM
and CM.cuFiscalYear = @FiscalYear

------------------------------------
-- Physical Therapy
------------------------------------
Select Distinct 
   BENE_HIC_NUM
, 'FY' + Format(CLM_THRU_DT, 'yyyy') as FiscalYear
Into #Temp2
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join
CCLF_LookupTables.dbo.tbl_CLM_LINE_HCPCS_Specialty HCPCS on
CM.CLM_LINE_HCPCS_CD = HCPCS.CLM_LINE_HCPCS_CD
Where 
	HCPCS.CLM_LINE_HCPCS_Specialty	= 'PhysicalTherapy'		-- Physical Therapy Codes
and CM.cuFiscalYear					= @FiscalYear


Update CM
Set InPhysicalTherapy = T2.FiscalYear
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join #Temp2 T2 on
	CM.cuFiscalYear = T2.FiscalYear
and CM.BENE_HIC_NUM = T2.BENE_HIC_NUM
and CM.cuFiscalYear = @FiscalYear

------------------------------------
-- Skilled Nursing Facility
------------------------------------
Select Distinct 
   BENE_HIC_NUM
, 'FY' + Format(CLM_THRU_DT, 'yyyy') as FiscalYear
Into #Temp9
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
	CLM_TYPE_CD		In ('20', '30')		-- SNF
and cuFiscalYear	= @FiscalYear

Update CM
Set InSNF = T9.FiscalYear
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Inner Join #Temp9 T9 on
	CM.cuFiscalYear = T9.FiscalYear
and CM.BENE_HIC_NUM = T9.BENE_HIC_NUM
and CM.cuFiscalYear = @FiscalYear

------------------------------------
-- Hospice
------------------------------------
Select Distinct 
   BENE_HIC_NUM
, 'FY' + Format(CLM_THRU_DT, 'yyyy') as FiscalYear
Into #Temp3
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_CohortManager CM
Where 
	CLM_TYPE_CD		= '50'		--- Hospice
and cuFiscalYear	= @FiscalYear


Update CM
