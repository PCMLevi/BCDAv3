3846,2026-06-27T14:54:39.867280,CREATE_FUNCTION,CCLF_Functions,dbo,Percent_Under,"
----------------------------------------------------------------------
-- This function will Calculate the Percent UNDER
--
-- Use Percent Under for ED Vists, RTA, etc.  
-- NPI (@Numerator) wants to be Under the ACO Average (@Denominator)
-- ie: Less ED Visits, Less ReAdmits
--
-- Use Percent Over for Quality Measures BP, Dep Screening, etc.
-- NPI (@Numerator) wants to be Over the ACO Average (@Denominator)
-- ie: More BP Pass, More Dep Screen
--
----------------------------------------------------------------------

Create Function Percent_Under
(
  @Numerator		as float
, @Denominator		as Float
)

RETURNS Float
AS

BEGIN

Declare @Percent_Under as Float

Set @Percent_Under = CCLF_Functions.dbo.Divide_Return0((@Denominator - @Numerator), @Denominator)

Return @Percent_Under

END

"
3845,2026-06-27T14:52:53.803598,CREATE_FUNCTION,CCLF_Functions,dbo,Percent_Over,"
----------------------------------------------------------------------
-- This function will Calculate the Percent Over the Group
--
-- Use Percent Over for Quality Measures BP, Dep Screening, etc.
-- NPI (@Numerator) wants to be Over the ACO Average (@Denominator)
-- ie: More BP Pass, More Dep Screen
--
-- Use Percent Under for ED Vists, RTA, etc.  
-- NPI (@Numerator) wants to be Under the ACO Average (@Denominator)
-- ie: Less ED Visits, Less ReAdmits
--
----------------------------------------------------------------------
Create Function Percent_Over
(
  @Numerator		as Int
, @Denominator		as Int
)

RETURNS Float
AS

BEGIN

Declare @Percent_Over as Float

Set @Percent_Over = CCLF_Functions.dbo.Divide_Return0((@Numerator - @Denominator), @Denominator)

Return @Percent_Over

END

