--------------------------------------------------
Select Distinct
  BENE_HIC_NUM
, Min(CLM_THRU_DT)		as CLM_THRU_DT
, CLM_DGNS_CD
Into #Temp2
From ##Temp1
Group by
  BENE_HIC_NUM
, CLM_DGNS_CD
Order by 
  BENE_HIC_NUM
, CLM_DGNS_CD

------------------------------------------------------------
-- Join back to #Temp1 to find the Minimum CUR_CLM_UNIQ_ID
------------------------------------------------------------
Select 
  T2.BENE_HIC_NUM
, T2.CLM_THRU_DT
, T2.CLM_DGNS_CD
, Min(CLM_DGNS_Position)	as CLM_DGNS_Position
, Min(T1.CUR_CLM_UNIQ_ID)	as CUR_CLM_UNIQ_ID
Into #Temp3
From #Temp2 T2
Inner Join 
##Temp1 T1 on
	T2.BENE_HIC_NUM = T1.BENE_HIC_NUM
and T2.CLM_DGNS_CD	= T1.CLM_DGNS_CD
and T2.CLM_THRU_DT	= T1.CLM_THRU_DT
Group by
  T2.BENE_HIC_NUM
, T2.CLM_THRU_DT
, T2.CLM_DGNS_CD
Order by
  T2.BENE_HIC_NUM
, T2.CLM_DGNS_CD
, T2.CLM_THRU_DT

