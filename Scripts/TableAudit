2640,2026-06-10T13:57:25.659908,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_2_3_ReAdmit_Calculations,"
Alter Procedure procCompensation_PYCurrent_06_2_3_ReAdmit_Calculations
(	
	    @Compensation_Year		as Varchar(6)  -- vst - Changed from 6 to 7 for Testing
	  , @Compensation_Quarter	as Varchar(6)
	  , @Compensation_Percent	As Float

)

AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate E1000 For Each Group
--=======================================

--===========
-- ACO
--===========
Select 
  Sum(ReAdmit_ACO)	as ReAdmit_ACO
, Sum(PY_ACO)		As PY_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_06_2_2_4_ReAdmit_Aggregate_ACO

Update ACO
Set ReAdmit_E1000_ACO = CCLF_Functions.dbo.Divide_Return0(TACO.ReAdmit_ACO, TACO.PY_ACO) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_4_ReAdmit_Aggregate_ACO ACO
Inner Join
#Temp_ACO TACO on
1=1

--===========
-- NPI
--===========
Select 
  NPI
, Sum(ReAdmit_NPI)	as ReAdmit_NPI
, Sum(PY_NPI)		As PY_NPI
Into #Temp_NPI
From Compensation_PYCurrent.dbo.Compensation_06_2_2_2_ReAdmit_Aggregate_NPI
Group By
NPI

Update NPI
Set ReAdmit_E1000_NPI = 
	CCLF_Functions.dbo.Divide_Return0(TNPI.ReAdmit_NPI, TNPI.PY_NPI) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_2_ReAdmit_Aggregate_NPI NPI
Inner Join
#Temp_NPI TNPI on
TNPI.NPI = NPI.NPI

--===========
-- TIN
--===========
Select 
  ACO_GroupTIN
, Sum(ReAdmit_TIN)	as ReAdmit_TIN
, Sum(PY_TIN)		As PY_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN
Group By
ACO_GroupTIN

Update TIN
Set ReAdmit_E1000_TIN = 
	CCLF_Functions.dbo.Divide_Return0(TTIN.ReAdmit_TIN, TTIN.PY_TIN) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN TIN
Left Join
#Temp_TIN TTIN on
TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN

--=======================================
-- Calculate E1000 Average For Each Group
--=======================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Average
--=========================
Declare @Average_ACO as Float
Declare @Average_TIN as Float
Declare @Average_NPI as Float

Set @Average_ACO = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(ReAdmit_ACO), Sum(PY_ACO)) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_4_ReAdmit_Aggregate_ACO ACO)

Update ACO
Set ReAdmit_E1000_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_06_2_2_4_ReAdmit_Aggregate_ACO ACO

--=========================
-- TIN Average
--=========================
Set @Average_TIN = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(ReAdmit_TIN), Sum(PY_TIN)) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN TIN)

Update TIN
Set TIN.ReAdmit_E1000_Average_TIN = @Average_TIN
From Compensation_PYCurrent.dbo.Compensation_06_2_2_3_ReAdmit_Aggregate_TIN TIN

--=========================
-- NPI Average
--=========================
Set @Average_NPI = 
(Select CCLF_Functions.dbo.Divide_Return0(Sum(ReAdmit_NPI), Sum(PY_NPI)) * 1000 
From Compensation_PYCurrent.dbo.Compensation_06_2_2_2_ReAdmit_Aggregate_NPI NPI)

Update NPI
Set NPI.ReAdmit_E1000_Average_NPI = @Average_NPI
From Compensation_PYCurrent.dbo.Compensation_06_2_2_2_ReAdmit_Aggregate_NPI NPI


End"
