2726,2026-06-12T13:28:15.699265,ALTER_PROCEDURE,CCLF_Procedures,dbo,CCLF_CU_BIG_09_CostUtilization_BIG_AllAttributed_Readmit_Hospital,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
ALTER PROCEDURE [dbo].[CCLF_CU_BIG_09_CostUtilization_BIG_AllAttributed_Readmit_Hospital]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	
---------------------------------------------------------------------------------------------------------------------
-- Find All of the ReAdmits for Hospital stays (Another hospital admit <30 days from clm_thru_dt
---------------------------------------------------------------------------------------------------------------------

Declare @InsertRecord			as int
Declare @Counter				int = 2
Declare @Max					int = 0
Declare @ReadmitDays			int = 0
Declare @Current_BENE			as char(11)		-- BENE_HIC_NUM of current Record
Declare @Current_From			as date			-- CLM_FROM_DT of current Record
Declare @Current_Thru			as date			-- CLM_THRU_DT of current Record
Declare @Current_ExpType2		as char(25)		-- expExpenseType2 of Current Record
Declare @Current_losID			int
Declare @Previous_BENE			as char(11)		-- BENE_HIC_NUM of previous Record
Declare @Previous_From			as date			-- CLM_FROM_DT of previous Record
Declare @Previous_Thru			as date			-- CLM_THRU_DT of previous Record
Declare @Previous_ExpType2		as char(25)		-- expExpenseType1 of previous Record
Declare @Previous_losID			int

Truncate Table CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital

--------------------------------------------------
-- Declare a variable of type TABLE.  It will be
-- used as a temporary table.
--------------------------------------------------
Declare @myTable TABLE 
(
  [Id]					int identity primary key clustered
, [losID]				int
, [BENE_HIC_NUM]		char(11)
, [ExpType2]			char(25)
, [CLM_FROM_DT]			date
, [CLM_THRU_DT]			date

)

--------------------------------------------------
-- Insert required data into the variable of
-- type TABLE
--------------------------------------------------
Insert into @MyTable

--------------------------------------------------
-- Sort data by Beneficiary, From Date
--------------------------------------------------
Select 
  losID
, losBENE_HIC_NUM
, losExpenseType2
, losCLM_FROM_DT
, losCLM_THRU_DT
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS
Where 
    losCLM_FROM_DT >= '1/1/2020'
and NOT (losCLM_FROM_DT = losCLM_THRU_DT)
and losExpenseType = 'Hospital'
and losExpenseType2 In ('Inpatient Hospital', 'Hosp Outpatient','Hospital Outpatient')
--and losBENE_HIC_NUM in ('006289233A')
Group by
  losId
, losBENE_HIC_NUM
, losExpenseType2
, losCLM_FROM_DT
, losCLM_THRU_DT
Order by
  losBENE_HIC_NUM
, losCLM_FROM_DT

Select * From @myTable
Order by 
  BENE_HIC_NUM
, CLM_FROM_DT

-----------------------------------------------------------------------------
-- Initialize the @max variable. This variable will be used in the next
-- While loop
-----------------------------------------------------------------------------
Select @Max = Count(ID) From @myTable

    Set @Previous_BENE =			(Select BENE_HIC_NUM		From @myTable Where ID = 1)
	set @Previous_ExpType2 =		(Select ExpType2			From @myTable where ID = 1)
	Set @Previous_From =			(Select CLM_FROM_DT			From @myTable Where ID = 1)
	Set @Previous_Thru =			(Select CLM_THRU_DT			From @myTable Where ID = 1)
	Set @Previous_losID =			(Select losID				From @myTable Where ID = 1)

	------------------------------------------------------
	-- Catch the last record in the dataset
	------------------------------------------------------
While @Counter <= @Max
BEGIN

    Set @Current_BENE =			(Select BENE_HIC_NUM		From @myTable Where ID = @Counter)
	set @Current_ExpType2 =		(Select ExpType2			From @myTable where ID = @Counter)
	Set @Current_Thru =			(Select CLM_THRU_DT			From @myTable Where ID = @Counter)
	Set @Current_From =			(Select CLM_FROM_DT			From @myTable Where ID = @Counter)
	Set @Current_losID =		(Select losID				From @myTable Where ID = @Counter)
	
	------------------------------------------------------
	-- First find the Record that has the Discharge To
	-- Status of HHA (BENE_PTNT_STUS)
	------------------------------------------------------
		If @Current_BENE = @Previous_BENE
			BEGIN
				-------------------------------------------------------------------------------------
				-- Check to see if we found the Facility the patient was discharged to and if the
				-- record Start Date is not less than the Previous from date
				-------------------------------------------------------------------------------------
				If ((@Current_From <= DateAdd(day, 60 ,@Previous_Thru)) or @Current_From = @Previous_Thru) and DateDiff(DAY, @Previous_Thru, @Current_From) >= 0
					BEGIN
						Set @InsertRecord = 1	
						Set @ReadmitDays = DATEDIFF(DAY, @Previous_Thru, @Current_From)
					END
			END
		
		if @InsertRecord = 1
			BEGIN
			Insert Into CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital
				( 
				  raBENE_HIC_NUM
				, raExpenseType2_Current
				, raExpenseType2_Previous
				, ralosID_Current
				, ralosID_Previous
				, raCLM_FROM_DT_Current
				, raCLM_FROM_DT_Previous
				, raCLM_THRU_DT_Current
				, raCLM_THRU_DT_Previous
				, raReAdmit_InDays
				, SQLRunDate
				)
			Values
				(
				  @Current_BENE
				, @Current_ExpType2
				, @Previous_ExpType2
				, @Current_losID
				, @Previous_losID
				, @Current_From
				, @Previous_From
				, @Current_Thru
				, @Previous_Thru
				, @ReadmitDays
				, GetDate()
				)
			End

	--------------------------------------------------------------------------
	-- Reset Current_From for code to work properly after inserting the
	-- record
	--------------------------------------------------------------------------
	Set @Previous_losID =			@Current_losID
	Set @Previous_BENE =			@Current_BENE
	set @Previous_ExpType2 =		@Current_ExpType2
	Set @Previous_From =			@Current_From
	Set @Previous_Thru =			@Current_Thru
	
	Set @Counter  = @Counter + 1
	Set @InsertRecord = 0
	Set @ReadmitDays = 0

END

-----------------------------------------------------------------------------
-- Update all of the rest of the fields in the table for the CURRENT Value
-----------------------------------------------------------------------------
Update RA
Set 
  raCostUtilizationID_Current	= LOS.losCostUtilizationID
, raExpenseType_Current			= LOS.losExpenseType
, raExpenseType1_Current		= LOS.losExpenseType1
, raFiscalYear_Current			= LOS.losFiscalYear
, raPaidTotal_Current			= LOS.losPaidTotal
, raFacility_Current			= LOS.losFacility
, raDischarge_CD_Current		= LOS.losDischarge_CD
, raDischarge_Current			= LOS.losDischarge
, raPRNCPL_DGNS_CD_Current		= LOS.losPRNCPL_DGNS_CD
, raPRNCPL_DGNS_Current			= LOS.losPRNCPL_DGNS
, raDGNS_DRG_CD_Current			= LOS.losDGNS_DRG_CD
, raDGNS_DRG_Current			= LOS.losDGNS_DRG
, raDGNS_DRG_MDC_CD_Current		= LOS.losDGNS_DRG_MDC_CD
, raDGNS_DRG_MDC_Current		= LOS.losDGNS_DRG_MDC
, SQLRunDate					= GetDate()
, ACO_GroupTinShortName			= LOS.ACO_GroupTinShortName
, raCUR_CLM_UNIQ_ID_Current		= LOS.losCUR_CLM_UNIQ_ID
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS on
RA.raLOSID_Current = LOS.losID

-----------------------------------------------------------------------------
-- Update all of the rest of the fields in the table for the PREVIOUS Value
-----------------------------------------------------------------------------
Update RA
Set 
  raCostUtilizationID_Previous	= LOS.losCostUtilizationID
, raExpenseType_Previous		= LOS.losExpenseType
, raExpenseType1_Previous		= LOS.losExpenseType1
, raFiscalYear_Previous			= LOS.losFiscalYear
, raPaidTotal_Previous			= LOS.losPaidTotal
, raFacility_Previous			= LOS.losFacility
, raDischarge_CD_Previous		= LOS.losDischarge_CD
, raDischarge_Previous			= LOS.losDischarge
, raPRNCPL_DGNS_CD_Previous		= LOS.losPRNCPL_DGNS_CD
, raPRNCPL_DGNS_Previous		= LOS.losPRNCPL_DGNS
, raDGNS_DRG_CD_Previous		= LOS.losDGNS_DRG_CD
, raDGNS_DRG_Previous			= LOS.losDGNS_DRG
, raDGNS_DRG_MDC_CD_Previous	= LOS.losDGNS_DRG_MDC_CD
, raDGNS_DRG_MDC_Previous		= LOS.losDGNS_DRG_MDC
, SQLRunDate = GetDate()
, ACO_GroupTinShortName			= LOS.ACO_GroupTinShortName
, raCUR_CLM_UNIQ_ID_Previous	= LOS.losCUR_CLM_UNIQ_ID
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_LOS LOS on
--CCLF_Reports.dbo.CostUtilization_LOS LOS on  -- Changed to AllAttributed on 7/11/2022
RA.raLOSID_Previous = LOS.losID

-----------------------------------------------------------------------------
-- Update Provider field in the table for the PREVIOUS Value
-----------------------------------------------------------------------------
Update RA
Set 
  raOPRTG_Prvdr_LName_Previous = OPRTG_Prvdr_LName
, raOPRTG_Prvdr_FName_Previous = OPRTG_Prvdr_FName
, raATNDG_Prvdr_LName_Previous =  ATNDG_PRVDR_LName
, raATNDG_Prvdr_FName_Previous = ATNDG_Prvdr_FName
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
RA.raCUR_CLM_UNIQ_ID_Previous = FinalData.CUR_CLM_UNIQ_ID
Where
CCLFFile = 'CCLF1'
and CLM_LINE_NUM = '1'

-----------------------------------------------------------------------------
-- Update Provider field in the table for the CURRENT Value
-----------------------------------------------------------------------------
Update RA
Set 
  raOPRTG_Prvdr_LName_Current = OPRTG_Prvdr_LName
, raOPRTG_Prvdr_FName_Current = OPRTG_Prvdr_FName
, raATNDG_Prvdr_LName_Current =  ATNDG_PRVDR_LName
, raATNDG_Prvdr_FName_Current = ATNDG_Prvdr_FName
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
RA.raCUR_CLM_UNIQ_ID_Current = FinalData.CUR_CLM_UNIQ_ID
Where
CCLFFile = 'CCLF1'
and CLM_LINE_NUM = '1'


-----------------------------------------------------------------------------
-- Update BENE_Name and Last Attribution Quarter.  
-- Write the data to #Temp1 so we have the Last Attribution Quarter to 
-- find the correct record for each bene for the correct PCP
-----------------------------------------------------------------------------
Drop Table if exists #Temp1

/*	-- Changed code below to pull from ACO_BENE instead of QASSGN 9/11/2024
Select 
  raBENE_HIC_NUM
, Q1.Q1_LastName + ', ' + Q1.Q1_FirstName as BENE_FullName
, Max(Q1_YearQuarter) as LastAttributionQuarter
Into #Temp1
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1 on
RA.raBENE_HIC_NUM = Q1.Q1_HICN
Group by
raBENE_HIC_NUM
, Q1.Q1_LastName
, Q1.Q1_FirstName
*/

Select 
  raBENE_HIC_NUM
, ACO_BENE.BENE_LastName + ', ' + ACO_BENE.BENE_FirstName as BENE_FullName
, Max(ACO_BENE.BENE_YearQuarter) as LastAttributionQuarter
Into #Temp1
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
RA.raBENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Group by
raBENE_HIC_NUM
, ACO_BENE.BENE_LastName
, ACO_BENE.BENE_FirstName

Update RA
Set 
  RA.raBENE_FullName			= T1.BENE_FullName
, RA.raBENE_AttributionQuarter	= T1.LastAttributionQuarter
, RA.raBENE_PCP_NPI				= ACO_BENE.BENE_NPI_Number
, RA.raBENE_PCP					= ACO_BENE.BENE_NPI_LastName + ', ' + ACO_BENE.BENE_NPI_FirstName
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
RA.raBENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Inner Join
#Temp1 T1 on
T1.raBENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
and T1.LastAttributionQuarter = ACO_BENE.BENE_YearQuarter

-----------------------------------------------------------------------------
-- Find the INTERIM information (which HHA, SNF, SB, etc they went to 
-- Before being Readmitted.
-- First Find information and put into Temp Table
-- Then Join to ReAdmit_Hospital Table and update the Interim information
-----------------------------------------------------------------------------

-----------------------------
-- Write Data to Temp Table
-----------------------------
Drop Table if Exists #Temp2
Select 
  RA.raLosID_Previous
, LOS.losId
, LOS.losExpenseType
, LOS.losExpenseType1
, LOS.losExpenseType2
, LOS.losExpenseType2_ShortLabel
, LOS.losFacility
, LOS.losCLM_FROM_DT
, LOS.losCLM_THRU_DT
, LOS.losCUR_CLM_UNIQ_ID
, LOS.losPaidTotal
, LOS.losPRNCPL_DGNS_CD
, LOS.losPRNCPL_DGNS
Into #Temp2
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
CCLF_Reports.dbo.CostUtilization_LOS LOS on
RA.raBENE_HIC_NUM = LOS.losBENE_HIC_NUM
and RA.raLosID_Previous <> LOS.losId
and LOS.losExpenseType in ('CAH', 'Home Health', 'Skilled Nursing Facility', 'Hospice')
--and LOS.losCLM_FROM_DT between Dateadd(Day,0,RA.raCLM_THRU_DT_Previous) and DateAdd(Day, 2,RA.raCLM_THRU_DT_Previous)
and LOS.losCLM_FROM_DT >= raCLM_THRU_DT_Previous
and los.losCLM_FROM_DT <= raCLM_FROM_DT_Current
Order by 
  raBENE_FullName
, raCLM_FROM_DT_Previous

---------------------------------------
-- First Update the INTERIM losId
---------------------------------------
Update RA
Set RA.raLosID_Interim = T2.losId
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
#Temp2 T2 on 
RA.raLosID_Previous = T2.raLosID_Previous

-- Update ReAdmit Interim Data
-----------------------------
Update RA
Set
  raExpenseType_Interim				= T2.losExpenseType
, raExpenseType1_Interim			= T2.losExpenseType1
, raExpenseType2_Interim			= T2.losExpenseType2
, raFacility_Interim				= T2.losFacility
, raCLM_FROM_DT_Interim				= T2.losCLM_FROM_DT
, raCLM_THRU_DT_Interim				= T2.losCLM_THRU_DT
, raDischarge_Previous_Actual		= T2.losExpenseType2_ShortLabel
, raPaidTotal_Interim				= T2.losPaidTotal
, raPRNCPL_DGNS_CD_Interim			= T2.losPRNCPL_DGNS_CD
, raPRNCPL_DGNS_Interim				= T2.losPRNCPL_DGNS
, raCUR_CLM_UNIQ_ID_Interim			= T2.losCUR_CLM_UNIQ_ID

from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
#Temp2 T2 on
RA.raLosID_Interim = T2.losId

--------------------------------------------------------------------------
-- Delete Readmit days = 0
-- Delete Discharged to other Hospital if Readmit days are 0 or 1
--------------------------------------------------------------------------
Delete
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital
Where raReAdmit_InDays between 0 and 1
and   raDischarge_CD_Previous = '02'

--------------------------------------------------------------------------
-- Update ACO_GroupTinShortName
--------------------------------------------------------------------------
Update Readmit
Set Readmit.ACO_GroupTinShortName = ACO.ACO_GroupTinShortName
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital Readmit
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq on
Readmit.raBENE_HIC_NUM = Uniq.BENE_HIC_NUM
Inner Join
CCLF_LookupTables.dbo.aco ACO on
Uniq.BENE_NPI_Number = ACO.ACO_NPIIndividual
Where
Readmit.ACO_GroupTinShortName is null

-------------------------------------------
-- Find who signed the 485
-------------------------------------------
Drop Table if Exists #Temp3
Drop Table if Exists #Temp4

Select 
  raBENE_HIC_NUM
, raBENE_FullName
, raCLM_FROM_DT_Interim
, raCLM_THRU_DT_Interim
, raFacility_Interim
, Min(CLM_FROM_DT) as SignDate485
Into #Temp3
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital Hosp
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
Hosp.raBENE_HIC_NUM = FinalData.BENE_HIC_NUM
Where
	raExpenseType_Interim		= 'Home Health'
and FinalData.CCLFFile			= 'CCLF5'
and FinalData.CLM_LINE_HCPCS_CD In ('G0179', 'G0180','G0181')	-- Added G0181 2/22/2024
and FinalData.CLM_FROM_DT		between raCLM_FROM_DT_Interim and raCLM_THRU_DT_Interim
Group by
  raBENE_HIC_NUM
, raBENE_FullName
, raCLM_FROM_DT_Interim
, raCLM_THRU_DT_Interim
, raFacility_Interim
Order by
raBENE_HIC_NUM
, raCLM_FROM_DT_Interim

Select
  raBENE_HIC_NUM
, raBENE_FullName
, raCLM_FROM_DT_Interim
, raCLM_THRU_DT_Interim
, raFacility_Interim
, FinalData.CLM_FROM_DT
, FinalData.CLM_LINE_HCPCS_CD
, FinalData.RNDRG_Prvdr_LName + ', ' + RNDRG_Prvdr_FName as Signed485
, T3.SignDate485
Into #Temp4
from #Temp3 T3
Inner Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
	T3.raBENE_HIC_NUM				= FinalData.BENE_HIC_NUM
and T3.SignDate485					= FinalData.CLM_FROM_DT
and FinalData.CLM_LINE_HCPCS_CD		In ('G0179', 'G0180','G0181')		-- Added G0181 2/22/2024
Order by
raBENE_HIC_NUM
, raCLM_FROM_DT_Interim

Update RA
Set 
  raSigned485_Interim		= T4.Signed485
, raSigned485Date_Interim	= T4.SignDate485
from CCLF_Reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital RA
Inner Join
#Temp4 T4 on
RA.raBENE_HIC_NUM = T4.raBENE_HIC_NUM
and RA.raCLM_FROM_DT_Interim = T4.raCLM_FROM_DT_Interim
and RA.raCLM_THRU_DT_Interim = T4.raCLM_THRU_DT_Interim
/*
--------------------------------------------------
--Update Bene_MasterID											--Levi 8/11/2025
--------------------------------------------------
update cclf_reports.dbo.CostUtilization_BIG_AllAttributed_Readmit_Hospital
set BENE_MasterID = ML.BENE_MasterID
