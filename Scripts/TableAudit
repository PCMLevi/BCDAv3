------------------------------------
Select Distinct 
  CRNT_HIC_NUM
, PRVS_NUM
, Cast(PRVS_ID_EFCTV_DT as Date) as PRVS_ID_EFCTV_DT
, Cast(PRVS_ID_OBSLT_DT as Date) as PRVS_ID_OBSLT_DT
Into #Temp_BENE_Xref
from CCLF_Months.dbo.CCLF9_2026
Where
-- PRVS_ID_OBSLT_DT Between @StartDate and @StopDate
PRVS_ID_OBSLT_DT <= @Q2_StopDate
Order by
  CRNT_HIC_NUM
, PRVS_NUM
, PRVS_ID_OBSLT_DT

-- Select * from #Temp_BENE_Xref order by CRNT_HIC_NUM, PRVS_ID_OBSLT_DT

----------------------------------------
-- Find BENE_HIC_NUM with 1 Change
----------------------------------------
Select 
  CRNT_HIC_NUM
, Count(CRNT_HIC_NUM) as NumChanges
Into #Temp_Change_1
from #Temp_BENE_Xref
Group by
CRNT_HIC_NUM
Having Count(CRNT_HIC_NUM) = 1

-- Select * From #Temp_Change_1 Where CRNT_HIC_NUM = '1A00A66RJ06'

----------------------------------------
-- Find BENE_HIC_NUM with 2 Change
----------------------------------------
Select 
  CRNT_HIC_NUM
, Count(CRNT_HIC_NUM) as NumChanges
Into #Temp_Change_2
from #Temp_BENE_Xref
Group by
CRNT_HIC_NUM
Having Count(CRNT_HIC_NUM) = 2

-- Select * From #Temp_Change_2 Where CRNT_HIC_NUM = '1MC6E54HK30'

--------------------------------------------
-- Find BENE_HIC_NUM with 3 or more Changes
--------------------------------------------
Select 
  CRNT_HIC_NUM
, Count(CRNT_HIC_NUM) as NumChanges
Into #Temp_Change_3
from #Temp_BENE_Xref
Group by
CRNT_HIC_NUM
Having Count(CRNT_HIC_NUM) >= 3

-- Select * From #Temp_Change_3 Where CRNT_HIC_NUM = '1MC6E54HK30'

-------------------------------------------------
-- Union Tables together to find Single Record
-------------------------------------------------
Select *
Into #Temp_Change_1_2_3
from #Temp_Change_1
Union
Select *
from #Temp_Change_2
Union
Select *
from #Temp_Change_3
order by
CRNT_HIC_NUM

-- Select * From #Temp_Change_1_2_3 order by CRNT_HIC_NUM

-------------------------------
-- Join back to 2026 Full Data
-- Select Max Effective Date
-------------------------------
Select 
  Xref.CRNT_HIC_NUM
, C123.NumChanges
, Max(Xref.PRVS_ID_EFCTV_DT) as Max_PRVS_ID_EFCTV_DT
Into #Temp_Change_1_2_3_Max
from #Temp_BENE_Xref Xref
Inner Join
#Temp_Change_1_2_3 C123 on
Xref.CRNT_HIC_NUM = C123.CRNT_HIC_NUM
Group by
  Xref.CRNT_HIC_NUM
, C123.NumChanges

-- Select * From #Temp_Change_1_2_3_Max

-------------------------------
-- Join back to 2026 Full Data
-- To get all fields needed
-------------------------------
Select 
  Xref.CRNT_HIC_NUM
, Xref.PRVS_NUM
, Xref.PRVS_ID_EFCTV_DT
, Xref.PRVS_ID_OBSLT_DT
Into CCLF_Testing.dbo.Temp_BENE_Xref_1_2_3
from #Temp_BENE_Xref Xref
Inner Join
#Temp_Change_1_2_3_Max CMax on
	Xref.CRNT_HIC_NUM		= CMax.CRNT_HIC_NUM
and Xref.PRVS_ID_EFCTV_DT	= CMax.Max_PRVS_ID_EFCTV_DT
Order by
Xref.CRNT_HIC_NUM

-- Select * From CCLF_Testing.dbo.Temp_BENE_Xref_1_2_3

------------------------------------------------
-- Find ALL Information for BENEs with 1 Change
------------------------------------------------
Select Distinct 
  Xref.CRNT_HIC_NUM
, Xref.PRVS_NUM
, Xref.PRVS_ID_EFCTV_DT
, Xref.PRVS_ID_OBSLT_DT
, Case 
	When PRVS_ID_OBSLT_DT < @StartDate							 Then @Q4_Quarter	-- vst Added 3/6/2026
	When PRVS_ID_OBSLT_DT Between @Q1_StartDate and @Q1_StopDate Then @Q1_Quarter 
	When PRVS_ID_OBSLT_DT Between @Q2_StartDate and @Q2_StopDate Then @Q2_Quarter
	When PRVS_ID_OBSLT_DT Between @Q3_StartDate and @Q3_StopDate Then @Q3_Quarter
	When PRVS_ID_OBSLT_DT Between @Q4_StartDate and @Q4_StopDate Then @Q4_Quarter
  End as Quarter_Change
, Cast(Null as Varchar(11))	as Q1_Change
, Cast(Null as Varchar(11))	as Q2_Change
, Cast(Null as Varchar(11))	as Q3_Change
, Cast(Null as Varchar(11))	as Q4_Change
Into #Temp_QuarterChange
from CCLF_Testing.dbo.Temp_BENE_Xref_1_2_3 Xref
--Inner Join
--#Temp_Change_1 C1 on
--Xref.CRNT_HIC_NUM = C1.CRNT_HIC_NUM
Order by
  Quarter_Change
, Xref.CRNT_HIC_NUM

-- Select * From #Temp_Change_1
-- Select * From #Temp_QuarterChange Order by CRNT_HIC_NUM

Update TQ
Set 
  Q1_Change = Case When Quarter_Change In (@Q1_Quarter)										Then Prvs_Num End
, Q2_Change = Case When Quarter_Change In (@Q1_Quarter,@Q2_Quarter)							Then Prvs_Num End
, Q3_Change = Case When Quarter_Change In (@Q1_Quarter,@Q2_Quarter,@Q3_Quarter)				Then Prvs_Num End
, Q4_Change = Case When Quarter_Change In (@Q1_Quarter,@Q2_Quarter,@Q3_Quarter,@Q4_Quarter)	Then Prvs_Num End
from #Temp_QuarterChange TQ

-- Select * From #Temp_QuarterChange Order by CRNT_HIC_NUM

--------------------------------------------------------------
-- Update Q1 Previous Information
-- Since we are running this on an unknown Quarter 
--		(are we running this after more Quarters are processed)?
--		Update future Quarters.
-------------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_HIC_NUM_Previous		= TQ.PRVS_NUM
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT	= TQ.PRVS_ID_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT	= TQ.PRVS_ID_OBSLT_DT
, ACO_BENE.SQLRunDate					= GetDate()				-- Added 9/3/2026 because I want to see if previous quarter is changed
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_QuarterChange TQ on
ACO_BENE.BENE_HIC_NUM = TQ.CRNT_HIC_NUM
Where
	BENE_YearQuarter	In (@Q1_Quarter, @Q2_Quarter, @Q3_Quarter, @Q4_Quarter)  --vst Changed 3/6/2026
and TQ.Q1_Change		is not Null

---------------------------------------
-- Update Q2 Previous Information
---------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_HIC_NUM_Previous		= TQ.PRVS_NUM
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT	= TQ.PRVS_ID_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT	= TQ.PRVS_ID_OBSLT_DT
, ACO_BENE.SQLRunDate					= GetDate()				-- Added 9/3/2026 because I want to see if previous quarter is changed
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_QuarterChange TQ on
ACO_BENE.BENE_HIC_NUM = TQ.CRNT_HIC_NUM
Where
	BENE_YearQuarter	In (@Q2_Quarter, @Q3_Quarter, @Q4_Quarter)  --vst Changed 3/6/2026
and TQ.Q2_Change		is not Null

---------------------------------------
-- Update Q3 Previous Information
---------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_HIC_NUM_Previous		= TQ.PRVS_NUM
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT	= TQ.PRVS_ID_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT	= TQ.PRVS_ID_OBSLT_DT
, ACO_BENE.SQLRunDate					= GetDate()				-- Added 9/3/2026 because I want to see if previous quarter is changed
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_QuarterChange TQ on
ACO_BENE.BENE_HIC_NUM = TQ.CRNT_HIC_NUM
Where
	BENE_YearQuarter	In (@Q3_Quarter, @Q4_Quarter)  --vst Changed 3/6/2026
and TQ.Q3_Change		is not Null

---------------------------------------
-- Update Q4 Previous Information
---------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_HIC_NUM_Previous		= TQ.PRVS_NUM
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT	= TQ.PRVS_ID_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT	= TQ.PRVS_ID_OBSLT_DT
, ACO_BENE.SQLRunDate					= GetDate()				-- Added 9/3/2026 because I want to see if previous quarter is changed
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_QuarterChange TQ on
ACO_BENE.BENE_HIC_NUM = TQ.CRNT_HIC_NUM
Where
	BENE_YearQuarter	= @Q4_Quarter
and TQ.Q4_Change		is not Null

--***********************************************
-- Work on 2 Changes
--***********************************************
Select 
  T2.CRNT_HIC_NUM
, Min(Xref.PRVS_ID_EFCTV_DT) as Min_PRVS_ID_EFCTV_DT
Into #Temp_Change_2_MIN
From #Temp_Change_2 T2
Inner Join
#Temp_BENE_Xref XREF on
T2.CRNT_HIC_NUM = XREF.CRNT_HIC_NUM
Group by
T2.CRNT_HIC_NUM
Order by
T2.CRNT_HIC_NUM

Select 
  XREF.CRNT_HIC_NUM
, XREF.PRVS_NUM
, XREF.PRVS_ID_EFCTV_DT
, XREF.PRVS_ID_OBSLT_DT
Into CCLF_Testing.dbo.Temp_BENE_Xref_2
from #Temp_BENE_Xref XREF
Inner Join
#Temp_Change_2_MIN T2Min on
	XREF.CRNT_HIC_NUM		= T2Min.CRNT_HIC_NUM
and XREF.PRVS_ID_EFCTV_DT	= T2Min.Min_PRVS_ID_EFCTV_DT

------------------------------------------------
-- Find ALL Information for BENEs with 2 Changes
------------------------------------------------
Select Distinct 
  Xref.CRNT_HIC_NUM
, Xref.PRVS_NUM
, Xref.PRVS_ID_EFCTV_DT
, Xref.PRVS_ID_OBSLT_DT
, Case 
	When PRVS_ID_OBSLT_DT < @StartDate							 Then @Q4_Quarter
	When PRVS_ID_OBSLT_DT Between @Q1_StartDate and @Q1_StopDate Then @Q1_Quarter 
	When PRVS_ID_OBSLT_DT Between @Q2_StartDate and @Q2_StopDate Then @Q2_Quarter
	When PRVS_ID_OBSLT_DT Between @Q3_StartDate and @Q3_StopDate Then @Q3_Quarter
	When PRVS_ID_OBSLT_DT Between @Q4_StartDate and @Q4_StopDate Then @Q4_Quarter
  End as Quarter_Change
, Cast(Null as Varchar(11))	as Q1_Change
, Cast(Null as Varchar(11))	as Q2_Change
, Cast(Null as Varchar(11))	as Q3_Change
, Cast(Null as Varchar(11))	as Q4_Change
Into #Temp_QuarterChange2
from CCLF_Testing.dbo.Temp_BENE_Xref_2 Xref
Order by
  Quarter_Change
, Xref.CRNT_HIC_NUM

Update TQ2
Set 
  Q1_Change = Case When Quarter_Change In (@Q1_Quarter)										Then Prvs_Num End
, Q2_Change = Case When Quarter_Change In (@Q1_Quarter,@Q2_Quarter)							Then Prvs_Num End
, Q3_Change = Case When Quarter_Change In (@Q1_Quarter,@Q2_Quarter,@Q3_Quarter)				Then Prvs_Num End
, Q4_Change = Case When Quarter_Change In (@Q1_Quarter,@Q2_Quarter,@Q3_Quarter,@Q4_Quarter)	Then Prvs_Num End
from #Temp_QuarterChange2 TQ2

-- Select * From #Temp_QuarterChange2 Order by CRNT_HIC_NUM

---------------------------------------------
-- Update Q1 Previous Information (Change_2)
---------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_HIC_NUM_Prev2			= TQ2.PRVS_NUM
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT2	= TQ2.PRVS_ID_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT2	= TQ2.PRVS_ID_OBSLT_DT
, ACO_BENE.SQLRunDate					= GetDate()				-- Added 8/3/2026? because I want to see if previous quarter is changed
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_QuarterChange2 TQ2 on
ACO_BENE.BENE_HIC_NUM = TQ2.CRNT_HIC_NUM
Where
	BENE_YearQuarter	In (@Q1_Quarter, @Q2_Quarter, @Q3_Quarter, @Q4_Quarter)  --vst Changed 3/6/2026
and TQ2.Q1_Change		is not Null

-- Select * From #Temp_QuarterChange2 TQ2 Order by CRNT_HIC_NUM

---------------------------------------------
-- Update Q2 Previous Information (Change_2)
---------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_HIC_NUM_Prev2			= TQ2.PRVS_NUM
, ACO_BENE.BENE_HIC_NUM_Prev_EFCTV_DT2	= TQ2.PRVS_ID_EFCTV_DT
, ACO_BENE.BENE_HIC_NUM_Prev_OBSLT_DT2	= TQ2.PRVS_ID_OBSLT_DT
, ACO_BENE.SQLRunDate					= GetDate()				-- Added 9/3/2026 because I want to see if previous quarter is changed
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
#Temp_QuarterChange2 TQ2 on
ACO_BENE.BENE_HIC_NUM = TQ2.CRNT_HIC_NUM
Where
	BENE_YearQuarter	In (@Q2_Quarter, @Q3_Quarter, @Q4_Quarter)  --vst Changed 3/6/2026
and TQ2.Q2_Change		is not Null

---------------------------------------------
-- Update Q3 Previous Information (Change_2)
