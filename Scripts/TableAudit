Alter Procedure procCompensation_PYCurrent_06_1_3_Hospital_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate E1000 For Each Group
--=======================================

--===========
-- ACO
--===========
Select 
  Sum(Hospital_ACO)	as Hospital_ACO
, Sum(PY_ACO)		As PY_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_Hospital_Aggregate_ACO

Update ACO
Set Hospital_E1000_ACO = CCLF_Functions.dbo.Divide_Return0(TACO.Hospital_ACO, TACO.PY_ACO) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_Hospital_Aggregate_ACO ACO
Inner Join
#Temp_ACO TACO on
1=1

--===========
-- NPI
--===========
Select 
  NPI
, Sum(Hospital_NPI)	as Hospital_NPI
, Sum(PY_NPI)		As PY_NPI
Into #Temp_NPI
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_Hospital_Aggregate_NPI
Group By
NPI

Update NPI
Set Hospital_E1000_NPI = 
	CCLF_Functions.dbo.Divide_Return0(TNPI.Hospital_NPI, TNPI.PY_NPI) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_Hospital_Aggregate_NPI NPI
Inner Join
#Temp_NPI TNPI on
TNPI.NPI = NPI.NPI

--===========
-- TIN
--===========
Select 
  ACO_GroupTIN
, Sum(Hospital_TIN)	as Hospital_TIN
, Sum(PY_TIN)		As PY_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_Hospital_Aggregate_TIN
Group By
ACO_GroupTIN

Update TIN
Set Hospital_E1000_TIN = 
	CCLF_Functions.dbo.Divide_Return0(TTIN.Hospital_TIN, TTIN.PY_TIN) * 1000
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_Hospital_Aggregate_TIN TIN
Left Join
#Temp_TIN TTIN on
TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN




--=======================================
-- Calculate E1000 Average For Each Group
--=======================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Average
