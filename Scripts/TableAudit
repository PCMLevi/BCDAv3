2256,2026-06-03T23:46:03.969045,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_2_2_A1C_Aggregate,"
Alter Procedure procCompensation_PYCurrent_10_001_2_2_A1C_Aggregate
(	
	    @Compensation_Year		as Varchar(6)  -- vst - Changed from 6 to 7 for Testing
	  , @Compensation_Percent	As Float
	  , @Compensation_Quarter	as Varchar(6)
	  , @MDI_Download_DT		as Date
)

AS
BEGIN

Declare @SelectType		as Varchar(15)
Declare @MeasureNumber	as Varchar(3)
Declare @MeasureAbbr	as Varchar(5)

Set		@MeasureNumber		= '001'
Set		@SelectType			= @Compensation_Year
Set		@MeasureAbbr		= (Select A1C_Abbr From Database_Constants.dbo.Mips Where SelectType = @SelectType and A1C_Number = @MeasureNumber)

Drop Table if Exists #Temp_A1C

Select 
  @MeasureAbbr				As MeasureAbbr
, Case
	When Performance_MetNotMet =  'Not Met'		Then 'NotMet'
	When Performance_MetNotMet =  'Met'			Then 'Met'
	When Performance_MetNotMet =  'Unreported'	Then 'UnReported'
	Else											 'UnReported'
	End as Measure_Result
, Count(Performance_MetNotMet)	as Performance_MetNotMet
, Cast( 1 as Float)				as Performance_Total
Into #Temp_A1C
from Compensation_PYCurrent.dbo.Compensation_10_001_1_A1C_ByBENE
Group By
Performance_MetNotMet
Order by
Performance_MetNotMet

Declare @Result_Eligible	as Float
Set		@Result_Eligible	= (Select Sum(Performance_MetNotMet) From #Temp_A1C)

Declare @Result_Met			as Float
Set		@Result_Met			= (Select Performance_MetNotMet From #Temp_A1C Where Measure_Result = 'Met')

Declare @Result_NotMet		as Float
Set		@Result_NotMet		= (Select Performance_MetNotMet From #Temp_A1C Where Measure_Result = 'NotMet')

Declare @Result_UnReported	as Float
Set		@Result_UnReported	= (Select Performance_MetNotMet From #Temp_A1C Where Measure_Result = 'UnReported')

Select Distinct 
  @MeasureAbbr						as MeasureAbbr
, @MeasureNumber					as MeasureNumber
, @Result_Met						as Met
, @Result_NotMet					as NotMet
, @Result_UnReported				as UnReported
, @Result_Eligible					as Eligible
, (@Result_Met + @Result_NotMet)	as Complete
, (@Result_Met + @Result_NotMet) 
/ @Result_Eligible					as CompletionRate
, @Result_NotMet / (@Result_Met 
+ @Result_NotMet)					as PerformanceRate
, SQLRunDate
From Compensation_PYCurrent.dbo.Compensation_10_001_1_A1C_ByBENE

End"
