4278,2026-07-08T23:37:22.678920,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_05_1_4_2_EDObs_Bonus_NPI,"
Alter Procedure procCompensation_PYCurrent_05_1_4_2_EDObs_Bonus_NPI
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Set		@SelectType = 'Current'

Delete From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI

Drop Table if Exists #Temp_PercentPositive
Drop Table if Exists #Temp_EDObs_TotalWeight

----------------------------------------------------------------
-- Insert Only the NPI's in TINs that are under the ACO Average
----------------------------------------------------------------
Insert Into Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_FullName
, PY_NPI
, NumBENE_NPI
, EDVisit_NPI
, EDVisit_TIN
, EDVisit_ACO
, EDVisit_E1000_NPI
, EDVisit_E1000_TIN
, EDVisit_E1000_ACO
, EDVisit_Average_PY_NPI
, EDVisit_Average_PY_TIN
, EDVisit_Average_PY_ACO
, EDVisit_E1000_NPI_Under_TIN
, EDVisit_E1000_NPI_Under_ACO
, EDVisit_Flag_NPI_Under_TIN
, EDVisit_Flag_NPI_Under_ACO
, EDVisit_Flag_TIN_Under_ACO
, EDObs_Bonus_Allotment_TIN
, SQLRunDate_EDobs
)
Select 
  @YearQuarter
, @CompensationPercent
, Agg_NPI.ACO_GroupTIN
, Agg_NPI.ACO_GroupTINName_New
, Agg_NPI.NPI
, AGG_NPI.NPI_Fullname
, Agg_NPI.PY_NPI
, Agg_NPI.NumBENE_NPI
, Agg_NPI.EDVisit_NPI
, Agg_NPI.EDVisit_TIN
, Agg_NPI.EDVisit_ACO
, Agg_NPI.EDVisit_E1000_NPI
, Agg_NPI.EDVisit_E1000_TIN
, Agg_NPI.EDVisit_E1000_ACO
, Agg_NPI.EDVisit_Average_PY_NPI
, Agg_NPI.EDVisit_Average_PY_TIN
, Agg_NPI.EDVisit_Average_PY_ACO
, Agg_NPI.EDVisit_E1000_NPI_Under_TIN
, Agg_NPI.EDVisit_E1000_NPI_Under_ACO
, Agg_NPI.EDVisit_Flag_NPI_Under_TIN
, AGG_NPI.EDVisit_Flag_NPI_Under_ACO
, BonusTin.EDVisit_Flag_TIN_Under_ACO
, BonusTin.EDObs_Bonus_TIN
, Agg_NPI.SQLRunDate_EDObs
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI Agg_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_05_1_4_1_EDObs_Bonus_TIN BonusTin on
Agg_NPI.ACO_GroupTIN = BonusTin.ACO_GroupTIN
Where
BonusTin.EDVisit_Flag_TIN_Under_ACO = 1

-------------------------------
-- Calculation Quality Weight
-------------------------------
Update EDBonus
Set 
EDObs_Quality_Weight = 
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1 
		Then CCLF_Functions.dbo.Divide_Return0(
			 EDVisit_E1000_NPI_Under_ACO 
		   , EDVisit_Average_PY_ACO) * -1 -- Multiply by -1 so Bonus information is positive
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus

-----------------------------------------
-- Calculation BENE Weight
-- Beneficiares for NPI * Quality Weight
-----------------------------------------
Update EDBonus
Set 
EDObs_BENE_Weight =
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1 
		Then NumBENE_NPI * EDObs_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus

----------------------------------------------------
-- Calculate and Update Total Weight for Each TIN
-- Sum BENE Weight by TIN
----------------------------------------------------
Select 
  EDBonus.ACO_GroupTIN
, Sum(EDBonus.EDObs_BENE_Weight) as EDObos_TotalWeight
Into #Temp_EDObs_TotalWeight
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus
Where
EDBonus.EDVisit_Flag_NPI_Under_ACO = 1
Group By
EDBonus.ACO_GroupTIN

Update EDBonus
Set 
EDBonus.EDObs_Total_Weight = 
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1 
		Then TW.EDObos_TotalWeight
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus
Inner Join
#Temp_EDObs_TotalWeight TW on
EDBonus.ACO_GroupTIN = TW.ACO_GroupTIN

-------------------------------------
-- Calculate EDObs Bonus Percent
-- (BENE Weight / BENE Total Weight)
-------------------------------------
Update EDBonus
Set 
EDObs_Bonus_Percent	= 
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0(EDObs_BENE_Weight, EDObs_Total_Weight)
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus

---------------------------------
-- Calculate ED Bonus
-- Bonus of TIN * Bonus Percent
---------------------------------
Update EDBonus
Set 
  EDObs_Bonus_PerNPI	=  
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1
		Then EDObs_Bonus_Percent * EDObs_Bonus_Allotment_TIN
		Else 0
	End 
, EDObs_Bonus_NPI		=  
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1
		Then EDObs_Bonus_Percent * EDObs_Bonus_Allotment_TIN
		Else 0
	End
, EDObs_Bonus_PerBENE	= 
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0(
		     (EDObs_Bonus_Percent * EDObs_Bonus_Allotment_TIN), NumBENE_NPI)
		Else 0
	End
, EDObs_Bonus_Allotment_TIN = 
	Case
		When EDVisit_Flag_NPI_Under_ACO = 1
		Then EDObs_Bonus_Allotment_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus

------------------------
-- Update SQLRunDate
------------------------
Update EDBonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_05_1_4_2_EDObs_Bonus_NPI EDBonus

End
"
