Create Procedure procCompensation_PYCurrent_06_1_4_1_ReAdmit_Bonus_TIN
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Declare @ReAdmit_Bonus_Allotment as float

Set @SelectType = 'Current'
Set @ReAdmit_Bonus_Allotment = (Select ReAdmit_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN

--Select @ReAdmit_Bonus_Allotment As ReAdmit_Bonus_Allotment

Drop Table if Exists #Temp_PercentPositive

Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, Hospital_TIN		--EDVisit_TIN
, Hospital_ACO		--EDVisit_ACO
, ReAdmit_TIN		--EDVisit_E1000_TIN
, ReAdmit_ACO		--EDVisit_E1000_ACO
, ReAdmit_Rate_TIN	--EDVisit_Average_PY_TIN
, ReAdmit_Rate_ACO	--EDVisit_Average_PY_ACO
, ReAdmit_Rate_TIN_Under_ACO	--EDVisit_E1000_TIN_Under_ACO
, ReAdmit_Flag_TIN_Under_ACO	--EDVisit_Flag_TIN_Under_ACO
, ReAdmit_Bonus_Allotment
, SQLRunDate_ReAdmit
)
Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, Hospital_TIN		--EDVisit_TIN
, Hospital_ACO		--EDVisit_ACO
, ReAdmit_TIN		--EDVisit_E1000_TIN
, ReAdmit_ACO		--EDVisit_E1000_ACO
, ReAdmit_Rate_TIN	--EDVisit_Average_PY_TIN
, ReAdmit_Rate_ACO	--EDVisit_Average_PY_ACO
, ReAdmit_Rate_TIN_Under_ACO	--EDVisit_E1000_TIN_Under_ACO
, ReAdmit_Flag_TIN_Under_ACO	--EDVisit_Flag_TIN_Under_ACO
, @ReAdmit_Bonus_Allotment
, SQLRunDate_ReAdmit
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN

-------------------------------
-- Calculation Quality Weight
-------------------------------
Update EDBonus
Set 
ReAdmit_Quality_Weight = 
	Case 
		When ReAdmit_Flag_TIN_Under_ACO = 1 
		Then  CCLF_Functions.dbo.Divide_Return0(
			  ReAdmit_Rate_TIN_Under_ACO 
			, ReAdmit_Rate_ACO) * -1 -- Multiply by -1 so Bonus information is positive
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN EDBonus

-----------------------------------------
-- Calculation BENE Weight
-- Beneficiares for TIN * Quality Weight
-----------------------------------------
Update EDBonus
Set 
ReAdmit_BENE_Weight =
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1 
		Then NumBENE_TIN * ReAdmit_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN EDBonus

----------------------------------------------------
-- Calculate and Update Total Weight
-- Sum BENE Weight by TIN
----------------------------------------------------
Declare @Total_BENE_Weight as Float
Set		@Total_BENE_Weight = 
		(Select Sum(ReAdmit_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN)

Update EDBonus
Set ReAdmit_Total_Weight = 
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then @Total_BENE_Weight
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN EDBonus

-------------------------------------
-- Calculate ReAdmit Bonus Percent
-- (Weight / Total Weight)
-------------------------------------
Update EDBonus
Set 
  ReAdmit_Bonus_Percent	= 
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0(ReAdmit_BENE_Weight, ReAdmit_Total_Weight)
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN EDBonus

---------------------------------
-- Calculate ED Bonus
-- Bonus Allotment * Bonus Percent
---------------------------------
Update EDBonus
Set 
  ReAdmit_Bonus_PerTIN	=  
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment
		Else 0
	End 
, ReAdmit_Bonus_TIN		=  
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment
		Else 0
	End
, ReAdmit_Bonus_PerBENE	= 
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then (ReAdmit_Bonus_Percent * ReAdmit_Bonus_Allotment) / NumBENE_TIN
		Else 0
	End
, ReAdmit_Bonus_Allotment =			-- Show only on lines with criteria
	Case
		When ReAdmit_Flag_TIN_Under_ACO = 1
		Then ReAdmit_Bonus_Allotment
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN EDBonus

------------------------
-- Update SQLRunDate
------------------------
Update EDBonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_06_1_4_1_ReAdmit_Bonus_TIN EDBonus

End
