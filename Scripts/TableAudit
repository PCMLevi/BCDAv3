Q8.Newly_Enrolled = NEW_ENROLL.Newly_Enrolled_CD
Left Join
CCLF_LookupTables.dbo.tbl_QALR_Reactivated_CD REACT on
Q8.Reactivated = REACT.Reactivated_CD

