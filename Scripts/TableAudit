Group by
  raBENE_HIC_NUM
, raBENE_FullName
, raCLM_FROM_DT_Interim
, raCLM_THRU_DT_Interim
, raFacility_Interim
Order by
raBENE_HIC_NUM
, raCLM_FROM_DT_Interim

Select
  raBENE_HIC_NUM
, raBENE_FullName
, raCLM_FROM_DT_Interim
, raCLM_THRU_DT_Interim
, raFacility_Interim
, FinalData.CLM_FROM_DT
, FinalData.CLM_LINE_HCPCS_CD
, FinalData.RNDRG_Prvdr_LName + ', ' + RNDRG_Prvdr_FName as Signed485
, T3.SignDate485
Into #Temp4
