, HCCRiskScore_V28			= HCC.HCCRiskScore_V28		-- Added 10/8/2024
, SQLRunDate				= GetDate()
, BENE_HIC_NUM_OLD			= CCLF5.BENE_HIC_NUM
, CLM_RNDRG_PRVDR_NPI_NUM	= CCLF5.CLM_RNDRG_PRVDR_NPI_NUM
, CLM_RFRG_PRVDR_NPI_NUM	= CCLF5.CLM_RFRG_PRVDR_NPI_NUM
From CCLF_Subsets.dbo.CLM_DGNS DGNS
