CLM_DGNS.CLM_DGNS_CD = ICD10.Diagnosis_Code
Where 
	CLM_DGNS.MedicareFileDate	= @MedicarefileDate
and CLM_DGNS.CLM_THRU_DT		between @StartDate and @StopDate
and CLM_DGNS.CCLFFile			= @CCLFFile
and CLM_DGNS.FromFile			= @FromFile

---------------------------------------------------
-- Update Acute/Chronic.  Added 7/13/2021
---------------------------------------------------
Update CLM_DGNS
Set 
  CLM_DGNS.Acute	= ICD10.Acute
, CLM_DGNS.Chronic	= ICD10.Chronic
from CCLF_Subsets.dbo.CLM_DGNS CLM_DGNS
Inner Join
CCLF_LookupTables.dbo.tbl_HCC_HCPCS_ICD10CM ICD10 on			-- 5/2/2023 Changed to Table with Unique Values
--CCLF_LookupTables.dbo.tbl_HCC_HCPCS_ICD10CM_2022 ICD10 on
CLM_DGNS.CLM_DGNS_CD = ICD10.Diagnosis_Code
Where 
(
	CLM_DGNS.Acute is null 
 or CLM_DGNS.Chronic is null
)
and MedicareFileDate = @MedicareFileDate


