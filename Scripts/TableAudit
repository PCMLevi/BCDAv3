Alter Procedure procCompensation_PYCurrent_10_112_3_BCS_Calculations
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Set		@SelectType				= 'Current'

Drop Table if Exists #Temp_Complete_NPI
Drop Table if Exists #Temp_Complete_TIN
Drop Table if Exists #Temp_Complete_ACO

Drop Table if Exists #Temp_Performance_NPI
Drop Table if Exists #Temp_Performance_TIN
Drop Table if Exists #Temp_Performance_ACO

Drop Table if Exists #Temp_Perf_NPI
Drop Table if Exists #Temp_Perf_TIN
Drop Table if Exists #Temp_Perf_ACO

Drop Table if Exists #Temp_Over_NPI

--=======================================
-- Calculate Completion Rate
-- Calculate Performance Rate
-- Calculate % Above ACO Average
-- See if Group has a positive Above Average
--=======================================

--============================================
-- Update Completion Percent  (Lookup Values)
-- Update Performance Percent (Lookup Values)
--============================================
------------------------------------------------------
-- Update Pct Constants - NPI
-- Update Compensation_Quarter & Compensaton_Percent
------------------------------------------------------
Update BCS_NPI
Set 
  
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI BCS_NPI

-------------------------------
-- Update Pct Constants - TIN
-------------------------------
Update BCS_TIN
Set 
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN BCS_TIN

-------------------------------
-- Update Pct Constants - ACO
-------------------------------
Update BCS_ACO
Set 
  QM_Completion_Percent	= @QM_Completion_Percent
, QM_40th_Percentile	= @QM_40th_Percentile
from Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO BCS_ACO

--========================
-- Update Completion Rate
--========================

--=====================
-- Completion Rate
--=====================
-------------------
-- Completion_ACO
-------------------
Update BCS_ACO
Set 
  BCS_ACO.BCS_Completion_Rate_ACO = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Complete_ACO as Float)
		 , BCS_Eligible_ACO
	) 

From Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO BCS_ACO

-------------------------
-- Completion Rate NPI
-------------------------
-- Select * From #Temp_Complete_NPI

Update BCS_NPI
Set 
  BCS_NPI.BCS_Completion_Rate_NPI	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Complete_NPI as Float)
		 , BCS_Eligible_NPI
	)

From Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI BCS_NPI

-------------------------
-- Completion Rate TIN
-------------------------
Update BCS_TIN
Set 
  BCS_TIN.BCS_Completion_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Complete_TIN as Float)
		 , BCS_Eligible_TIN
	)

From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN BCS_TIN

--=====================
-- Fail Rate
--=====================
-------------------
-- Fail Rate NPI
-------------------
Update NPI
Set NPI.BCS_Fail_Rate_NPI = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Fail_NPI as Float)
		 , BCS_Complete_NPI
	) 
From Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI NPI

-------------------
-- Fail Rate TIN
-------------------
Update TIN
Set TIN.BCS_Fail_Rate_TIN = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Fail_TIN as Float)
		 , BCS_Complete_TIN
	) 
From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN TIN

-------------------
-- Fail Rate ACO
-------------------
Update ACO
Set ACO.BCS_Fail_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Fail_ACO as Float)
		 , BCS_Complete_ACO
	) 
From Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO ACO

--===================================================
-- Performance Rate
-- NOTE:  Performance Rate is the same as Pass Rate
--===================================================
-------------------
-- Performance_ACO
-------------------
Update BCS_ACO
Set 
  BCS_ACO.BCS_Performance_Rate_ACO = 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Pass_ACO as Float)
	,	   BCS_Complete_ACO
	)
, BCS_ACO.BCS_Pass_Rate_ACO	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Pass_ACO as Float)
	,	   BCS_Complete_ACO
	)
From Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO BCS_ACO

Declare @BCS_Performance_Rate_ACO as Float
Set		@BCS_Performance_Rate_ACO = 
			(Select BCS_Performance_Rate_ACO
			 From Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO)

--------------------------
-- Performance Rate TIN
--------------------------
Update BCS_TIN
Set 
  BCS_TIN.BCS_Performance_Rate_TIN = 
  CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Pass_TIN as Float)
		 , BCS_Complete_TIN
	)

, BCS_TIN.BCS_Pass_Rate_TIN	= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Pass_TIN as Float)
		 , BCS_Complete_TIN
	)

, BCS_TIN.BCS_Performance_Rate_ACO	= @BCS_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN BCS_TIN

-------------------------
-- Performance Rate NPI
-------------------------
Update BCS_NPI
Set 
  BCS_NPI.BCS_Performance_Rate_NPI		= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Pass_NPI as Float)
		 , BCS_Complete_NPI
	)

, BCS_NPI.BCS_Pass_Rate_NPI				= 
	CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(BCS_Pass_NPI as Float)
		 , BCS_Complete_NPI
	)
, BCS_NPI.BCS_Completion_Rate_TIN		= BCS_TIN.BCS_Completion_Rate_TIN
, BCS_NPI.BCS_Performance_Rate_TIN		= BCS_TIN.BCS_Performance_Rate_TIN
, BCS_NPI.BCS_Performance_Rate_ACO		= @BCS_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI BCS_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN BCS_TIN on
BCS_NPI.ACO_GroupTIN = BCS_TIN.ACO_GroupTIN

--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  BCS_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  BCS_Performance_Rate_TIN
		, @BCS_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Update NPI
Set 
  BCS_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  BCS_Performance_Rate_NPI
		, BCS_Performance_Rate_TIN
		)

, BCS_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		    BCS_Performance_Rate_NPI
		  , @BCS_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI NPI

--=========================
-- Over Group Flag
-- Performance_Rate_Base
--=========================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.BCS_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.BCS_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
, TIN.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.BCS_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.BCS_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.BCS_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.BCS_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
, NPI.QM_40th_Percentile = @QM_40th_Percentile
From Compensation_PYCurrent.dbo.Compensation_10_112_2_2_BCS_Aggregate_NPI NPI


End 
