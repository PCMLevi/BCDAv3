------------------------------------------------------------------
-- I had to Update each Range separately with the Where clause
-- because the case statement overwrote previous values
------------------------------------------------------------------
Update LOS
Set 
  LOS_Range_30	= Null
, LOS_Range_60	= Null
, LOS_Range_99	= Null
, LOS_Range_199	= Null
, LOS_Range_299 = Null
, LOS_Range_300 = Null
From CCLF_Reports.dbo.CostUtilization_LOS LOS

