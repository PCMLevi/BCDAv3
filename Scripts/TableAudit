Set BENE_HIC_NUM_Type = Crnt.BENE_Type
From CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq
Left Join
#Temp_Uniq_Current Crnt on
Uniq.BENE_HIC_NUM = Crnt.BENE_HIC_NUM


END
