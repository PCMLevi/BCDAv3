From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI A1C_MDI

Update A1C_MDI
Set 
  A1C_MDI.A1C_Performance_Rate_MDI	= TPerf_MDI.A1C_Performance_Rate
, A1C_MDI.A1C_Pass_Rate_MDI			= TPerf_MDI.A1C_Performance_Rate
From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI A1C_MDI
Left Join #Temp_Perf_MDI TPerf_MDI on
1=1

--------------------------
-- Performance Rate TIN
--------------------------
Select 
  ACO_GroupTIN
, A1C_Pass_TIN
, A1C_Pass_Rate_TIN
, A1C_Complete_TIN
, A1C_Completion_Rate_TIN
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_TIN as Float)
		 , A1C_Complete_TIN
	)	as A1C_Performance_Rate_TIN
Into #Temp_Perf_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN

-- Select * From #Temp_Perf_TIN

Update A1C_TIN
Set 
  A1C_TIN.A1C_Performance_Rate_TIN	= TPerf_TIN.A1C_Performance_Rate_TIN
, A1C_TIN.A1C_Pass_Rate_TIN			= TPerf_TIN.A1C_Performance_Rate_TIN
, A1C_TIN.A1C_Performance_Rate_ACO	= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN A1C_TIN
Left Join #Temp_Perf_TIN TPerf_TIN on
A1C_TIN.ACO_GroupTIN = TPerf_TIN.ACO_GroupTIN

-------------------------
-- Performance Rate NPI
-------------------------
Select 
  NPI
, A1C_Pass_NPI
, A1C_Complete_NPI
, CCLF_Functions.dbo.Divide_Return0
	(
	  Cast(A1C_Pass_NPI as Float)
		 , A1C_Complete_NPI
	)	as A1C_Performance_Rate_NPI
Into #Temp_Perf_NPI
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI

Update A1C_NPI
Set 
  A1C_NPI.A1C_Performance_Rate_NPI		= TPerf_NPI.A1C_Performance_Rate_NPI
, A1C_NPI.A1C_Pass_Rate_NPI				= TPerf_NPI.A1C_Performance_Rate_NPI
, A1C_NPI.A1C_Performance_Rate_ACO		= @A1C_Performance_Rate_ACO
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI A1C_NPI
Left Join #Temp_Perf_NPI TPerf_NPI on
A1C_NPI.NPI = TPerf_NPI.NPI

-------------------------
-- Performance Rate TIN
-------------------------
Update NPI
Set 
  NPI.A1C_Performance_Rate_TIN		= TIN.A1C_Performance_Rate_TIN
, NPI.A1C_Pass_Rate_NPI				= TIN.A1C_Performance_Rate_TIN
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI
Left Join Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN


--==============================
-- NPI Over Group Percent
--==============================
--------------------------------
-- TIN Over Percents
--------------------------------
Update TIN
Set 
  A1C_Performance_Rate_TIN_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_TIN
		, @A1C_Performance_Rate_ACO
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

--------------------------------
-- NPI Over Percents
--------------------------------
Update NPI
Set 
  A1C_Performance_Rate_NPI_Over_ACO = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, @A1C_Performance_Rate_ACO
		)
		
, A1C_Performance_Rate_NPI_Over_TIN = 
	CCLF_Functions.dbo.Percent_Over
		(
		  A1C_Performance_Rate_NPI
		, A1C_Performance_Rate_TIN
		)
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI

--=====================
-- Over Group Flag
--=====================
-----------------------
-- TIN Over ACO Flag
-----------------------
Update TIN
Set 
  TIN.A1C_Performance_Flag_TIN_Over_ACO = 
	Case
		When TIN.A1C_Performance_Rate_TIN_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN TIN

----------------------------
-- NPI Over Percents Flag
----------------------------
Update NPI
Set 
  NPI.A1C_Performance_Flag_NPI_Over_TIN = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_TIN > 0
		Then 1
		Else 0
	End
, NPI.A1C_Performance_Flag_NPI_Over_ACO = 
	Case
		When NPI.A1C_Performance_Rate_NPI_Over_ACO > 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI NPI


End 
