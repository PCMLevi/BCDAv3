  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, DEP_Eligible_TIN
, DEP_Pass_TIN
, DEP_Complete_TIN
, @QM_Completion_Percent
, @QM_40th_Percentile
, DEP_Performance_Rate_TIN
, @DEP_Performance_Rate_ACO
, DEP_Performance_Rate_TIN_Over_ACO
, DEP_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(   DEP_Performance_Rate_TIN
	 , @DEP_Performance_Rate_ACO
	) 
, @DEP_Bonus_Allotment
, SQLRunDate_MDI_DEP
From Compensation_PYCurrent.dbo.Compensation_10_134_2_3_DEP_Aggregate_TIN


Update DEP
Set 
DEP_BENE_Weight =
	Case
		When DEP_Performance_Flag_TIN_Over_ACO = 1 
		Then DEP_Eligible_TIN * DEP_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_134_2_6_DEP_Bonus_TIN DEP

Declare @DEP_BENE_Weight_Total as Float
Set		@DEP_BENE_Weight_Total = 
		(Select Sum(DEP_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_134_2_6_DEP_Bonus_TIN)

Update DEP
Set 
  DEP_Bonus_Percent	= 
	Case
		When DEP_Performance_Flag_TIN_Over_ACO = 1
		Then (DEP_BENE_Weight / @DEP_BENE_Weight_Total)
		Else 0
	End
, DEP_BENE_Weight_Total	= @DEP_BENE_Weight_Total
From Compensation_PYCurrent.dbo.Compensation_10_134_2_6_DEP_Bonus_TIN DEP

Update DEP
Set 
  DEP_Bonus_PerTIN	=  
	Case
		When DEP_Performance_Flag_TIN_Over_ACO = 1
		Then DEP_Bonus_Percent * DEP_Bonus_Allotment
		Else 0
	End 
, DEP_Bonus_TIN		=  
	Case
		When DEP_Performance_Flag_TIN_Over_ACO = 1
		Then DEP_Bonus_Percent * DEP_Bonus_Allotment
		Else 0
	End
, DEP_Bonus_PerBENE	= 
	Case
		When DEP_Performance_Flag_TIN_Over_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0
			(
			 (DEP_Bonus_Percent * DEP_Bonus_Allotment)
		    , DEP_Eligible_TIN
		    )
		
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_134_2_6_DEP_Bonus_TIN DEP

------------------------
-- Update SQLRunDate
------------------------
Update DEP
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_134_2_6_DEP_Bonus_TIN DEP

End
