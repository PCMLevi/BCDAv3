4110,2026-07-06T13:10:40.031511,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_112_4_BCS_Bonus,"
Create Procedure procCompensation_PYCurrent_10_112_4_BCS_Bonus
(	
	  @CompensationYear			as Char(6)
	, @YearQuarter				as Varchar(7)
	, @CompensationPercent		as Float
	, @QM_Completion_Percent	as Float
	, @QM_40th_Percentile		as Float
)
AS
BEGIN

Declare @SelectType				as Varchar(15)
Declare @BCS_Bonus_Allotment	as float

Set @SelectType = 'Current'
Set @BCS_Bonus_Allotment = (Select BCS_Allotment From Compensation_PYCurrent.dbo.Compensation_00_1_Constants Where SelectType = @SelectType and Compensation_Percent = @CompensationPercent)

Delete From Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN

Select 
  @QM_Completion_Percent	as ComplPct
, @QM_40th_Percentile		as PerfPct
, @BCS_Bonus_Allotment		As BCS_Allotment


Drop Table if Exists #Temp_PercentPositive

Declare @BCS_Performance_Rate_ACO as Float	
Set		
@BCS_Performance_Rate_ACO = 
	(Select BCS_Performance_Rate_ACO
	 From   Compensation_PYCurrent.dbo.Compensation_10_112_2_4_BCS_Aggregate_ACO)

-- Select @BCS_Performance_Rate_ACO as PerfRate_ACO

Insert Into Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, BCS_Eligible_TIN
, BCS_Pass_TIN
, BCS_Complete_TIN
, Completion_Percent
, Performance_Percent
, BCS_Performance_Rate_TIN
, BCS_Performance_Rate_ACO
, BCS_Performance_Rate_TIN_Over_ACO
, BCS_Performance_Flag_TIN_Over_ACO
, BCS_Quality_Weight
, BCS_Bonus_Allotment
, SQLRunDate_MDI_BCS
)

Select 
  @YearQuarter
, @CompensationPercent
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, BCS_Eligible_TIN
, BCS_Pass_TIN
, BCS_Complete_TIN
, @QM_Completion_Percent
, @QM_40th_Percentile
, BCS_Performance_Rate_TIN
, @BCS_Performance_Rate_ACO
, BCS_Performance_Rate_TIN_Over_ACO
, BCS_Performance_Flag_TIN_Over_ACO
, CCLF_Functions.dbo.Percent_Over
	(   BCS_Performance_Rate_TIN
	 , @BCS_Performance_Rate_ACO
	) 
, @BCS_Bonus_Allotment
, SQLRunDate_MDI_BCS
From Compensation_PYCurrent.dbo.Compensation_10_112_2_3_BCS_Aggregate_TIN


Update BCS
Set 
BCS_BENE_Weight =
	Case
		When BCS_Performance_Flag_TIN_Over_ACO = 1 
		Then BCS_Eligible_TIN * BCS_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN BCS

Declare @BCS_BENE_Weight_Total as Float
Set		@BCS_BENE_Weight_Total = 
		(Select Sum(BCS_BENE_Weight)
		From Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN)

Update BCS
Set 
  BCS_Bonus_Percent	= 
	Case
		When BCS_Performance_Flag_TIN_Over_ACO = 1
		Then (BCS_BENE_Weight / @BCS_BENE_Weight_Total)
		Else 0
	End
, BCS_BENE_Weight_Total	= @BCS_BENE_Weight_Total
From Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN BCS

Update BCS
Set 
  BCS_Bonus_PerTIN	=  
	Case
		When BCS_Performance_Flag_TIN_Over_ACO = 1
		Then BCS_Bonus_Percent * BCS_Bonus_Allotment
		Else 0
	End 
, BCS_Bonus_TIN		=  
	Case
		When BCS_Performance_Flag_TIN_Over_ACO = 1
		Then BCS_Bonus_Percent * BCS_Bonus_Allotment
		Else 0
	End
, BCS_Bonus_PerBENE	= 
	Case
		When BCS_Performance_Flag_TIN_Over_ACO = 1
		Then CCLF_Functions.dbo.Divide_Return0
			(
			 (BCS_Bonus_Percent * BCS_Bonus_Allotment)
		    , BCS_Eligible_TIN
		    )
		
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN BCS

------------------------
-- Update SQLRunDate
------------------------
Update BCS
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_112_2_6_BCS_Bonus_TIN BCS

End
