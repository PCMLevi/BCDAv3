AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
    -- Insert statements for procedure here
with cte as(
select * 
from BCDA_Staging.dbo.eob_base_staging_v3
where type_code_display != 'pharmacy'
)
merge BCDA_Data.dbo.EOB_Base_v3 as tgt 
using cte as src
on tgt.claim_id = src.claim_id
when matched then 
update
set 
 tgt.Cntrl_Num = src.Cntrl_Num
,tgt.BillablePeriod_Start = src.BillablePeriod_Start
,tgt.BillablePeriod_End = src.BillablePeriod_End
,tgt.Payment_Amount = src.Payment_Amount
,tgt.Payment_Date = src.Payment_Date
,tgt.Patient_ID = src.Patient_ID
,tgt.Provider_ID = src.Provider_ID
,tgt.status  = src.status
,tgt.Outcome = src.Outcome
,tgt.Type_Code = src.Type_Code
,tgt.Type_Display = src.Type_Display
,tgt.Type_Code_Display = src.Type_Code_Display
,tgt.Related_Value = src.Related_Value
,tgt.Related_Relationship = src.Related_Relationship
,tgt.Source = src.Source
,tgt.Final_Action = src.Final_Action
,tgt.Created = src.Created
,tgt.LastUpdated = src.LastUpdated
,tgt.MergedBy = 'Updated'
,tgt.Filename = src.Filename
,tgt.Extract_Date = src.Extract_Date
when not matched then 
insert (
 Claim_ID
,Cntrl_Num
,BillablePeriod_Start
,BillablePeriod_End
,Payment_Amount
,Payment_Date
,Patient_ID
,Provider_ID
,status
,Outcome
,Type_Code
,Type_Display
,Type_Code_Display
,Related_Value
,Related_Relationship
,Source
,Final_Action
,Created
,LastUpdated
,MergedBy
,Filename
,Extract_Date
) Values (
 Claim_ID
,Cntrl_Num
,BillablePeriod_Start
,BillablePeriod_End
,Payment_Amount
,Payment_Date
,Patient_ID
,Provider_ID
,status
,Outcome
,Type_Code
,Type_Display
,Type_Code_Display
,Related_Value
,Related_Relationship
,Source
,Final_Action
,Created
,LastUpdated
,'Inserted'
,Filename
,Extract_Date
);


update BCDA_Data.dbo.EOB_Base_v3
set
Provider_Display = pt.Provider_Name_or_ORG
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join NPPES.dbo.Primary_Taxonomy pt on 
pt.NPI = bt.Provider_ID


update BCDA_Data.dbo.EOB_Base_v3
set
 Patient_Family = pb.Family
,Patient_Given  = pb.Given
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join BCDA_Data.dbo.Patient_Base_v3 pb on 
pb.Patient_ID = bt.Patient_ID


update BCDA_Data.dbo.EOB_Base_v3
set Adj_Type = ss.supportingInfo_code_display
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on bt.Claim_ID = ss.claim_id
where ss.supportingInfo_category_code = 'CLM_ADJSTMT_TYPE_CD'

update BCDA_Data.dbo.EOB_Base_v3
set DRG = ss.supportingInfo_code
from BCDA_Data.dbo.EOB_Base_v3 bt
inner join BCDA_Staging.dbo.eob_supporting_staging_v3 ss
on bt.Claim_ID = ss.claim_id
where ss.supportingInfo_category_code = 'drg'

