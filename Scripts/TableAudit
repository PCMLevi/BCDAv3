4171,2026-07-06T17:32:55.528152,CREATE_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_02_2_Attribution_Bonus_TIN,"				
Create Procedure procCompensation_PYCurrent_02_2_Attribution_Bonus_TIN
(	
	  @CompensationYear		as Char(6)
	, @CompensationQuarter	as Varchar(6)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @Attribution_Allotment	as Float
Declare @BENE_PY_Total			as Float
Declare @Allotment_Each			as Float

Delete From Compensation_PYCurrent.dbo.Compensation_02_2_Attribution_Bonus_TIN

Drop Table if Exists #Temp_TIN

Set @Attribution_Allotment = 
(
	Select 
	Attribution_Allotment
	from Compensation_PYCurrent.dbo.Compensation_00_1_Constants
	Where
		Compensation_Year		= @CompensationYear
	and Compensation_Percent	= @CompensationPercent
) 

SELECT 
  
  ACO_GroupTin			
, Count(BENE_HIC_NUM)		as NumBENE
, Sum(BENE_PY)				as BENE_PY
, @Attribution_Allotment	as Attributon_Allotment
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized
Group By
ACO_GroupTin

Set @BENE_PY_Total = 
(
	Select 
	Sum(BENE_PY)
	From #Temp_TIN
)

Set @Allotment_Each = @Attribution_Allotment / @BENE_PY_Total

Insert Into Compensation_PYCurrent.dbo.Compensation_02_2_Attribution_Bonus_TIN
( Compensation_Quarter
, Compensation_Percent
, ACO_GroupTin
, NumBENE
, BENE_PersonYears
, AttributionBonus_Allotment
, AttributionBonus_Each
, AttributionBonus
)

SELECT 
  @CompensationQuarter
, @CompensationPercent
, ACO_GroupTin
, NumBENE
, BENE_PY
, @Attribution_Allotment
, @Allotment_Each
, BENE_PY * @Allotment_Each	as Attribution_Bonus
From #Temp_TIN

-----------------------------------
-- Update ACO and TIN Information
-----------------------------------
Update Bonus_TIN
Set 
  Bonus_TIN.ACO_GroupName			= NPI.ACO_GroupName
, Bonus_TIN.ACO_GroupTinName		= NPI.ACO_GroupTINName
, Bonus_TIN.ACO_GroupTinName_New	= NPI.ACO_GroupTinName_New
From Compensation_PYCurrent.dbo.Compensation_02_2_Attribution_Bonus_TIN Bonus_TIN
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_4_ACO_NPI NPI on
Bonus_TIN.ACO_GroupTin = NPI.ACO_GroupTin

----------------------
-- Update SQLRunDate
----------------------
Update Bonus_TIN
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_02_2_Attribution_Bonus_TIN Bonus_TIN

End"
