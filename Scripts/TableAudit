Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI
Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO

Drop Table If Exists #Temp_Base
Drop Table If Exists #Temp_ACO
Drop Table If Exists #Temp_TIN
Drop Table if Exists #Temp_NPI
Drop Table if Exists #Temp_NPIPercent
Drop Table if Exists #Temp_TINPercent


--=============================
-- Aggregate to BENE Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, Hospital_BENE
, ReAdmit_BENE
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select 
  ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY
, 1										as NumBENE_BENE
, Count(ReAdmit.Hospital_FacilityName)	as Hospital_BENE
, Count(ReAdmit.ReAdmit_FacilityName)	as ReAdmit_BENE
, Max(SQLRunDate_Hospital)				as SQLRunDate_Hospital
, Max(SQLRunDate_ReAdmit)				as SQLRunDate_ReAdmit
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_06_1_1_ReAdmit_ByBENE ReAdmit on
ACO_BENE.BENE_HIC_NUM = ReAdmit.BENE_HIC_NUM
Group By
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY


-- Select * From Compensation_PYCurrent.dbo.Compensation_06_1_2_ReAdmit_Aggregate_BENE

--=============================
-- Aggregate to ACO Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO
(
  PY_ACO
, NumBENE_ACO
, Hospital_ACO
, ReAdmit_ACO
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select
  Sum(PY_BENE)				as PY_ACO
, Sum(NumBENE_BENE)			as NumBENE_ACO
, Sum(Hospital_BENE)		as Hospital_ACO
, Sum(ReAdmit_BENE)			as ReAdmit_ACO
, Max(SQLRunDate_Hospital)	as SQLRunDate_Hospital
, Max(SQLRunDate_ReAdmit)	as SQLRunDate_ReAdmit
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE

--=============================
-- Aggregate to the TIN Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
(
  ACO_GroupTIN
, ACO_GroupTINName_New
, PY_TIN
, NumBENE_TIN
, Hospital_TIN
, ReAdmit_TIN
, Hospital_ACO
, ReAdmit_ACO
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select
  BENE.ACO_GroupTIN
, BENE.ACO_GroupTINName_New
, Sum(BENE.PY_BENE)				as PY_TIN
, Sum(BENE.NumBENE_BENE)		as NumBENE_TIN
, Sum(BENE.Hospital_BENE)		as Hospital_TIN
, Sum(BENE.ReAdmit_BENE)		as ReAdmit_TIN
, ACO.Hospital_ACO				as Hospital_ACO
, ACO.ReAdmit_ACO				as ReAdmit_ACO
, Max(BENE.SQLRunDate_Hospital)	as SQLRunDate_Hospital
, Max(BENE.SQLRunDate_ReAdmit)	as SQLRunDate_ReAdmit
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO ACO on
1=1		-- Use 1=1 Because there is nothing to join to at the ACO level
Group By
  BENE.ACO_GroupTIN
, BENE.ACO_GroupTINName_New
, ACO.Hospital_ACO
, ACO.ReAdmit_ACO

--=============================
-- Aggregate to the NPI Level
--=============================

Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_NPI
, NumBENE_NPI

, Hospital_NPI
, Hospital_TIN
, Hospital_ACO
, ReAdmit_NPI
, ReAdmit_TIN
, ReAdmit_ACO
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)
Select
  BENE.NPI
, BENE.NPI_FullName
, BENE.ACO_GroupTIN
, BENE.ACO_GroupTINName_New
, Sum(BENE.PY_BENE)				as PY_NPI
, Sum(BENE.NumBENE_BENE)		as NumBENE_NPI

, Sum(BENE.Hospital_BENE)		as Hospital_NPI
, TIN.Hospital_TIN
, ACO.Hospital_ACO

, Sum(BENE.ReAdmit_BENE)		as ReAdmit_NPI
, TIN.ReAdmit_TIN
, ACO.ReAdmit_ACO
, Max(BENE.SQLRunDate_Hospital)
, Max(BENE.SQLRunDate_ReAdmit)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE BENE
Left Join Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN TIN on
BENE.ACO_GroupTIN = TIN.ACO_GroupTIN
Left Join Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO ACO on
1=1
Group By
  BENE.ACO_GroupTIN
, BENE.ACO_GroupTINName_New
, BENE.NPI
, BENE.NPI_FullName
, TIN.Hospital_TIN
, TIN.ReAdmit_TIN
, ACO.Hospital_ACO
, ACO.ReAdmit_ACO

End"
