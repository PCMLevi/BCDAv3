2500,2026-06-04T14:05:04.146494,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_01_3_Attribution_ByCMSRiskType_Annualized,"
Alter Procedure procCompensation_PYCurrent_01_3_Attribution_ByCMSRiskType_Annualized
(	
	 @Compensation_Quarter					as Varchar(7)
   , @Compensation_Percent					as Float 
)
AS
BEGIN

Drop Table if Exists #Temp_Attribution

Declare @SelectType							as Varchar(15)
Declare @CMSRiskScore_Weight_AgedDual		as Float
Declare @CMSRiskScore_Weight_AgedNonDual	as Float
Declare @CMSRiskScore_Weight_Disabled		as Float
Declare @CMSRiskScore_Weight_ESRD			as Float

Set @SelectType				= 'Current'

Select @SelectType as SelectType, @Compensation_Quarter as Qtr, @Compensation_Percent as Pct

Set @CMSRiskScore_Weight_AgedDual = 
	(Select STLMT_BenchmarkWeight From Compensation_PYCurrent.dbo.Compensation_00_2_ACOBenchmark
	 Where CMSRiskType= 'Aged_Dual')

Set @CMSRiskScore_Weight_AgedNonDual = 
	(Select STLMT_BenchmarkWeight From Compensation_PYCurrent.dbo.Compensation_00_2_ACOBenchmark
	 Where CMSRiskType= 'Aged_NonDual')

Set @CMSRiskScore_Weight_Disabled = 
	(Select STLMT_BenchmarkWeight From Compensation_PYCurrent.dbo.Compensation_00_2_ACOBenchmark
	 Where CMSRiskType= 'Disabled')

Set @CMSRiskScore_Weight_ESRD = 
	(Select STLMT_BenchmarkWeight From Compensation_PYCurrent.dbo.Compensation_00_2_ACOBenchmark
	 Where CMSRiskType= 'ESRD')

-------------------------------------------------------
-- Write Sum of Detail by BENE, CMSRiskType
-------------------------------------------------------

Select 
  RTDetail.Compensation_Quarter
, RTDetail.Compensation_Percent
, RTDetail.ACO_GroupName
, RTDetail.ACO_GroupTinName
, RTDetail.ACO_GroupTINName_New
, RTDetail.ACO_GroupTin
, RTDetail.NPI
, RTDetail.NPI_LastName
, RTDetail.NPI_FirstName
, RTDetail.NPI_Fullname
, RTDetail.BENE_HIC_NUM
, RTDetail.BENE_HIC_NUM_Previous
, RTDetail.CMSRiskType
, ACO_BENE.BENE_CMSRiskScore								as CMSRiskScore
, Sum(RTDetail.BENE_PY)										as BENE_PY
, ACO_BENE.BENE_CMSRiskScore	* Sum(RTDetail.BENE_PY)		as CMSRiskScore_PY
, Sum(RTDetail.BENE_TotalPaid)								as BENE_TotalPaid
, Sum(RTDetail.BENE_TotalPaid)	* Sum(RTDetail.BENE_PY)		As BENE_TotalPaid_PY
Into #Temp_Attribution
from Compensation_PYCurrent.dbo.Compensation_01_1_Attribution_ByCMSRiskType_ByMonth RTDetail
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE on
RTDetail.BENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Where
ACO_BENE.BENE_YearQuarter	= @Compensation_Quarter
Group by
  RTDetail.Compensation_Quarter
, RTDetail.Compensation_Percent
, RTDetail.ACO_GroupName
, RTDetail.ACO_GroupTINName
, RTDetail.ACO_GroupTINName_New
, RTDetail.ACO_GroupTIN
, RTDetail.NPI
, RTDetail.NPI_LastName
, RTDetail.NPI_FirstName
, RTDetail.NPI_Fullname
, RTDetail.BENE_HIC_NUM
, RTDetail.BENE_HIC_NUM_Previous
, RTDetail.CMSRiskType
, ACO_BENE.BENE_CMSRiskScore

-- Select * From #Temp_Attribution

-------------------------------------------------------
-- Write Data From Detail to 01_Attribution
-------------------------------------------------------
Delete From Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized

Insert Into Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized
(
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupName
, ACO_GroupTinName
, ACO_GroupTinName_New
, ACO_GroupTin
, NPI
, NPI_LastName
, NPI_FirstName
, NPI_Fullname
, NPI_Classification
, NPI_Classification_Type
, Compensation_PYCurrent
, BENE_HIC_NUM
, BENE_HIC_NUM_Previous
, BENE_LastName
, BENE_FirstName
, BENE_FullName
, DOB
, DeathDate
, BENE_Sex
, PCS_Visits_Number
, Attrib_From
, BENE_PY
, CMSRiskType
, CMSRiskScore
, CMSRiskScore_PY
, CMSRiskType_Weight
, BENE_TotalPaid
, BENE_TotalPaid_PY
, BENE_TotalPaid_PY_Annualized
, SQLRunDate
)

Select 
  @Compensation_Quarter
, @Compensation_Percent
, TAttrib.ACO_GroupName
, TAttrib.ACO_GroupTinName
, TAttrib.ACO_GroupTINName_New
, TAttrib.ACO_GroupTin
, TAttrib.NPI
, TAttrib.NPI_LastName
, TAttrib.NPI_FirstName
, TAttrib.NPI_Fullname
, ACO.ACO_NPI_Classification						
, ACO.ACO_NPI_Classification_Type					
, ACO.ACO_Compensation_PYCurrent					
, TAttrib.BENE_HIC_NUM
, TAttrib.BENE_HIC_NUM_Previous
, ACO_BENE.BENE_LastName
, ACO_BENE.BENE_FirstName
, ACO_BENE.BENE_LastName + ', ' + 
  ACO_BENE.BENE_FirstName							
, ACO_BENE.BENE_BirthDate							
, ACO_BENE.BENE_DeathDate							
, ACO_BENE.BENE_Sex
, Cast(0 as Int)									
, ACO_BENE.BENE_Attribution_From					
, TAttrib.BENE_PY								
, TAttrib.CMSRiskType
, TAttrib.CMSRiskScore
, TAttrib.CMSRiskScore_PY
, Cast(0 as Float)									
, IsNull(TAttrib.BENE_TotalPaid,0)					
, IsNull(TAttrib.BENE_TotalPaid_PY,0)				
, IsNull(CCLF_Functions.dbo.Divide_Return0
  (TAttrib.BENE_TotalPaid, TAttrib.BENE_PY),0)	
, GetDate()											
from #Temp_Attribution TAttrib
Inner Join
Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE on
TAttrib.BENE_HIC_NUM = ACO_BENE.BENE_HIC_NUM
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
TAttrib.NPI = ACO.ACO_NPIIndividual
Where
	ACO_BENE.BENE_YearQuarter			= @Compensation_Quarter

------------------------------
-- Update PCS Visits
------------------------------
Update Attrib
Set 
Attrib.PCS_Visits_Number = Q4_PCS_Count
From Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized Attrib
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	Q4.Q4_HICN			= Attrib.BENE_HIC_NUM
and Q4.Q4_IndividualNPI = Attrib.NPI
Where
Q4.Q4_YearQuarter = @Compensation_Quarter

-------------------------------------------
-- Update PCS Visits for Voluntary Aligned
-------------------------------------------
Update Attrib
Set 
Attrib.PCS_Visits_Number = 0
From Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized Attrib
Where
Attrib.Attrib_From = 'Voluntary Aligned'

------------------------------------
-- Update CMS Risk Score Weight
------------------------------------
Update Attrib
Set Attrib.CMSRiskType_Weight = 
  Case
	When Attrib.CMSRiskType= 'Aged_Dual'	Then @CMSRiskScore_Weight_AgedDual
	When Attrib.CMSRiskType= 'Aged_NonDual'	Then @CMSRiskScore_Weight_AgedNonDual
	When Attrib.CMSRiskType= 'Disabled'		Then @CMSRiskScore_Weight_Disabled
	When Attrib.CMSRiskType= 'ESRD'			Then @CMSRiskScore_Weight_ESRD
	Else 0
  End
from Compensation_PYCurrent.dbo.Compensation_01_3_Attribution_ByCMSRiskType_Annualized Attrib

END"
