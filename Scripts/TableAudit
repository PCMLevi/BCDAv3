RAISERROR  (@MsgString, 10,1) WITH NOWAIT

-------------------------------------------------------
-- Update the Max Date found in Final Data
-------------------------------------------------------
Set @StartTime = GetDate()

Select 
  Uniq.BENE_HIC_NUM
, Max(CLM_THRU_DT) as MaxCLM_THRU_DT
Into #Temp_Max_CLM_Date
from CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
Uniq.BENE_HIC_NUM = FinalData.BENE_HIC_NUM
Group by
 Uniq.BENE_HIC_NUM

 Update Uniq
 Set MaxCLM_THRU_DT = T8.MaxCLM_THRU_DT
 from CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq
 Inner Join
 #Temp_Max_CLM_Date T8 on 
 Uniq.BENE_HIC_NUM = T8.BENE_HIC_NUM

Set @StopTime = GetDate()
Set @MsgString = 'Max Date Updated (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

-------------------------------------------------------
-- Update the Death Date and Age
-------------------------------------------------------
Set @StartTime = GetDate()

Update Uniq
Set 
  Uniq.BENE_DeathDate = GEO.BENE_DEATH_DT
, Uniq.BENE_AGE = 
	Case 
		When GEO.BENE_DEATH_DT is null		Then DateDiff(year, Uniq.BENE_BirthDate, GetDate())
		When GEO.BENE_DEATH_DT is not Null	Then DateDiff(year, Uniq.BENE_BirthDate, GEO.BENE_DEATH_DT)
	END
from CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq
Inner Join
CCLF_Subsets.dbo.BENE_GEO_INFO GEO on
Uniq.BENE_HIC_NUM = GEO.BENE_HIC_NUM
Where
Uniq.BENE_DeathDate is null
and GEO.BENE_DEATH_DT is not null

Set @StopTime = GetDate()
Set @MsgString = 'Death Date and Age Updated (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

-------------------------------------------------------
-- Add / Update Last AWV Date
-------------------------------------------------------
Set @StartTime = GetDate()

Select 
  BENE_HIC_NUM
, Max(CLM_THRU_DT) as LastAWV
Into #Temp_Last_AWV
from CCLF_Subsets.dbo.CLM_HCPCS
Where
CLM_LINE_HCPCS_CD In ('G0438','G0439','G0402')
Group by
BENE_HIC_NUM

Update Uniq
Set Uniq.LastAWV = T9.LastAWV
from CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq 
Left Join
#Temp_Last_AWV T9 on 
Uniq.BENE_HIC_NUM = T9.BENE_HIC_NUM

Set @StopTime = GetDate()
Set @MsgString = 'AWV Updated (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

-------------------------------------------------------
-- Update Master ID
-------------------------------------------------------
Update Uniq
Set Uniq.BENE_MasterID = ML.BENE_MasterID
From CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq
Inner Join
CCLF_LookupTables.dbo.ACO_BENE_MasterList ML on
	Uniq.BENE_HIC_NUM = ML.BENE_HIC_NUM
Or  Uniq.BENE_HIC_NUM = ML.BENE_HIC_NUM_Previous

------------------------
-- Update SQLRunDate
------------------------
Update Uniq
Set SQLRunDate = GETDATE()
From CCLF_LookupTables.dbo.ACO_Beneficiaries_Unique Uniq
END
