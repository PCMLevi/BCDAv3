set @claimyear        = (select CCLFFileYear from database_constants.dbo.Import_Export_Automated)--'2026'


select
    *
into #temp_total
from
    CCLF_subsets.dbo.clm_dgns_test
where 1=2

select
    *
into #temp_aco_npi
from
    CCLF_subsets.dbo.clm_dgns_test
where 1=2

set @sql = 
'
select 
	   lt.[MedicareFileDate]
      ,lt.[CCLFFile]
      ,lt.[CUR_CLM_UNIQ_ID]
      ,lt.[BENE_MBI_ID]
      ,lt.[BENE_HIC_NUM]
      ,lt.[CLM_TYPE_CD]
      ,lt.[CLM_TYPE]
      ,lt.[CLM_PROD_TYPE_CD]
      ,lt.[CLM_PROD_TYPE]
      ,lt.[CLM_VAL_SQNC_NUM]
      ,lt.[CLM_DGNS_CD]
      ,lt.[CLM_DGNS]
      ,lt.[BENE_EQTBL_BIC_HICN_NUM]
      ,lt.[PRVDR_OSCAR_NUM]
      ,lt.[CLM_FROM_DT]
      ,lt.[CLM_THRU_DT]
      ,lt.[CLM_POA_IND]
      ,lt.[CLM_POA_ShortDesc]
      ,lt.[DGNS_PRCDR_ICD_IND]
      ,lt.[CLM_BLG_PRVDR_OSCAR_NUM]
      ,fd.ATNDG_PRVDR_NPI_NUM
      ,fd.ATNDG_Prvdr_LName
      ,fd.ATNDG_Prvdr_FName
      ,aco.ACO_Active
      ,fd.FAC_PRVDR_NPI_NUM
      ,fd.FAC_Prvdr_LName
      ,fd.FAC_Prvdr_FName
      ,''CCLF4'' as clm_dgns_position
      into ##temp_CCLF4
from [CCLF_Months].[dbo].[CCLF4_'+@claimyear+'_WithLookupTables] lt
inner join CCLF_ProgrammingCopy.dbo.CCLF_FinalData fd on  
fd.[CUR_CLM_UNIQ_ID] = lt.[CUR_CLM_UNIQ_ID]
left join cclf_lookuptables.dbo.ACO aco on 
aco.ACO_NPIIndividual = fd.ATNDG_PRVDR_NPI_NUM
where lt.MedicareFileDate = '+quotename(@medicarefiledate, '''')+'
'

exec(@sql)

--select distinct * from ##temp_CCLF4 Order by BENE_HIC_NUM, CLM_DGNS_CD

set @sql = 
'
select lt.[MedicareFileDate]
      ,lt.[CCLFFile]
      ,lt.[CUR_CLM_UNIQ_ID]
      ,lt.[CLM_LINE_NUM]
      ,lt.[BENE_MBI_ID]
      ,lt.[BENE_HIC_NUM]
      ,lt.[CLM_TYPE_CD]
      ,lt.[CLM_TYPE]
      ,lt.[CLM_FROM_DT]
      ,lt.[CLM_THRU_DT]
      ,lt.[RNDRG_PRVDR_TYPE_CD]
