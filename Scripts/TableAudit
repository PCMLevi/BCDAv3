3668,2026-06-22T08:30:37.904236,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_05_1_3_EDObs_Calculations,"
Alter Procedure procCompensation_PYCurrent_05_1_3_EDObs_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=======================================
-- Calculate 
--   EDVisit_E1000
-- , EDVisit_E1000 Average
-- , E1000_Group_Under_Total
-- , E1000_Group_Flag_Under_Total
--	 For Each Group
--=======================================

--========================
-- Update ACO Aggregate
--========================

--------------
-- ED Visit
--------------
Select 
  Sum(EDVisit_ACO)	as EDVisit_ACO
, Sum(PY_ACO)		As PY_ACO
Into #Temp_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO

-------------------
-- ED Visit E1000
-------------------
Update ACO
Set 
  EDVisit_E1000_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	  EDVisit_ACO
	, PY_ACO) * 1000
, EDVisit_Average_PY_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	  EDVisit_ACO
	, PY_ACO)
From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO ACO

-------------------------
-- ED Visit Declare's
-------------------------
Declare @EDVisit_ACO				As int
Declare @EDVisit_E1000_ACO			as Float
Declare @EDVisit_Average_PY_ACO	As Float

Set		@EDVisit_ACO = 
		(Select EDVisit_ACO
		 From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO)

Set		@EDVisit_E1000_ACO = 
		(Select EDVisit_E1000_ACO 
		 From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO)

Set		@EDVisit_Average_PY_ACO = 
			(Select EDVisit_Average_PY_ACO 
			 From Compensation_PYCurrent.dbo.Compensation_05_1_2_4_EDObs_Aggregate_ACO)

Select 
  @EDVisit_ACO				as ACO
, @EDVisit_E1000_ACO		as E1000_ACO
, @EDVisit_Average_PY_ACO	as E1000_Avg_ACO

--========================
-- Update TIN Aggregate
--========================

----------------
-- TIN EDVisit
----------------
Select 
  ACO_GroupTIN
, Sum(EDVisit_TIN)	as EDVisit_TIN
, @EDVisit_ACO		As EDVisit_ACO
, Sum(PY_TIN)		As PY_TIN
Into #Temp_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN
Group By
ACO_GroupTIN

Update TIN
Set 
  TIN.EDVisit_TIN		= TempTIN.EDVisit_TIN
, TIN.EDVisit_ACO		= TempTIN.EDVisit_ACO
, TIN.PY_TIN			= TempTIN.PY_TIN
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN
Inner Join
#Temp_TIN TempTIN on
TIN.ACO_GroupTIN = TempTIN.ACO_GroupTIN

----------------------
-- TIN EDVisit E1000
----------------------
Update TIN
Set 
  TIN.EDVisit_E1000_TIN			= 
	  CCLF_Functions.dbo.Divide_Return0(
	  TTIN.EDVisit_TIN
	, TTIN.PY_TIN) * 1000
, TIN.EDVisit_E1000_ACO			= @EDVisit_E1000_ACO
, TIN.EDVisit_Average_PY_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	  TTIN.EDVisit_TIN
	, TTIN.PY_TIN)
, TIN.EDVisit_Average_PY_ACO = @EDVisit_Average_PY_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN
Left Join
#Temp_TIN TTIN on
TIN.ACO_GroupTIN = TTIN.ACO_GroupTIN

-----------------------------------------------
-- TIN EDVisit % Under
-- Less EDVisits than Avg ACO Visits = Better
-----------------------------------------------
-- Select * From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN
Update TIN
Set 
EDVisit_E1000_TIN_Under_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (TIN.EDVisit_E1000_TIN
	- TIN.EDVisit_E1000_ACO)
	, TIN.EDVisit_E1000_ACO)
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN

Update TIN
Set 
EDVisit_Flag_TIN_Under_ACO = 
	Case
		When EDVisit_E1000_TIN_Under_ACO < 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN

--========================
-- Update NPI Aggregate
--========================

----------------
-- NPI EDVisit
----------------
Select 
  NPI
, Sum(EDVisit_NPI)	As EDVisit_NPI
, Sum(EDVisit_TIN)	as EDVisit_TIN
, @EDVisit_ACO		As EDVisit_ACO
, Sum(PY_NPI)		As PY_NPI
Into #Temp_NPI
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI
Group By
NPI

Update NPI
Set 
  NPI.EDVisit_NPI		= TempNPI.EDVisit_NPI
, NPI.EDVisit_TIN		= TempNPI.EDVisit_TIN
, NPI.EDVisit_ACO		= TempNPI.EDVisit_ACO
, NPI.PY_NPI			= TempNPI.PY_NPI
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI
Inner Join
#Temp_NPI TempNPI on
NPI.NPI = TempNPI.NPI

----------------------
-- NPI EDVisit E1000
----------------------
Update NPI
Set 
  NPI.EDVisit_E1000_NPI			= 
	  CCLF_Functions.dbo.Divide_Return0(
	  NPI.EDVisit_NPI
	, NPI.PY_NPI) * 1000
, NPI.EDVisit_E1000_TIN			= TIN.EDVisit_E1000_TIN
, NPI.EDVisit_E1000_ACO			= @EDVisit_E1000_ACO
, NPI.EDVisit_Average_PY_NPI = 
	  CCLF_Functions.dbo.Divide_Return0(
	  NPI.EDVisit_NPI
	, NPI.PY_NPI)
, NPI.EDVisit_Average_PY_TIN = TIN.EDVisit_Average_PY_TIN
, NPI.EDVisit_Average_PY_ACO = @EDVisit_Average_PY_ACO
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI
Left Join
Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN

-----------------------------------------------
-- NPI EDVisit % Under
-- Less EDVisits than Avg ACO Visits = Better
-----------------------------------------------
Update NPI
Set 
  EDVisit_E1000_NPI_Under_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (NPI.EDVisit_E1000_NPI
	- NPI.EDVisit_E1000_TIN)
	, NPI.EDVisit_E1000_TIN)
, EDVisit_E1000_NPI_Under_ACO = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (NPI.EDVisit_E1000_NPI
	- NPI.EDVisit_E1000_ACO)
	, NPI.EDVisit_E1000_ACO)
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI

Update NPI
Set 
  EDVisit_Flag_NPI_Under_TIN = 
	Case
		When EDVisit_E1000_NPI_Under_TIN < 0
		Then 1
		Else 0
	End

, EDVisit_Flag_NPI_Under_ACO = 
	Case
		When EDVisit_E1000_NPI_Under_ACO < 0
		Then 1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_05_1_2_2_EDObs_Aggregate_NPI NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_05_1_2_3_EDObs_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN

End 
