3624,2026-06-19T19:11:10.939895,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_2_ReAdmit_Aggregate,"
Alter Procedure dbo.procCompensation_PYCurrent_06_1_2_ReAdmit_Aggregate
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE
Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_ReAdmit_Aggregate_NPI
Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_ReAdmit_Aggregate_TIN
Delete From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO

Drop Table If Exists #Temp_Base
Drop Table If Exists #Temp_ACO
Drop Table If Exists #Temp_TIN
Drop Table if Exists #Temp_NPI
Drop Table if Exists #Temp_NPIPercent
Drop Table if Exists #Temp_TINPercent


--=============================
-- Aggregate to BENE Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_1_ReAdmit_Aggregate_BENE
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, Hospital_BENE
, ReAdmit_BENE
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select 
  ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY
, 1										as NumBENE_BENE
, Count(ReAdmit.Hospital_FacilityName)	as Hospital_BENE
, Count(ReAdmit.ReAdmit_FacilityName)	as ReAdmit_BENE
, Max(SQLRunDate_Hospital)				as SQLRunDate_Hospital
, Max(SQLRunDate_ReAdmit)				as SQLRunDate_ReAdmit
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_06_1_1_ReAdmit_ByBENE ReAdmit on
ACO_BENE.BENE_HIC_NUM = ReAdmit.BENE_HIC_NUM
Group By
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY


-- Select * From Compensation_PYCurrent.dbo.Compensation_06_1_2_ReAdmit_Aggregate_BENE

--=============================
-- Aggregate to ACO Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_1_2_4_ReAdmit_Aggregate_ACO
(
  PY_ACO
, NumBENE_ACO
, Hospital_ACO
, ReAdmit_ACO
, SQLRunDate_Hospital
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select
  Sum(PY_BENE)				as PY_ACO
, Sum(NumBENE_BENE)			as NumBENE_ACO
, Sum(Hospital_BENE)		as Hospital_ACO
, Sum(ReAdmit_BENE)			as ReAdmit_ACO
, Max(SQLRunDate_Hospital)	as SQLRunDate_Hospital
, Max(SQLRunDate_ReAdmit)	as SQLRunDate_ReAdmit
