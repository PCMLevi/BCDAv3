    CCLF_LookupTables.dbo.tbl_HCC_HCPCS_ICD10CM HCC on
      DGNS.CLM_DGNS_CD = HCC.Diagnosis_Code
    Left Join
    CCLF_LookupTables.dbo.tbl_ICD10CM ICD10CM on
      DGNS.CLM_DGNS_CD = ICD10CM.ICD10CM_Code
    left join
    NPPES.dbo.npidata_pfile Nppes on		
         DGNS.RNDRG_PRVDR_NPI_NUM = Nppes.NPI
      where from_merge is not null

update dgns
      set 
	   FAC_PRVDR_NPI_Name			    = nppes.[Provider Last Name (Legal Name)] + ', ' + nppes.[Provider First Name]
      ,FAC_Prvdr_FName					= nppes.[Provider First Name]
      ,FAC_Prvdr_LName					= nppes.[Provider Last Name (Legal Name)]
      ,FAC_Prvdr_Org_Name_Lgl_Bus_Name  = nppes.[Provider Organization Name (Legal Business Name)]
      ,FAC_Prvdr_Othr_Org_Name          = nppes.[Provider Other Organization Name]
      ,ClaimYear                        = year(dgns.CLM_THRU_DT)
      from
    CCLF_subsets.dbo.clm_dgns_test DGNS
    left join
    NPPES.dbo.npidata_pfile Nppes on		
      DGNS.FAC_PRVDR_NPI_NUM = Nppes.NPI
      where from_merge is not null

update dgns
      set ATNDG_Prvdr_Org_Name_Lgl_Bus_Name = nppes.[Provider Organization Name (Legal Business Name)]
      from
    CCLF_subsets.dbo.clm_dgns_test DGNS
    left join
    NPPES.dbo.npidata_pfile Nppes on		
      DGNS.ATNDG_PRVDR_NPI_NUM = Nppes.NPI
      where from_merge is not null


END
