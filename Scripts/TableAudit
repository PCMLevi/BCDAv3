2649,2026-06-10T20:16:04.580291,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_3_2_HospReAdmit_Aggregate,"
Alter Procedure dbo.procCompensation_PYCurrent_06_3_2_HospReAdmit_Aggregate
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Delete From Compensation_PYCurrent.dbo.Compensation_06_3_2_1_HospReAdmit_Aggregate_BENE
Delete From Compensation_PYCurrent.dbo.Compensation_06_3_2_2_HospReAdmit_Aggregate_NPI
Delete From Compensation_PYCurrent.dbo.Compensation_06_3_2_3_HospReAdmit_Aggregate_TIN
Delete From Compensation_PYCurrent.dbo.Compensation_06_3_2_4_HospReAdmit_Aggregate_ACO

Drop Table If Exists #Temp_Base
Drop Table If Exists #Temp_ACO
Drop Table If Exists #Temp_TIN
Drop Table if Exists #Temp_NPI
Drop Table if Exists #Temp_NPIPercent
Drop Table if Exists #Temp_TINPercent

--=========================================================
-- Aggregate to BENE Level
-- Use 06_3_1 for BENE (Each BENE has 0+ Hospital Visits)
--=========================================================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_3_2_1_HospReAdmit_Aggregate_BENE
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, HospVisit_BENE
, HospPaid_BENE
, ReAdmit_BENE
, ReAdmitPaid_BENE
, HospReAdmit_BENE
, HospReAdmitPaid_BENE
, SQLRunDate_Hosp
, SQLRunDate_ReAdmit
, SQLRunDate
)

Select 
  ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY
, 1										as NumBENE_BENE
, Sum(HospReAdmit.HospVisit_Count )		as HospVisit_BENE
, Sum(HospReAdmit.HospPaid)				as HospPaid
, Sum(HospReAdmit.ReAdmitVisit_Count )	as ReAdmit_BENE
, Sum(HospReAdmit.ReAdmitPaid)			as ReAdmitPaid
, Sum(HospReAdmit.HospReAdmit_Visit)	as HospReAdmit_Visit
, Sum(HospReAdmit.HospReAdmitPaid)		as HospReAdmitPaid	
, Max(SQLRunDate_Hosp)					as SQLRunDate_Hosp
, Max(SQLRunDate_ReAdmit)				as SQLRunDate_ReAdmit
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_06_3_1_HospReAdmit_ByBENE HospReAdmit on
ACO_BENE.BENE_HIC_NUM = HospReAdmit.BENE_HIC_NUM
Group By
  ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY

-- Select * From Compensation_PYCurrent.dbo.Compensation_06_3_2_HospReAdmit_Aggregate_BENE

--=====================================================
-- Aggregate to NPI Level
-- Use 06_3_2_1 (NOT 06_3_1).  
-- 06_3_2_1 has aggregated BENE to th BENE Sum Level 
-- for multiple Rows per BENE
--=====================================================
Insert Into Compensation_PYCurrent.dbo.Compensation_06_3_2_2_HospReAdmit_Aggregate_NPI
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, PY_NPI
, NumBENE_NPI
, HospVisit_NPI
, HospPaid_NPI
, ReAdmit_NPI
