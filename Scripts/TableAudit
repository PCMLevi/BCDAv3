Where
	CLM_LINE_NUM	= ''1''
and ClaimYear		= @ClaimYear
and DGNS.CCLFFile	= @CCLFFile
and DGNS.FromFile	= @FromFile
'
exec sp_executesql
    @sql,
    N'@ClaimYear char(6),
      @CCLFFile char(5),
      @FromFile varchar(5),
      @MedicareFileDate date',
    @ClaimYear = @ClaimYear,
    @CCLFFile = @CCLFFile,
    @FromFile = @FromFile,
    @MedicareFileDate = @MedicareFileDate


