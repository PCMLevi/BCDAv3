Create Procedure dbo.procCompensation_PYCurrent_10_001_A1C_1_ByBene
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
	, @MDI_Download_DT		as Date
)
AS
BEGIN

Declare @SelectType		as Varchar(15)
Declare @MeasureNumber	as Varchar(3)
Declare @MeasureName	as Varchar(255)
Declare @MeasureAbbr	as Varchar(5)

