2849,2026-06-13T09:06:08.749193,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_06_1_3_Hospital_ReAdmit_Calculations,"
Alter Procedure procCompensation_PYCurrent_06_1_3_Hospital_ReAdmit_Calculations
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--====================================================
-- Calculate Hospital ReAdmit Percent 
-- Calculate Hospital ReAdmit Average
-- Calculate Hospital ReAdmit Percent Over_Under
--====================================================
Drop Table if Exists #Temp_ACO
Drop Table if Exists #Temp_TIN
Drop Table if Exists #Temp_NPI

--=========================
-- ACO Percent (Average)
--=========================
Declare @Average_ACO as Float

Set @Average_ACO = 
(Select CCLF_Functions.dbo.Divide_Return0(ReAdmit_VisitCount_ACO, Hospital_VisitCount_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_Hospital_ReAdmit_Aggregate_ACO ACO)

Update ACO
Set Hospital_ReAdmit_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_4_Hospital_ReAdmit_Aggregate_ACO ACO

--=========================
-- TIN Percent (Average)
--=========================
Update TIN
Set 
  TIN.Hospital_ReAdmit_Average_TIN = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	  TIN.ReAdmit_VisitCount_TIN
	, TIN.Hospital_VisitCount_TIN)
, TIN.Hospital_ReAdmit_Percent_TIN = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	  TIN.ReAdmit_VisitCount_TIN
	, TIN.Hospital_VisitCount_TIN)
, TIN.Hospital_ReAdmit_Average_ACO = @Average_ACO
from Compensation_PYCurrent.dbo.Compensation_06_1_2_3_Hospital_ReAdmit_Aggregate_TIN TIN

Update TIN
Set 
TIN.Hospital_ReAdmit_OverUnder_TIN = 
	  CCLF_Functions.dbo.Divide_Return0(
	 (TIN.Hospital_ReAdmit_Average_TIN 
	- TIN.Hospital_ReAdmit_Average_ACO)
	, TIN.Hospital_ReAdmit_Average_ACO)
From Compensation_PYCurrent.dbo.Compensation_06_1_2_3_Hospital_ReAdmit_Aggregate_TIN TIN

Update NPI
Set 
NPI.Hospital_ReAdmit_Average_TIN = TIN.Hospital_ReAdmit_Average_TIN
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_Hospital_ReAdmit_Aggregate_NPI NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_06_1_2_3_Hospital_ReAdmit_Aggregate_TIN TIN on
NPI.ACO_GroupTIN = TIN.ACO_GroupTIN

--=========================
-- NPI Percent (Average)
--=========================
Update NPI
Set 
  NPI.Hospital_ReAdmit_Percent_NPI = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	  NPI.ReAdmit_VisitCount_NPI
	, NPI.Hospital_VisitCount_NPI)
, NPI.Hospital_ReAdmit_Average_ACO = @Average_ACO
From Compensation_PYCurrent.dbo.Compensation_06_1_2_2_Hospital_ReAdmit_Aggregate_NPI NPI

Update NPI
Set 
  NPI.Hospital_ReAdmit_OverUnder_TIN = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	 (NPI.Hospital_ReAdmit_Percent_NPI 
	- NPI.Hospital_ReAdmit_Average_TIN)
	, NPI.Hospital_ReAdmit_Average_TIN)
, NPI.Hospital_ReAdmit_OverUnder_ACO = 
	  CCLF_FUnctions.dbo.Divide_Return0(
	 (NPI.Hospital_ReAdmit_Percent_NPI 
	- NPI.Hospital_ReAdmit_Average_ACO)
	, NPI.Hospital_ReAdmit_Average_ACO)

from Compensation_PYCurrent.dbo.Compensation_06_1_2_2_Hospital_ReAdmit_Aggregate_NPI NPI

End
