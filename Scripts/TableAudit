3787,2026-06-25T12:48:05.398303,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_2_A1C_Aggregate,"
Alter Procedure dbo.procCompensation_PYCurrent_10_001_2_A1C_Aggregate
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_0_A1C_Aggregate_MDI
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_1_A1C_Aggregate_BENE
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_2_A1C_Aggregate_NPI
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_3_A1C_Aggregate_TIN
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO
Delete From Compensation_PYCurrent.dbo.Compensation_10_001_2_5_A1C_Aggregate_MDI

Drop Table If Exists #Temp_Base
Drop Table If Exists #Temp_ACO
Drop Table If Exists #Temp_TIN
Drop Table if Exists #Temp_NPI
Drop Table if Exists #Temp_NPIPercent
Drop Table if Exists #Temp_TINPercent


--=============================
-- Aggregate to BENE Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_1_A1C_Aggregate_BENE
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, BENE_FullName
, PY_BENE
, NumBENE_BENE
, A1C_Eligible
, A1C_Complete
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, SQLRunDate_MDI_A1C
, SQLRunDate
)

Select 
  ACO_BENE.NPI
, ACO_BENE.NPI_FullName
, ACO_BENE.ACO_GroupTIN
, ACO_BENE.ACO_GroupTINName_New
, ACO_BENE.BENE_HIC_NUM
, ACO_BENE.BENE_FullName
, ACO_BENE.BENE_PY
, 1						as NumBENE_BENE
, A1C_Eligible
, A1C_Complete
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, SQLRunDate_MDI_A1C
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE
Left Join
Compensation_PYCurrent.dbo.Compensation_10_001_1_A1C_ByBENE A1C on
ACO_BENE.BENE_HIC_NUM = A1C.BENE_HIC_NUM

-- Select * From Compensation_PYCurrent.dbo.Compensation_10_001_2_A1C_Aggregate_BENE

--=============================
-- Aggregate to ACO Level
--=============================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_4_A1C_Aggregate_ACO
(
  GroupName
, PY_BENE_ACO
, NumBENE_BENE_ACO
, A1C_Eligible_ACO
, A1C_Complete_ACO
, A1C_Met_ACO
, A1C_NotMet_ACO
, A1C_UnReported_ACO
, A1C_Pass_ACO
, A1C_Fail_ACO
, SQLRunDate_MDI_A1C
, SQLRunDate
)
Select
  'ACO'
, Sum(ACO_BENE.BENE_PY)
, Sum(numBENE_BENE)
, Sum(A1C_Eligible)
, Sum(A1C_Complete)
, Sum(A1C_Met)
, Sum(A1C_NotMet)
, Sum(A1C_UnReported)
, Sum(A1C_Pass)
, Sum(A1C_Fail)
, Max(SQLRunDate_MDI_A1C)
, GetDate()
From Compensation_PYCurrent.dbo.Compensation_00_3_ACO_Beneficiaries ACO_BENE 
Left Join
Compensation_PYCurrent.dbo.Compensation_10_001_1_A1C_ByBENE A1C on
ACO_BENE.BENE_HIC_NUM = A1C.BENE_HIC_NUM

--=============================================================
-- Aggregate to MDI BENE Level
--
-- NOTE:  I am creating this to aggregate to (MDI Summary) and 
--		  compare Summary results against Quality Submission
--		  Details that Jae tracks.
--=============================================================
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_2_0_A1C_Aggregate_MDI
(
  NPI
, NPI_Fullname
, ACO_GroupTIN
, ACO_GroupTINName_New
, BENE_HIC_NUM
, PY_BENE
, NumBENE_BENE
, A1C_Eligible
, A1C_Complete
, A1C_Met
, A1C_NotMet
, A1C_UnReported
, A1C_Pass
, A1C_Fail
, SQLRunDate_MDI_A1C
, SQLRunDate
)

