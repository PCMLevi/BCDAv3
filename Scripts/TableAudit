            @rundate,
            @JobName,
            @CurrentProc,
            @StartTime,
            SYSDATETIME(),
            'Failed',
            ERROR_NUMBER(),
            ERROR_MESSAGE()
        );
    throw

end catch
set xact_abort off

END

