	 , @IDR_LD_DT				as Date
	 , @StartDate_1				as Date
	 , @StartDate_2				as Date
	 , @StartDate_3				As Date
	 , @StartDate_4				As Date
	 , @StartDate_5				As Date
	 , @StartDate_6				As Date
	 , @StartDate_7				As Date
	 , @StartDate_8				As Date
	 , @StartDate_9				As Date
	 , @StartDate_10			As Date
	 , @StartDate_11			As Date
	 , @StartDate_12			As Date
	 , @StopDate_1				As Date
	 , @StopDate_2				As Date
	 , @StopDate_3				As Date
	 , @StopDate_4				As Date
	 , @StopDate_5				As Date
	 , @StopDate_6				As Date
	 , @StopDate_7				As Date
	 , @StopDate_8				As Date
	 , @StopDate_9				As Date
	 , @StopDate_10				As Date
	 , @StopDate_11				As Date
	 , @StopDate_12				As Date
	 )
AS
