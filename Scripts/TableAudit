2439,2026-06-04T09:52:29.884754,CREATE_PROCEDURE,CCLF_Procedures,dbo,BCBS_Crosswalk_Update,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE BCBS_Crosswalk_Update
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

-------------------------------------------------
-- Update Crosswalk Information that is Missing
-- but pertinent
-------------------------------------------------

Declare @BCBSFileDate as Date
Set @BCBSFileDate = (select max(bcbsfiledate) from BCBS_Months.dbo.Crosswalk_Months)

Drop Table if Exists #Temp1
Drop Table if Exists #Temp2

------------------------------------------
-- Find Information from Crosswalk file
-- Indicator_834 means Patient is in the
-- Current Membership File
------------------------------------------
Select
  PatientId				As Crosswalk_PatientID
, BCBSFileDate			As Crosswalk_BCBSFileDate
, PatientID_Type		As Crosswalk_PatientID_Type
, MemberCounty			As Crosswalk_MemberCounty
, MemberCountyMarket	as Crosswalk_MemberCountyMarket
, ProductType_CD		As CrossWalk_ProductType_CD
, ProductType			As CrossWalk_ProductType
Into #Temp1
from BCBS_Months.dbo.Crosswalk_Months
Where
BCBSFileDate = @BCBSFileDate
and Indicator_834 = 'Y'

------------------------------------------
-- Find Information from Membership File
------------------------------------------
Select 
  PatientId				As Mbr_PatientID
, BCBSFileDate			As Mbr_BCBSFileDate
, PatientID_Type		As Mbr_PatientID_Type
, MemberCounty			As Mbr_MemberCounty
, MemberCountyMarket	As Mbr_MemberCountyMarket
, ProductType_CD		As Mbr_ProuctType_Cd
, Null					as Mbr_ProductType
Into #Temp2
From BCBS_Months.dbo.Membership_Months
Where
BCBSFileDate = @BCBSFileDate

----------------------------------------
-- Join the two files togeter
-- Select just the Pertinent information
-- To Update the Corsswalk File
----------------------------------------
Select 
  Mbr_PatientID
, Mbr_BCBSFileDate
, Mbr_PatientID_Type
, Mbr_MemberCounty
, Mbr_MemberCountyMarket
Into #Temp3
from #Temp1 T1
Left Join
#Temp2 T2 on
T1.Crosswalk_PatientID = T2.Mbr_PatientID
Order by
T1.Crosswalk_PatientID

Update Xref
Set
  Xref.PatientID_Type		= T3.Mbr_PatientID_Type
, Xref.MemberCounty			= T3.Mbr_MemberCounty
, Xref.MemberCountyMarket	= T3.Mbr_MemberCountyMarket
from BCBS_Months.dbo.Crosswalk_Months Xref
Inner Join
#Temp3 T3 on
	Xref.BCBSFileDate		= T3.Mbr_BCBSFileDate
and Xref.PatientID			= T3.Mbr_PatientID
Where
	Xref.Indicator_834		= 'Y'
and BCBSFileDate			= @BCBSFileDate


END
"
