5632,2026-08-12T14:30:53.629619,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_30_2_0_ACO_Beneficiaries_2025_Quarterly_Ver3_0,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_30_2_0_ACO_Beneficiaries_2025_Quarterly_Ver3_0
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	--*********************************************************************************************
-- 30_2_0_ACO_Beneficiaries_2025_Quarterly_Ver3_0.sql
--
-- vst 11/11/2025 Changes
-- 
-- Some Voluntary Aligned Beneficiaries DO have PCS records in the Q4 Table.
--
-- Change:  
--		Some Beneficiaries have PCS Records in QASSGN_4 (which is the QARL data)
--
--		Some Beneficiaries do not have PCS Records and are only 
--		Voluntary aligned (data in QASSGN_1 (which is the QARL data).
--
--		Some Beneficiary are Voluntarily aligned with an Physician 
--		who is no longer Active in the ACO.
--
-- Flag Definitions:
--		FLAG_NPI_PCS:	Beneficiary has records in the PCS Table (QASSGN_1_4)
--		FLAG_NPI_VA:	Beneficiary is Voluntarily Aligned and has a row in the QASSGN_1_1 Table
--		Flag_VA_Active:	The Physician is marked ""Active"" in the ACO Table.
--	
-- To handle all of the different scenarios, a truth table has been 
-- created to designate current Attribution.
--
--		  Flag			   Flag			  Flag			Bene_Attribution	Bene_Attribution
--		  InPCS			   InVA			  Active		NPI_Number			NPI_Number2
--														PCS or VA			PCS or VA
--		__________		__________		__________		________________	_________________
--		   1				1				1			  VA_NPI				PCS_NPI
--		   1				0				#N/A		  PCS_NPI				NULL
--		   1				1				0			  PCS_NPI				VA_NPI
--		   0				1				1			  VA_NPI				NULL
--		   0 				1				0			  VA_NPI				NULL
--
--*********************************************************************************************

-----------------------------------------------------
-- Trying to re-work Beneficiary File
-- CHANGE THE CCLF8 File at the bottom!
-----------------------------------------------------
Drop Table if Exists #Temp_NPI_Switch

Declare @SelectType			as Varchar(15)
Declare @YearQuarter		as char(6)
Declare @StartDate			as date
Declare @StopDate			as date
Declare @PrimaryTaxanomy	as varchar(50)

Declare @FiscalYear			as Varchar(6)
Declare @QuarterStart		as Date
Declare @QuarterStop		as Date

Declare @StartTime			as DateTime
Declare @StopTime			as Datetime
Declare @MsgString			as Varchar(75)

Set @SelectType			= 'Current'
Set @FiscalYear			= (Select FiscalYear	From Database_Constants.dbo.Quarterly_Automated)
Set @YearQuarter		= (Select YearQuarter	From Database_Constants.dbo.Quarterly_Automated)
Set @QuarterStart		= (Select QuarterStart	From Database_Constants.dbo.Quarterly_Automated)
Set	@QuarterStop		= (Select QuarterStop	From Database_Constants.dbo.Quarterly_Automated)

----------------------------------------------------------------------------
-- NOTE!!!!!
--
-- I copied attribution records for 2021Q4 for 2022Q1 for Power BI Reports
-- (If 2021Q4 needs run a 2nd time then delete 2022Q1 records and re-copy)
----------------------------------------------------------------------------
Drop Table if exists cclf_testing.dbo.tblTemp1
Drop Table if exists CCLF_Testing.dbo.tblTemp2
Drop Table if exists CCLF_Testing.dbo.tblTemp3
Drop Table if exists CCLF_Testing.dbo.tblTemp4
Drop Table if exists CCLF_Testing.dbo.tblTemp5_0
Drop Table if exists CCLF_Testing.dbo.tblTemp5_1
Drop Table if exists CCLF_Testing.dbo.tblTemp5_2
Drop Table if exists CCLF_Testing.dbo.tblTemp5_3
Drop Table if exists CCLF_Testing.dbo.tblTemp5_4
Drop Table if exists CCLF_Testing.dbo.tblTemp5_5
Drop Table if exists CCLF_Testing.dbo.tblTemp5_6
Drop Table if exists CCLF_Testing.dbo.tblTemp6
Drop Table if exists CCLF_Testing.dbo.tblTemp7
Drop Table if exists CCLF_Testing.dbo.tblTemp8
Drop Table if exists CCLF_Testing.dbo.tblTemp9
Drop Table if exists CCLF_Testing.dbo.tblTemp10
Drop Table if exists CCLF_Testing.dbo.tblTemp11
Drop Table if exists CCLF_Testing.dbo.tblTemp12
Drop Table if exists CCLF_Testing.dbo.tblTemp13
Drop Table if exists CCLF_Testing.dbo.tblTemp13_A
Drop Table if exists CCLF_Testing.dbo.tblTemp14
Drop Table if exists CCLF_Testing.dbo.tblTemp15
Drop Table if exists CCLF_Testing.dbo.tblTemp16

---------------------------------------------------------------------------
-- Delete the current quarter from the ACO_Beneficiaries Table
---------------------------------------------------------------------------
Delete From CCLF_LookupTables.dbo.ACO_Beneficiaries
Where 
BENE_YearQuarter = @YearQuarter

---------------------------------------------------------------------------
-- Insert the Beneficiary informaton from Qassgn into the ACO_Beneficiaries
-- table to start Finding out who their Primary Care Physician is
--
-- BENE_NPI_2 Information is inserted into ACO_Beneficiaries from the Start
-- Because they are Voluntarily Aligned in QASSGN_1.
--
-- BENE_NPI_Number (Regular) is assigned as program determines the correct 
-- PCP the Beneficiary is attributed to according to CMS Rules.
---------------------------------------------------------------------------
Insert into CCLF_LookupTables.dbo.ACO_Beneficiaries
		(
		  BENE_YearQuarter
		, BENE_HIC_NUM
		, BENE_NPI_2_Number
		, BENE_NPI_2_TIN
		, Flag_NPI_VA
		, Flag_NPI_PCS
		, IN_VA_MAX
		)	 

		Select 
		  @YearQuarter
		, Q1.Q1_HICN
		, Q1.VA_NPI
		, Q1.VA_TIN
		, Case 
			When Q1.VA_NPI is null 
			Then 0 Else 1 
		  End As Flag_NPI_VA
		, 0							-- Set pcs_Flag to 0.  
		, IN_VA_MAX					-- We do not know who has/does not have record(s) in PCS
		from CCLF_LookupTables.dbo.QASSGN_Table1_1 Q1
		Where Q1_YearQuarter = @YearQuarter


--------------------------------------------------------------------------
-- Update NPI2_GroupTinName because GroupTinName is not in the Q1 Table
-- Update NPI2 Last Name and First Name
--------------------------------------------------------------------------
update BN
set 
  BENE_NPI_2_TINName		= ACO.ACO_GroupTinName
, BENE_NPI_2_Group			= ACO.ACO_GroupTinShortName
, BENE_NPI_2_LastName		= ACO.ACO_NPI_LastName
, BENE_NPI_2_FirstName		= ACO.ACO_NPI_FirstName
, BENE_NPI_Classification	= ACO.ACO_PrimaryTaxonomy         ---Levi 12/1/2025
From CCLF_LookupTables.dbo.ACO_Beneficiaries BN
inner join CCLF_LookupTables.dbo.ACO ACO
on BN.BENE_NPI_2_Number = ACO.ACO_NPIIndividual
Where
BN.BENE_NPI_2_Number	is not null

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have only 
-- 1 NPI.
-- Update all the records in the ACO_Beneficiaries table with this
-- information
---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select 
  Q4_HICN
, Min(Q4_IndividualNPI) as MinNPI
Into cclf_testing.dbo.tblTemp1
from CCLF_LookupTables.dbo.QASSGN_Table1_4
Where
Q4_YearQuarter = @YearQuarter
Group by
  Q4_HICN
Having Count(Q4_HICN) = 1
Order by 
Q4_HICN

Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= Temp1.MinNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 01.  1 NPI'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp1 Temp1 on
ACO_BENE.BENE_HIC_NUM = Temp1.Q4_HICN
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is null	

--Select * from CCLF_Testing.dbo.tblTemp1

Set @StopTime = GetDate()
Set @MsgString = 'Step 01.  1 NPI Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have  
-- > 1 NPI and Only 1 records is a ""Family Medicine"" NPI  
--
-- Update all the records in the ACO_Beneficiaries table with this
-- information

---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select
  Q4.Q4_HICN
, MIN(Q4.Q4_IndividualNPI) as MinNPI
Into CCLF_Testing.dbo.tblTemp2
from CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4
Inner Join
CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
Q4.Q4_HICN = ACO_BENE.BENE_HIC_NUM
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where
	ACO_BENE.BENE_YearQuarter		= @YearQuarter
and Q4.Q4_YearQuarter				= @YearQuarter
and ACO_BENE.BENE_ATTR_From			is null
and ACO.ACO_NPI_Classification		In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active					= 'Yes' -- Added 10/25/2021 to make sure 
Group By
  Q4.Q4_HICN
Having Count(Q4.Q4_HICN) = 1
Order by
Q4.Q4_HICN

Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= Temp2.MinNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 02.  1 FAM NPI'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp2 Temp2 on
ACO_BENE.BENE_HIC_NUM = Temp2.Q4_HICN
Where 
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and BENE_ATTR_From				Is Null

Set @StopTime = GetDate()
Set @MsgString = 'Step 02.  1 Family NPI Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

---------------------------------------------------------------------------
-- Find all of the records in the QASSGN File (Q4) that have  
-- > 1 NPI and > 1 record that is a ""Family Medicine"" NPI  
--
-- Next find which NPI had the most Visits
---------------------------------------------------------------------------
Set @StartTime = GetDate()

Select
 ACO_BENE.BENE_HIC_NUM
Into CCLF_Testing.dbo.tblTemp3
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
ACO_BENE.BENE_HIC_NUM = Q4.Q4_HICN
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and Q4.Q4_YearQuarter			= @YearQuarter
and ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is null
and ACO.ACO_NPI_Classification	In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active				= 'Yes' -- Added 10/25/2021 to make sure 
Group By
  ACO_BENE.BENE_HIC_NUM
Having Count(BENE_HIC_NUM) > 1
Order by
BENE_HIC_NUM

----------------------------------------------
-- Join to QASSGN1_4 to find multiple NPI's
----------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp4
from CCLF_Testing.dbo.tblTemp3 T3
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
T3.BENE_HIC_NUM = Q4.Q4_HICN
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
Q4.Q4_IndividualNPI = ACO.ACO_NPIIndividual
Where 
    Q4.Q4_YearQuarter			= @YearQuarter
And ACO.ACO_NPI_Classification	In ('Family Medicine', 'General Practice','Physician Assistant','Nurse Practitioner','Internal Medicine','Obstetrics & Gynecology')
and ACO.ACO_Active				= 'Yes' -- Added 10/25/2021 to make sure 
Order by 
T3.BENE_HIC_NUM

--------------------------------------------------
-- Join to PCS File to Find Most PCS Visits
--------------------------------------------------
Select 
  T4.BENE_HIC_NUM
--, T4.ACO_NPIIndividual
-- Changed 8/22/2019 for Plurality of greatest cost
--, Count(distinct CUR_CLM_UNIQ_ID) as NumVisits
, Max(Q4.Q4_PCS_Count) as NumVisits
Into CCLF_Testing.dbo.tblTemp5_0
from CCLF_Testing.dbo.tblTemp4 T4
Left Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
    T4.BENE_HIC_NUM			= Q4.Q4_HICN
and T4.ACO_NPIIndividual	= Q4.Q4_IndividualNPI
Where
Q4.Q4_YearQuarter			= @YearQuarter
Group by
  T4.BENE_HIC_NUM
--, T4.ACO_NPIIndividual

------------------------------------------------------
-- Join Back to PCS File to Find NPI with Max Visits
------------------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp5_1 
from CCLF_Testing.dbo.tblTemp5_0 T5
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T5.BENE_HIC_NUM = Q4.Q4_HICN
and T5.NumVisits	= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter = @YearQuarter

--------------------------------------------------
-- Find Single NPI / Beneficiaries
--------------------------------------------------
Select 
  BENE_HIC_NUM
, NumVisits
, Count(BENE_HIC_NUM) as NumRecords
Into CCLF_Testing.dbo.tblTemp5_2
from CCLF_Testing.dbo.tblTemp5_1
Group by
  BENE_HIC_NUM
, NumVisits
Having Count(BENE_HIC_NUM) = 1
Order by
  NumRecords DESC
, BENE_HIC_NUM

---------------------------------------------
-- Join Back to Find NPI with the Max Visits
---------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp5_3
From CCLF_Testing.dbo.tblTemp5_2 T5
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T5.BENE_HIC_NUM		= Q4.Q4_HICN
and T5.NumVisits		= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter		= @YearQuarter
Order by
BENE_HIC_NUM

--------------------------------------------------
-- Update ACO_Beneficiaries 
--------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T5.Q4_IndividualNPI
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 03.  FAM NPI Max PCS Visits'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE 
Inner Join
CCLF_Testing.dbo.tblTemp5_3 T5 on 
ACO_BENE.BENE_HIC_NUM = T5.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is Null		-- vst 11/13/2025  added where clause to make sure we are not updating previous records which were already assigned attribution

Set @StopTime = GetDate()
Set @MsgString = 'Step 03.  FAM NPI Max PCS Visits (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

--------------------------------------------------
-- Select Beneficiaries with more than 1 Fam NPI
-- and Same # of PCS Visits
--------------------------------------------------
Set @StartTime = GetDate()

Select 
  BENE_HIC_NUM
, NumVisits
, Count(BENE_HIC_NUM) as NumRecords
Into CCLF_Testing.dbo.tblTemp5_4
from CCLF_Testing.dbo.tblTemp5_1
Group by
  BENE_HIC_NUM
, NumVisits
Having Count(BENE_HIC_NUM) > 1
Order by
  NumRecords DESC
, BENE_HIC_NUM

----------------------------------------------------
-- Join Back to Find NPI with Same # of PCS  Visits
----------------------------------------------------
Select *
Into CCLF_Testing.dbo.tblTemp5_5
From CCLF_Testing.dbo.tblTemp5_4 T5
Inner Join
CCLF_LookupTables.dbo.QASSGN_Table1_4 Q4 on
	T5.BENE_HIC_NUM = Q4.Q4_HICN
and T5.NumVisits	= Q4.Q4_PCS_Count
Where
Q4.Q4_YearQuarter	= @YearQuarter
Order by
BENE_HIC_NUM

--------------------------------------------------
-- Join to Final Data to find NPI with most $$
--------------------------------------------------
-------------------------
-- Create Index on T5_5
-------------------------
Create Index idx_BENE_HIC_NUM		on CCLF_Testing.dbo.tblTemp5_5 (BENE_HIC_NUM)
Create Index idx_Q4_IndividualNPI	on CCLF_Testing.dbo.tblTemp5_5 (Q4_IndividualNPI)

Select 
  T5.BENE_HIC_NUM
, T5.Q4_IndividualNPI
-- Changed 8/22/2019 for Plurality of greatest cost
--, Count(distinct CUR_CLM_UNIQ_ID) as NumVisits
, Sum(CLM_PMT_AMT) as TotalPaid
Into CCLF_Testing.dbo.tblTemp5_6
from CCLF_Testing.dbo.tblTemp5_5 T5
Left Join
CCLF_ProgrammingCopy.dbo.CCLF_FinalData FinalData on
    T5.BENE_HIC_NUM		= FinalData.BENE_HIC_NUM
and T5.Q4_IndividualNPI = FinalData.RNDRG_PRVDR_NPI_NUM
Where
FinalData.CLM_THRU_DT between @StartDate and @StopDate
Group by
  T5.BENE_HIC_NUM
, T5.Q4_IndividualNPI

-------------------------------------------------------
-- Partition by BENE_HIC_NUM to select Max Paid
-------------------------------------------------------
Select 
  BENE_HIC_NUM
, Q4_IndividualNPI
, TotalPaid
, First_Value(Q4_IndividualNPI) Over (Partition by BENE_HIC_NUM Order by TotalPaid Desc) as NPIWithMostDollars
into CCLF_Testing.dbo.tblTemp6
from CCLF_Testing.dbo.tblTemp5_6
Order by
BENE_HIC_NUM

----------------------------------------------------------
-- Group by to get the NPI with Most Visits isolated
----------------------------------------------------------
Select 
  T6.BENE_HIC_NUM
, T6.NPIWithMostDollars
Into CCLF_Testing.dbo.tblTemp7
from CCLF_Testing.dbo.tblTemp6 T6
Group by
  T6.BENE_HIC_NUM
, T6.NPIWithMostDollars

----------------------------------------------------------
-- Update the ACO_Beneficiary table with FinalData - 2 FAM NPI
----------------------------------------------------------
Update ACO_BENE
Set 
  ACO_BENE.BENE_NPI_Number	= T7.NPIWithMostDollars
, ACO_Bene.Flag_NPI_PCS		= 1
, ACO_BENE.BENE_ATTR_From	= 'Step 04.  Final Data-2 NPI Fam Max$'
from CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE
Inner Join
CCLF_Testing.dbo.tblTemp7 T7 on
ACO_BENE.BENE_HIC_NUM = T7.BENE_HIC_NUM
Where
	ACO_BENE.BENE_YearQuarter	= @YearQuarter
and ACO_BENE.BENE_ATTR_From		is Null		-- vst 11/13/2025  added where clause to make sure we are not updating previous records which were already assigned attribution

Set @StopTime = GetDate()
Set @MsgString = 'Step 04.  2 Family Data Most Dollars NPI Completed (' + Convert(varchar,DateDiff(minute, @StartTime, @StopTime)) + ' Mins)'
RAISERROR  (@MsgString, 10,1) WITH NOWAIT

