DECLARE filecursor CURSOR
FOR
SELECT filename,
	format(cast(left(right(filename, 15), 6) AS DATE), 'yyyy-MM-01') AS Medicarefiledate,
	format(cast(left(right(filename, 15), 6) AS DATE), 'MMyyyy') AS CCLFFileDate,
	format(cast(left(right(filename, 15), 6) AS DATE), 'yyyy') AS CCLFFileYear,
	FilesizeMB,
	Connector,
	Filetype
FROM #filelist fl
JOIN #temp1 T1 ON fl.filename LIKE '%' + t1.connector + '%'

OPEN filecursor

FETCH NEXT
FROM filecursor
INTO @filename,
	@MedicareFileDate,
	@CCLFFileDate,
	@CCLFFileYear,
	@filesizeMB,
	@connector,
	@filetype

WHILE @@FETCH_STATUS = 0
BEGIN
	DELETE
	FROM CCLF_Months.dbo.CCLFStaging

	BEGIN TRY
		SET @CCLFFileStructure = @filetype + '_' + @CCLFFileYear
		SET @CCLFFileLocation = REPLACE(@dir, '""', '') + '\' + @filename
		SET @sql = 'Bulk insert  CCLF_Months.dbo.CCLFStaging from ''' + @CCLFFileLocation + '''  WITH (ROWTERMINATOR = ''0x0A'')'

		EXEC (@sql)

		SET @sql = 'EXEC CCLF_Procedures.dbo.procBulkImport_' + @filetype + '_2023 ' + '''' + CONVERT(VARCHAR(10), @MedicareFileDate, 120) + ''', ' + '''' + @CCLFFileDate + ''', ' + '''' + @filetype + ''', ' + '''' + @CCLFFileStructure + ''', ' + '''' + @CCLFFileLocation + ''''

		EXEC (@sql)

		SET @sql = '
          Insert Into Master.dbo.CCLF_ImportLog
          (Filename, FileType, FilesizeMB, Success, Message, DateImported)
          Values
          (
          ''' + @filename + ''',
          ''' + @filetype + ''',
          ''' + cast(@filesizeMB AS VARCHAR(50)) + ''',
          1,
          ''Imported Successfully'',
          ''' + CONVERT(VARCHAR(23), GETDATE(), 121) + '''
          )'

		EXEC (@SQL)
	END TRY

	BEGIN CATCH
		SET @ErrorMessage = ERROR_MESSAGE()
		SET @sql = '
          Insert Into Master.dbo.CCLF_ImportLog
          (Filename, FileType, FilesizeMB, Success, Message, DateImported)
          Values
          (
          ''' + @filename + ''',
          ''' + @filetype + ''',
          ''' + cast(@filesizeMB AS VARCHAR(50)) + ''',
          0,
          ''' + @ErrorMessage + ''',
          ''' + CONVERT(VARCHAR(23), GETDATE(), 121) + '''
          )'

		EXEC (@sql)
	END CATCH

	FETCH NEXT
	FROM filecursor
	INTO @filename,
		@MedicareFileDate,
		@CCLFFileDate,
		@CCLFFileYear,
		@filesizeMB,
		@connector,
		@filetype
END

