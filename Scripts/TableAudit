, BENE_DemoRiskScore
, BENE_DemoRiskScoreType
, BENE_NPI_Number
, BENE_NPI_LastName
, BENE_NPI_FirstName
, BENE_NPI_2_Number			-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_NPI_2_LastName		-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_NPI_2_FirstName		-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_Zip
, BENE_PersonYears
, BENE_ATTR_From
, BENE_ACO_GroupTinShortName
, ACO_GroupTinshortName
, ACO_GroupTinName
, ACO_GroupTin
, BENE_NPI_2_Group			-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_NPI_2_TINName		-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
, BENE_NPI_2_TIN			-- vst 11/11/2025 New field to account for Beneficiaries Voluntarily aligned to a Physician which is no longer with the ACO
