Set		@SelectType			= 'Current'
Set		@MeasureAbbr		= (Select A1C_Abbr From Database_Constants.dbo.Mips Where SelectType = @SelectType and A1C_Number = @MeasureNumber)
Set		@MeasureName		= (Select A1C_Name From Database_Constants.dbo.Mips Where SelectType = @SelectType and A1C_Number = @MeasureNumber)

