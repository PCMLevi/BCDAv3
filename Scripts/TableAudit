AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

DECLARE @filename NVARCHAR(500),
        @date NVARCHAR(50),
        @SQL NVARCHAR(MAX),
        @FileSizeMB FLOAT,
        @ErrorMsg NVARCHAR(4000),
        @fulldate nvarchar(50)

DROP TABLE IF EXISTS #filelistraw, #filelist;

CREATE TABLE #filelistraw (line NVARCHAR(500));

INSERT INTO #filelistraw
EXEC xp_cmdshell 
'powershell -NoProfile -Command ""Get-ChildItem ''E:\SQL\BCBS_Import'' -File | Select-Object Name, Length | ForEach-Object { $_.Name + ''|'' + $_.Length }""';

CREATE TABLE #filelist (
    filename NVARCHAR(200),
    FileSizeMB FLOAT
);

INSERT INTO #filelist (filename, FileSizeMB)
SELECT 
    LEFT(line, CHARINDEX('|', line)-1) AS FileName,
    CAST(RIGHT(line, LEN(line) - CHARINDEX('|', line)) AS FLOAT) / 1048576 AS FileSizeMB
FROM #FileListRaw
WHERE line IS NOT NULL;

DECLARE filecursor CURSOR FOR 
SELECT 
    filename,
    FileSizeMB,
    CONVERT(VARCHAR(8), format(CAST(LEFT(RIGHT(filename, 19), 8) AS DATE),'MMyyyy'), 112) AS FileDate,
        CONVERT(VARCHAR(8), CAST(LEFT(RIGHT(filename, 19), 8) AS DATE), 112)         Fulldate
FROM #filelist
WHERE filename LIKE 'FFV_ADHOC%'

OPEN filecursor;
FETCH NEXT FROM filecursor INTO @filename, @FileSizeMB, @date, @fulldate

WHILE @@FETCH_STATUS = 0
BEGIN
    BEGIN TRY
        SET @SQL = '

        drop table if exists BCBS_Months.dbo.FileSummary_Staging_' + @date + '
        truncate table BCBS_Months.dbo.FileSummary_Staging

        select * into BCBS_Months.dbo.FileSummary_Staging_' + @date + ' 
        from BCBS_Months.dbo.FileSummary_Staging
        where 1=2

BULK INSERT BCBS_Months.dbo.FileSummary_Staging_' + @date + '
FROM ''C:\BCBS_Import\' + @filename + '''
WITH (
    FIELDTERMINATOR = ''|'',
    ROWTERMINATOR = ''0x0A'',
    FIRSTROW = 2
)

BULK INSERT BCBS_Months.dbo.FileSummary_Staging
FROM ''C:\BCBS_Import\' + @filename + '''
WITH (
    FIELDTERMINATOR = ''|'',
    ROWTERMINATOR = ''0x0A'',
    FIRSTROW = 2
)

insert into BCBS_Months.dbo.FileSummary
(
BCBSFileDate,
ClaimType,
RecordCount,
FileName,
ClaimCount
)
Select
'''+format(cast(@fulldate as date), 'yyyy-MM-01')+''',
claimtype,
recordcount,
Filename,
claimcount
from BCBS_Months.dbo.FileSummary_Staging_' + @date + '
where not exists 
(
select 1 from BCBS_Months.dbo.FileSummary where BCBSFiledate = '''+format(cast(@fulldate as date), 'yyyy-MM-01')+'''
)
'
        EXEC(@SQL);
        PRINT(@SQL);

        SET @SQL = '
INSERT INTO master.dbo.BCBS_ImportLog
(Filename, MonthTable, FileSizeMB, Success, Message, DateImported)
VALUES
(''' + @filename + ''', 
 ''BCBS_Months.dbo.FileSummary_Staging_' + @date + ''',
 ' + CAST(@FileSizeMB AS NVARCHAR(50)) + ',
 1,
 ''Imported successfully'',
 ''' + CONVERT(NVARCHAR(30), GETDATE(), 120) + ''');';
        EXEC(@SQL);
    END TRY
    BEGIN CATCH
        SET @ErrorMsg = ERROR_MESSAGE();
        SET @SQL = '
INSERT INTO master.dbo.BCBS_ImportLog
(Filename, MonthTable, FileSizeMB, Success, Message, DateImported)
VALUES
(''' + @filename + ''', 
 ''BCBS_Months.dbo.FileSummary_Staging_' + @date + ''',
 ' + CAST(@FileSizeMB AS NVARCHAR(50)) + ',
 0,
 ''' + REPLACE(@ErrorMsg, '''', '''''') + ''',
 ''' + CONVERT(NVARCHAR(30), GETDATE(), 120) + ''');';
        EXEC(@SQL);
        
    END CATCH;

 FETCH NEXT FROM filecursor INTO @filename, @FileSizeMB, @date, @fulldate;  
END;

CLOSE filecursor;
DEALLOCATE filecursor;



set @SQL = 
'
update [master].[dbo].[BCBS_ImportVerify]
set ClaimType = FS.ClaimType
,ADHOC_RecordCount = FS.RecordCount
from [master].[dbo].[BCBS_ImportVerify] BI
left join BCBS_Months.dbo.filesummary_staging_'+@date+' FS on
left(FS.FileName,15) = left(BI.Filename, 15)
where TableDate = '''+@date+'''
'
exec(@SQL)


Update [master].[dbo].[BCBS_ImportVerify]
set Match = Case when ADHOC_RecordCount = Imported_RecordCount then 1 Else 0 End
,DateVerified = Getdate()



END
