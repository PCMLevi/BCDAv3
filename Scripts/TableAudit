2431,2026-06-04T09:48:09.040262,CREATE_PROCEDURE,CCLF_Procedures,dbo,BCBS_Professional_Header_Detail,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- =============================================
CREATE PROCEDURE BCBS_Professional_Header_Detail
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

----------------------------------------------------
-- Professional File
-- Update PatientID, SubscriberID, PlaceOfTreatment
-- File Summary - Update the Detail Count
----------------------------------------------------
Declare @BCBSFileDate	as Date
Declare @NumRecords		as Int

Set @BCBSFileDate	= 
(
select top 1 format(dateadd(Month,1,cast(Line_PaidDate as date)),'MM/01/yyyy') 
from BCBS_Months.dbo.Professional_Staging order by Line_PaidDate desc
)
--10/1/2025
Set @NumRecords = 
	(
		Select 
		Count(Id)
		from BCBS_Months.dbo.Professional_Detail_Months
		Where
		BCBSFileDate = @BCBSFileDate
	)

Drop Table if Exists #Temp1
Drop Table if Exists #Temp2

Select Distinct 
  PatientID
, SubscriberID
, ClaimId
, PlaceOfTreatment_CD
, PlaceOfTreatment
Into #Temp1
From BCBS_Months.dbo.Professional_Header_Months ProfH
Where
ProfH.BCBSFileDate = @BCBSFileDate

Update ProfD
Set 
  ProfD.PatientID					= T1.PatientID
, ProfD.PatientID_Type	=
  Case
	When Left(T1.PatientID,8) = '99000000' Then 'Host'
	Else 'Texas'
  End
, ProfD.SubscriberID				= T1.SubscriberID
, ProfD.Line_PlaceOfTreatment_CD	= T1.PlaceOfTreatment_CD
, ProfD.Line_PlaceOfTreatment		= T1.PlaceOfTreatment
from BCBS_Months.dbo.Professional_Detail_Months ProfD
Inner Join
#Temp1 T1 on
ProfD.ClaimID = T1.ClaimID
Where
ProfD.BCBSFileDate = @BCBSFileDate

-----------------------------------------------------------
-- Update the HEADER Date of Service from the Line Detail
-----------------------------------------------------------
Select Distinct 
  ClaimID
, Line_ServiceDate
Into #Temp2
from BCBS_Months.dbo.Professional_Detail_Months ProfD
Where
ProfD.BCBSFileDate = @BCBSFileDate
Order by
  ClaimID
, Line_ServiceDate

Update ProfH
Set ServiceDate =  T2.Line_ServiceDate
from BCBS_Months.dbo.Professional_Header_Months ProfH
Inner Join
#Temp2 T2 on
ProfH.ClaimID = T2.ClaimID
Where
ProfH.BCBSFileDate = @BCBSFileDate

--------------------------------------------
-- Update the Member County and Market
--------------------------------------------
Update ProfH
Set 
  ProfH.MemberCounty			= Mbr.MemberCounty
, ProfH.MemberCountyMarket		= Mbr.MemberCountyMarket
from BCBS_Months.dbo.Professional_Header_Months ProfH
Inner Join
BCBS_Months.dbo.Membership_Months Mbr on
ProfH.PatientID = mbr.PatientID
Where
ProfH.BCBSFileDate = @BCBSFileDate





