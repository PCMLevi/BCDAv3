4317,2026-07-09T12:48:12.662094,ALTER_PROCEDURE,CCLF_Procedures,dbo,procCompensation_PYCurrent_10_001_A1C_3_2_Bonus_NPI,"
Alter Procedure procCompensation_PYCurrent_10_001_A1C_3_2_Bonus_NPI
(	
	  @CompensationYear		as Char(6)
	, @YearQuarter			as Varchar(7)
	, @CompensationPercent	as Float
)
AS
BEGIN

Declare @SelectType as Varchar(15)
Set		@SelectType = 'Current'

Delete From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI

Drop Table if Exists #Temp_PercentPositive
Drop Table if Exists #Temp_TotalWeight

----------------------------------------------------------------
-- Insert Only the NPI's in TINs that are Over the ACO Average
----------------------------------------------------------------
Insert Into Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI
(  
  Compensation_Quarter
, Compensation_Percent
, ACO_GroupTIN
, ACO_GroupTINName_New
, NPI
, NPI_FullName
, PY_NPI
, NumBENE_NPI
, QM_Completion_Percent
, QM_40th_Percentile
, A1C_Eligible_NPI
, A1C_Complete_NPI
, A1C_Pass_NPI
, A1C_Performance_Rate_NPI
, A1C_Performance_Rate_TIN
, A1C_Performance_Rate_ACO
, A1C_Performance_Rate_NPI_Over_TIN
, A1C_Performance_Rate_NPI_Over_ACO
, A1C_Performance_Flag_NPI_Over_TIN
, A1C_Performance_Flag_NPI_Over_ACO
, A1C_Performance_Flag_TIN_Over_ACO
, A1C_Bonus_Allotment_TIN
, SQLRunDate_MDI_A1C
)
Select 
  @YearQuarter
, @CompensationPercent
, Agg_NPI.ACO_GroupTIN
, Agg_NPI.ACO_GroupTINName_New
, Agg_NPI.NPI
, Agg_NPI.NPI_FullName
, Agg_NPI.PY_NPI
, Agg_NPI.NumBENE_NPI
, Agg_NPI.QM_Completion_Percent
, Agg_NPI.QM_40th_Percentile
, Agg_NPI.A1C_Eligible_NPI
, Agg_NPI.A1C_Complete_NPI
, Agg_NPI.A1C_Pass_NPI
, Agg_NPI.A1C_Performance_Rate_NPI
, Agg_NPI.A1C_Performance_Rate_TIN
, Agg_NPI.A1C_Performance_Rate_ACO
, Agg_NPI.A1C_Performance_Rate_NPI_Over_TIN
, Agg_NPI.A1C_Performance_Rate_NPI_Over_ACO
, Agg_NPI.A1C_Performance_Flag_NPI_Over_TIN
, Agg_NPI.A1C_Performance_Flag_NPI_Over_ACO
, BonusTin.A1C_Performance_Flag_TIN_Over_ACO
, BonusTin.A1C_Bonus_TIN
, Agg_NPI.SQLRunDate_MDI_A1C
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_2_2_Aggregate_NPI Agg_NPI
Inner Join
Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_1_Bonus_TIN BonusTin on
Agg_NPI.ACO_GroupTIN = BonusTin.ACO_GroupTIN
Where
BonusTin.A1C_Performance_Flag_TIN_Over_ACO = 1

-------------------------------
-- Calculation Quality Weight
-------------------------------
Update EDBonus
Set 
A1C_Quality_Weight = 
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then CCLF_Functions.dbo.Divide_Return0(
			 A1C_Performance_Rate_TIN
		   , QM_40th_Percentile) *-1
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus

-----------------------------------------
-- Calculation BENE Weight
-- Beneficiares for NPI * Quality Weight
-----------------------------------------
Update EDBonus
Set 
A1C_BENE_Weight =
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then NumBENE_NPI * A1C_Quality_Weight
		Else 0
	End 
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus

----------------------------------------------------
-- Calculate and Update Total Weight for Each TIN
-- Sum BENE Weight by TIN
----------------------------------------------------
Select 
  EDBonus.ACO_GroupTIN
, Sum(EDBonus.A1C_BENE_Weight) as EDObos_TotalWeight
Into #Temp_TotalWeight
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus
Where
EDBonus.A1C_Performance_Flag_NPI_Over_ACO = 1 
Group By
EDBonus.ACO_GroupTIN

Update EDBonus
Set 
EDBonus.A1C_BENE_Weight_Total = 
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then TW.EDObos_TotalWeight
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus
Inner Join
#Temp_TotalWeight TW on
EDBonus.ACO_GroupTIN = TW.ACO_GroupTIN

-------------------------------------
-- Calculate EDObs Bonus Percent
-- (BENE Weight / BENE Total Weight)
-------------------------------------
Update EDBonus
Set 
A1C_Bonus_Percent	= 
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then CCLF_Functions.dbo.Divide_Return0(A1C_BENE_Weight, A1C_BENE_Weight_Total)
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus

---------------------------------
-- Calculate ED Bonus
-- Bonus of TIN * Bonus Percent
---------------------------------
Update EDBonus
Set 
  A1C_Bonus_PerNPI	=  
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment_TIN
		Else 0
	End 
, A1C_Bonus_NPI		=  
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then A1C_Bonus_Percent * A1C_Bonus_Allotment_TIN
		Else 0
	End
, A1C_Bonus_PerBENE	= 
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then CCLF_Functions.dbo.Divide_Return0(
		     (A1C_Bonus_Percent * A1C_Bonus_Allotment_TIN), NumBENE_NPI)
		Else 0
	End
, A1C_Bonus_Allotment_TIN = 
	Case
		When A1C_Performance_Flag_NPI_Over_ACO = 1 
		Then A1C_Bonus_Allotment_TIN
		Else 0
	End
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus

------------------------
-- Update SQLRunDate
------------------------
Update EDBonus
Set SQLRunDate = GetDate()
From Compensation_PYCurrent.dbo.Compensation_10_001_A1C_3_2_Bonus_NPI EDBonus

End
