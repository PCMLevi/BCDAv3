      ,lt.[CLM_LINE_PRMRY_PYR]
      ,lt.CLM_LINE_DGNS_CD
      ,lt.[CLM_LINE_DGNS]
        ,v.[CLM_DGNS_CD]
        ,v.CLM_DGNS_POS
      ,lt.[CLM_RNDRG_PRVDR_TAX_NUM]
      ,lt.[RNDRG_PRVDR_NPI_NUM]
      ,aco.ACO_Active
      ,fd.RNDRG_Prvdr_LName
      ,fd.RNDRG_Prvdr_FName
      ,lt.[CLM_CARR_PMT_DNL_CD]
      ,lt.[CLM_CARR_PMT_DNL]
      ,lt.[CLM_PRCSG_IND_CD]
      ,lt.[CLM_PRCSG_IND]
      ,lt.[CLM_ADJSMT_TYPE_CD]
      ,lt.[CLM_ADJSMT_TYPE]
      ,lt.[CLM_EFCTV_DT]
      ,lt.[CLM_IDR_LD_DT]
      ,lt.[CLM_CNTL_NUM]
      ,lt.[BENE_EQTBL_BIC_HICN_NUM]
      ,lt.[CLM_LINE_ALOWD_CHRG_AMT]
      ,lt.[CLM_LINE_SRVC_UNIT_QTY]
      ,lt.[HCPCS_1_MDFR_CD]
      ,lt.[HCPCS_2_MDFR_CD]
      ,lt.[HCPCS_3_MDFR_CD]
      ,lt.[HCPCS_4_MDFR_CD]
      ,lt.[HCPCS_5_MDFR_CD]
      ,lt.[CLM_DISP_CD]
      ,lt.[CLM_DISP]
      ,lt.[CLM_DGNS_1_CD]
      ,lt.[CLM_DGNS_2_CD]
      ,lt.[CLM_DGNS_3_CD]
      ,lt.[CLM_DGNS_4_CD]
      ,lt.[CLM_DGNS_5_CD]
      ,lt.[CLM_DGNS_6_CD]
      ,lt.[CLM_DGNS_7_CD]
      ,lt.[CLM_DGNS_8_CD]
      ,lt.[CLM_DGNS_9_CD]
      ,lt.[CLM_DGNS_10_CD]
      ,lt.[CLM_DGNS_11_CD]
      ,lt.[CLM_DGNS_12_CD]
      ,lt.[DGNS_PRCDR_ICD_IND]
      ,lt.[HCPCS_BETOS_CD]
      ,lt.[HCPCS_BETOS]
      ,lt.[CLM_RNDRG_PRVDR_NPI_NUM]
      ,lt.[CLM_RFRG_PRVDR_NPI_NUM]
      ,lt.[CLM_CNTRCTR_NUM]
      into ##temp_CCLF5
    FROM [CCLF_Months].[dbo].[CCLF5_'+@claimyear+'_WithLookupTables] lt
    inner join CCLF_ProgrammingCopy.dbo.CCLF_FinalData fd on  
fd.[CUR_CLM_UNIQ_ID] = lt.[CUR_CLM_UNIQ_ID]
    left join cclf_lookuptables.dbo.ACO aco on 
    aco.ACO_NPIIndividual = lt.[CLM_RNDRG_PRVDR_NPI_NUM]
    CROSS APPLY (
    VALUES
        (lt.CLM_DGNS_1_CD, ''CLM_DGNS_1''),
        (lt.CLM_DGNS_2_CD, ''CLM_DGNS_2''),
        (lt.CLM_DGNS_3_CD, ''CLM_DGNS_3''),
        (lt.CLM_DGNS_4_CD, ''CLM_DGNS_4''),
        (lt.CLM_DGNS_5_CD, ''CLM_DGNS_5''),
        (lt.CLM_DGNS_6_CD, ''CLM_DGNS_6''),
        (lt.CLM_DGNS_7_CD, ''CLM_DGNS_7''),
        (lt.CLM_DGNS_8_CD, ''CLM_DGNS_8''),
        (lt.CLM_DGNS_9_CD, ''CLM_DGNS_9''),
        (lt.CLM_DGNS_10_CD,''CLM_DGNS_10''),
        (lt.CLM_DGNS_11_CD,''CLM_DGNS_11''),
        (lt.CLM_DGNS_12_CD,''CLM_DGNS_12'')
    ) v(CLM_DGNS_CD, CLM_DGNS_POS)
    where lt.medicarefiledate = '+quotename(@medicarefiledate, '''')+'
    AND v.CLM_DGNS_CD IS NOT NULL
    AND v.CLM_DGNS_CD != ''~''
'
exec(@sql)
