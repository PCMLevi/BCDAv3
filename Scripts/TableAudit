5635,2026-08-12T14:41:40.489589,CREATE_PROCEDURE,CCLF_Procedures,dbo,Quarterly_8_0_1_Update_BENE_XRef_Previous_HICN_Current,"-- =============================================
-- Author:		<Author,,Name>
-- Create date: <Create Date,,>
-- Description:	<Description,,>
-- ============================================
CREATE PROCEDURE Quarterly_8_0_1_Update_BENE_XRef_Previous_HICN_Current
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	--------------------------------------------
-- Cross Reference Previous BENE_HIC Nums
-- for the Current Year/Quarter
--------------------------------------------
Declare @StartDate		as Date
Declare @StopDate		as Date
Declare @FiscalYear		as Char(6)
Declare @YearQuarter	as Char(6)

Declare @Q1_StartDate	as Date
Declare @Q1_StopDate	as Date
Declare @Q2_StartDate	as Date
Declare @Q2_StopDate	as Date
Declare @Q3_StartDate	as Date
Declare @Q3_StopDate	as Date
Declare @Q4_StartDate	as Date
Declare @Q4_StopDate	as Date

Declare @Q1_Quarter		as Varchar(6)
Declare @Q2_Quarter		as Varchar(6)
Declare @Q3_Quarter		as Varchar(6)
Declare @Q4_Quarter		as Varchar(6)

Set @FiscalYear		= (select FiscalYear from database_constants.dbo.Quarterly_Automated)
Set @YearQuarter	= (select YearQuarter from database_constants.dbo.Quarterly_Automated)

Set @StartDate		= '01/01/' + left(@YearQuarter, 4)
Set @StopDate		= '12/31/' + left(@YearQuarter, 4)

-- Set @YearQuarter	= (Select CurrentQuarter From Database_Constants.dbo.Import_Export Where FiscalYear = @FiscalYear)


Set @Q1_StartDate	= '01/01/' + left(@YearQuarter, 4)
Set @Q1_StopDate	= '03/31/' + left(@YearQuarter, 4)

Set @Q2_StartDate	= '04/01/' + left(@YearQuarter, 4)
Set @Q2_StopDate	= '06/30/' + left(@YearQuarter, 4)

Set @Q3_StartDate	= '07/01/' + left(@YearQuarter, 4)
Set @Q3_StopDate	= '09/30/' + left(@YearQuarter, 4)

Set @Q4_StartDate	= '10/01/' + left(@YearQuarter, 4)
Set @Q4_StopDate	= '12/31/' + left(@YearQuarter, 4)

Set @Q1_Quarter = left(@YearQuarter, 4) + 'Q1'
Set @Q2_Quarter = left(@YearQuarter, 4) + 'Q2'
Set @Q3_Quarter = left(@YearQuarter, 4) + 'Q3'
Set @Q4_Quarter = left(@YearQuarter, 4) + 'Q4'

Drop Table if Exists #Temp_BENE_Xref 
Drop Table if Exists CCLF_Testing.dbo.Temp_BENE_Xref_1_2_3
Drop Table if Exists #Temp_Change_1
Drop Table if Exists #Temp_Change_2
Drop Table if Exists #Temp_Change_3
Drop Table if Exists #Temp_QuarterChange
Drop Table if Exists #Temp_Change_1_2_3
Drop Table if Exists #Temp_Change_1_2_3_Max
Drop Table if Exists #Temp_Change_2_MIN
Drop Table if Exists CCLF_Testing.dbo.Temp_BENE_Xref_2
Drop Table if Exists #Temp_QuarterChange2

----------------------------------------------------------
-- Clear out all Beneficiary Previous Information since 
-- we are running the program again
-- vst Added 3/6/2026
----------------------------------------------------------
