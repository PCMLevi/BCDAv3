, T6.BENE_DEATH_DT
, T6.BENE_RNG_BGN_DT
, T6.BENE_RNG_END_DT
, T6.BENE_1ST_NAME
, T6.BENE_MIDL_NAME
, T6.BENE_LAST_NAME
, T6.BENE_ORGNL_ENTLMT_RSN_CD
, T6.BENE_ORGNL_ENTLMT_RSN
, T6.BENE_ENTLMT_BUYIN_IND
, T6.BENE_ENTLMT_BUYIN
, T6.BENE_PART_A_ENRLMT_BGN_DT
, T6.BENE_PART_B_ENRLMT_BGN_DT
, T6.BENE_LINE_1_ADR
, T6.BENE_LINE_2_ADR
, T6.BENE_LINE_3_ADR
, T6.BENE_LINE_4_ADR
, T6.BENE_LINE_5_ADR
, T6.BENE_LINE_6_ADR
, T6.GEO_ZIP_PLC_NAME
, T6.GEO_USPS_STATE_CD
, T6.GEO_ZIP5_CD
, T6.GEO_ZIP4_CD
, ACO_BENE.BENE_NPI_Number
, ACO_BENE.BENE_NPI_LastName
, ACO_BENE.BENE_NPI_FirstName
, GetDate()
from #Temp2 T2
Left Join #Temp5 T5 on
T2.BENE_HIC_NUM = T5.BENE_HIC_NUM
Inner Join #Temp6 T6 on
    T5.BENE_HIC_NUM     = T6.BENE_HIC_NUM
and T5.MedicareFileDate = T6.MedicareFileDate
Left Join #Temp3 T3 on
T2.BENE_HIC_NUM = T3.BENE_HIC_NUM
Left Join CCLF_LookupTables.dbo.ACO_Beneficiaries ACO_BENE on
    ACO_BENE.BENE_HIC_NUM     = T3.BENE_HIC_NUM
and ACo_BENE.BENE_YearQuarter = T3.LastAttributedQuarter

----------------------------------------------
-- Update the ACO_GroupTin
----------------------------------------------
Update GEO
Set GEO.ACO_GroupTin = ACO.ACO_GroupTin
from CCLF_Subsets.dbo.BENE_GEO_INFO GEO
Inner Join
CCLF_LookupTables.dbo.ACO ACO on
GEO.PCP_NPI_Number = ACO.ACO_NPIIndividual

----------------------------------------------
-- Update Death Date = 1/1/1900
----------------------------------------------
Update GEO
Set BENE_DEATH_DT = Null
from CCLF_Subsets.dbo.BENE_GEO_INFO GEO
Where
BENE_DEATH_DT = '1/1/1900'

----------------------------------------------
-- Update RNDRG_BGN_DT = 1/1/1900
----------------------------------------------
Update GEO
Set BENE_RNG_BGN_DT = Null
from CCLF_Subsets.dbo.BENE_GEO_INFO GEO
Where
BENE_RNG_BGN_DT = '1/1/1900'

----------------------------------------------
-- Update RNDRG_END_DT = 1/1/1900
----------------------------------------------
Update GEO
Set BENE_RNG_END_DT = Null
from CCLF_Subsets.dbo.BENE_GEO_INFO GEO
Where
BENE_RNG_END_DT = '1/1/1900'

Set @RptStopTime = GetDate()
Set @rptStepRunTime		= Cast(DateDiff(ss, @rptStartTime, @RptStopTime) as varchar)
EXEC CCLF_Procedures.dbo.proc_ImportExport_ReportRunTimes @MedicareFileDate, @RptName, @rptStep, @rptStepRunTime

END;
