, DGNS_PRCDR_ICD_IND
, FromFile
, CLM_BLG_PRVDR_OSCAR_NUM
, CLM_DGNS_Position             -------Levi 12-19-2025 Clm_dgns_position wasnt being added
)

Select 
  CCLF4.MedicareFileDate
, CCLF4.CCLFFile
, ''' + @ClaimYear + '''
, T3.CUR_CLM_UNIQ_ID
, T3.BENE_HIC_NUM
, CCLF4.BENE_MBI_ID
, CCLF4.CLM_TYPE_CD
, CCLF4.CLM_TYPE
, CCLF4.CLM_PROD_TYPE_CD
, CCLF4.CLM_PROD_TYPE
, CCLF4.CLM_VAL_SQNC_NUM
, T3.CLM_DGNS_CD
, CCLF4.CLM_DGNS
, CCLF4.BENE_EQTBL_BIC_HICN_NUM
, CCLF4.PRVDR_OSCAR_NUM
, CCLF4.CLM_FROM_DT
, T3.CLM_THRU_DT
, CCLF4.CLM_POA_IND
, CCLF4.CLM_POA_ShortDesc
